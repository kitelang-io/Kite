// Boxed-String end-to-end: the `class String(n,data)` surface (the unconditional String representation).
// Every check must hold or `ok` drops to 0; main returns 77 iff all pass (the suite asserts exit 77).
fun eqStr(a: String, b: String): Int { return if (a == b) { 1 } else { 0 } }

fun main(): Int {
  var ok = 1

  // (1) THE representation flip: an embedded \x00 is a real byte, so len is the true byte count (3), not
  // the strlen-truncated 2 the T0 NUL-terminated C-string would report. This is the leak-end's precondition.
  val e = "a\x00b"
  if (e.length() != 3) { ok = 0 }
  if (e.byteAt(1) != 0) { ok = 0 }
  if (e.byteAt(2) != 98) { ok = 0 }

  // (2) concat (`+` -> String_add) boxes a fresh owned result.
  val c = "foo" + "bar"
  if (c.length() != 6) { ok = 0 }
  if (eqStr(c, "foobar") != 1) { ok = 0 }

  // (3) substr -> a fresh owned String copy; toStr() on a String is the identity materialize.
  val v = c.substr(1, 3)
  if (v.length() != 3) { ok = 0 }
  if (v.byteAt(0) != 111) { ok = 0 }
  if (eqStr(v.toStr(), "oob") != 1) { ok = 0 }

  // (4) `n.toStr()` boxes; interpolation ($x) routes through the show/concat roles.
  if (eqStr((42).toStr(), "42") != 1) { ok = 0 }
  if (eqStr((0).toStr(), "0") != 1) { ok = 0 }
  if (eqStr((0 - 5).toStr(), "-5") != 1) { ok = 0 }
  val x = 7
  if (eqStr("x=$x!", "x=7!") != 1) { ok = 0 }

  // (5) ordering (Ord) + equality (Eq) over the byte window.
  if (eqStr("abc", "abc") != 1) { ok = 0 }
  if (eqStr("abc", "abd") != 0) { ok = 0 }
  if ((if ("abc" < "abd") { 1 } else { 0 }) != 1) { ok = 0 }
  if ((if ("abcd" < "abc") { 1 } else { 0 }) != 0) { ok = 0 }

  // (6) StrBuilder assembles onto one buffer and finish() seals it into an owned String.
  val sb = strNew()
  sb.pushStr("Ka")
  sb.pushInt(9)
  sb.pushChar(33)
  val fin = sb.finish()
  if (fin.length() != 4) { ok = 0 }
  if (eqStr(fin, "Ka9!") != 1) { ok = 0 }

  // (7) String is ARC-EXEMPT (@arc(manual)): the box carries a refcount header (initialized to 1 at
  // allocation) but NO auto retain/release is emitted, so aliasing does NOT bump the count — it stays 1 —
  // and the buffer is a never-freed owned blob (leak-managed). This exemption is what makes the whole
  // compiler self-host with boxed strings (see the @arc(manual) rationale in lib/core/string.kite).
  val a = "hello"
  if (__refcount(a) != 1) { ok = 0 }
  val al = a
  if (__refcount(a) != 1) { ok = 0 }
  println(al)

  return if (ok == 1) { 77 } else { 0 }
}
