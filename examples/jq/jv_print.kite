// jv_print.kite — render a Json value as compact JSON text (matches `jq -c`). Mirrors jq's src/jv_print.c.
import "examples/jq/jv.kite"

// escape a string the way jq -c does for the characters this port can produce.
fun escStr(s: String): String {
  var out = "\""
  var i = 0
  while (i < strLen(s)) {
    val c = charAt(s, i)
    if (c == 34) { out += "\\\"" }
    else { if (c == 92) { out += "\\\\" }
    else { if (c == 10) { out += "\\n" }
    else { if (c == 9) { out += "\\t" }
    else { out += substr(s, i, 1) } } } }
    i += 1
  }
  return out + "\""
}

fun jsonToStr(j: Json): String {
  return when (j) {
    JNull -> "null"
    JBool(b) -> if (b) { "true" } else { "false" }
    JNum(n) -> intToStr(n)
    JStr(s) -> escStr(s)
    JArr(xs) -> {
      var out = "["
      var first = true
      for (x in xs) { if (first) { first = false } else { out += "," }  out += jsonToStr(x) }
      out + "]"
    }
    JObj(es) -> {
      var out = "{"
      var first = true
      for (e in es) {
        if (first) { first = false } else { out += "," }
        out += escStr(entryKey(e)) + ":" + jsonToStr(entryValue(e))
      }
      out + "}"
    }
  }
}
