import "lib/alloc/collections/hashmap.kite"
fun main(): Int {
  var acc = 0
  // Int -> Int map
  val m = HashMap::<Int, Int>(0, 0, 0, 0, 0, 0)
  m.set(10, 100) m.set(20, 200) m.set(30, 300)
  m.set(20, 222)                       // update in place, order preserved
  if (m.size() == 3) { acc = acc + 1 }
  when (m.get(20)) { Some(v) -> { if (v == 222) { acc = acc + 1 } }; None -> 0 }
  when (m.get(99)) { Some(v) -> 0; None -> { acc = acc + 1 } }
  if (m.getOr(30, 0) == 300) { acc = acc + 1 }
  if (m.has(10)) { acc = acc + 1 }
  if (m.keyAt(0) == 10) { acc = acc + 1 }   // insertion order
  if (m.keyAt(1) == 20) { acc = acc + 1 }
  if (m.valAt(1) == 222) { acc = acc + 1 }
  when (m.remove(20)) { Some(v) -> { if (v == 222) { acc = acc + 1 } }; None -> 0 }
  if (m.size() == 2) { acc = acc + 1 }
  if (m.keyAt(1) == 30) { acc = acc + 1 }   // order compacted: 10,30
  // grow: insert many
  var i = 0
  while (i < 50) { m.set(1000 + i, i) i = i + 1 }
  if (m.getOr(1042, 0) == 42) { acc = acc + 1 }
  return acc
}
