// compiler/klower.kite — the integration driver: lowers kfront's full-language surface AST (F*)
// into kenc's codegen AST, then runs the backend (codegen -> assemble -> Mach-O -> sign).
// Build: kitec run compiler/kfront.kite compiler/kenc.kite compiler/klower.kite
// Real CLI: `kitec [options] <input.kite>` (see docs/CLI.md); default output = input minus ".kite".
//
// TYPE-DIRECTED: a per-function context Lo carries a fresh-name counter + a coarse local type
// env + global fun-return/struct-field maps, so lowering can pick intToStr-vs-string for
// interpolation and listGet-vs-charAt for indexing. parseLower is 2-phase (collect all sigs,
// then lower) so forward references resolve. Constructs outside kenc's codegen (lambdas, floats,
// map literals, traits/impl, nullable ops) are still reported via lowFail.

struct Lo(val ctr: List, val locN: List, val locT: List, val fN: List, val fR: List, val sN: List, val sFN: List, val sFT: List, val lifted: List, val gctr: List, val classN: List, val arcOwned: List, val traitN: List, val constN: List, val constV: List, val cfuncs: List, val traitMethN: List, val traitMethT: List, val pmN: List, val pmM: List, val variantN: List, val variantTys: List, val variantOwn: List, val roleK: List, val roleV: List, val arcE: List)

struct PFun(val owner: String, val fd: FFunc) // owner "" = free function; else the struct type

fun lastSeg(path: String): String {
  var i = path.len() - 1
  while (i >= 1) { if (path.charAt(i - 1) == 58 && path.charAt(i) == 58) { return path.substr(i + 1, path.len() - i - 1) } i = i - 1 }
  return path
}

// An unsupported construct is a HARD build failure, not a silent one. Before Phase 0.5 this printed to
// STDOUT and returned 0, so lowering continued and emitted a garbage binary that "built" successfully
// (redesign §3h). Now it emits a real error Diagnostic to STDERR (through the single sink) and aborts the
// process with a non-zero exit via __abort() — no binary is written. The `return 0` is unreachable, kept
// only so the type-checker sees an Int result at lowFail's many expression-position call sites.
fun lowFail(msg: String): Int {
  emitDiag(diagError("klower: unsupported construct: " + msg))
  __abort()
  return 0
}

fun memListL(l: List, n: String): Bool {
  var i = 0
  while (i < l.len()) { val x: String = l.get(i); if (x == n) { return true }; i = i + 1 }
  return false
}

fun freshName(lo: Lo, pre: String): String { val n: Int = lo.ctr.get(0); lo.ctr.set(0, n + 1); return pre + n.toStr() }

fun bindLoc(lo: Lo, nm: String, tag: String): Int { lo.locN.push(nm); lo.locT.push(tag); return 0 }

// ---------- coarse type tags ----------
// normalize a type string to a coarse tag: "List<Int>"->"List", "Int?"->"Int", "a::B"->"B", ""->"?"
fun tyTag(s: String): String {
  if (s == "") { return "?" }
  var stop = s.len()
  var i = 0
  while (i < s.len()) { val c = s.charAt(i); if (c == 60 || c == 63 || c == 32) { stop = i; i = s.len() } else { i = i + 1 } }
  return lastSeg(s.substr(0, stop))
}

// a param type carries an ownership-mode prefix ("consuming "=transfer, "inout "=borrow-mutable, none=borrow).
// paramMode returns the mode keyword; stripMode returns the bare type (so tyTag sees the real type, not the mode).
fun paramMode(ty: String): String {
  val n = ty.len()
  if (n >= 10) { if (ty.substr(0, 10) == "consuming ") { return "consuming" } }
  if (n >= 6) { if (ty.substr(0, 6) == "inout ") { return "inout" } }
  return ""
}

fun stripMode(ty: String): String {
  val n = ty.len()
  if (n >= 10) { if (ty.substr(0, 10) == "consuming ") { return ty.substr(10, n - 10) } }
  if (n >= 6) { if (ty.substr(0, 6) == "inout ") { return ty.substr(6, n - 6) } }
  return ty
}

fun localTag(lo: Lo, nm: String): String {
  var i = lo.locN.len() - 1
  while (i >= 0) { if (lo.locN.get(i) == nm) { return lo.locT.get(i) }; i = i - 1 }
  return "?"
}

// tag of a bare identifier: a local's static tag, else — for a nullary enum variant used as a value
// (e.g. `Unit`, `None`) — the owning enum type, so `Unit.debug()` and `x == Unit` resolve. "?" otherwise.
fun identTag(lo: Lo, nm: String): String {
  val lt = localTag(lo, nm)
  if (lt != "?") { return lt }
  val vo = variantOwnerIn(lo.variantN, lo.variantOwn, nm)
  if (vo != "") { return vo }
  return "?"
}

// builtinRetTag: the return tag of a type-carrying INTRINSIC (no Kite body). Sourced from codegen's ONE
// manifest floorRetTag so it can never drift from typeNameOf. The pure-Kite prelude functions
// (intToStr/concat/substr/strLen/charAt/listLen/listPush/listSet) are no longer listed here — their tags
// resolve through the collected fN/fR signatures in funRetTag below, so this stopped being a second copy.
fun builtinRetTag(nm: String): String { return floorRetTag(nm) }

// The INTRINSIC FLOOR: names with NO Kite definition anywhere. The compiler emits them directly (the
// per-name dispatch in codegen's genCall) or folds them at lower time (comptime). The floor name set is
// defined ONCE, in codegen's intrinsicFloor() — the machine-lowered names — and this predicate DERIVES
// from it, adding only `comptime` (a lower-time-only fold that never reaches codegen). The M2 checker's
// isBuiltin (kcheck.kite) defers to this predicate, so the lowerer, the checker, and codegen can never
// disagree about the floor. Everything else a program can call is a real Kite function: a prelude module
// (preludeConfPaths) or the user's own source.
fun isIntrinsic(nm: String): Bool {
  if (nm == "comptime") { return true }
  // Phase 6 monomorphization intrinsics — folded at LOWER time (never reach codegen), like comptime:
  //   sizeOf::<T>()            -> the packed byte size of T (Int literal)
  //   __packedGet::<T>(p, i)   -> the width/sign-correct sized load at stride sizeOf<T>()
  //   __packedSet::<T>(p, i, v)-> the width-truncating sized store at stride sizeOf<T>()
  // The compiler's own sources use none of these, so this is inert for the self-host build.
  if (nm == "sizeOf" || nm == "__packedGet" || nm == "__packedSet") { return true }
  return memListL(intrinsicFloor(), nm)
}

fun funRetTag(lo: Lo, nm: String): String {
  val b = builtinRetTag(nm)
  if (b != "") { return b }
  var i = 0
  while (i < lo.fN.len()) { if (lo.fN.get(i) == nm) { return tyTag(lo.fR.get(i)) }; i = i + 1 }
  if (memListL(lo.sN, nm)) { return nm } // struct constructor
  val vo = variantOwnerIn(lo.variantN, lo.variantOwn, nm)
  if (vo != "") { return vo } // enum variant constructor -> its owning enum type
  return "?"
}

// owning enum type of a variant constructor name (parallel variantN/variantOwn tables); "" if not a variant.
fun variantOwnerIn(variantN: List, variantOwn: List, nm: String): String {
  var i = 0
  while (i < variantN.len()) { if (variantN.get(i) == nm) { return variantOwn.get(i) }; i = i + 1 }
  return ""
}

fun fieldTag(lo: Lo, a: FExpr, f: String): String {
  val at = tagOf(lo, a)
  var i = 0
  while (i < lo.sN.len()) {
    if (lo.sN.get(i) == at) {
      val fns: List = lo.sFN.get(i)
      val fts: List = lo.sFT.get(i)
      var j = 0
      while (j < fns.len()) { if (fns.get(j) == f) { return tyTag(fts.get(j)) }; j = j + 1 }
      return "?"
    }
    i = i + 1
  }
  return "?"
}

// Is `f` a DECLARED field of struct/class type `recvTag`? Distinguishes a real field access from a
// property getter/setter (a bare `obj.name` where `name` is a nullary convention method, not a field).
fun isFieldOf(lo: Lo, recvTag: String, f: String): Bool {
  var i = 0
  while (i < lo.sN.len()) {
    if (lo.sN.get(i) == recvTag) {
      val fns: List = lo.sFN.get(i)
      var j = 0
      while (j < fns.len()) { if (fns.get(j) == f) { return true }; j = j + 1 }
      return false
    }
    i = i + 1
  }
  return false
}

fun tagBin(lo: Lo, op: String, a: FExpr, b: FExpr): String {
  if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") { return "Bool" }
  if (op == ".." || op == "..<") { return "Range" }
  val fl = tagOf(lo, a) == "Float" || tagOf(lo, b) == "Float"
  if (op == "+") { if (fl) { return "Float" } if (tagOf(lo, a) == "String" || tagOf(lo, b) == "String") { return "String" } return "Int" }
  if (fl) { return "Float" }
  return "Int"
}

fun isArithOrCmp(op: String): Bool {
  return op == "+" || op == "-" || op == "*" || op == "/" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!="
}

// ---------- the desugar role table: the compiler's SINGLE SOURCE OF TRUTH for stdlib symbols ----------
// The ~6 desugaring sites (list/map literals, index get/set, for-in, string interpolation, operator
// overloading) do NOT bake in stdlib symbol names anymore — they ask this table for a symbol BY ROLE.
// Binding is by NAME CONVENTION: a role maps to the exact free-function / method / operator-method name
// the lowerer emits today. The table is now SOURCED FROM lib/: each prelude decl carries a user-facing
// `@lang("<role>")` attribute, collected during injectHelpers (the pre-lowering prelude pass) into the
// lo.roleK/lo.roleV parallel lists. roleSym looks the role up there; the hardcoded roleSymFallback below
// is kept ONLY as a never-hit safety net for an un-annotated role. Each role MUST resolve to the exact
// symbol emitted before this refactor, so IR/emission for every program is unchanged (self-reproduction
// kcc2==kcc3 holds byte-for-byte).
fun roleLookup(roleK: List, roleV: List, role: String): String {
  var i = 0
  while (i < roleK.len()) { if (roleK.get(i) == role) { return roleV.get(i) }; i = i + 1 }
  return ""
}

fun roleSym(lo: Lo, role: String): String {
  val s = roleLookup(lo.roleK, lo.roleV, role)
  if (s != "") { return s }
  return roleSymFallback(role)
}

fun roleSymFallback(role: String): String {
  // list literals `[..]` / for-in / a[i] on a List
  if (role == "list.new") { return "list" } // [..] constructor
  if (role == "list.push") { return "List_push" } // [..] element append
  if (role == "list.get") { return "List_get" } // a[i] load / for-in element
  if (role == "list.set") { return "List_set" } // a[i] = v store
  if (role == "list.len") { return "List_len" } // for-in bound
  // string index / interpolation
  if (role == "str.get") { return "String_charAt" } // s[i] on a String
  if (role == "str.show") { return "Int_toStr" } // $expr -> Int_toStr(expr)
  if (role == "str.concat") { return "String_add" } // two-piece interpolation join
  // string builder (interpolation of >=2 pieces lowers onto ONE StrBuilder, then finish())
  if (role == "str.build.new") { return "strNew" } // fresh StrBuilder
  if (role == "str.build.push") { return "StrBuilder_pushStr" } // append a piece, returns the builder
  if (role == "str.build.finish") { return "StrBuilder_finish" } // seal to a String
  // map literals `{..}` / m[k] / m[k]=v — the map.put role (append) is realized by mapPutInto below
  if (role == "map.new") { return "map" } // {..} constructor
  if (role == "map.putList") { return "List_push" } // append into a parallel word-list (map.put)
  if (role == "map.getS") { return "Map_get" } // m[k] load, String key
  if (role == "map.getI") { return "Map_getI" } // m[k] load, Int key
  if (role == "map.setS") { return "Map_set" } // m[k] = v store, String key
  if (role == "map.setI") { return "Map_setI" } // m[k] = v store, Int key
  // operator overloading: `a op b` -> mangled `<T>_<method>` (method name only; owner mangled by caller)
  if (role == "op.+") { return "add" }
  if (role == "op.-") { return "sub" }
  if (role == "op.*") { return "mul" }
  if (role == "op./") { return "div" }
  if (role == "op.%") { return "rem" }
  if (role == "op.==") { return "eq" } // `a == b`/`a != b` on String -> <T>_eq
  return ""
}

// operator overloading: the arithmetic operators map to trait methods (+ -> add, - -> sub, * -> mul,
// / -> div, % -> rem). isOverloadableOp gates the desugar; opMethodName is the method name for `op`,
// resolved through the role table (roles op.+ .. op.%).
fun isOverloadableOp(op: String): Bool {
  return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
}

fun opMethodName(lo: Lo, op: String): String { return roleSym(lo, "op." + op) }

// float arithmetic/comparison (either operand Float) -> EFBin; otherwise the integer EBin.
// OPERATOR OVERLOADING: `a op b` desugars to the operator method when the LEFT operand's type has a
// CONCRETE impl of it (String_add, V2_add, ...). We resolve DIRECTLY to the mangled static method with
// both operands already-lowered as args — NOT via methodCallee (which, once `add` is a trait method,
// would dynamic-dispatch `__dyn_Add_add` for ANY operand incl. Int -> a bad switch on a header-less Int).
// So we guard strictly on the concrete mangled method existing (funDefined). Int/Float with no impl fall
// through to the primitive EFBin/EBin below — zero-cost for the numeric core (self-host stays byte-identical
// because the compiler's own sources only ever `+` integers, whose type tag is "Int", never a defined op method).
// resolve `a op b` to the mangled operator method `<T>_<m>` when EITHER operand's concrete type defines it
// (left first, then right). Two operands, one method: the left-first rule matches the trait convention, and
// the right fallback lets an erased/untyped LEFT still route when the RIGHT is a concrete String (e.g.
// `xs.get(i) + ("_" + m)` — left erased, right String). Returns "" when neither side has the method.
fun opMangledFor(lo: Lo, op: String, l: FExpr, r: FExpr): String {
  val ol = mangleMethod(tagOf(lo, l), opMethodName(lo, op))
  if (funDefined(lo, ol)) { return ol }
  val orr = mangleMethod(tagOf(lo, r), opMethodName(lo, op))
  if (funDefined(lo, orr)) { return orr }
  return ""
}

// Ord ordering-operator desugar (Phase 4): `a < b` (and <=, >, >=) route through the LEFT (else RIGHT)
// operand's `<T>_cmp` when one is defined, comparing the -1/0/1 result against 0. Fires ONLY when a
// concrete `cmp` method exists — Int/Char/every scalar has none, so the compiler's own integer
// comparisons stay machine `cmp`+condition-codes and the self-host fixpoint is unaffected.
fun isOrderingOp(op: String): Bool { return op == "<" || op == "<=" || op == ">" || op == ">=" }

fun cmpMangledFor(lo: Lo, l: FExpr, r: FExpr): String {
  val ol = mangleMethod(tagOf(lo, l), "cmp")
  if (funDefined(lo, ol)) { return ol }
  val olp = mangleMethod(tagOf(lo, l), "partialCmp")
  if (funDefined(lo, olp)) { return olp }
  val orr = mangleMethod(tagOf(lo, r), "cmp")
  if (funDefined(lo, orr)) { return orr }
  val orp = mangleMethod(tagOf(lo, r), "partialCmp")
  if (funDefined(lo, orp)) { return orp }
  return ""
}

fun lowerBin(lo: Lo, op: String, l: FExpr, r: FExpr): Expr {
  if (isOverloadableOp(op)) {
    val om = opMangledFor(lo, op, l, r)
    if (om != "") {
      val ca = list(); ca.push(lowerExpr(lo, l)); ca.push(lowerExpr(lo, r))
      return ECall(om, ca)
    }
  }
  // String value-equality: `a == b`/`a != b` route to the Eq method (String_eq) ONLY when an operand is
  // concretely String (opMangledFor resolves the mangled method from whichever side is String, else "").
  // Int/Char/Float/other `==` has no Eq impl -> falls through to the primitive machine compare below.
  if (op == "==" || op == "!=") {
    val em = opMangledFor(lo, "==", l, r)
    if (em != "") {
      val ca = list(); ca.push(lowerExpr(lo, l)); ca.push(lowerExpr(lo, r))
      val eq = ECall(em, ca)
      if (op == "!=") { return EUnary("not !", eq) }
      return eq
    }
  }
  if (isOrderingOp(op)) {
    val cm = cmpMangledFor(lo, l, r)
    if (cm != "") {
      val ca = list(); ca.push(lowerExpr(lo, l)); ca.push(lowerExpr(lo, r))
      return EBin(op, ECall(cm, ca), EInt("0"))
    }
  }
  if (isArithOrCmp(op) && (tagOf(lo, l) == "Float" || tagOf(lo, r) == "Float")) {
    return EFBin(op, lowerExpr(lo, l), lowerExpr(lo, r))
  }
  return EBin(op, lowerExpr(lo, l), lowerExpr(lo, r))
}

// methods (struct-body / trait-impl / inherent-impl) are mangled by their owner type so that
// same-named methods on different types don't collide: `area` on Circle -> `Circle_area`. Free
// functions (owner "") keep their bare name.
fun mangleMethod(owner: String, name: String): String {
  if (owner == "") { return name }
  return owner + ("_" + name)
}

// List/String/Map are nominal builtins: method calls on them mangle to type-scoped wrappers
// (List_push, String_charAt, ...) that are injected as thin wrappers over the builtins. This set is
// exactly the ARC-EXEMPT set, so isBuiltinNominal defers to the shared isArcExempt predicate (defined
// once, in codegen.kite) — the exempt types live in exactly one place, consulted by both ARC sites.
fun isBuiltinNominal(lo: Lo, t: String): Bool { return isArcExemptIn(lo.arcE, t) }

// return-type tag of a call, resolving `recv.method(..)` to the mangled method when recv's static
// type is a known struct/class; otherwise the bare callee name (free fn / builtin).
fun funDefined(lo: Lo, nm: String): Bool { return memListL(lo.fN, nm) }

// resolve `recv.m` to a real method `<Type>_m` when one is defined; otherwise the bare `m`
// (UFCS: `recv.m(a)` calls free function `m(recv, a)`, e.g. `acc.mean()` -> `mean(acc)`).
fun methodCallee(lo: Lo, recv: FExpr, m: String): String {
  val rt = tagOf(lo, recv)
  // trait-typed receiver -> dynamic dispatch through the generated ___dyn_<Trait>_<m> switch
  if (memListL(lo.traitN, rt)) { return "__dyn_" + (rt + ("_" + m)) }
  val mangled = mangleMethod(rt, m)
  if (memListL(lo.sN, rt) && funDefined(lo, mangled)) { return mangled }
  if (isBuiltinNominal(lo, rt) && funDefined(lo, mangled)) { return mangled }
  // enum receiver with a concrete method (e.g. a derived `<Enum>_clone`/`_hash`/`_debug`): dispatch to it.
  if (isEnumType(lo.variantOwn, rt) && funDefined(lo, mangled)) { return mangled }
  // erased / unknown-typed receiver (e.g. an element pulled from a List<Shape>): if `m` is a trait method,
  // still dynamic-dispatch on the object's type-id header. Concrete + free-fn cases were handled above.
  val ti = indexOfL(lo.traitMethN, m)
  if (ti >= 0) { return "__dyn_" + (lo.traitMethT.get(ti) + ("_" + m)) }
  return m
}

// PROPERTY GETTER: a bare `obj.name` (no parens) where `name` is NOT a field resolves to the nullary
// convention method `<Type>_name(obj)` when one is DEFINED. Mirrors methodCallee's "definite method"
// branches (trait-typed / struct-method / builtin-nominal-method / erased-trait-method) but EXCLUDES
// the bare-UFCS fallback: a getter fires only when a real accessor method exists, so plain field
// access and unresolved names keep their existing lowering (this makes the feature purely additive).
fun hasGetterMethod(lo: Lo, recv: FExpr, m: String): Bool {
  val rt = tagOf(lo, recv)
  if (memListL(lo.traitN, rt)) { return true }
  val mangled = mangleMethod(rt, m)
  if (memListL(lo.sN, rt) && funDefined(lo, mangled)) { return true }
  if (isBuiltinNominal(lo, rt) && funDefined(lo, mangled)) { return true }
  if (indexOfL(lo.traitMethN, m) >= 0) { return true }
  return false
}

// PROPERTY SETTER: `obj.name = v` where `name` is NOT a field resolves to the setter convention method
// `<Type>_name_set(obj, v)` when one is DEFINED. Returns "" when there is no setter (caller keeps the
// existing field-store path). Uses the same resolution shape as the getter, on the `<name>_set` method.
fun setterCallee(lo: Lo, recv: FExpr, m: String): String {
  val sm = m + "_set"
  val rt = tagOf(lo, recv)
  if (memListL(lo.traitN, rt)) { val mgd = "__dyn_" + (rt + ("_" + sm)); if (funDefined(lo, mgd)) { return mgd }; return "" }
  val mangled = mangleMethod(rt, sm)
  if (memListL(lo.sN, rt) && funDefined(lo, mangled)) { return mangled }
  if (isBuiltinNominal(lo, rt) && funDefined(lo, mangled)) { return mangled }
  return ""
}

fun hasSetter(lo: Lo, recv: FExpr, m: String): Bool { return setterCallee(lo, recv, m) != "" }

// `Type::method` resolves to the owner-mangled static method `Type_method` when one is defined (e.g. a
// derived `Point::default` -> `Point_default`), else the bare method name. Used by BOTH the call lowering
// and the return-tag inference so a `val d = Type::method()` local infers the right type.
fun staticCallee(lo: Lo, b: FExpr, m: String): String {
  val bn = when (b) { FEIdent(x) -> x; else -> "" }
  val mgd = mangleMethod(bn, m)
  if (bn != "" && funDefined(lo, mgd)) { return mgd }
  return m
}

// `Enum.Variant(args)` (a FEField whose base names the owning enum and whose selector is one of its variants)
// is enum CONSTRUCTION, not a method call. Without this the FEField lowering treats it as UFCS and PREPENDS
// the base `Enum` as arg0 (stored into the payload, dropping the real args) — a silent payload miscompile.
fun isQualVariant(lo: Lo, recv: FExpr, m: String): Bool {
  val rn = when (recv) { FEIdent(x) -> x; else -> "" }
  if (rn == "") { return false }
  return variantOwnerIn(lo.variantN, lo.variantOwn, m) == rn
}

fun callRetTag(lo: Lo, callee: FExpr): String {
  return when (callee) {
    FEField(recv, m) -> if (isQualVariant(lo, recv, m)) { variantOwnerIn(lo.variantN, lo.variantOwn, m) } else { funRetTag(lo, methodCallee(lo, recv, m)) }
    FEStatic(b, m) -> funRetTag(lo, staticCallee(lo, b, m))
    FETypeApp(inner, ta) -> callRetTag(lo, inner)
    else -> funRetTag(lo, calleeName(callee))
  }
}

fun tagOf(lo: Lo, e: FExpr): String {
  return when (e) {
    FEInt(t) -> "Int"
    FEChar(t) -> "Char"
    FEBool(b) -> "Bool"
    FEFloat(t) -> "Float"
    FEStr(t, r) -> "String"
    FEInterp(parts, r) -> "String"
    FEList(es) -> "List"
    FEMap(ents) -> "Map"
    FEIdent(nm) -> identTag(lo, nm)
    FEThis -> localTag(lo, "this")
    FEUnary(op, x) -> if (op == "not !") { "Bool" } else { tagOf(lo, x) }
    FECast(x, ty) -> if (ty == "Double" || ty == "Float") { "Float" } else { ty }
    FEBin(op, a, b) -> tagBin(lo, op, a, b)
    FECall(callee, args) -> callRetTag(lo, callee)
    FEField(a, f) -> fieldTag(lo, a, f)
    FENotNull(x) -> tagOf(lo, x)
    // if/when result tag: prefer a CONCRETE branch tag. Needed so a `val nm = when {..-> s; else -> ""}`
    // tags as String, which is what routes an `nm == other` to String_eq (else both operands read "?" and
    // `==` wrongly stays a pointer compare — the exact hazard the strEq->== rewrite must avoid).
    FEIf(c, t, el) -> tagJoin2(tagOf(lo, t), tagOf(lo, el))
    FEWhen(hs, bs, subj, arms) -> tagOfArms(lo, arms)
    else -> "?"
  }
}

// join two coarse tags: prefer a concrete (non-"?") tag. Used to infer if/when result tags.
fun tagJoin2(a: String, b: String): String { if (a == "?") { return b }; return a }

fun tagOfArms(lo: Lo, arms: List): String {
  var i = 0
  while (i < arms.len()) { val a: FArm = arms.get(i); val t = tagOf(lo, a.body); if (t == "?") { } else { return t }; i = i + 1 }
  return "?"
}

// ---------- expression lowering ----------
fun calleeName(callee: FExpr): String {
  return when (callee) {
    FEIdent(nm) -> nm
    FEField(b, m) -> m
    FEStatic(b, m) -> m
    FETypeApp(inner, ta) -> calleeName(inner)
    else -> ""
  }
}

fun consFront(x: Expr, rest: List): List {
  val out = list()
  out.push(x)
  var i = 0
  while (i < rest.len()) { out.push(rest.get(i)); i = i + 1 }
  return out
}

// ---------- closures: lift lambdas + capture enclosing locals ----------
fun one(x: String): List { val l = list(); l.push(x); return l }

fun extendB(bound: List, names: List): List {
  val nb = list()
  var i = 0
  while (i < bound.len()) { nb.push(bound.get(i)); i = i + 1 }
  var j = 0
  while (j < names.len()) { nb.push(names.get(j)); j = j + 1 }
  return nb
}

fun splitLamNames(s: String): List {
  val out = list()
  if (s == "") { return out }
  val n = s.len(); var i = 0; var start = 0
  while (i <= n) {
    if (i == n || s.charAt(i) == 44) {
      var e = start; while (e < i && s.charAt(e) == 32) { e = e + 1 }
      var stop = e; while (stop < i && s.charAt(stop) != 58) { stop = stop + 1 }
      out.push(s.substr(e, stop - e)); start = i + 1
    }
    i = i + 1
  }
  return out
}

fun patVarsInto(pat: FPat, out: List): Int {
  when (pat) {
    FPBind(s) -> out.push(s)
    FPCtor(pth, subs) -> { var i = 0; while (i < subs.len()) { patVarsInto(subs.get(i), out); i = i + 1 } 0 }
    FPRecord(pth, flds, hasRest) -> { var i = 0; while (i < flds.len()) { val f: FRFld = flds.get(i); if (f.hasPat == 1) { patVarsInto(f.pat, out) } else { out.push(f.name) }; i = i + 1 } 0 }
    else -> 0
  }
  return 0
}

fun patVars(pat: FPat): List { val out = list(); patVarsInto(pat, out); return out }

// collect free variables of `e` (referenced idents that are enclosing locals, not bound within `e`)
fun fvArgs(lo: Lo, bound: List, args: List, out: List): Int {
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); fvExpr(lo, bound, a.expr, out); i = i + 1 }
  return 0
}

fun fvList(lo: Lo, bound: List, es: List, out: List): Int {
  var i = 0
  while (i < es.len()) { fvExpr(lo, bound, es.get(i), out); i = i + 1 }
  return 0
}

fun fvInterp(lo: Lo, bound: List, parts: List, out: List): Int {
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); when (pt) { FIExpr(e) -> fvExpr(lo, bound, e, out); else -> 0 }; i = i + 1 }
  return 0
}

fun fvStmt(lo: Lo, bound: List, s: FStmt, out: List): List {
  return when (s) {
    FSLet(isVar, nm, ty, init) -> { fvExpr(lo, bound, init, out); extendB(bound, one(nm)) }
    FSExprS(e) -> { fvExpr(lo, bound, e, out); bound }
    FSAssign(l, r) -> { fvExpr(lo, bound, l, out); fvExpr(lo, bound, r, out); bound }
    FSReturnV(e) -> { fvExpr(lo, bound, e, out); bound }
    FSWhile(c, bd) -> { fvExpr(lo, bound, c, out); fvExpr(lo, bound, bd, out); bound }
    FSFor(v, it, bd) -> { fvExpr(lo, bound, it, out); fvExpr(lo, extendB(bound, one(v)), bd, out); bound }
    else -> bound
  }
}

fun fvBlock(lo: Lo, bound: List, stmts: List, res: FExpr, out: List): Int {
  var b = bound
  var i = 0
  while (i < stmts.len()) { b = fvStmt(lo, b, stmts.get(i), out); i = i + 1 }
  fvExpr(lo, b, res, out)
  return 0
}

fun fvWhen(lo: Lo, bound: List, hasSubj: Int, subj: FExpr, arms: List, out: List): Int {
  if (hasSubj == 1) { fvExpr(lo, bound, subj, out) }
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    var b = bound
    if (a.kind == 2) { var j = 0; while (j < a.pats.len()) { b = extendB(b, patVars(a.pats.get(j))); j = j + 1 } }
    else { if (a.kind == 0) { fvExpr(lo, b, a.lhs, out) } }
    if (isNoResF(a.guard) == false) { fvExpr(lo, b, a.guard, out) }
    fvExpr(lo, b, a.body, out)
    i = i + 1
  }
  return 0
}

fun fvExpr(lo: Lo, bound: List, e: FExpr, out: List): Int {
  when (e) {
    FEIdent(nm) -> { if (memListL(bound, nm) == false && memListL(lo.locN, nm) && memListL(out, nm) == false) { out.push(nm) } 0 }
    FEThis -> { if (memListL(bound, "this") == false && memListL(lo.locN, "this") && memListL(out, "this") == false) { out.push("this") } 0 }
    FEUnary(op, x) -> fvExpr(lo, bound, x, out)
    FEBin(op, a, b) -> { fvExpr(lo, bound, a, out); fvExpr(lo, bound, b, out) }
    FEField(a, f) -> fvExpr(lo, bound, a, out)
    FESafeField(a, f) -> fvExpr(lo, bound, a, out)
    FEStatic(a, f) -> fvExpr(lo, bound, a, out)
    FETypeApp(a, t) -> fvExpr(lo, bound, a, out)
    FECast(a, ty) -> fvExpr(lo, bound, a, out)
    FENotNull(a) -> fvExpr(lo, bound, a, out)
    FEElvis(a, b) -> { fvExpr(lo, bound, a, out); fvExpr(lo, bound, b, out) }
    FEIndex(a, b) -> { fvExpr(lo, bound, a, out); fvExpr(lo, bound, b, out) }
    FECall(callee, args) -> { fvExpr(lo, bound, callee, out); fvArgs(lo, bound, args, out) }
    FEList(es) -> fvList(lo, bound, es, out)
    FEInterp(parts, r) -> fvInterp(lo, bound, parts, out)
    FERet(x) -> fvExpr(lo, bound, x, out)
    FEIf(c, t, el) -> { fvExpr(lo, bound, c, out); fvExpr(lo, bound, t, out); fvExpr(lo, bound, el, out) }
    FELambda(params, body) -> fvExpr(lo, extendB(bound, splitLamNames(params)), body, out)
    FEBlock(stmts, res) -> fvBlock(lo, bound, stmts, res, out)
    FEWhen(hasSubj, bind, subj, arms) -> fvWhen(lo, bound, hasSubj, subj, arms, out)
    else -> 0
  }
  return 0
}

// { params -> body }  ->  lift a top-level __lamN(env, params) that reads captures from env;
// the site evaluates to a closure __closNew("__lamN", cap0, cap1, ...).
fun lowerLambda(lo: Lo, params: String, body: FExpr): Expr {
  val id: Int = lo.gctr.get(0); lo.gctr.set(0, id + 1)
  val name = "__lam" + id.toStr()
  val pnames = splitLamNames(params)
  val bound = list()
  var pi = 0; while (pi < pnames.len()) { bound.push(pnames.get(pi)); pi = pi + 1 }
  val caps = list()
  fvExpr(lo, bound, body, caps)
  // lifted function: params = env + lambda params; body loads captures then runs
  val lnames = list(); lnames.push("env")
  val ltys = list(); ltys.push("?")
  var qi = 0; while (qi < pnames.len()) { lnames.push(pnames.get(qi)); ltys.push("?"); qi = qi + 1 }
  val lctr = list(); lctr.push(0)
  val llo = Lo(lctr, list(), list(), lo.fN, lo.fR, lo.sN, lo.sFN, lo.sFT, lo.lifted, lo.gctr, lo.classN, list(), lo.traitN, lo.constN, lo.constV, lo.cfuncs, lo.traitMethN, lo.traitMethT, lo.pmN, lo.pmM, lo.variantN, lo.variantTys, lo.variantOwn, lo.roleK, lo.roleV, lo.arcE)
  bindLoc(llo, "env", "?")
  var ri = 0; while (ri < pnames.len()) { bindLoc(llo, pnames.get(ri), "?"); ri = ri + 1 }
  val lstmts = list()
  var ci = 0
  while (ci < caps.len()) {
    val cn: String = caps.get(ci)
    bindLoc(llo, cn, localTag(lo, cn))
    val ga = list(); ga.push(EIdent("env")); ga.push(EInt(ci.toStr()))
    lstmts.push(SLet(cn, ECall("__closGet", ga)))
    ci = ci + 1
  }
  val lbody = lowerExpr(llo, body)
  lo.lifted.push(Func(name, lnames, ltys, EBlock(lstmts, lbody)))
  // closure value: __closNew("__lamN", cap0, cap1, ...)
  val cargs = list(); cargs.push(EStr(name))
  var di = 0; while (di < caps.len()) { cargs.push(EIdent(caps.get(di))); di = di + 1 }
  return ECall("__closNew", cargs)
}

fun closCall(lo: Lo, envE: Expr, args: List): Expr { return ECall("__closCall", consFront(envE, lowerArgs(lo, args))) }

fun lowerArgs(lo: Lo, args: List): List {
  val out = list()
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); out.push(lowerExpr(lo, a.expr)); i = i + 1 }
  return out
}

fun argExprAt(args: List, i: Int): FExpr { val a: FArg = args.get(i); return a.expr }

// true iff the call has exactly one Float argument. NOTE: `&&` is NOT short-circuit here (bitwise), so
// this MUST guard the length internally before touching args[0] — else a zero-arg call reads out of bounds.
fun oneFloatArg(lo: Lo, args: List): Bool {
  if (args.len() != 1) { return false }
  return tagOf(lo, argExprAt(args, 0)) == "Float"
}

// A bare ident that is a LOCAL is a closure value -> indirect call; otherwise a direct call to a
// top-level function/ctor. obj.m(args) is a method (UFCS). Any other callee is a closure value.
// ---------- comptime: fold a constant expression at compile time ----------
// `comptime(expr)` is evaluated by the compiler and replaced by its integer-literal result, so the
// runtime never computes it. v1 grammar: int/bool/char literals, unary minus, and the binary
// arithmetic/bitwise/shift/comparison operators — all constant-foldable. (Compile-time evaluation of
// user function calls is future work.)
fun cevalBin(op: String, a: Int, b: Int): Int {
  if (op == "+") { return a + b }
  if (op == "-") { return a - b }
  if (op == "*") { return a * b }
  if (op == "/") { return a / b }
  if (op == "%") { return a - (a / b) * b }
  if (op == "<<") { return a << b }
  if (op == ">>") { return a >> b }
  if (op == "&") { return a & b }
  if (op == "|") { return a | b }
  if (op == "^") { return a ^ b }
  if (op == "==") { if (a == b) { return 1 } return 0 }
  if (op == "!=") { if (a != b) { return 1 } return 0 }
  if (op == "<") { if (a < b) { return 1 } return 0 }
  if (op == ">") { if (a > b) { return 1 } return 0 }
  if (op == "<=") { if (a <= b) { return 1 } return 0 }
  if (op == ">=") { if (a >= b) { return 1 } return 0 }
  return 0
}

// A small compile-time INTEGER interpreter. `comptime(expr)` / `const NAME = expr` are evaluated here and
// replaced by their integer result. Supports literals, arithmetic/bitwise/compare, params/locals (val/var),
// if, while, return, and CALLS to pure integer functions (incl. recursion), via the function table `funcs`.
// Pure-integer only: no heap (lists/strings/structs), no side effects. `names`/`vals` are the variable env.
fun ceVarGet(names: List, vals: List, nm: String): Int {
  var i = names.len() - 1
  while (i >= 0) { if (names.get(i) == nm) { return vals.get(i) }; i = i - 1 }
  return 0
}

fun ceVarSet(names: List, vals: List, nm: String, v: Int): Int {
  var i = names.len() - 1
  while (i >= 0) { if (names.get(i) == nm) { vals.set(i, v); return 0 }; i = i - 1 }
  return 0
}

fun ceFindFunc(funcs: List, nm: String): Int {
  var i = 0
  while (i < funcs.len()) { val f: FFunc = funcs.get(i); if (f.name == nm) { return i }; i = i + 1 }
  return 0 - 1
}

// The compile-time interpreter carries REAL Kite heap values (strings, lists) as machine words through
// `Int` — legitimate in the boxed/erased model (a word is a word). So `comptime(...)` may COMPUTE strings and
// lists (build a list in a loop, concat strings, ...) and reduce an Int-valued result. FEStr yields the string
// word; FEList builds a real list by evaluating each element; the string/list builtins run for real.
fun ceBuildList(names: List, vals: List, kinds: List, funcs: List, es: List): Int {
  val l = ceLNew()
  var i = 0
  while (i < es.len()) { ceLPush(l, ceEval(names, vals, kinds, funcs, es.get(i))); i = i + 1 }
  return l
}

// coarse comptime value KIND ("String" / "List" / "Int"): the erased-word interpreter has no runtime type
// tag, and now that String's ops are methods, `.len()`/`.length` are defined on BOTH String and List — so
// they are routed by the RECEIVER'S kind, inferred from its expression shape plus the parallel `kinds` env
// (bound per variable at let/param time). charAt/substr/toStr (String-only) and get/set/push (List-only)
// stay unambiguous by name.
fun ceKindFromTy(ty: String): String {
  val tg = tyTag(stripMode(ty))
  if (tg == "String") { return "String" }
  if (tg == "List") { return "List" }
  return "Int"
}

fun ceKindGet(names: List, kinds: List, nm: String): String {
  var i = names.len() - 1
  while (i >= 0) { if (names.get(i) == nm) { return kinds.get(i) }; i = i - 1 }
  return "Int"
}

fun ceCallKind(callee: FExpr): String {
  return when (callee) {
    FEField(recv, m) -> if (m == "substr" || m == "toStr") { "String" } else { "Int" }
    FEIdent(nm) -> if (nm == "list") { "List" } else { "Int" }
    else -> "Int"
  }
}

fun ceKindOf(names: List, kinds: List, funcs: List, e: FExpr): String {
  return when (e) {
    FEStr(t, r) -> "String"
    FEInterp(parts, r) -> "String"
    FEList(es) -> "List"
    FEIdent(nm) -> ceKindGet(names, kinds, nm)
    FEBin(op, a, b) -> if (op == "+" && (ceKindOf(names, kinds, funcs, a) == "String" || ceKindOf(names, kinds, funcs, b) == "String")) { "String" } else { "Int" }
    FECall(callee, args) -> ceCallKind(callee)
    else -> "Int"
  }
}

fun ceEval(names: List, vals: List, kinds: List, funcs: List, e: FExpr): Int {
  return when (e) {
    FEInt(t) -> parseIntK(litNum(t))
    FEChar(t) -> parseIntK(t)
    FEBool(b) -> if (b == "true") { 1 } else { 0 }
    FEStr(t, r) -> t
    FEList(es) -> ceBuildList(names, vals, kinds, funcs, es)
    FEIdent(nm) -> ceVarGet(names, vals, nm)
    FEUnary(op, x) -> 0 - ceEval(names, vals, kinds, funcs, x)
    FEBin(op, a, b) -> ceEvalBin(names, vals, kinds, funcs, op, a, b)
    FEIf(c, t, el) -> if (ceEval(names, vals, kinds, funcs, c) != 0) { ceEval(names, vals, kinds, funcs, t) } else { ceEval(names, vals, kinds, funcs, el) }
    FECall(callee, args) -> ceCall(names, vals, kinds, funcs, callee, args)
    FEBlock(stmts, res) -> ceRunBody(names, vals, kinds, funcs, e)
    // A no-result expression (an else-less `if`'s empty else branch, an empty block tail) evaluates to
    // the unit value 0 at comptime. Before Phase 0.5's lowFail hard-abort this fell through to lowFail and
    // silently returned 0 anyway; now it must be handled explicitly so a valid comptime fn (e.g. fib's
    // `if (n<2){return n}`) does not abort the build.
    FENoRes -> 0
    else -> { lowFail("comptime: unsupported expression"); 0 }
  }
}

// `+` with a String operand is concatenation (String_add on the erased words); otherwise integer arithmetic.
fun ceEvalBin(names: List, vals: List, kinds: List, funcs: List, op: String, a: FExpr, b: FExpr): Int {
  val va = ceEval(names, vals, kinds, funcs, a)
  val vb = ceEval(names, vals, kinds, funcs, b)
  if (op == "+" && (ceKindOf(names, kinds, funcs, a) == "String" || ceKindOf(names, kinds, funcs, b) == "String")) { return ceSConcat(va, vb) }
  return cevalBin(op, va, vb)
}

// comptime string concatenation on the erased words. Mirrors `impl Add for String` (String_add), but is
// spelled with the raw-memory intrinsics + the raw ceSLen so no String-typed value flows through the
// erased Int word (the checker does not expose the impl-mangled String_add as a callable free name, and
// arg-type-checks String_len's String parameter).
fun ceSConcat(a: Int, b: Int): Int {
  val la = ceSLen(a)
  val lb = ceSLen(b)
  val r = __rawAlloc(la + lb + 1)
  var i = 0
  while (i < la) { __rawStoreByte(r, i, __rawLoadByte(a, i)) i = i + 1 }
  var j = 0
  while (j < lb) { __rawStoreByte(r, la + j, __rawLoadByte(b, j)) j = j + 1 }
  __rawStoreByte(r, la + lb, 0)
  return r
}

fun ceArg(names: List, vals: List, kinds: List, funcs: List, args: List, i: Int): Int { val a: FArg = args.get(i); return ceEval(names, vals, kinds, funcs, a.expr) }

// list builtins for the comptime interpreter. It threads erased List words through `Int`, so these read
// and write the word directly via the raw-memory intrinsics on List's layout {n@0, cap@8, data@16} (see
// lib/alloc/collections/list.kite). Intrinsics are untyped to the checker, so the Int word passes with no
// List-typed reinterpret cast (a compiler-source `l: List` param would reject the Int arg). ceLPush
// mirrors List.push's grow-if-full.
fun ceLLen(w: Int): Int { return __rawLoad(w, 0) }

fun ceLGet(w: Int, i: Int): Int { return __rawLoad(__rawLoad(w, 16), i * 8) }

fun ceLSet(w: Int, i: Int, x: Int): Int { __rawStore(__rawLoad(w, 16), i * 8, x) return 0 }

fun ceLPush(w: Int, x: Int): Int {
  var n = __rawLoad(w, 0)
  var cap = __rawLoad(w, 8)
  var data = __rawLoad(w, 16)
  if (n == cap) { if (cap == 0) { cap = 4 } else { cap = cap * 2 } data = __rawRealloc(data, cap * 8) __rawStore(w, 8, cap) __rawStore(w, 16, data) }
  __rawStore(data, n * 8, x)
  __rawStore(w, 0, n + 1)
  return 0
}

// Raw Int-word String helpers for the comptime interpreter — the String counterparts of ceLLen/ceLGet/
// ceLPush. They compute on the erased word with ONLY the untyped raw-memory intrinsics, so a String-typed
// value never flows through the universal `Int` word (which the checker, once it arg-type-checks prelude
// calls, would reject if the erased word were handed to String_len/String_charAt/… directly). Bodies
// mirror lib/core/string.kite's String_len / String_substr / Int_toStr.
fun ceSLen(w: Int): Int { var i = 0 while (__rawLoadByte(w, i) != 0) { i = i + 1 } return i }

fun ceSubstr(w: Int, st: Int, len: Int): Int {
  val r = __rawAlloc(len + 1)
  var i = 0
  while (i < len) { __rawStoreByte(r, i, __rawLoadByte(w, st + i)) i = i + 1 }
  __rawStoreByte(r, len, 0)
  return r
}

fun ceIntToStr(n: Int): Int {
  if (n == 0) { val z = __rawAlloc(2) __rawStoreByte(z, 0, 48) __rawStoreByte(z, 1, 0) return z }
  var neg = 0
  var m = n
  if (n < 0) { neg = 1 m = 0 - n }
  var digits = 0
  var t = m
  while (t > 0) { digits = digits + 1 t = t / 10 }
  val total = digits + neg
  val r = __rawAlloc(total + 1)
  __rawStoreByte(r, total, 0)
  var pos = total - 1
  var mm = m
  while (mm > 0) { val d = mm - (mm / 10) * 10 __rawStoreByte(r, pos, 48 + d) pos = pos - 1 mm = mm / 10 }
  if (neg == 1) { __rawStoreByte(r, 0, 45) }
  return r
}

// A fresh empty comptime List as an erased Int word, laid out {n@0, cap@8, data@16} exactly like list()
// (lib/alloc/collections/list.kite) so ceLGet/ceLSet/ceLPush/ceLLen operate on it. Header-less (the
// comptime evaluator never releases these — leak-managed like the rest).
fun ceLNew(): Int { val w = __rawAlloc(24) __rawStore(w, 0, 0) __rawStore(w, 8, 4) __rawStore(w, 16, __rawAlloc(32)) return w }

// method-call form `recv.m(args)` in comptime code. String methods run the raw-word ops on the erased
// word; List methods (the [..]/index desugar methods) run the raw-layout ops; `.len()`/`.length` (on both)
// is routed by the receiver's inferred kind.
fun ceMethodCall(names: List, vals: List, kinds: List, funcs: List, recv: FExpr, m: String, args: List): Int {
  val r = ceEval(names, vals, kinds, funcs, recv)
  if (m == "charAt" && args.len() == 1) { return __rawLoadByte(r, ceArg(names, vals, kinds, funcs, args, 0)) }
  if (m == "substr" && args.len() == 2) { return ceSubstr(r, ceArg(names, vals, kinds, funcs, args, 0), ceArg(names, vals, kinds, funcs, args, 1)) }
  if (m == "toStr" && args.len() == 0) { return ceIntToStr(r) }
  if (m == "push" && args.len() == 1) { return ceLPush(r, ceArg(names, vals, kinds, funcs, args, 0)) }
  if (m == "get" && args.len() == 1) { return ceLGet(r, ceArg(names, vals, kinds, funcs, args, 0)) }
  if (m == "set" && args.len() == 2) { return ceLSet(r, ceArg(names, vals, kinds, funcs, args, 0), ceArg(names, vals, kinds, funcs, args, 1)) }
  if ((m == "len" || m == "length") && args.len() == 0) {
    if (ceKindOf(names, kinds, funcs, recv) == "String") { return ceSLen(r) }
    return ceLLen(r)
  }
  return 0
}

fun ceCall(names: List, vals: List, kinds: List, funcs: List, callee: FExpr, args: List): Int {
  return when (callee) {
    FEField(recv, m) -> ceMethodCall(names, vals, kinds, funcs, recv, m, args)
    else -> ceFreeCall(names, vals, kinds, funcs, calleeName(callee), args)
  }
}

fun ceFreeCall(names: List, vals: List, kinds: List, funcs: List, fn: String, args: List): Int {
  if (fn == "list" && args.len() == 0) { return ceLNew() }
  val idx = ceFindFunc(funcs, fn)
  if (idx < 0) { return 0 }
  val fd: FFunc = funcs.get(idx)
  val pn = list(); val pv = list(); val pk = list()
  var i = 0
  while (i < fd.params.len()) {
    val pp: FParam = fd.params.get(i); val av: FArg = args.get(i)
    pn.push(pp.name); pv.push(ceEval(names, vals, kinds, funcs, av.expr)); pk.push(ceKindFromTy(pp.ty)); i = i + 1
  }
  return ceRunBody(pn, pv, pk, funcs, fd.body)
}

fun ceRunBody(names: List, vals: List, kinds: List, funcs: List, body: FExpr): Int {
  return when (body) {
    FEBlock(stmts, res) -> {
      val ret = list(); ret.push(0); ret.push(0) // [returned?, value]
      ceExec(names, vals, kinds, funcs, stmts, ret)
      if (ret.get(0) == 1) { ret.get(1) } else { if (isNoResF(res)) { 0 } else { ceEval(names, vals, kinds, funcs, res) } }
    }
    else -> ceEval(names, vals, kinds, funcs, body)
  }
}

// execute an expression in STATEMENT position, propagating `return` up through nested if/blocks via the
// shared `ret` cell (so `if (c) { return x }` returns from the enclosing function, not just the block).
fun ceExecExpr(names: List, vals: List, kinds: List, funcs: List, e: FExpr, ret: List): Int {
  when (e) {
    FEIf(c, t, el) -> { if (ceEval(names, vals, kinds, funcs, c) != 0) { ceExecExpr(names, vals, kinds, funcs, t, ret) } else { ceExecExpr(names, vals, kinds, funcs, el, ret) } }
    FEBlock(stmts, res) -> { ceExec(names, vals, kinds, funcs, stmts, ret); if (isNoResF(res) == false && ret.get(0) == 0) { ceExecExpr(names, vals, kinds, funcs, res, ret) }; 0 }
    FERet(x) -> { ret.set(1, ceEval(names, vals, kinds, funcs, x)); ret.set(0, 1); 0 }
    else -> { ceEval(names, vals, kinds, funcs, e); 0 }
  }
  return 0
}

fun ceExec(names: List, vals: List, kinds: List, funcs: List, stmts: List, ret: List): Int {
  var i = 0
  while (i < stmts.len() && ret.get(0) == 0) {
    val s: FStmt = stmts.get(i)
    when (s) {
      FSLet(isVar, nm, ty, init) -> { val v = ceEval(names, vals, kinds, funcs, init); val kd = ceKindOf(names, kinds, funcs, init); names.push(nm); vals.push(v); kinds.push(kd); 0 }
      FSReturnV(x) -> { ret.set(1, ceEval(names, vals, kinds, funcs, x)); ret.set(0, 1); 0 }
      FSReturnU -> { ret.set(0, 1); 0 }
      FSAssign(lhs, rhs) -> { val v = ceEval(names, vals, kinds, funcs, rhs); ceExecAssign(names, vals, lhs, v); 0 }
      FSWhile(c, b) -> { ceWhile(names, vals, kinds, funcs, c, b, ret); 0 }
      FSExprS(x) -> { ceExecExpr(names, vals, kinds, funcs, x, ret); 0 }
      else -> 0
    }
    i = i + 1
  }
  return 0
}

fun ceExecAssign(names: List, vals: List, lhs: FExpr, v: Int): Int {
  when (lhs) { FEIdent(nm) -> { ceVarSet(names, vals, nm, v); 0 } else -> 0 }
  return 0
}

fun ceWhile(names: List, vals: List, kinds: List, funcs: List, c: FExpr, body: FExpr, ret: List): Int {
  while (ceEval(names, vals, kinds, funcs, c) != 0 && ret.get(0) == 0) {
    ceExecExpr(names, vals, kinds, funcs, body, ret)
  }
  return 0
}

// top-level constant-expression eval (empty variable env)
fun ceval(funcs: List, e: FExpr): Int { return ceEval(list(), list(), list(), funcs, e) }

// comptime eval that seeds the env with the program's consts (so comptime(SOME_CONST + 1) works)
fun cevalWithConsts(lo: Lo, e: FExpr): Int {
  val en = list(); val ev = list(); val ek = list()
  var i = 0
  while (i < lo.constN.len()) { en.push(lo.constN.get(i)); ev.push(parseIntK(lo.constV.get(i))); ek.push("Int"); i = i + 1 }
  return ceEval(en, ev, ek, lo.cfuncs, e)
}

fun paramModeAt(lo: Lo, fname: String, i: Int): String {
  var k = 0
  while (k < lo.pmN.len()) {
    if (lo.pmN.get(k) == fname) { val modes: List = lo.pmM.get(k); if (i < modes.len()) { return modes.get(i) }; return "" }
    k = k + 1
  }
  return ""
}

// a builtin whose arg is STORED (transferred), so the caller must NOT release the temp it passes.
fun isStoringBuiltin(nm: String): Bool {
  return nm == "List_push" || nm == "List_set" || nm == "__rawStore" || nm == "__rawStoreByte" || nm == "__closNew"
}

// a class-typed fresh constructor passed as an argument is an owned temporary needing lifetime handling.
fun argIsClassTemp(lo: Lo, e: FExpr): Bool {
  if (isFreshCtor(lo, e) == false) { return false }
  return isClassTag(lo, tagOf(lo, e))
}

// TRANSFER (callee takes ownership, do NOT release): a constructor, a storing builtin, or a `consuming` param.
// Otherwise BORROW: the caller keeps ownership and must release the temp after the call.
fun argTransfers(lo: Lo, nm: String, i: Int): Bool {
  if (memListL(lo.sN, nm)) { return true }
  if (isStoringBuiltin(nm)) { return true }
  if (paramModeAt(lo, nm, i) == "consuming") { return true }
  return false
}

// Plain free-function call. If any class-temp arg is BORROWED, spill EVERY arg to a temp (preserving
// left-to-right evaluation order), call, then release the borrowed temps after the call. No class temps
// => emit the plain ECall unchanged (so the class-free compiler self-hosts byte-for-byte on this path).
// a borrow-temp is released after the call ONLY if the callee CANNOT alias it into its result — i.e. the
// callee returns a non-class. If the callee returns a class, its result may BE the arg (identity/passthrough),
// so releasing would be a use-after-free; we conservatively leak instead (never a double-free/UAF).
fun argNeedsRelease(lo: Lo, nm: String, i: Int, e: FExpr): Bool {
  if (argIsClassTemp(lo, e) == false) { return false }
  if (argTransfers(lo, nm, i)) { return false }
  if (isClassTag(lo, funRetTag(lo, nm))) { return false }
  return true
}

fun lowerPlainCall(lo: Lo, nm: String, args: List): Expr {
  var need = 0
  var i = 0
  while (i < args.len()) { if (argNeedsRelease(lo, nm, i, argExprAt(args, i))) { need = 1 }; i = i + 1 }
  if (need == 0) { return ECall(nm, lowerArgs(lo, args)) }
  val stmts = list()
  val callArgs = list()
  val rels = list()
  var j = 0
  while (j < args.len()) {
    val ae = argExprAt(args, j)
    val t = freshName(lo, "_at")
    stmts.push(SLet(t, lowerExpr(lo, ae)))
    callArgs.push(EIdent(t))
    if (argNeedsRelease(lo, nm, j, ae)) { rels.push(t) }
    j = j + 1
  }
  val rn = freshName(lo, "_ar")
  stmts.push(SLet(rn, ECall(nm, callArgs)))
  var r = 0
  while (r < rels.len()) { val ra = list(); ra.push(EIdent(rels.get(r))); stmts.push(SExprS(ECall("__release", ra))); r = r + 1 }
  return EBlock(stmts, EIdent(rn))
}

// ---------- Phase 6: comptime sizeOf<T>() + packed element access (the monomorphization keystone) ----------
// The packed byte size of a type: scalars from the primitive registry (an integer strides by its width,
// Bool 1, Char 4, Double one word, Unit 0), a struct by the sum of its (packed) field sizes, and a class /
// erased / unknown type by one reference word. This is what Vec<T> strides its inline storage by, so
// `sizeOf::<U16>()` is 2 and `Vec<U16>` packs two bytes per element instead of List's eight.
fun sizeOfTy(lo: Lo, ty: String): Int {
  val t = tyTag(stripMode(ty))
  val k = primKind(t)
  if (k == 1 || k == 2) { return primBits(t) / 8 }
  if (k == 3) { return 8 }
  if (k == 4) { return 1 }
  if (k == 5) { return 4 }
  if (k == 6) { return 8 }
  if (k == 7) { return 0 }
  if (k == 9) { return 16 }
  val si = indexOfL(lo.sN, t)
  if (si >= 0) {
    val fts: List = lo.sFT.get(si)
    var sum = 0
    var i = 0
    while (i < fts.len()) { sum = sum + sizeOfTy(lo, fts.get(i)); i = i + 1 }
    return sum
  }
  return 8
}

// The width/sign-correct raw load intrinsic for an element of type T: unsigned zero-extends, signed
// sign-extends, an 8-byte element is the plain word load. Element ops are DIRECT (a concrete sized load
// chosen at instantiation from the fully-known T), not a runtime dispatch on a stored size — the point of
// monomorphization.
fun packedLoadName(lo: Lo, ty: String): String {
  val t = tyTag(stripMode(ty))
  val sz = sizeOfTy(lo, t)
  val signed = primIsSigned(t)
  if (sz == 1) { if (signed) { return "__rawLoad8S" } else { return "__rawLoadByte" } }
  if (sz == 2) { if (signed) { return "__rawLoad16S" } else { return "__rawLoad16" } }
  if (sz == 4) { if (signed) { return "__rawLoad32S" } else { return "__rawLoad32" } }
  return "__rawLoad"
}

// The width-truncating raw store intrinsic for an element of type T (the hardware width store drops the
// high bits, so no explicit mask is needed).
fun packedStoreName(lo: Lo, ty: String): String {
  val sz = sizeOfTy(lo, tyTag(stripMode(ty)))
  if (sz == 1) { return "__rawStoreByte" }
  if (sz == 2) { return "__rawStore16" }
  if (sz == 4) { return "__rawStore32" }
  return "__rawStore"
}

// byte offset of element `idx` in a T-strided buffer: idx * sizeOf<T> (idx itself when the stride is 1).
fun packedOff(idx: FExpr, sz: Int): FExpr {
  if (sz == 1) { return idx }
  return FEBin("*", idx, FEInt(sz.toStr()))
}

fun lowerPackedGet(lo: Lo, ty: String, args: List): Expr {
  val sz = sizeOfTy(lo, tyTag(stripMode(ty)))
  val ca = list(); ca.push(lowerExpr(lo, argExprAt(args, 0))); ca.push(lowerExpr(lo, packedOff(argExprAt(args, 1), sz)))
  return ECall(packedLoadName(lo, ty), ca)
}

fun lowerPackedSet(lo: Lo, ty: String, args: List): Expr {
  val sz = sizeOfTy(lo, tyTag(stripMode(ty)))
  val ca = list(); ca.push(lowerExpr(lo, argExprAt(args, 0))); ca.push(lowerExpr(lo, packedOff(argExprAt(args, 1), sz))); ca.push(lowerExpr(lo, argExprAt(args, 2)))
  return ECall(packedStoreName(lo, ty), ca)
}

fun lowerCall(lo: Lo, callee: FExpr, args: List): Expr {
  return when (callee) {
    FEIdent(nm) -> {
      if (nm == "comptime" && args.len() == 1) { val fa: FArg = args.get(0); EInt(cevalWithConsts(lo, fa.expr).toStr()) }
      else { if ((nm == "println" || nm == "print") && oneFloatArg(lo, args)) { ECall(nm + "F", lowerArgs(lo, args)) }
        else { if (memListL(lo.locN, nm)) { closCall(lo, EIdent(nm), args) } else { lowerPlainCall(lo, nm, args) } } }
    }
    FEField(recv, m) -> if (isQualVariant(lo, recv, m)) { ECall(m, lowerArgs(lo, args)) } else { ECall(methodCallee(lo, recv, m), consFront(lowerExpr(lo, recv), lowerArgs(lo, args))) }
    // `Type::method(args)` binds to the owner-mangled static method `Type_method` when one is defined
    // (e.g. a derived `Point::default()` -> `Point_default()`); otherwise the bare name is called.
    FEStatic(b, m) -> ECall(staticCallee(lo, b, m), lowerArgs(lo, args))
    // Phase 6 monomorphization intrinsics carry their element type as a turbofish arg; fold them here with
    // T fully concrete (the monomorphizer has already substituted it). A monomorphized-type constructor
    // turbofish (`Vec::<U16>(..)`) is never seen here — the mono rewrite turned it into a plain call to
    // the specialized `Vec$U16` before lowering — so a leftover turbofish is a generic-fn call (types erase).
    FETypeApp(inner, ta) -> {
      val cn = calleeName(inner)
      if (cn == "sizeOf") { EInt(sizeOfTy(lo, ta).toStr()) }
      else { if (cn == "__packedGet") { lowerPackedGet(lo, ta, args) }
        else { if (cn == "__packedSet") { lowerPackedSet(lo, ta, args) }
          else { lowerCall(lo, inner, args) } } }
    }
    else -> closCall(lo, lowerExpr(lo, callee), args)
  }
}

// [a, b, c] -> { val _l = list() ; _l.push(a) ; ... ; _l } — emits the list() constructor + the
// List_push method (methods-only: the free listNew/listPush are being retired).
fun lowerList(lo: Lo, es: List): Expr {
  val nm = freshName(lo, "__lst")
  val stmts = list()
  stmts.push(SLet(nm, ECall(roleSym(lo, "list.new"), list())))
  var i = 0
  while (i < es.len()) {
    val a2 = list(); a2.push(EIdent(nm)); a2.push(lowerExpr(lo, es.get(i)))
    stmts.push(SExprS(ECall(roleSym(lo, "list.push"), a2)))
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// map.put role — the ONE place that knows Map's internal storage layout. Appends a (k, v) pair into the
// map bound to `nm`: a pure append into the two parallel word-lists (NO key comparison), correct for both
// Int and String keys (comparison only happens later at m[k]/m[k]=v via the map.get/set roles). This is
// the sole reference to Map's `.keys`/`.vals` internals in the lowerer — if Map's layout changes, only
// this helper changes, not lowerMap. `nm`'s codegen local-type is inferred as Map from mapNewM()'s return,
// so the field offsets resolve. Emits, per entry: listPush(_m.keys, k); listPush(_m.vals, v).
fun mapPutInto(lo: Lo, out: List, nm: String, k: FExpr, v: FExpr): Int {
  val ka = list(); ka.push(EField(EIdent(nm), "keys")); ka.push(lowerExpr(lo, k))
  out.push(SExprS(ECall(roleSym(lo, "map.putList"), ka)))
  val va = list(); va.push(EField(EIdent(nm), "vals")); va.push(lowerExpr(lo, v))
  out.push(SExprS(ECall(roleSym(lo, "map.putList"), va)))
  return 0
}

// {..} builds a REAL Map (class Map(keys, vals), lib/alloc/collections/list.kite). lowerMap only emits the
// map.new + map.put roles — it does NOT touch Map's internal fields directly (mapPutInto owns that), so
// Map's internals can change later without editing this desugar site.
// [k0: v0, k1: v1] -> { val _m = mapNewM(); listPush(_m.keys,k0); listPush(_m.vals,v0); ...; _m }
fun lowerMap(lo: Lo, ents: List): Expr {
  val nm = freshName(lo, "__map")
  val stmts = list()
  stmts.push(SLet(nm, ECall(roleSym(lo, "map.new"), list())))
  var i = 0
  while (i < ents.len()) {
    val en: FMapEnt = ents.get(i)
    mapPutInto(lo, stmts, nm, en.k, en.v)
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// a[i] -> charAt (String) / __mapGetS|I (Map, by key type) / listGet (List/default)
fun lowerIndex(lo: Lo, a: FExpr, ix: FExpr): Expr {
  val at = tagOf(lo, a)
  val args = list(); args.push(lowerExpr(lo, a)); args.push(lowerExpr(lo, ix))
  if (at == "String") { return ECall(roleSym(lo, "str.get"), args) }
  if (at == "Map") {
    if (tagOf(lo, ix) == "String") { return ECall(roleSym(lo, "map.getS"), args) }
    return ECall(roleSym(lo, "map.getI"), args)
  }
  return ECall(roleSym(lo, "list.get"), args)
}

// string interpolation -> concat chain; each $expr becomes intToStr(expr) unless it is a String
fun interpPiece(lo: Lo, e: FExpr): Expr {
  if (tagOf(lo, e) == "String") { return lowerExpr(lo, e) }
  val a = list(); a.push(lowerExpr(lo, e))
  return ECall(roleSym(lo, "str.show"), a)
}

// string interpolation lowers onto ONE StrBuilder: `finish(pushStr(pushStr(strNew(), p0), p1) ...)` —
// amortized O(n) instead of a left-folded `concat` chain (O(n^2) copies + a leak per intermediate). Each
// piece is a String (a literal chunk, or `$expr` rendered via interpPiece/str.show). The 0-piece and
// 1-piece cases short-circuit to the piece itself (no builder allocation for a plain string).
fun lowerInterp(lo: Lo, parts: List): Expr {
  val pieces = list()
  var i = 0
  while (i < parts.len()) {
    val pt: FIPart = parts.get(i)
    val piece = when (pt) { FILit(s) -> EStr(s); FIExpr(e) -> interpPiece(lo, e); else -> EStr("") }
    pieces.push(piece)
    i = i + 1
  }
  if (pieces.len() == 0) { return EStr("") }
  if (pieces.len() == 1) { val only: Expr = pieces.get(0); return only }
  var acc = ECall(roleSym(lo, "str.build.new"), list())
  var j = 0
  while (j < pieces.len()) {
    val pj: Expr = pieces.get(j)
    val pa = list(); pa.push(acc); pa.push(pj)
    acc = ECall(roleSym(lo, "str.build.push"), pa)
    j = j + 1
  }
  val fa = list(); fa.push(acc)
  return ECall(roleSym(lo, "str.build.finish"), fa)
}

fun lowerExpr(lo: Lo, e: FExpr): Expr {
  return when (e) {
    FEInt(t) -> EInt(litNum(t))
    FEChar(t) -> EInt(t)
    FEBool(b) -> if (b == "true") { EInt("1") } else { EInt("0") }
    FENull -> EInt("0")
    FEStr(t, r) -> EStr(t)
    FEInterp(parts, r) -> lowerInterp(lo, parts)
    FEIdent(nm) -> { val ci = indexOfL(lo.constN, nm); if (ci >= 0) { EInt(lo.constV.get(ci)) } else { EIdent(nm) } }
    FEThis -> EIdent("this")
    FEFloat(t) -> EFLit(t)
    FEUnary(op, x) -> EUnary(op, lowerExpr(lo, x))
    FEBin(op, l, r) -> lowerBin(lo, op, l, r)
    FEField(x, nm) -> if (isFieldOf(lo, tagOf(lo, x), nm)) { EField(lowerExpr(lo, x), nm) }
    else { if (hasGetterMethod(lo, x, nm)) { ECall(methodCallee(lo, x, nm), consFront(lowerExpr(lo, x), list())) }
      else { EField(lowerExpr(lo, x), nm) } }
    FEStatic(x, nm) -> EIdent(nm)
    FECall(callee, args) -> lowerCall(lo, callee, args)
    FEIndex(a, ix) -> lowerIndex(lo, a, ix)
    FELambda(params, body) -> lowerLambda(lo, params, body)
    FEList(es) -> lowerList(lo, es)
    FEMap(ents) -> lowerMap(lo, ents)
    FEBlock(stmts, res) -> EBlock(lowerStmts(lo, stmts), lowerExpr(lo, res))
    FEIf(c, t, el) -> EIf(lowerExpr(lo, c), lowerExpr(lo, t), lowerExpr(lo, el))
    FEWhen(hasSubj, bind, subj, arms) -> EWhen(lowerExpr(lo, subj), lowerArms(lo, arms))
    FERet(x) -> ERet(lowerExpr(lo, x))
    FETypeApp(inner, ta) -> lowerExpr(lo, inner) // types erase: x<T> lowers to x
    FECast(inner, ty) -> ECast(lowerExpr(lo, inner), ty) // `e as T` numeric conversion (Phase 3)
    FESafeField(a, f) -> lowerSafe(lo, a, f)
    FENotNull(a) -> lowerNotNull(lo, a)
    FEElvis(a, b) -> lowerElvis(lo, a, b)
    FENoRes -> ENoRes
    FEBrk -> EBrk
    FECont -> ECont
    else -> { lowFail("expression"); ENoRes }
  }
}

// nullable sugar: null is the 0 pointer. Each op binds the receiver to one temp (single eval),
// then branches on `== 0`.   a?.f -> t=a; t==0 ? null : t.f    a?:b -> t=a; t==0 ? b : t
// a!! -> t=a; t==0 ? abort() : t
fun guardTemp(lo: Lo, a: FExpr, pre: String): String {
  val t = freshName(lo, pre); bindLoc(lo, t, "?")
  return t
}

fun lowerSafe(lo: Lo, a: FExpr, f: String): Expr {
  val t = guardTemp(lo, a, "_sf")
  val stmts = list(); stmts.push(SLet(t, lowerExpr(lo, a)))
  val cond = EBin("==", EIdent(t), EInt("0"))
  return EBlock(stmts, EIf(cond, EInt("0"), EField(EIdent(t), f)))
}

fun lowerNotNull(lo: Lo, a: FExpr): Expr {
  val t = guardTemp(lo, a, "_nn")
  val stmts = list(); stmts.push(SLet(t, lowerExpr(lo, a)))
  val cond = EBin("==", EIdent(t), EInt("0"))
  return EBlock(stmts, EIf(cond, ECall("__abort", list()), EIdent(t)))
}

fun lowerElvis(lo: Lo, a: FExpr, b: FExpr): Expr {
  val t = guardTemp(lo, a, "_ev")
  val stmts = list(); stmts.push(SLet(t, lowerExpr(lo, a)))
  val cond = EBin("==", EIdent(t), EInt("0"))
  return EBlock(stmts, EIf(cond, lowerExpr(lo, b), EIdent(t)))
}

// ---------- statement lowering ----------
// reassigning an owned class variable must balance ARC: retain the new value (or take a fresh ctor's +1),
// release the OLD value, then store. Order is eval-new -> release-old -> store, which is safe even for
// self-assignment (`x = x`) and for a rhs that reads the old x.
fun lowerAssignInto(lo: Lo, out: List, nm: String, rhs: FExpr): Int {
  val tmp = freshName(lo, "_rc")
  var rv = lowerExpr(lo, rhs)
  if (isFreshCtor(lo, rhs) == false) { val a = list(); a.push(rv); rv = ECall("__retain", a) }
  out.push(SLet(tmp, rv))
  val relA = list(); relA.push(EIdent(nm))
  out.push(SExprS(ECall("__release", relA)))
  out.push(SAssign(nm, EIdent(tmp)))
  return 0
}

fun isOwnedClassAssign(lo: Lo, lhs: FExpr): Bool {
  return when (lhs) { FEIdent(nm) -> memListL(lo.arcOwned, nm); else -> false }
}

// storing into a CLASS-typed field must balance ARC just like a var reassignment: retain the new value
// (or take a fresh ctor's +1), release the field's OLD value, then store. The object expression is
// evaluated ONCE into a temp so a side-effecting `obj` isn't run twice (old-release + store).
fun lowerFieldAssignInto(lo: Lo, out: List, obj: FExpr, f: String, rhs: FExpr): Int {
  val to = freshName(lo, "_ro")
  out.push(SLet(to, lowerExpr(lo, obj)))
  var rv = lowerExpr(lo, rhs)
  if (isFreshCtor(lo, rhs) == false) { val a = list(); a.push(rv); rv = ECall("__retain", a) }
  val tn = freshName(lo, "_rn")
  out.push(SLet(tn, rv))
  val relA = list(); relA.push(EField(EIdent(to), f))
  out.push(SExprS(ECall("__release", relA)))
  out.push(SAssignF(EIdent(to), f, EIdent(tn)))
  return 0
}

// route an assignment: owned-class var -> balanced var-reassign; class-typed field -> balanced field
// store; everything else -> plain lowering. (The compiler is class-free, so this never fires for it.)
fun lowerAssignStmtInto(lo: Lo, out: List, s: FStmt, lhs: FExpr, rhs: FExpr): Int {
  return when (lhs) {
    FEIdent(nm) -> if (memListL(lo.arcOwned, nm)) { lowerAssignInto(lo, out, nm, rhs) } else { out.push(lowerStmt(lo, s)); 0 }
    FEField(obj, f) -> if (isClassTag(lo, fieldTag(lo, obj, f))) { lowerFieldAssignInto(lo, out, obj, f, rhs) } else { out.push(lowerStmt(lo, s)); 0 }
    else -> { out.push(lowerStmt(lo, s)); 0 }
  }
}

fun lowerStmtInto(lo: Lo, out: List, s: FStmt): Int {
  return when (s) {
    FSFor(v, it, b) -> lowerForInto(lo, out, v, it, b)
    FSAssign(lhs, rhs) -> lowerAssignStmtInto(lo, out, s, lhs, rhs)
    else -> { out.push(lowerStmt(lo, s)); 0 }
  }
}

fun assignName(lhs: FExpr): String { return when (lhs) { FEIdent(nm) -> nm; else -> "" } }

fun lowerStmts(lo: Lo, stmts: List): List {
  val out = list()
  var i = 0
  while (i < stmts.len()) { lowerStmtInto(lo, out, stmts.get(i)); i = i + 1 }
  return out
}

fun lowerBodyInto(lo: Lo, out: List, body: FExpr): Int {
  return when (body) {
    FEBlock(bstmts, res) -> {
      var i = 0
      while (i < bstmts.len()) { lowerStmtInto(lo, out, bstmts.get(i)); i = i + 1 }
      if (isNoResF(res) == false) { out.push(SExprS(lowerExpr(lo, res))) }
      0
    }
    else -> { out.push(SExprS(lowerExpr(lo, body))); 0 }
  }
}

fun lowerForInto(lo: Lo, out: List, v: String, it: FExpr, body: FExpr): Int {
  return when (it) {
    FEBin(op, lo2, hi) ->
    if (op == "..") { lowerForRange(lo, out, v, lo2, hi, body, "<=") }
    else { if (op == "..<") { lowerForRange(lo, out, v, lo2, hi, body, "<") }
      else { lowerForEach(lo, out, v, it, body) } }
    else -> lowerForEach(lo, out, v, it, body)
  }
}

// `for (v in a..b)` / `a..<b` -> a counted loop. cmp is "<=" for inclusive `..`, "<" for exclusive `..<`.
// The `v = v + 1` increment is the loop STEP (emitted at the continue target), so `continue` advances v.
fun lowerForRange(lo: Lo, out: List, v: String, loE: FExpr, hi: FExpr, body: FExpr, cmp: String): Int {
  bindLoc(lo, v, "Int")
  val stmts = list()
  lowerBodyInto(lo, stmts, body)
  val step = SAssign(v, EBin("+", EIdent(v), EInt("1")))
  out.push(SLet(v, lowerExpr(lo, loE)))
  out.push(SLoop(EBin(cmp, EIdent(v), lowerExpr(lo, hi)), EBlock(stmts, ENoRes), step))
  return 0
}

fun lowerForEach(lo: Lo, out: List, v: String, it: FExpr, body: FExpr): Int {
  bindLoc(lo, v, "?")
  val lst = freshName(lo, "__it")
  val idx = freshName(lo, "__i")
  out.push(SLet(lst, lowerExpr(lo, it)))
  out.push(SLet(idx, EInt("0")))
  val ga = list(); ga.push(EIdent(lst)); ga.push(EIdent(idx))
  val stmts = list()
  stmts.push(SLet(v, ECall(roleSym(lo, "list.get"), ga)))
  lowerBodyInto(lo, stmts, body)
  val la = list(); la.push(EIdent(lst))
  val step = SAssign(idx, EBin("+", EIdent(idx), EInt("1")))
  out.push(SLoop(EBin("<", EIdent(idx), ECall(roleSym(lo, "list.len"), la)), EBlock(stmts, ENoRes), step))
  return 0
}

// index STORE `a[i] = v`, mirroring lowerIndex's load dispatch: List -> listSet, Map -> __mapSet(S/I),
// String is immutable so it's rejected.
fun lowerIndexStore(lo: Lo, a: FExpr, ix: FExpr, rhs: FExpr): Stmt {
  val at = tagOf(lo, a)
  val args = list()
  args.push(lowerExpr(lo, a)); args.push(lowerExpr(lo, ix)); args.push(lowerExpr(lo, rhs))
  if (at == "String") { lowFail("cannot store into an immutable String index"); return SExprS(EInt("0")) }
  if (at == "Map") {
    if (tagOf(lo, ix) == "String") { return SExprS(ECall(roleSym(lo, "map.setS"), args)) }
    return SExprS(ECall(roleSym(lo, "map.setI"), args))
  }
  return SExprS(ECall(roleSym(lo, "list.set"), args))
}

fun pairE(a: Expr, b: Expr): List { val l = list(); l.push(a); l.push(b); return l }

fun lowerAssign(lo: Lo, lhs: FExpr, rhs: FExpr): Stmt {
  return when (lhs) {
    FEIdent(nm) -> SAssign(nm, lowerExpr(lo, rhs))
    FEField(b, f) -> if (isFieldOf(lo, tagOf(lo, b), f)) { SAssignF(lowerExpr(lo, b), f, lowerExpr(lo, rhs)) }
    else { if (hasSetter(lo, b, f)) { SExprS(ECall(setterCallee(lo, b, f), pairE(lowerExpr(lo, b), lowerExpr(lo, rhs)))) }
      else { SAssignF(lowerExpr(lo, b), f, lowerExpr(lo, rhs)) } }
    FEIndex(a, ix) -> lowerIndexStore(lo, a, ix, rhs)
    else -> { lowFail("assignment target"); SExprS(lowerExpr(lo, rhs)) }
  }
}

fun lowerLet(lo: Lo, nm: String, ty: String, init: FExpr): Stmt {
  val tag = if (ty == "") { tagOf(lo, init) } else { tyTag(ty) }
  var initE = lowerExpr(lo, init)
  // class ARC: a class-typed local is an owned reference. A fresh constructor already carries its
  // +1; binding an EXISTING class value (alias) takes a new co-ownership, so retain it.
  if (isClassTag(lo, tag)) {
    lo.arcOwned.push(nm)
    if (isFreshCtor(lo, init) == false) { val a = list(); a.push(initE); initE = ECall("__retain", a) }
  }
  bindLoc(lo, nm, tag)
  if (ty == "") { return SLet(nm, initE) }
  return SLetT(nm, ty, initE)
}

fun lowerStmt(lo: Lo, s: FStmt): Stmt {
  return when (s) {
    FSLet(isVar, nm, ty, init) -> lowerLet(lo, nm, ty, init)
    FSReturnV(x) -> SReturnV(lowerExpr(lo, x))
    FSReturnU -> SReturnU
    FSExprS(x) -> SExprS(lowerExpr(lo, x))
    FSAssign(lhs, rhs) -> lowerAssign(lo, lhs, rhs)
    FSWhile(c, b) -> SLoop(lowerExpr(lo, c), lowerExpr(lo, b), SExprS(ENoRes)) // empty step: `continue` re-tests the condition
    else -> { lowFail("statement"); SReturnU }
  }
}

// ---------- pattern lowering ----------
fun lowerPats(subs: List): List {
  val out = list()
  var i = 0
  while (i < subs.len()) { val s: FPat = subs.get(i); out.push(lowerPat(s)); i = i + 1 }
  return out
}

fun lowerPat(p: FPat): Pat {
  return when (p) {
    FPWild -> PWild
    FPBind(s) -> PBindP(s)
    FPInt(t) -> PIntP(litNum(t))
    FPCharP(t) -> PIntP(t)
    FPBoolP(b) -> if (b == "true") { PIntP("1") } else { PIntP("0") }
    FPNullP -> PIntP("0")
    FPPath(pth) -> PVarP(lastSeg(pth))
    FPCtor(pth, subs) -> PCtorP(lastSeg(pth), lowerPats(subs))
    else -> { lowFail("pattern"); PWild }
  }
}

// payload types declared for an enum constructor (e.g. JArr -> ["List"]); empty if unknown.
fun ctorPayloadTys(lo: Lo, ctorName: String): List {
  var i = 0
  while (i < lo.variantN.len()) { if (lo.variantN.get(i) == ctorName) { return lo.variantTys.get(i) }; i = i + 1 }
  return list()
}

// bind a single pattern variable with a known type (a leaf FPBind); recurse for a nested constructor.
fun bindPatVarTyped(lo: Lo, pat: FPat, ty: String): Int {
  when (pat) {
    FPBind(s) -> bindLoc(lo, s, ty)
    else -> bindPatVars(lo, pat)
  }
  return 0
}

// Bind the variables a pattern introduces, tagging each with its STATIC type so method dispatch on a
// destructured payload works (e.g. `when (j) { JArr(xs) -> xs.len() }` mangles to List_len, not a bare
// unresolved `len`). Constructor payload types come from the enum's variant table (ctorPayloadTys).
fun bindPatVars(lo: Lo, pat: FPat): Int {
  when (pat) {
    FPBind(s) -> bindLoc(lo, s, "?")
    FPCtor(pth, subs) -> {
      val ptys = ctorPayloadTys(lo, pth)
      var i = 0
      while (i < subs.len()) {
        val ty = if (i < ptys.len()) { tyTag(ptys.get(i)) } else { "?" }
        bindPatVarTyped(lo, subs.get(i), ty)
        i = i + 1
      }
      0
    }
    FPRecord(pth, flds, hasRest) -> {
      var i = 0
      while (i < flds.len()) { val f: FRFld = flds.get(i); if (f.hasPat == 1) { bindPatVars(lo, f.pat) } else { bindLoc(lo, f.name, "?") }; i = i + 1 }
      0
    }
    else -> 0
  }
  return 0
}

fun lowerArm(lo: Lo, a: FArm): Arm {
  if (a.kind == 1) { return Arm(1, PWild, lowerExpr(lo, a.body)) }
  if (a.kind == 0) { lowFail("subjectless when arm"); return Arm(1, PWild, lowerExpr(lo, a.body)) }
  val first: FPat = a.pats.get(0)
  bindPatVars(lo, first)
  return Arm(0, lowerPat(first), lowerExpr(lo, a.body))
}

fun lowerArms(lo: Lo, arms: List): List {
  val out = list()
  var i = 0
  while (i < arms.len()) { val a: FArm = arms.get(i); out.push(lowerArm(lo, a)); i = i + 1 }
  return out
}

// ---------- declaration collection (2-phase) ----------
fun collectStruct(td: FTDecl, structN: List, structF: List, structFT: List): Int {
  val fields = list()
  val ftys = list()
  var i = 0
  while (i < td.fields.len()) { val f: FFld = td.fields.get(i); fields.push(f.name); ftys.push(f.ty); i = i + 1 }
  structN.push(td.name); structF.push(fields); structFT.push(ftys)
  return 0
}

fun collectMethodSigs(td: FTDecl, pfuns: List, fN: List, fR: List): Int {
  var i = 0
  while (i < td.methods.len()) {
    val m: FFunc = td.methods.get(i)
    pfuns.push(PFun(td.name, m)); fN.push(mangleMethod(td.name, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// a class `deinit { ... }` becomes a method `<Class>_deinit(this)`; the generated recursive-release
// routine calls it when the last reference drops (see codegen buildRelRoutine / hasDeinit).
fun collectDeinit(td: FTDecl, pfuns: List, fN: List, fR: List): Int {
  if (isNoResF(td.dtor)) { return 0 }
  val df = FFunc(list(), "deinit", "", "self", list(), "Int", "", td.dtor)
  pfuns.push(PFun(td.name, df)); fN.push(mangleMethod(td.name, "deinit")); fR.push("Int")
  return 0
}

// impl-block methods (trait impls or inherent impls) register exactly like struct-body methods,
// owned by the `for` type. traitName is only a contract marker — static dispatch needs only the type.
fun collectImplMethods(im: FImplDecl, pfuns: List, fN: List, fR: List): Int {
  var i = 0
  while (i < im.methods.len()) {
    val m: FFunc = im.methods.get(i)
    pfuns.push(PFun(im.forTy, m)); fN.push(mangleMethod(im.forTy, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

fun collectEnum(ed: FEDecl, variantN: List, variantTag: List, variantTys: List, variantOwn: List): Int {
  var tag = 0
  var i = 0
  while (i < ed.variants.len()) {
    val v: FVariant = ed.variants.get(i)
    variantN.push(v.name); variantTag.push(tag); variantTys.push(v.tys); variantOwn.push(ed.name); tag = tag + 1
    i = i + 1
  }
  return 0
}

// ---------- class ARC: automatic retain/release insertion for reference (class) types ----------
// SAFE BY CONSTRUCTION: the compiler is written entirely in struct/enum, never `class`, so every
// compiler function has an empty owned-class-local set and arcInjectBody returns its body UNCHANGED
// -> the self-hosting fixpoint is structurally untouched. Only class-using (user) code is rewritten.
// Model: a class local created by a constructor owns +1; aliasing an existing class value retains it;
// owned class locals are released at scope exit; a returned local transfers ownership (not released).
// v1 limitation: only fall-through + TOP-LEVEL return statements are cleaned up (a return nested inside
// if/when leaks its owned locals — safe, never a double-free). `var` reassignment isn't balanced yet.
// A class gets automatic retain/release, but the built-in container nominals (List/Map) are EXEMPT:
// they are word-lists whose elements are type-erased Int words, so listPush can't retain a class
// element, and the compiler stores lists-inside-lists (structF/funP/variantTys) whose inner list a
// naive release would free while the outer still holds the raw pointer (UAF). So List/Map stay
// leak-managed exactly as when they were opaque builtins — declaring `class List` only gives them a
// visible layout + methods, never ARC. Real user classes are unaffected.
fun isClassTag(lo: Lo, t: String): Bool { return memListL(lo.classN, t) && (isArcExemptIn(lo.arcE, t) == false) }

fun isCtorCallee(lo: Lo, callee: FExpr): Bool {
  return when (callee) { FEIdent(nm) -> memListL(lo.sN, nm); else -> false }
}

fun isFreshCtor(lo: Lo, e: FExpr): Bool {
  return when (e) { FECall(callee, args) -> isCtorCallee(lo, callee); else -> false }
}

fun arcReleaseInto(out: List, cls: List, exceptNm: String): Int {
  var i = 0
  while (i < cls.len()) {
    val c: String = cls.get(i)
    if (c != exceptNm) { val a = list(); a.push(EIdent(c)); out.push(SExprS(ECall("__release", a))) }
    i = i + 1
  }
  return 0
}

fun arcRetName(e: Expr): String { return when (e) { EIdent(n) -> n; else -> "" } }

fun arcRelList(cls: List, exceptNm: String): List { val out = list(); arcReleaseInto(out, cls, exceptNm); return out }

fun arcZeroInto(out: List, cls: List): Int {
  var i = 0
  while (i < cls.len()) { out.push(SAssign(cls.get(i), EInt("0"))); i = i + 1 }
  return 0
}

// recursive rewrite: release owned class locals before EVERY return (top-level + nested in if/when/blocks).
// Zero-init at entry (arcZeroInto) makes releasing a not-yet-declared local a nil-safe no-op, so we can
// release the whole owned set at any exit without flow-sensitive scope tracking. A returned local is
// excluded (ownership transfers to the caller); any other returned value is spilled to a temp first.
fun arcRet(lo: Lo, cls: List, v: Expr): Expr {
  val rn = arcRetName(v)
  if (memListL(cls, rn)) { return EBlock(arcRelList(cls, rn), v) }
  val t = freshName(lo, "_ar")
  val ss = list(); ss.push(SLet(t, v)); arcReleaseInto(ss, cls, "")
  return EBlock(ss, EIdent(t))
}

fun arcRwArms(lo: Lo, cls: List, arms: List): List {
  val out = list()
  var i = 0
  while (i < arms.len()) { val a: Arm = arms.get(i); out.push(Arm(a.isElse, a.pat, arcRwExpr(lo, cls, a.body))); i = i + 1 }
  return out
}

fun arcRwExpr(lo: Lo, cls: List, e: Expr): Expr {
  return when (e) {
    ERet(v) -> ERet(arcRet(lo, cls, v))
    EIf(c, t, el) -> EIf(c, arcRwExpr(lo, cls, t), arcRwExpr(lo, cls, el))
    EWhen(subj, arms) -> EWhen(subj, arcRwArms(lo, cls, arms))
    EBlock(stmts, res) -> EBlock(arcRwStmts(lo, cls, stmts), arcRwExpr(lo, cls, res))
    else -> e
  }
}

fun arcRwStmts(lo: Lo, cls: List, stmts: List): List {
  val out = list()
  var i = 0
  while (i < stmts.len()) {
    val s: Stmt = stmts.get(i)
    when (s) {
      SReturnV(e) -> {
        val rn = arcRetName(e)
        if (memListL(cls, rn)) { arcReleaseInto(out, cls, rn); out.push(SReturnV(e)) }
        else { val t = freshName(lo, "_ar"); out.push(SLet(t, e)); arcReleaseInto(out, cls, ""); out.push(SReturnV(EIdent(t))) }
      }
      SReturnU -> { arcReleaseInto(out, cls, ""); out.push(SReturnU) }
      SExprS(e) -> { out.push(SExprS(arcRwExpr(lo, cls, e))); 0 }
      SWhile(c, b) -> { out.push(SWhile(c, arcRwExpr(lo, cls, b))); 0 }
      SLoop(c, b, st) -> { out.push(SLoop(c, arcRwExpr(lo, cls, b), st)); 0 }
      else -> { out.push(s); 0 }
    }
    i = i + 1
  }
  return out
}

fun arcInjectBody(lo: Lo, body: Expr, cls: List): Expr {
  if (cls.len() == 0) { return body }
  return when (body) {
    EBlock(stmts, res) -> {
      val out = list()
      arcZeroInto(out, cls)
      val rw = arcRwStmts(lo, cls, stmts)
      var i = 0
      while (i < rw.len()) { out.push(rw.get(i)); i = i + 1 }
      if (isNoRes(res)) { arcReleaseInto(out, cls, ""); EBlock(out, ENoRes) }
      else {
        val r2 = arcRwExpr(lo, cls, res)
        val rn = arcRetName(r2)
        if (memListL(cls, rn)) { arcReleaseInto(out, cls, rn); EBlock(out, r2) }
        else { val t = freshName(lo, "_ar"); out.push(SLet(t, r2)); arcReleaseInto(out, cls, ""); EBlock(out, EIdent(t)) }
      }
    }
    else -> {
      val out = list()
      arcZeroInto(out, cls)
      val t = freshName(lo, "_ar"); out.push(SLet(t, arcRwExpr(lo, cls, body))); arcReleaseInto(out, cls, "")
      EBlock(out, EIdent(t))
    }
  }
}

// ---------- dynamic trait dispatch: generate a ___dyn_<Trait>_<m> switch over the object's type-id ----------
fun indexOfL(l: List, n: String): Int {
  var i = 0
  while (i < l.len()) { if (l.get(i) == n) { return i }; i = i + 1 }
  return 0 - 1
}

fun findTraitDeclIdx(traitDecls: List, name: String): Int {
  var i = 0
  while (i < traitDecls.len()) { val tr: FTraitDecl = traitDecls.get(i); if (tr.name == name) { return i }; i = i + 1 }
  return 0 - 1
}

fun oneStmt(s: Stmt): List { val l = list(); l.push(s); return l }

// implementations of trait `tn` (parallel implTrait/implType lists) -> the list of impl type names
fun implTypesOf(implTrait: List, implType: List, tn: String): List {
  val out = list()
  var i = 0
  while (i < implTrait.len()) { if (implTrait.get(i) == tn) { out.push(implType.get(i)) }; i = i + 1 }
  return out
}

// build  fun ___dyn_T_m(obj, <method params>): Ret { val __t = __typeId(obj)
//   if (__t == id(Ty0)) return Ty0_m(obj, params) ; ... ; return 0 }
fun buildDispatcher(traitName: String, m: FFunc, implTypes: List, structN: List): Func {
  val pnames = list(); pnames.push("obj")
  val ptys = list(); ptys.push(traitName)
  var i = 0
  while (i < m.params.len()) { val pp: FParam = m.params.get(i); pnames.push(pp.name); ptys.push(pp.ty); i = i + 1 }
  val stmts = list()
  val tArgs = list(); tArgs.push(EIdent("obj"))
  stmts.push(SLet("__t", ECall("__typeId", tArgs)))
  var j = 0
  while (j < implTypes.len()) {
    val ty: String = implTypes.get(j)
    val id = indexOfL(structN, ty)
    val cargs = list(); cargs.push(EIdent("obj"))
    var k = 0
    while (k < m.params.len()) { val pp: FParam = m.params.get(k); cargs.push(EIdent(pp.name)); k = k + 1 }
    val callE = ECall(mangleMethod(ty, m.name), cargs)
    val cond = EBin("==", EIdent("__t"), EInt(id.toStr()))
    stmts.push(SExprS(EIf(cond, EBlock(oneStmt(SReturnV(callE)), ENoRes), ENoRes)))
    j = j + 1
  }
  // No impl matched the runtime type-id: this is a hard error (a trait method invoked on a type that
  // does not implement it), not a silently-wrong 0. Abort the process; the trailing return is unreachable
  // but keeps the function value-returning for the checker/codegen (STDLIB-REDESIGN §2b, Phase 4).
  stmts.push(SExprS(ECall("__abort", list())))
  stmts.push(SReturnV(EInt("0")))
  return Func("__dyn_" + (traitName + ("_" + m.name)), pnames, ptys, EBlock(stmts, ENoRes))
}

// generate every trait method's dispatcher; register names/returns so calls resolve during lowering
fun genDispatchers(traitDecls: List, implTrait: List, implType: List, structN: List, fN: List, fR: List): List {
  val out = list()
  var i = 0
  while (i < traitDecls.len()) {
    val tr: FTraitDecl = traitDecls.get(i)
    val impls = implTypesOf(implTrait, implType, tr.name)
    var j = 0
    while (j < tr.methods.len()) {
      val m: FFunc = tr.methods.get(j)
      val d = buildDispatcher(tr.name, m, impls, structN)
      out.push(d); fN.push(d.name); fR.push(m.ret)
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// ---------- @derive: monomorphizing structural-impl synthesis (STDLIB-REDESIGN §2b, Phase 4) ----------
// A `@derive(Tr, ...)` on a struct/class synthesizes a concrete `<Type>_<method>` FFunc by structural
// recursion over the declared fields, registered exactly like a hand-written impl so the static desugar
// (==/</cmp), method dispatch, and dynamic dispatch all resolve to it. Auto-derivable trait set:
//   Eq PartialEq -> eq(self,other):Bool      Ord PartialOrd -> cmp(self,other):Int
//   Hash -> hash(self):Int                   Clone -> clone(self):Self
//   Debug -> debug(self):String             Default -> default():Self     Copy -> marker (no method)
// Requesting a non-derivable trait (Display/From/Iterator/an operator trait) is a hard build error.
// The compiler's own sources use no @derive, so this pass is inert for the self-host build.

// `t` is a leaf scalar whose eq/cmp/hash/clone/debug lower inline (no per-field method call).
fun deriveIsScalar(t: String): Bool {
  val b = tyTag(t)
  return b == "Int" || b == "Long" || b == "ISize" || b == "USize" || b == "Byte" ||
  b == "I8" || b == "I16" || b == "I32" || b == "I64" ||
  b == "U8" || b == "U16" || b == "U32" || b == "U64" ||
  b == "Int8" || b == "Int16" || b == "Int32" || b == "Int64" ||
  b == "UInt8" || b == "UInt16" || b == "UInt32" || b == "UInt64" ||
  b == "Bool" || b == "Char" || b == "Float" || b == "Double"
}

fun deriveIsString(t: String): Bool { return tyTag(t) == "String" }

fun deriveThisF(fn: String): FExpr { return FEField(FEThis, fn) }

fun deriveOtherF(fn: String): FExpr { return FEField(FEIdent("other"), fn) }

// eq body: conjunction of `self.fi == other.fi`. The synthesized `==` re-enters lowerBin so scalar fields
// machine-compare, String fields route to String_eq, and nested derived structs to their own <T>_eq.
fun deriveEqBody(fields: List): FExpr {
  if (fields.len() == 0) { return FEBlock(oneStmt(FSReturnV(FEBool("true"))), FENoRes) }
  var acc = FEBin("==", deriveThisF(fields.get(0)), deriveOtherF(fields.get(0)))
  var i = 1
  while (i < fields.len()) {
    val fn: String = fields.get(i)
    acc = FEBin("&&", acc, FEBin("==", deriveThisF(fn), deriveOtherF(fn)))
    i = i + 1
  }
  return FEBlock(oneStmt(FSReturnV(acc)), FENoRes)
}

// cmp body: lexicographic over fields, returning -1/0/1. Uses only `<`, which re-enters lowerBin so a
// nested field routes to its own <T>_cmp (Ord desugar) while scalar fields machine-compare.
fun deriveCmpBody(fields: List): FExpr {
  val stmts = list()
  var i = 0
  while (i < fields.len()) {
    val fn: String = fields.get(i)
    val ltCond = FEBin("<", deriveThisF(fn), deriveOtherF(fn))
    stmts.push(FSExprS(FEIf(ltCond, FEBlock(oneStmt(FSReturnV(FEBin("-", FEInt("0"), FEInt("1")))), FENoRes), FENoRes)))
    val gtCond = FEBin("<", deriveOtherF(fn), deriveThisF(fn))
    stmts.push(FSExprS(FEIf(gtCond, FEBlock(oneStmt(FSReturnV(FEInt("1"))), FENoRes), FENoRes)))
    i = i + 1
  }
  stmts.push(FSReturnV(FEInt("0")))
  return FEBlock(stmts, FENoRes)
}

// per-field hash contribution as an INT surrogate: the FNV mix folds it through integer `*`/`+`, so the
// contribution must be Int-typed — feeding a String (routes `+` to concat, deref-crash) or a boxed Double
// (would IMul a pointer) into that arithmetic corrupts/crashes. String -> its byte length (.len()); a
// Double/Float -> toInt() truncation; other scalars (Int/Bool/Char/…) are already a raw Int word; a nested
// derived type -> its own <T>_hash(). A proper byte-fold String hash arrives with the Phase 5 String work.
fun deriveHashOf(fn: String, ft: String): FExpr {
  val b = tyTag(ft)
  if (b == "String") { return FECall(FEField(deriveThisF(fn), "len"), list()) }
  if (b == "Float" || b == "Double") { val ta = list(); ta.push(FArg("", deriveThisF(fn))); return FECall(FEIdent("toInt"), ta) }
  if (deriveIsScalar(ft)) { return deriveThisF(fn) }
  return FECall(FEField(deriveThisF(fn), "hash"), list())
}

// hash body: FNV-style mix  var __h = 0 ; __h = __h*31 + hash(fi) ; ... ; return __h
fun deriveHashBody(fields: List, ftys: List): FExpr {
  val stmts = list()
  stmts.push(FSLet(1, "__h", "Int", FEInt("0")))
  var i = 0
  while (i < fields.len()) {
    val h = deriveHashOf(fields.get(i), ftys.get(i))
    stmts.push(FSAssign(FEIdent("__h"), FEBin("+", FEBin("*", FEIdent("__h"), FEInt("31")), h)))
    i = i + 1
  }
  stmts.push(FSReturnV(FEIdent("__h")))
  return FEBlock(stmts, FENoRes)
}

// clone body: reconstruct the struct; scalar/String fields copy the word, nested fields deep-clone.
fun deriveCloneBody(tyName: String, fields: List, ftys: List): FExpr {
  val args = list()
  var i = 0
  while (i < fields.len()) {
    val fn: String = fields.get(i); val ft: String = ftys.get(i)
    if (deriveIsScalar(ft) || deriveIsString(ft)) { args.push(FArg("", deriveThisF(fn))) }
    else { args.push(FArg("", FECall(FEField(deriveThisF(fn), "clone"), list()))) }
    i = i + 1
  }
  return FEBlock(oneStmt(FSReturnV(FECall(FEIdent(tyName), args))), FENoRes)
}

// debug body: `TypeName(f0, f1, ...)` via interpolation. Scalars render via str.show (Int_toStr), String
// fields render directly, nested fields render via their own <T>_debug() (a String).
fun deriveDebugBody(tyName: String, fields: List, ftys: List): FExpr {
  val parts = list()
  parts.push(FILit(tyName + "("))
  var i = 0
  while (i < fields.len()) {
    if (i > 0) { parts.push(FILit(", ")) }
    val fn: String = fields.get(i); val ft: String = ftys.get(i)
    if (deriveIsScalar(ft) || deriveIsString(ft)) { parts.push(FIExpr(deriveThisF(fn))) }
    else { parts.push(FIExpr(FECall(FEField(deriveThisF(fn), "debug"), list()))) }
    i = i + 1
  }
  parts.push(FILit(")"))
  return FEBlock(oneStmt(FSReturnV(FEInterp(parts, 0))), FENoRes)
}

// default body: construct from each field's default (0 for scalars, "" for String, <T>::default() nested).
fun deriveDefaultBody(tyName: String, fields: List, ftys: List): FExpr {
  val args = list()
  var i = 0
  while (i < fields.len()) {
    val ft: String = ftys.get(i)
    if (deriveIsScalar(ft)) { args.push(FArg("", FEInt("0"))) }
    else { if (deriveIsString(ft)) { args.push(FArg("", FEStr("", 0))) }
      else { args.push(FArg("", FECall(FEStatic(FEIdent(tyTag(ft)), "default"), list()))) } }
    i = i + 1
  }
  return FEBlock(oneStmt(FSReturnV(FECall(FEIdent(tyName), args))), FENoRes)
}

// ---------- @derive over ENUMS (STDLIB-REDESIGN §2b, Phase 4) ----------
// An enum value is a boxed {tag@0, payload@8+8j}. A derived method matches on the variant (a `when` over
// self, and — for the binary Eq/Ord — a nested `when` over other) so the tag is compared first and the
// payloads structurally. The subject is FEThis (the recv `self` binds to `this`), never a param literally
// named `self` (a free-fn param named `self` is a known codegen hazard). Per-arm the payload binders are
// __s0.. (self) / __o0.. (other), typed from the variant table so `__sJ == __oJ` routes by payload type.

// one-element FPat list (an arm's pattern-alternatives list holds a single ctor pattern).
fun oneP(p: FPat): List { val l = list(); l.push(p); return l }

// ctor pattern `V(__<pre>0, __<pre>1, ...)` binding `n` positional payload holes.
fun deriveBindPats(pre: String, n: Int): List {
  val ps = list()
  var j = 0
  while (j < n) { ps.push(FPBind("__" + (pre + j.toStr()))); j = j + 1 }
  return ps
}

// gather one enum's variant names (declaration order) from the flat variant table (filtered by owner).
fun enumVariantNamesOf(variantN: List, variantOwn: List, en: String): List {
  val out = list()
  var i = 0
  while (i < variantN.len()) { if (variantOwn.get(i) == en) { out.push(variantN.get(i)) }; i = i + 1 }
  return out
}

// gather the parallel per-variant payload-type lists for one enum.
fun enumVariantTysOf(variantN: List, variantOwn: List, variantTys: List, en: String): List {
  val out = list()
  var i = 0
  while (i < variantN.len()) { if (variantOwn.get(i) == en) { out.push(variantTys.get(i)) }; i = i + 1 }
  return out
}

// eq conjunction over the payload binders `__s0..__o0..`: AND of `__sJ == __oJ`; empty payload -> true.
fun deriveEnumEqConj(n: Int): FExpr {
  if (n == 0) { return FEBool("true") }
  var acc = FEBin("==", FEIdent("__s0"), FEIdent("__o0"))
  var j = 1
  while (j < n) { acc = FEBin("&&", acc, FEBin("==", FEIdent("__s" + j.toStr()), FEIdent("__o" + j.toStr()))); j = j + 1 }
  return acc
}

// enum eq: `when (self) { V(s..) -> when (other) { V(o..) -> AND(s==o) ; else -> false } ... else -> false }`.
fun deriveEnumEqBody(vnames: List, vtys: List): FExpr {
  val arms = list()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: List = vtys.get(i)
    val innerArms = list()
    innerArms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("o", tys.len()))), FENoRes, deriveEnumEqConj(tys.len())))
    innerArms.push(FArm(1, FENoRes, list(), FENoRes, FEBool("false")))
    val inner = FEWhen(1, "", FEIdent("other"), innerArms)
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, inner))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, list(), FENoRes, FEBool("false")))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// lexicographic payload compare of `__s0..` vs `__o0..` as a value: nested if returning -1/0/1.
fun deriveEnumCmpPayload(n: Int, i: Int): FExpr {
  if (i >= n) { return FEInt("0") }
  val sJ = FEIdent("__s" + i.toStr()); val oJ = FEIdent("__o" + i.toStr())
  val neg = FEBin("-", FEInt("0"), FEInt("1"))
  return FEIf(FEBin("<", sJ, oJ), neg, FEIf(FEBin("<", oJ, sJ), FEInt("1"), deriveEnumCmpPayload(n, i + 1)))
}

// enum cmp: variant declaration order first, then payloads. For outer variant `oi`, the inner `when (other)`
// returns 1 for an EARLIER variant (self greater), the payload compare for the SAME variant, -1 for a LATER
// variant. Every variant is covered; an else -> 0 backstops.
fun deriveEnumCmpBody(vnames: List, vtys: List): FExpr {
  val arms = list()
  var oi = 0
  while (oi < vnames.len()) {
    val vn: String = vnames.get(oi)
    val tys: List = vtys.get(oi)
    val innerArms = list()
    var ii = 0
    while (ii < vnames.len()) {
      val ivn: String = vnames.get(ii)
      val itys: List = vtys.get(ii)
      val body = if (ii == oi) { deriveEnumCmpPayload(tys.len(), 0) } else { if (ii < oi) { FEInt("1") } else { FEBin("-", FEInt("0"), FEInt("1")) } }
      innerArms.push(FArm(2, FENoRes, oneP(FPCtor(ivn, deriveBindPats("o", itys.len()))), FENoRes, body))
      ii = ii + 1
    }
    innerArms.push(FArm(1, FENoRes, list(), FENoRes, FEInt("0")))
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, FEWhen(1, "", FEIdent("other"), innerArms)))
    oi = oi + 1
  }
  arms.push(FArm(1, FENoRes, list(), FENoRes, FEInt("0")))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// per-payload-local hash surrogate (Int): String -> .len(), Double -> toInt(), scalar -> the word, nested -> .hash().
fun deriveEnumHashOf(nm: String, ft: String): FExpr {
  val b = tyTag(ft)
  if (b == "String") { return FECall(FEField(FEIdent(nm), "len"), list()) }
  if (b == "Float" || b == "Double") { val ta = list(); ta.push(FArg("", FEIdent(nm))); return FECall(FEIdent("toInt"), ta) }
  if (deriveIsScalar(ft)) { return FEIdent(nm) }
  return FECall(FEField(FEIdent(nm), "hash"), list())
}

// enum hash: `when (self) { V(s..) -> FNV-mix(<variant-index>, hash(s0), ...) }`. The variant index seeds the
// mix so distinct variants (even with equal payloads) hash apart; equal values hash equal (matches derived eq).
fun deriveEnumHashBody(vnames: List, vtys: List): FExpr {
  val arms = list()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: List = vtys.get(i)
    var acc = FEBin("+", FEBin("*", FEInt("0"), FEInt("31")), FEInt(i.toStr()))
    var j = 0
    while (j < tys.len()) {
      acc = FEBin("+", FEBin("*", acc, FEInt("31")), deriveEnumHashOf("__s" + j.toStr(), tys.get(j)))
      j = j + 1
    }
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, acc))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, list(), FENoRes, FEInt("0")))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// enum clone: `when (self) { V(s..) -> V(clone(s0), ...) }`. Scalar/String copy the word, nested deep-clone.
fun deriveEnumCloneBody(vnames: List, vtys: List): FExpr {
  val arms = list()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: List = vtys.get(i)
    val cargs = list()
    var j = 0
    while (j < tys.len()) {
      val ft: String = tys.get(j); val nm = "__s" + j.toStr()
      if (deriveIsScalar(ft) || deriveIsString(ft)) { cargs.push(FArg("", FEIdent(nm))) }
      else { cargs.push(FArg("", FECall(FEField(FEIdent(nm), "clone"), list()))) }
      j = j + 1
    }
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, FECall(FEIdent(vn), cargs)))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, list(), FENoRes, FEThis))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// enum debug: `when (self) { V(s..) -> "V(s0, s1)" }` via interpolation. Scalar/String render directly,
// nested via their own <T>_debug().
fun deriveEnumDebugBody(vnames: List, vtys: List): FExpr {
  val arms = list()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: List = vtys.get(i)
    val parts = list()
    if (tys.len() == 0) { parts.push(FILit(vn)) }
    else {
      parts.push(FILit(vn + "("))
      var j = 0
      while (j < tys.len()) {
        if (j > 0) { parts.push(FILit(", ")) }
        val ft: String = tys.get(j); val nm = "__s" + j.toStr()
        if (deriveIsScalar(ft) || deriveIsString(ft)) { parts.push(FIExpr(FEIdent(nm))) }
        else { parts.push(FIExpr(FECall(FEField(FEIdent(nm), "debug"), list()))) }
        j = j + 1
      }
      parts.push(FILit(")"))
    }
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, FEInterp(parts, 0)))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, list(), FENoRes, FEStr("", 0)))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// enum default: the FIRST variant, each payload at its own default (0 / "" / <T>::default()).
fun deriveEnumDefaultBody(vnames: List, vtys: List): FExpr {
  val vn: String = vnames.get(0)
  val tys: List = vtys.get(0)
  val args = list()
  var j = 0
  while (j < tys.len()) {
    val ft: String = tys.get(j)
    if (deriveIsScalar(ft)) { args.push(FArg("", FEInt("0"))) }
    else { if (deriveIsString(ft)) { args.push(FArg("", FEStr("", 0))) }
      else { args.push(FArg("", FECall(FEStatic(FEIdent(tyTag(ft)), "default"), list()))) } }
    j = j + 1
  }
  return FEBlock(oneStmt(FSReturnV(FECall(FEIdent(vn), args))), FENoRes)
}

// synthesize the method(s) for one `@derive(tr)` on ENUM `enName` with the given variant names / payload-ty lists.
fun deriveOneEnum(pfuns: List, fN: List, fR: List, implTrait: List, implType: List, enName: String, tr: String, vnames: List, vtys: List): Int {
  if (deriveIsKnown(tr) == false) { lowFail("cannot @derive(" + (tr + (") for " + (enName + " — not an auto-derivable trait")))); return 0 }
  if (tr == "Eq" || tr == "PartialEq") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "eq", "Bool", FFunc(list(), "eq", "", "self", cons1P(FParam("other", enName)), "Bool", "", deriveEnumEqBody(vnames, vtys)))
  }
  if (tr == "Ord") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "cmp", "Int", FFunc(list(), "cmp", "", "self", cons1P(FParam("other", enName)), "Int", "", deriveEnumCmpBody(vnames, vtys)))
  }
  if (tr == "PartialOrd") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "partialCmp", "Int", FFunc(list(), "partialCmp", "", "self", cons1P(FParam("other", enName)), "Int", "", deriveEnumCmpBody(vnames, vtys)))
  }
  if (tr == "Hash") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "hash", "Int", FFunc(list(), "hash", "", "self", list(), "Int", "", deriveEnumHashBody(vnames, vtys)))
  }
  if (tr == "Clone") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "clone", enName, FFunc(list(), "clone", "", "self", list(), enName, "", deriveEnumCloneBody(vnames, vtys)))
  }
  if (tr == "Debug") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "debug", "String", FFunc(list(), "debug", "", "self", list(), "String", "", deriveEnumDebugBody(vnames, vtys)))
  }
  if (tr == "Default") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "default", enName, FFunc(list(), "default", "", "", list(), enName, "", deriveEnumDefaultBody(vnames, vtys)))
  }
  // Copy is a marker: nothing to synthesize.
  return 0
}

// §2b well-formedness for an ENUM derive: every payload type of every variant must be scalar/String or itself
// carry the trait's method; Double payloads are rejected for the compare/print/default derives. Hard-aborts
// (exit 134, no binary) — the same silent-pointer-compare hazard the struct field check guards.
fun deriveCheckWFEnum(fN: List, enName: String, tr: String, vnames: List, vtys: List): Int {
  val m = deriveMethodFor(tr)
  if (m == "") { return 0 }
  var i = 0
  while (i < vnames.len()) {
    val tys: List = vtys.get(i)
    var j = 0
    while (j < tys.len()) {
      val ft: String = tys.get(j)
      val b = tyTag(ft)
      if (b == "Float" || b == "Double") {
        if (deriveFloatUnsafe(tr)) {
          lowFail("cannot @derive(" + (tr + (") for " + (enName + (": " + (vnames.get(i) + " payload — floating-point fields are not derivable until Double is unboxed"))))))
        }
      } else {
        if (deriveIsScalar(ft) == false && deriveIsString(ft) == false) {
          if (memListL(fN, mangleMethod(b, m)) == false) {
            lowFail("cannot @derive(" + (tr + (") for " + (enName + (": " + (vnames.get(i) + (" payload of type " + (ft + (" does not implement " + tr)))))))))
          }
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return 0
}

// membership in the auto-derivable trait set (rejects Display/From/Iterator/operator traits).
fun deriveIsKnown(tr: String): Bool {
  return tr == "Eq" || tr == "PartialEq" || tr == "Ord" || tr == "PartialOrd" ||
  tr == "Hash" || tr == "Clone" || tr == "Copy" || tr == "Default" || tr == "Debug"
}

// register one synthesized derive method (deduped against hand impls / prior derives). Records the impl in
// implTrait/implType too, so the trait's dispatcher (when the trait decl is present) includes this type.
fun deriveEmit(pfuns: List, fN: List, fR: List, implTrait: List, implType: List, tyName: String, tr: String, mName: String, ret: String, fn: FFunc): Int {
  val mangled = mangleMethod(tyName, mName)
  if (memListL(fN, mangled) == false) {
    pfuns.push(PFun(tyName, fn)); fN.push(mangled); fR.push(ret)
  }
  implTrait.push(tr); implType.push(tyName)
  return 0
}

// synthesize the method(s) for one `@derive(tr)` on struct `tyName` with the given fields/types.
fun deriveOne(pfuns: List, fN: List, fR: List, implTrait: List, implType: List, tyName: String, tr: String, fields: List, ftys: List): Int {
  if (deriveIsKnown(tr) == false) { lowFail("cannot @derive(" + (tr + (") for " + (tyName + " — not an auto-derivable trait")))); return 0 }
  if (tr == "Eq" || tr == "PartialEq") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "eq", "Bool", FFunc(list(), "eq", "", "self", cons1P(FParam("other", tyName)), "Bool", "", deriveEqBody(fields)))
  }
  // Ord's declared method is `cmp`; PartialOrd's is `partialCmp` (lib/core/cmp.kite). Emit under the
  // trait's ACTUAL method name so its dispatcher (__dyn_<Tr>_<m>) resolves to a real <T>_<m> — deriving
  // under the wrong name left __dyn_PartialOrd_partialCmp calling a never-synthesized <T>_partialCmp
  // (dangling symbol, non-loadable binary). The </<=/>/>= desugar (cmpMangledFor) resolves either name.
  if (tr == "Ord") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "cmp", "Int", FFunc(list(), "cmp", "", "self", cons1P(FParam("other", tyName)), "Int", "", deriveCmpBody(fields)))
  }
  if (tr == "PartialOrd") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "partialCmp", "Int", FFunc(list(), "partialCmp", "", "self", cons1P(FParam("other", tyName)), "Int", "", deriveCmpBody(fields)))
  }
  if (tr == "Hash") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "hash", "Int", FFunc(list(), "hash", "", "self", list(), "Int", "", deriveHashBody(fields, ftys)))
  }
  if (tr == "Clone") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "clone", tyName, FFunc(list(), "clone", "", "self", list(), tyName, "", deriveCloneBody(tyName, fields, ftys)))
  }
  if (tr == "Debug") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "debug", "String", FFunc(list(), "debug", "", "self", list(), "String", "", deriveDebugBody(tyName, fields, ftys)))
  }
  if (tr == "Default") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "default", tyName, FFunc(list(), "default", "", "", list(), tyName, "", deriveDefaultBody(tyName, fields, ftys)))
  }
  // Copy is a marker: nothing to synthesize (value structs already copy bitwise on assignment).
  return 0
}

// one-element FParam list helper (mirrors oneStmt).
fun cons1P(p: FParam): List { val l = list(); l.push(p); return l }

// the concrete method a nested field must provide so its <T>_<method> resolves during structural
// recursion (Eq/PartialEq->eq, Ord->cmp, PartialOrd->partialCmp, Hash->hash, Clone->clone, Debug->debug,
// Default->default). Copy is a marker with no per-field requirement -> "".
fun deriveMethodFor(tr: String): String {
  if (tr == "Eq" || tr == "PartialEq") { return "eq" }
  if (tr == "Ord") { return "cmp" }
  if (tr == "PartialOrd") { return "partialCmp" }
  if (tr == "Hash") { return "hash" }
  if (tr == "Clone") { return "clone" }
  if (tr == "Debug") { return "debug" }
  if (tr == "Default") { return "default" }
  return ""
}

// derived Eq/Ord/PartialOrd/Debug/Default over a Double/Float field silently MISCOMPILES today: tagOf
// cannot infer `self.<field>: Double`, so the synthesized `==`/`<` emit an INTEGER compare of the boxed
// pointers (Debug prints the box pointer; Default stores an Int 0 into a Double slot). Hash is safe (it
// folds a toInt() surrogate) and Clone/Copy copy the (immutable) word. Until Double is unboxed (Phase 10),
// reject these derives over a float field rather than emit wrong code. Root cause is pre-existing (a
// hand-written `self.c == other.c` over a Double field fails identically); this stops the silent-wrong.
fun deriveFloatUnsafe(tr: String): Bool {
  return tr == "Eq" || tr == "PartialEq" || tr == "Ord" || tr == "PartialOrd" || tr == "Debug" || tr == "Default"
}

// §2b well-formedness: a derive is rejected if any field type is not derivable for the trait. A scalar or
// String the synthesizer handles inline; any other field type must itself carry an impl/derive of the same
// trait (its `<Tag>_<method>` is registered in fN). A field lacking it would silently pointer-compare
// (garbage `==`), so we hard-abort here (exit 134, no binary) — the same path as the non-derivable-trait
// rejection. Float/Double fields are rejected for the compare/print/default derives (see deriveFloatUnsafe).
// Runs AFTER all synthesis so nested derives (e.g. Line over a derived Point) are already registered.
fun deriveCheckWF(fN: List, tyName: String, tr: String, fields: List, ftys: List): Int {
  val m = deriveMethodFor(tr)
  if (m == "") { return 0 }
  var i = 0
  while (i < fields.len()) {
    val fn: String = fields.get(i)
    val ft: String = ftys.get(i)
    val b = tyTag(ft)
    if (b == "Float" || b == "Double") {
      if (deriveFloatUnsafe(tr)) {
        lowFail("cannot @derive(" + (tr + (") for " + (tyName + (": field " + (fn + " — floating-point fields are not derivable until Double is unboxed"))))))
      }
    } else {
      if (deriveIsScalar(ft) == false && deriveIsString(ft) == false) {
        if (memListL(fN, mangleMethod(b, m)) == false) {
          lowFail("cannot @derive(" + (tr + (") for " + (tyName + (": field " + (fn + (" of type " + (ft + (" does not implement " + tr)))))))))
        }
      }
    }
    i = i + 1
  }
  return 0
}

// find struct `tyName`'s field-name / field-type lists; returns index into structN or -1.
fun deriveStructIdx(structN: List, name: String): Int {
  var i = 0
  while (i < structN.len()) { if (structN.get(i) == name) { return i }; i = i + 1 }
  return 0 - 1
}

// is `name` a declared enum (i.e. it owns at least one variant)?
fun isEnumType(variantOwn: List, name: String): Bool { return memListL(variantOwn, name) }

// run every collected @derive: for each (type, trait) pair, synthesize + register the concrete impl.
// A struct/class derives by structural recursion over its fields; an ENUM by matching on the variant (tag
// then payloads). A derive on a type that is NEITHER a known struct nor a known enum hard-aborts below via
// deriveOne's non-derivable path only if it is a struct — a stray name is dropped (no such surface exists).
fun runDerives(deriveT: List, deriveTr: List, pfuns: List, fN: List, fR: List, structN: List, structF: List, structFT: List, variantN: List, variantTys: List, variantOwn: List, implTrait: List, implType: List): Int {
  var i = 0
  while (i < deriveT.len()) {
    val tyName: String = deriveT.get(i)
    val tr: String = deriveTr.get(i)
    val si = deriveStructIdx(structN, tyName)
    if (si >= 0) {
      deriveOne(pfuns, fN, fR, implTrait, implType, tyName, tr, structF.get(si), structFT.get(si))
    } else { if (isEnumType(variantOwn, tyName)) {
        deriveOneEnum(pfuns, fN, fR, implTrait, implType, tyName, tr, enumVariantNamesOf(variantN, variantOwn, tyName), enumVariantTysOf(variantN, variantOwn, variantTys, tyName))
      } }
    i = i + 1
  }
  // §2b well-formedness — SECOND pass, after every derive is synthesized so nested-field methods
  // (a derived Point used inside a derived Line, or a struct payload inside a derived enum) are already
  // registered in fN. Any field/payload that is neither a scalar/String nor a type carrying the trait's
  // method hard-aborts (no binary) — this is what stops the silent pointer-compare for enums too.
  var w = 0
  while (w < deriveT.len()) {
    val wtn: String = deriveT.get(w)
    val wtr: String = deriveTr.get(w)
    val wsi = deriveStructIdx(structN, wtn)
    if (wsi >= 0) { deriveCheckWF(fN, wtn, wtr, structF.get(wsi), structFT.get(wsi)) }
    else { if (isEnumType(variantOwn, wtn)) { deriveCheckWFEnum(fN, wtn, wtr, enumVariantNamesOf(variantN, variantOwn, wtn), enumVariantTysOf(variantN, variantOwn, variantTys, wtn)) } }
    w = w + 1
  }
  return 0
}

// record @derive(Tr, ...) annotations on a type decl into the parallel (type,trait) worklists.
fun recordDerive(annos: List, tyName: String, deriveT: List, deriveTr: List): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "derive") {
      var j = 0
      while (j < a.args.len()) {
        val ax: FExpr = a.args.get(j)
        val trn = when (ax) { FEIdent(n) -> n; else -> "" }
        if (trn != "") { deriveT.push(tyName); deriveTr.push(trn) }
        j = j + 1
      }
    }
    i = i + 1
  }
  return 0
}

fun lowerFuncFull(pf: PFun, fN: List, fR: List, sN: List, sFN: List, sFT: List, lifted: List, gctr: List, classN: List, traitN: List, constN: List, constV: List, cfuncs: List, traitMethN: List, traitMethT: List, pmN: List, pmM: List, variantN: List, variantTys: List, variantOwn: List, roleK: List, roleV: List, arcE: List): Func {
  val fd = pf.fd
  val ctr = list(); ctr.push(0)
  val lo = Lo(ctr, list(), list(), fN, fR, sN, sFN, sFT, lifted, gctr, classN, list(), traitN, constN, constV, cfuncs, traitMethN, traitMethT, pmN, pmM, variantN, variantTys, variantOwn, roleK, roleV, arcE)
  val names = list()
  val tys = list()
  if (pf.owner != "" && fd.recv != "") { names.push("this"); tys.push(pf.owner); bindLoc(lo, "this", pf.owner) }
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); val bt = stripMode(pp.ty); names.push(pp.name); tys.push(bt); bindLoc(lo, pp.name, tyTag(bt)); i = i + 1 }
  val bodyE = lowerExpr(lo, fd.body)
  return Func(mangleMethod(pf.owner, fd.name), names, tys, arcInjectBody(lo, bodyE, lo.arcOwned))
}

// The implicit prelude (List/Map runtime + nominal methods) is auto-included into every program.
// It is CONFIGURATION-driven: compiler/prelude.conf NAMES the standard-library modules to inject
// (like C/C++ default availability). The compiler is NOT coupled to lib/ — it has no hardcoded
// prelude; it only reads the config and the lib modules the config names. Each `kite::` line resolves
// through the SAME `::`->/ + kite/->lib/ mapping as a normal import.
// (Paths are cwd-relative for now; a real install would resolve them near the binary.)
// A conf line is a COMMENT (skipped) when its first non-space char is `#`, or it is blank. This check
// MUST run before impExtractPath: impExtractQuoted() would otherwise pull a path out of a double-quoted
// word inside a comment (e.g. `# ... a "sugar" package`) → a bogus path → readFile null → segfault.
fun confIsComment(line: String): Int {
  val n = line.len()
  var i = 0
  var go = 1
  while (go == 1) { if (i >= n) { go = 0 } else { if (line.charAt(i) == 32) { i = i + 1 } else { go = 0 } } }
  if (i >= n) { return 1 }
  if (line.charAt(i) == 35) { return 1 }
  return 0
}

fun preludeConfPaths(): List {
  val out = list()
  val src = readFile("compiler/prelude.conf")
  val n = src.len()
  var i = 0
  var line = ""
  while (i <= n) {
    var brk = 0
    if (i == n) { brk = 1 } else { if (src.charAt(i) == 10) { brk = 1 } }
    if (brk == 1) {
      if (confIsComment(line) == 0) {
        val p = impExtractPath("import " + line)
        if (p != "") { out.push(p) }
      }
      line = ""
    } else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  return out
}

// ---------- @lang collection: source the desugar role table from lib/ annotations ----------
// A prelude decl may carry `@lang("<role>")`; we record role -> the symbol the compiler EMITS for that
// decl, so the desugar sites (roleSym) resolve exactly the symbol they baked in before. Symbol rule:
// a free function emits its bare name; a class/struct method emits its owner-mangled name (List_push);
// a trait method emits its bare method name (the operand's type is mangled in at the use site). These
// three rules mirror how the rest of the lowerer names those callees, so the map equals the old table.
fun annoStr(e: FExpr): String { return when (e) { FEStr(t, r) -> t; else -> "" } }

fun recordLang(annos: List, sym: String, roleK: List, roleV: List): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "lang" && a.args.len() > 0) { roleK.push(annoStr(a.args.get(0))); roleV.push(sym) }
    i = i + 1
  }
  return 0
}

// scan a method list; symbol = owner-mangled (mangle==1, class/struct) or bare method name (mangle==0, trait).
fun recordLangMethods(methods: List, owner: String, mangle: Int, roleK: List, roleV: List): Int {
  var i = 0
  while (i < methods.len()) {
    val m: FFunc = methods.get(i)
    val sym = if (mangle == 1) { mangleMethod(owner, m.name) } else { m.name }
    recordLang(m.annos, sym, roleK, roleV)
    i = i + 1
  }
  return 0
}

// @arc(manual): does this decl's annotation list mark it as manually ARC-managed (exempt from auto-ARC)?
fun hasArcManual(annos: List): Bool {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "arc" && a.args.len() > 0) {
      val e0: FExpr = a.args.get(0)
      val m = when (e0) { FEIdent(s) -> s; else -> "" }
      if (m == "manual") { return true }
    }
    i = i + 1
  }
  return false
}

fun recordArc(annos: List, name: String, arcE: List): Int {
  if (hasArcManual(annos)) { arcE.push(name) }
  return 0
}

// Collect ONE top-level declaration at the cursor into the sig/type tables, returning 1 if it consumed
// a known decl or 0 if the token isn't a decl-start (caller stops). Shared by parseLower's main loop AND
// injectHelpers, so the prelude can carry ANY declaration (class/struct/enum/trait/impl/const), not just
// functions — this is what lets `class List` live in lib/ as a real stdlib type. roleK/roleV accumulate
// the @lang role table from every decl (only prelude decls carry @lang today; user code carries none).
fun collectDecl(p: P, annos: List, pfuns: List, fN: List, fR: List, structN: List, structF: List, structFT: List, classN: List, traitN: List, traitDecls: List, implTrait: List, implType: List, constN: List, constExprs: List, variantN: List, variantTag: List, variantTys: List, variantOwn: List, roleK: List, roleV: List, arcE: List, deriveT: List, deriveTr: List, monoN: List, monoP: List): Int {
  val k = pk(p)
  if (k == 10) { val fd = parseFunc(p, annos); pfuns.push(PFun("", fd)); fN.push(fd.name); fR.push(fd.ret); recordLang(fd.annos, fd.name, roleK, roleV); return 1 }
  if (k == 54) { val td0 = parseTypeDecl(p, annos, 0); collectStruct(td0, structN, structF, structFT); collectMethodSigs(td0, pfuns, fN, fR); recordLangMethods(td0.methods, td0.name, 1, roleK, roleV); recordArc(annos, td0.name, arcE); recordDerive(annos, td0.name, deriveT, deriveTr); recordMono(annos, td0.name, td0.gen, monoN, monoP); return 1 }
  if (k == 65) { val td1 = parseTypeDecl(p, annos, 1); collectStruct(td1, structN, structF, structFT); classN.push(td1.name); collectMethodSigs(td1, pfuns, fN, fR); collectDeinit(td1, pfuns, fN, fR); recordLangMethods(td1.methods, td1.name, 1, roleK, roleV); recordArc(annos, td1.name, arcE); recordDerive(annos, td1.name, deriveT, deriveTr); recordMono(annos, td1.name, td1.gen, monoN, monoP); return 1 }
  if (k == 55) { val ed = parseEnum(p, annos); collectEnum(ed, variantN, variantTag, variantTys, variantOwn); recordDerive(ed.annos, ed.name, deriveT, deriveTr); return 1 }
  if (k == 66) { val tr = parseTrait(p, annos); traitN.push(tr.name); traitDecls.push(tr); recordLangMethods(tr.methods, "", 0, roleK, roleV); return 1 }
  if (k == 67) { val im = parseImpl(p, annos); collectImplMethods(im, pfuns, fN, fR); if (im.traitName != "") { implTrait.push(im.traitName); implType.push(im.forTy) }; recordLangMethods(im.methods, im.forTy, 1, roleK, roleV); recordArc(annos, im.forTy, arcE); return 1 }
  if (k == 58) { parseImport(p); return 1 }
  if (k == 80) { val cd = parseConst(p); constN.push(cd.name); constExprs.push(cd.expr); return 1 }
  return 0
}

// parse the injected library helpers (prelude modules) into the sig/type tables. A module may declare
// types (e.g. `class List`) as well as functions; collectDecl handles every decl kind.
fun injectHelpers(pfuns: List, fN: List, fR: List, structN: List, structF: List, structFT: List, classN: List, traitN: List, traitDecls: List, implTrait: List, implType: List, constN: List, constExprs: List, variantN: List, variantTag: List, variantTys: List, variantOwn: List, roleK: List, roleV: List, arcE: List, deriveT: List, deriveTr: List, monoN: List, monoP: List): Int {
  val paths = preludeConfPaths()
  var pi = 0
  while (pi < paths.len()) {
    val hp = P(lex(readFile(paths.get(pi))), 0)
    var go = 1
    while (go == 1) {
      if (pk(hp) == 0) { go = 0 }
      else { val annos = parseAnnos(hp); if (collectDecl(hp, annos, pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, deriveT, deriveTr, monoN, monoP) == 0) { go = 0 } }
    }
    pi = pi + 1
  }
  return 0
}

struct LR(val funcs: List, val structN: List, val structF: List, val structFT: List, val variantN: List, val variantTag: List, val variantTys: List, val funN: List, val funRet: List, val arcE: List)

fun parseLower(toks: List): LR {
  val p = P(toks, 0)
  val pfuns = list()
  val structN = list(); val structF = list(); val structFT = list()
  val classN = list()
  val traitN = list(); val traitDecls = list(); val implTrait = list(); val implType = list()
  val constN = list(); val constExprs = list()
  val variantN = list(); val variantTag = list(); val variantTys = list(); val variantOwn = list()
  val fN = list(); val fR = list()
  val roleK = list(); val roleV = list()
  val arcE = list()
  val deriveT = list(); val deriveTr = list()
  val monoN = list(); val monoP = list()
  injectHelpers(pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, deriveT, deriveTr, monoN, monoP)
  // phase 1: parse, collect signatures, keep functions unlowered
  var go = 1
  while (go == 1) {
    if (pk(p) == 0) { go = 0 }
    else {
      val annos = parseAnnos(p)
      if (collectDecl(p, annos, pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, deriveT, deriveTr, monoN, monoP) == 0) { go = 0 }
    }
  }
  return finishLower(pfuns, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, fN, fR, roleK, roleV, arcE, deriveT, deriveTr, monoN, monoP)
}

// ---------- Phase 6: monomorphization — one specialized body per concrete `@mono` type instantiation ----------
// A `@mono class Vec<T>` is a TEMPLATE: the compiler emits nothing for the generic form. For each concrete
// turbofish construction `Vec::<U16>(..)` in the program the pass INSTANTIATES a specialized type `Vec$U16`
// (fields copied, every method copied with the type parameter substituted so sizeOf<T>()/__packedGet<T>
// fold to the concrete width and stride) and REWRITES the construction plus every `Vec<U16>` annotation onto
// that concrete name. This is @derive's structural-specialization move (STDLIB-REDESIGN §2b) generalized to
// value generics. The compiler's own sources carry no `@mono`, so the whole pass is inert (monoN empty ->
// every helper below is a no-op) and the self-host fixpoint is untouched.

fun hasMono(annos: List): Bool {
  var i = 0
  while (i < annos.len()) { val a: Anno = annos.get(i); if (a.name == "mono") { return true }; i = i + 1 }
  return false
}

// first type-parameter name of a generic clause: "<T>"/"T"/"<T: Show>"/"<K, V>" -> "T"/"K".
fun firstTparam(gen: String): String {
  val n = gen.len()
  var i = 0
  if (n > 0) { if (gen.charAt(0) == 60) { i = 1 } }
  var s = ""
  var go = 1
  while (go == 1) {
    if (i >= n) { go = 0 }
    else { val c = gen.charAt(i)
      if (c == 62 || c == 44 || c == 58 || c == 32) { go = 0 } else { s = s + gen.substr(i, 1); i = i + 1 } }
  }
  return s
}

fun recordMono(annos: List, name: String, gen: String, monoN: List, monoP: List): Int {
  if (hasMono(annos)) { monoN.push(name); monoP.push(firstTparam(gen)) }
  return 0
}

// symbol-safe suffix for a concrete type-arg string: "U16"->"U16", "K, V"->"K_V".
fun monoArgSuffix(ta: String): String {
  var s = ""
  var i = 0
  val n = ta.len()
  while (i < n) {
    val c = ta.charAt(i)
    if (c == 32) { i = i + 1 }
    else { if (c == 44) { s = s + "_"; i = i + 1 } else { s = s + ta.substr(i, 1); i = i + 1 } }
  }
  return s
}

fun monoMangleTag(nm: String, ta: String): String { return nm + ("$" + monoArgSuffix(ta)) }

// substitute the template parameter for the concrete arg in ONE type string, preserving a mode prefix.
fun monoSubTyParam(param: String, concrete: String, ty: String): String {
  val mode = paramMode(ty)
  val base = stripMode(ty)
  var nb = base
  if (base == param) { nb = concrete }
  if (mode == "") { return nb }
  return mode + (" " + nb)
}

// mangle a mono-type annotation `Vec<U16>` -> `Vec$U16` (mode-preserving); non-mono types unchanged.
fun monoMangleTy(monoN: List, ty: String): String {
  val mode = paramMode(ty)
  val base = stripMode(ty)
  val lt = base.len()
  var lt2 = lt
  var i = 0
  while (i < base.len()) { if (base.charAt(i) == 60) { lt2 = i; i = base.len() } else { i = i + 1 } }
  if (lt2 == lt) { return ty }
  val head = base.substr(0, lt2)
  if (memListL(monoN, head) == false) { return ty }
  var end = lt
  var j = base.len() - 1
  var found = 0
  while (j >= 0 && found == 0) { if (base.charAt(j) == 62) { end = j; found = 1 } else { j = j - 1 } }
  val inner = base.substr(lt2 + 1, end - lt2 - 1)
  val mg = monoMangleTag(head, inner)
  if (mode == "") { return mg }
  return mode + (" " + mg)
}

// is `callee` the turbofish construction of a `@mono` template? returns the template name or "".
fun monoCtorName(monoN: List, callee: FExpr): String {
  return when (callee) {
    FETypeApp(inner, ta) -> when (inner) { FEIdent(nm) -> if (memListL(monoN, nm)) { nm } else { "" }; else -> "" }
    else -> ""
  }
}
fun monoCtorArg(callee: FExpr): String { return when (callee) { FETypeApp(inner, ta) -> ta; else -> "" } }

// ---- instantiation collection: record each unique (template, type-arg) turbofish construction ----
fun monoAddInst(instN: List, instA: List, nm: String, ta: String): Int {
  var i = 0
  while (i < instN.len()) { if (instN.get(i) == nm) { if (instA.get(i) == ta) { return 0 } }; i = i + 1 }
  instN.push(nm); instA.push(ta)
  return 0
}
fun monoCollectArgs(monoN: List, args: List, instN: List, instA: List): Int {
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); monoCollectExpr(monoN, a.expr, instN, instA); i = i + 1 }
  return 0
}
fun monoCollectList(monoN: List, es: List, instN: List, instA: List): Int {
  var i = 0
  while (i < es.len()) { monoCollectExpr(monoN, es.get(i), instN, instA); i = i + 1 }
  return 0
}
fun monoCollectMap(monoN: List, ents: List, instN: List, instA: List): Int {
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); monoCollectExpr(monoN, en.k, instN, instA); monoCollectExpr(monoN, en.v, instN, instA); i = i + 1 }
  return 0
}
fun monoCollectParts(monoN: List, parts: List, instN: List, instA: List): Int {
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); when (pt) { FIExpr(e) -> monoCollectExpr(monoN, e, instN, instA); else -> 0 }; i = i + 1 }
  return 0
}
fun monoCollectArms(monoN: List, arms: List, instN: List, instA: List): Int {
  var i = 0
  while (i < arms.len()) { val a: FArm = arms.get(i); if (a.kind == 0) { monoCollectExpr(monoN, a.lhs, instN, instA) }; if (isNoResF(a.guard) == false) { monoCollectExpr(monoN, a.guard, instN, instA) }; monoCollectExpr(monoN, a.body, instN, instA); i = i + 1 }
  return 0
}
fun monoCollectStmts(monoN: List, stmts: List, instN: List, instA: List): Int {
  var i = 0
  while (i < stmts.len()) {
    val s: FStmt = stmts.get(i)
    when (s) {
      FSLet(iv, nm, ty, init) -> monoCollectExpr(monoN, init, instN, instA)
      FSExprS(e) -> monoCollectExpr(monoN, e, instN, instA)
      FSAssign(l, r) -> { monoCollectExpr(monoN, l, instN, instA); monoCollectExpr(monoN, r, instN, instA) }
      FSReturnV(e) -> monoCollectExpr(monoN, e, instN, instA)
      FSWhile(c, bd) -> { monoCollectExpr(monoN, c, instN, instA); monoCollectExpr(monoN, bd, instN, instA) }
      FSFor(v, it, bd) -> { monoCollectExpr(monoN, it, instN, instA); monoCollectExpr(monoN, bd, instN, instA) }
      else -> 0
    }
    i = i + 1
  }
  return 0
}
fun monoCollectExpr(monoN: List, e: FExpr, instN: List, instA: List): Int {
  when (e) {
    FEUnary(op, x) -> monoCollectExpr(monoN, x, instN, instA)
    FEBin(op, a, b) -> { monoCollectExpr(monoN, a, instN, instA); monoCollectExpr(monoN, b, instN, instA) }
    FEField(a, f) -> monoCollectExpr(monoN, a, instN, instA)
    FESafeField(a, f) -> monoCollectExpr(monoN, a, instN, instA)
    FEStatic(a, f) -> monoCollectExpr(monoN, a, instN, instA)
    FETypeApp(a, t) -> monoCollectExpr(monoN, a, instN, instA)
    FENotNull(a) -> monoCollectExpr(monoN, a, instN, instA)
    FEElvis(a, b) -> { monoCollectExpr(monoN, a, instN, instA); monoCollectExpr(monoN, b, instN, instA) }
    FEIndex(a, b) -> { monoCollectExpr(monoN, a, instN, instA); monoCollectExpr(monoN, b, instN, instA) }
    FECast(a, ty) -> monoCollectExpr(monoN, a, instN, instA)
    FECall(callee, args) -> {
      val cn = monoCtorName(monoN, callee)
      if (cn != "") { monoAddInst(instN, instA, cn, monoCtorArg(callee)) }
      monoCollectExpr(monoN, callee, instN, instA); monoCollectArgs(monoN, args, instN, instA)
    }
    FEList(es) -> monoCollectList(monoN, es, instN, instA)
    FEMap(ents) -> monoCollectMap(monoN, ents, instN, instA)
    FELambda(params, body) -> monoCollectExpr(monoN, body, instN, instA)
    FEInterp(parts, r) -> monoCollectParts(monoN, parts, instN, instA)
    FEBlock(stmts, res) -> { monoCollectStmts(monoN, stmts, instN, instA); monoCollectExpr(monoN, res, instN, instA) }
    FEIf(c, t, el) -> { monoCollectExpr(monoN, c, instN, instA); monoCollectExpr(monoN, t, instN, instA); monoCollectExpr(monoN, el, instN, instA) }
    FEWhen(hs, bind, subj, arms) -> { monoCollectExpr(monoN, subj, instN, instA); monoCollectArms(monoN, arms, instN, instA) }
    FERet(x) -> monoCollectExpr(monoN, x, instN, instA)
    else -> 0
  }
  return 0
}

// ---- body rewrite: substitute the type parameter (param!="") and retarget mono constructions ----
fun monoFixArgs(monoN: List, param: String, concrete: String, args: List): List {
  val out = list()
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); out.push(FArg(a.name, monoFixExpr(monoN, param, concrete, a.expr))); i = i + 1 }
  return out
}
fun monoFixList(monoN: List, param: String, concrete: String, es: List): List {
  val out = list()
  var i = 0
  while (i < es.len()) { out.push(monoFixExpr(monoN, param, concrete, es.get(i))); i = i + 1 }
  return out
}
fun monoFixMap(monoN: List, param: String, concrete: String, ents: List): List {
  val out = list()
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); out.push(FMapEnt(monoFixExpr(monoN, param, concrete, en.k), monoFixExpr(monoN, param, concrete, en.v))); i = i + 1 }
  return out
}
fun monoFixParts(monoN: List, param: String, concrete: String, parts: List): List {
  val out = list()
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); val np = when (pt) { FIExpr(e) -> FIExpr(monoFixExpr(monoN, param, concrete, e)); else -> pt }; out.push(np); i = i + 1 }
  return out
}
fun monoFixArms(monoN: List, param: String, concrete: String, arms: List): List {
  val out = list()
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    val nlhs = if (a.kind == 0) { monoFixExpr(monoN, param, concrete, a.lhs) } else { a.lhs }
    val ng = if (isNoResF(a.guard)) { a.guard } else { monoFixExpr(monoN, param, concrete, a.guard) }
    out.push(FArm(a.kind, nlhs, a.pats, ng, monoFixExpr(monoN, param, concrete, a.body)))
    i = i + 1
  }
  return out
}
fun monoFixStmts(monoN: List, param: String, concrete: String, stmts: List): List {
  val out = list()
  var i = 0
  while (i < stmts.len()) {
    val s: FStmt = stmts.get(i)
    val ns = when (s) {
      FSLet(iv, nm, ty, init) -> FSLet(iv, nm, monoMangleTy(monoN, monoSubTyParam(param, concrete, ty)), monoFixExpr(monoN, param, concrete, init))
      FSExprS(e) -> FSExprS(monoFixExpr(monoN, param, concrete, e))
      FSAssign(l, r) -> FSAssign(monoFixExpr(monoN, param, concrete, l), monoFixExpr(monoN, param, concrete, r))
      FSReturnV(e) -> FSReturnV(monoFixExpr(monoN, param, concrete, e))
      FSWhile(c, bd) -> FSWhile(monoFixExpr(monoN, param, concrete, c), monoFixExpr(monoN, param, concrete, bd))
      FSFor(v, it, bd) -> FSFor(v, monoFixExpr(monoN, param, concrete, it), monoFixExpr(monoN, param, concrete, bd))
      else -> s
    }
    out.push(ns)
    i = i + 1
  }
  return out
}
// substitute the parameter inside a turbofish type-arg string (only when a template is being specialized).
fun monoFixTa(param: String, concrete: String, ta: String): String {
  if (param == "") { return ta }
  if (ta == param) { return concrete }
  return ta
}
fun monoFixExpr(monoN: List, param: String, concrete: String, e: FExpr): FExpr {
  return when (e) {
    FEUnary(op, x) -> FEUnary(op, monoFixExpr(monoN, param, concrete, x))
    FEBin(op, a, b) -> FEBin(op, monoFixExpr(monoN, param, concrete, a), monoFixExpr(monoN, param, concrete, b))
    FEField(a, f) -> FEField(monoFixExpr(monoN, param, concrete, a), f)
    FESafeField(a, f) -> FESafeField(monoFixExpr(monoN, param, concrete, a), f)
    FEStatic(a, f) -> FEStatic(monoFixExpr(monoN, param, concrete, a), f)
    FENotNull(a) -> FENotNull(monoFixExpr(monoN, param, concrete, a))
    FEElvis(a, b) -> FEElvis(monoFixExpr(monoN, param, concrete, a), monoFixExpr(monoN, param, concrete, b))
    FEIndex(a, b) -> FEIndex(monoFixExpr(monoN, param, concrete, a), monoFixExpr(monoN, param, concrete, b))
    FECast(a, ty) -> FECast(monoFixExpr(monoN, param, concrete, a), monoMangleTy(monoN, monoSubTyParam(param, concrete, ty)))
    FETypeApp(a, t) -> FETypeApp(monoFixExpr(monoN, param, concrete, a), monoFixTa(param, concrete, t))
    FECall(callee, args) -> {
      val cn = monoCtorName(monoN, callee)
      if (cn != "") { FECall(FEIdent(monoMangleTag(cn, monoFixTa(param, concrete, monoCtorArg(callee)))), monoFixArgs(monoN, param, concrete, args)) }
      else { FECall(monoFixExpr(monoN, param, concrete, callee), monoFixArgs(monoN, param, concrete, args)) }
    }
    FEList(es) -> FEList(monoFixList(monoN, param, concrete, es))
    FEMap(ents) -> FEMap(monoFixMap(monoN, param, concrete, ents))
    FELambda(params, body) -> FELambda(params, monoFixExpr(monoN, param, concrete, body))
    FEInterp(parts, r) -> FEInterp(monoFixParts(monoN, param, concrete, parts), r)
    FEBlock(stmts, res) -> FEBlock(monoFixStmts(monoN, param, concrete, stmts), monoFixExpr(monoN, param, concrete, res))
    FEIf(c, t, el) -> FEIf(monoFixExpr(monoN, param, concrete, c), monoFixExpr(monoN, param, concrete, t), monoFixExpr(monoN, param, concrete, el))
    FEWhen(hs, bind, subj, arms) -> FEWhen(hs, bind, monoFixExpr(monoN, param, concrete, subj), monoFixArms(monoN, param, concrete, arms))
    FERet(x) -> FERet(monoFixExpr(monoN, param, concrete, x))
    else -> e
  }
}

// specialize the template's params/return/body for one concrete arg, producing the `Vec$U16`-owned method.
fun monoSpecMethod(monoN: List, param: String, concrete: String, m: FFunc): FFunc {
  val nps = list()
  var i = 0
  while (i < m.params.len()) { val pp: FParam = m.params.get(i); nps.push(FParam(pp.name, monoMangleTy(monoN, monoSubTyParam(param, concrete, pp.ty)))); i = i + 1 }
  val nret = monoMangleTy(monoN, monoSubTyParam(param, concrete, m.ret))
  return FFunc(m.annos, m.name, "", m.recv, nps, nret, m.whr, monoFixExpr(monoN, param, concrete, m.body))
}

// instantiate every collected (template, type-arg): register the specialized struct + its methods.
fun monoInstantiate(monoN: List, monoP: List, pfuns: List, structN: List, structF: List, structFT: List, classN: List, fN: List, fR: List, arcE: List): Int {
  val instN = list(); val instA = list()
  var pi = 0
  while (pi < pfuns.len()) { val pf: PFun = pfuns.get(pi); monoCollectExpr(monoN, pf.fd.body, instN, instA); pi = pi + 1 }
  var ii = 0
  while (ii < instN.len()) {
    val nm: String = instN.get(ii)
    val ta: String = instA.get(ii)
    val mangled = monoMangleTag(nm, ta)
    if (memListL(structN, mangled) == false) {
      val ti = indexOfL(monoN, nm)
      val param = monoP.get(ti)
      val si = indexOfL(structN, nm)
      // specialized struct: field names copied; field types param-substituted (Vec's are plain Int).
      val flds: List = structF.get(si)
      val ftys: List = structFT.get(si)
      val nfl = list(); val nft = list()
      var fi = 0
      while (fi < flds.len()) { nfl.push(flds.get(fi)); nft.push(monoSubTyParam(param, ta, ftys.get(fi))); fi = fi + 1 }
      structN.push(mangled); structF.push(nfl); structFT.push(nft)
      if (memListL(classN, nm)) { classN.push(mangled) }
      if (memListL(arcE, nm)) { arcE.push(mangled) }
      // specialized methods: one concrete body per template method.
      var mi = 0
      while (mi < pfuns.len()) {
        val pf: PFun = pfuns.get(mi)
        if (pf.owner == nm) {
          val sm = monoSpecMethod(monoN, param, ta, pf.fd)
          pfuns.push(PFun(mangled, sm)); fN.push(mangleMethod(mangled, sm.name)); fR.push(sm.ret)
        }
        mi = mi + 1
      }
    }
    ii = ii + 1
  }
  return 0
}

// rewrite every NON-template function: retarget mono constructions to the specialized names and mangle
// mono-type annotations in params/return/local types. Template-owned methods are dropped later (never
// lowered), so they are skipped here. `fR` is the RETURN-TYPE table method dispatch / type-inference reads
// for an inferred-type binding (`val w = make()` looks up `make` in fN/fR to type `w`); it is parallel to
// `pfuns` and MUST be re-mangled in lockstep with the PFun's own `fd.ret`, else `w.get(0)` would infer the
// un-specialized head `Vec` and dispatch to the DROPPED template method `Vec_get` — a silent load-time
// miscompile (undefined symbol, dyld abort).
fun monoRewriteAll(monoN: List, pfuns: List, fR: List): Int {
  var i = 0
  while (i < pfuns.len()) {
    val pf: PFun = pfuns.get(i)
    if (memListL(monoN, pf.owner) == false) {
      val fd = pf.fd
      val nps = list()
      var j = 0
      while (j < fd.params.len()) { val pp: FParam = fd.params.get(j); nps.push(FParam(pp.name, monoMangleTy(monoN, pp.ty))); j = j + 1 }
      val nret = monoMangleTy(monoN, fd.ret)
      val nfd = FFunc(fd.annos, fd.name, fd.gen, fd.recv, nps, nret, fd.whr, monoFixExpr(monoN, "", "", fd.body))
      pfuns.set(i, PFun(pf.owner, nfd))
      if (i < fR.len()) { fR.set(i, monoMangleTy(monoN, fR.get(i))) }
    }
    i = i + 1
  }
  return 0
}

// mangle every mono-type annotation that appears as a STRUCT/CLASS FIELD type. Without this a `@mono`
// type used as a field-type annotation (`struct Box(v: Vec<Int>)`) keeps the un-specialized template
// name, so `box.v`'s static type resolves method dispatch to the DROPPED template method (never lowered)
// and the call jumps to a bad address — a silent miscompile (rc=0, segfault). Covers every collected
// struct/class, both @mono-instantiated (`Vec$U16`, whose Int fields are unaffected) and plain.
fun monoRewriteFields(monoN: List, structN: List, structFT: List): Int {
  var si = 0
  while (si < structN.len()) {
    val ftys: List = structFT.get(si)
    var fi = 0
    while (fi < ftys.len()) { ftys.set(fi, monoMangleTy(monoN, ftys.get(fi))); fi = fi + 1 }
    si = si + 1
  }
  return 0
}

// the head type name of an annotation `Vec<U16>` -> `Vec` (mode-stripped, before the first `<`); a bare
// type is returned unchanged. Used by the residual assertion to spot an un-mangled `@mono` template name.
fun monoTyHead(ty: String): String {
  val base = stripMode(ty)
  var i = 0
  while (i < base.len()) { if (base.charAt(i) == 60) { return base.substr(0, i) } else { i = i + 1 } }
  return base
}

// HARD-ABORT if any un-monomorphized `@mono` template name survives into a lowered type position (a field
// type, or a non-template function's param/return type). Mirrors the Phase-0.5/Phase-4 discipline: a
// residual template name would otherwise dispatch to a dropped method body and silently miscompile, so we
// exit 134 with a diagnostic and emit no binary instead.
fun monoAssertNoResidual(monoN: List, structN: List, structFT: List, pfuns: List): Int {
  var si = 0
  while (si < structN.len()) {
    if (memListL(monoN, structN.get(si)) == false) {
      val ftys: List = structFT.get(si)
      var fi = 0
      while (fi < ftys.len()) {
        if (memListL(monoN, monoTyHead(ftys.get(fi)))) { lowFail("un-monomorphized @mono type " + (ftys.get(fi) + (" in field of " + structN.get(si)))) }
        fi = fi + 1
      }
    }
    si = si + 1
  }
  var pi = 0
  while (pi < pfuns.len()) {
    val pf: PFun = pfuns.get(pi)
    if (memListL(monoN, pf.owner) == false) {
      val fd = pf.fd
      if (memListL(monoN, monoTyHead(fd.ret))) { lowFail("un-monomorphized @mono type " + (fd.ret + (" in return of " + fd.name))) }
      var j = 0
      while (j < fd.params.len()) { val pp: FParam = fd.params.get(j); if (memListL(monoN, monoTyHead(pp.ty))) { lowFail("un-monomorphized @mono type " + (pp.ty + (" in param of " + fd.name))) }; j = j + 1 }
    }
    pi = pi + 1
  }
  return 0
}

fun runMono(monoN: List, monoP: List, pfuns: List, structN: List, structF: List, structFT: List, classN: List, fN: List, fR: List, arcE: List): Int {
  if (monoN.len() == 0) { return 0 }
  monoInstantiate(monoN, monoP, pfuns, structN, structF, structFT, classN, fN, fR, arcE)
  monoRewriteAll(monoN, pfuns, fR)
  monoRewriteFields(monoN, structN, structFT)
  monoAssertNoResidual(monoN, structN, structFT, pfuns)
  return 0
}

// phase 2 (shared by parseLower and parseLowerModules): synthesize trait defaults, evaluate consts,
// register trait-method + dispatcher names, then lower every collected function.
fun finishLower(pfuns: List, structN: List, structF: List, structFT: List, classN: List, traitN: List, traitDecls: List, implTrait: List, implType: List, constN: List, constExprs: List, variantN: List, variantTag: List, variantTys: List, variantOwn: List, fN: List, fR: List, roleK: List, roleV: List, arcE: List, deriveT: List, deriveTr: List, monoN: List, monoP: List): LR {
  val constV = list()
  // Monomorphization keystone (Phase 6): instantiate every concrete `@mono` template use into a specialized
  // struct + methods and retarget the program onto them, BEFORE derive/dispatch/phase-2 so the concrete
  // instantiations are ordinary types downstream. No-op when nothing is `@mono` (the compiler's own build).
  runMono(monoN, monoP, pfuns, structN, structF, structFT, classN, fN, fR, arcE)
  // @derive pass (Phase 4): synthesize the requested structural impls BEFORE trait-default synthesis and
  // dispatchers, so a derived method is a hand-impl for every downstream stage (dedup guards against a
  // hand impl of the same method). No-op when nothing was @derived (the compiler's own build).
  runDerives(deriveT, deriveTr, pfuns, fN, fR, structN, structF, structFT, variantN, variantTys, variantOwn, implTrait, implType)
  // trait DEFAULT methods: for each `impl Trait for Type` that doesn't override a trait method carrying a
  // body, synthesize `<Type>_<method>` from that default body (bound to `this: Type`). Must run after all
  // impls are collected (so the override check is accurate) and before dispatchers/phase-2.
  var sdi = 0
  while (sdi < implTrait.len()) {
    val stn: String = implTrait.get(sdi)
    val sty: String = implType.get(sdi)
    val tdix = findTraitDeclIdx(traitDecls, stn)
    if (tdix >= 0) {
      val str: FTraitDecl = traitDecls.get(tdix)
      var smi = 0
      while (smi < str.methods.len()) {
        val sm: FFunc = str.methods.get(smi)
        if (isNoResF(sm.body) == false) {
          val smn = mangleMethod(sty, sm.name)
          if (memListL(fN, smn) == false) { pfuns.push(PFun(sty, sm)); fN.push(smn); fR.push(sm.ret) }
        }
        smi = smi + 1
      }
    }
    sdi = sdi + 1
  }
  // build the compile-time function table (free functions), then evaluate consts in order (a const may
  // reference earlier consts and any function) so `const N = fib(10)` and `comptime(...)` can run them.
  val cfuncs = list()
  var cfi = 0
  while (cfi < pfuns.len()) { val pf: PFun = pfuns.get(cfi); if (pf.owner == "") { cfuncs.push(pf.fd) }; cfi = cfi + 1 }
  val ceEnvN = list(); val ceEnvV = list(); val ceEnvK = list()
  var cei = 0
  while (cei < constExprs.len()) {
    val ce = constExprs.get(cei)
    val cv = ceEval(ceEnvN, ceEnvV, ceEnvK, cfuncs, ce)
    val ck = ceKindOf(ceEnvN, ceEnvK, cfuncs, ce)
    ceEnvN.push(constN.get(cei)); ceEnvV.push(cv); ceEnvK.push(ck); constV.push(cv.toStr())
    cei = cei + 1
  }
  // trait-method registry (method name -> owning trait) so an erased receiver's method call can dynamic-dispatch
  val traitMethN = list(); val traitMethT = list()
  var tmi = 0
  while (tmi < traitDecls.len()) {
    val tr: FTraitDecl = traitDecls.get(tmi)
    var tmj = 0
    while (tmj < tr.methods.len()) { val tm: FFunc = tr.methods.get(tmj); traitMethN.push(tm.name); traitMethT.push(tr.name); tmj = tmj + 1 }
    tmi = tmi + 1
  }
  // trait dispatchers: generated + name-registered BEFORE phase 2 so trait-typed method calls resolve
  val dispatchers = genDispatchers(traitDecls, implTrait, implType, structN, fN, fR)
  // ownership-mode table for TOP-LEVEL free functions (owner==""): name -> per-param mode list. Used by
  // lowerPlainCall to decide whether a class temp passed as an arg is BORROWED (release after) or
  // TRANSFERRED (consuming — callee owns it). Built once here; empty for the class-free compiler.
  val pmN = list(); val pmM = list()
  var pmi = 0
  while (pmi < pfuns.len()) {
    val pf0: PFun = pfuns.get(pmi)
    if (pf0.owner == "") {
      pmN.push(pf0.fd.name)
      val modes = list()
      var ppi = 0
      while (ppi < pf0.fd.params.len()) { val pp0: FParam = pf0.fd.params.get(ppi); modes.push(paramMode(pp0.ty)); ppi = ppi + 1 }
      pmM.push(modes)
    }
    pmi = pmi + 1
  }
  // phase 2: lower every function now that all signatures are known; lambdas lift into `lifted`
  val funcs = list()
  val lifted = list()
  val gctr = list(); gctr.push(0)
  var i = 0
  while (i < pfuns.len()) { val pf: PFun = pfuns.get(i); if (memListL(monoN, pf.owner)) { i = i + 1 } else { funcs.push(lowerFuncFull(pf, fN, fR, structN, structF, structFT, lifted, gctr, classN, traitN, constN, constV, cfuncs, traitMethN, traitMethT, pmN, pmM, variantN, variantTys, variantOwn, roleK, roleV, arcE)); i = i + 1 } }
  var j = 0
  while (j < lifted.len()) { funcs.push(lifted.get(j)); j = j + 1 }
  var d = 0
  while (d < dispatchers.len()) { funcs.push(dispatchers.get(d)); d = d + 1 }
  return LR(funcs, structN, structF, structFT, variantN, variantTag, variantTys, fN, fR, arcE)
}

// ---------- module system: `import "path"` resolved by inlining files, with transitive dedup ----------
// A line whose first non-space token is `import` (followed by a space or quote) is an import; its
// quoted path is read, its own imports resolved, and its content inlined in place of the line. A
// shared `seen` list dedups so a module included via several paths is emitted once. Import-free
// source is reconstructed byte-for-byte (so the compiler, which uses no imports, self-hosts unchanged).
fun impExtractQuoted(line: String): String {
  var i = 0
  val n = line.len()
  while (i < n && line.charAt(i) != 34) { i = i + 1 }
  if (i >= n) { return "" }
  i = i + 1
  var s = ""
  while (i < n && line.charAt(i) != 34) { s = s + line.substr(i, 1); i = i + 1 }
  return s
}

// skip leading spaces + an optional `pub ` prefix; returns the index where `import` should start.
fun impKwStart(line: String): Int {
  var i = 0
  val n = line.len()
  while (i < n && line.charAt(i) == 32) { i = i + 1 }
  if (i + 4 <= n) { if (line.substr(i, 4) == "pub ") { i = i + 4; while (i < n && line.charAt(i) == 32) { i = i + 1 } } }
  return i
}

fun impIsImport(line: String): Bool {
  val i = impKwStart(line)
  val n = line.len()
  if (i + 6 > n) { return false }
  if (line.substr(i, 6) != "import") { return false }
  val c = line.charAt(i + 6)
  return c == 32 || c == 34
}

fun impIdentChar(c: Int): Bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 }

// Resolve an import line to the FILE PATH it names, from EITHER form:
//   import "kite/core.kite"   -> "kite/core.kite"   (quoted = literal relative path, the escape hatch)
//   import kite::core         -> "kite/core.kite"   (namespace path: `::` -> `/`, append `.kite`)
// The module NAME downstream is modName(path) = last '/'-segment (so `import kite::core` -> module `core`).
fun impExtractPath(line: String): String {
  val q = impExtractQuoted(line)
  if (q != "") { return q }
  val n = line.len()
  var i = impKwStart(line) + 6 // skip [pub] 'import' (impIsImport matched it)
  while (i < n && line.charAt(i) == 32) { i = i + 1 } // spaces after 'import'
  var path = ""
  var go = 1
  while (i < n && go == 1) {
    val c = line.charAt(i)
    if (c == 58) { path = path + "/"; i = i + 1; if (i < n && line.charAt(i) == 58) { i = i + 1 } }
    else { if (impIdentChar(c)) { path = path + line.substr(i, 1); i = i + 1 } else { go = 0 } }
  }
  if (path == "") { return "" }
  // the `kite` root package maps to the lib/ directory (lib/ IS the kite standard library)
  if (path.len() >= 5) { if (path.substr(0, 5) == "kite/") { path = "lib/" + path.substr(5, path.len() - 5) } }
  return path + ".kite"
}

// Inline a QUOTED include flat; PRESERVE a namespace (`import kite::a::b`) import line so the module
// system can still see it downstream. This is what lets the two import kinds be MIXED in one file:
// quoted includes get flattened here, and any remaining namespace imports route the result to the
// module path. (Previously a namespace line was dropped, forcing an all-or-nothing choice.)
fun impProcLine(line: String, seen: List): String {
  if (impIsImport(line) == false) { return line }
  val q = impExtractQuoted(line)
  if (q == "") { return line } // namespace import -> keep the line for collectModules
  if (memListL(seen, q)) { return "" } // quoted include already inlined -> drop
  seen.push(q)
  return resolveImports(readFile(q), seen)
}

fun resolveImports(src: String, seen: List): String {
  var result = ""
  var line = ""
  var i = 0
  val n = src.len()
  while (i < n) {
    val c = src.charAt(i)
    if (c == 10) { result = result + (impProcLine(line, seen) + "\n"); line = "" }
    else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  return result + impProcLine(line, seen)
}

// ================= S1: real module system (namespaced imports) =================
// FIXPOINT-SAFE BY CONSTRUCTION: the compiler's own source contains no `import "..."`, so main()
// takes the else fast-path (today's exact resolveImports->parseLower) and NONE of the code below
// ever runs while compiling the compiler. Only inputs with a string-path import engage this path.
//
// Semantics: `import "std/x.kite"` names the file module "x" (last path segment sans .kite). Each
// module's top-level FREE FUNCTIONS are mangled `x__name` so two modules may share a name. Inside a
// module, an unqualified reference resolves to that module's own item first, else to a `use`/import
// alias, else global. `mod::name` resolves to the module-mangled item. `use mod::name` aliases bare
// `name` in the importing scope. The ROOT module additionally auto-imports every imported module's
// bare names (so plain `import` + unqualified use keeps working). v1 scope: only free functions are
// namespaced; types/enums/traits/impls/consts stay global (documented limitation).
struct Mod(val name: String, val src: String)

struct RawMod(val name: String, val funcs: List, val tdecls: List, val edecls: List, val traits: List, val impls: List, val consts: List, val uses: List, val L: List, val imps: List, val impPub: List)

struct Ren(val m: String, val L: List, val MODS: List, val aN: List, val aT: List)

fun mangleMod(m: String, n: String): String {
  if (m == "") { return n }
  return m + ("__" + n)
}

// last '/'-segment of a path, minus a trailing ".kite"
fun modName(path: String): String {
  val n = path.len()
  var slash = 0 - 1
  var i = 0
  while (i < n) { if (path.charAt(i) == 47) { slash = i }; i = i + 1 }
  val start = slash + 1
  var base = path.substr(start, n - start)
  val bl = base.len()
  if (bl >= 5) { if (base.substr(bl - 5, 5) == ".kite") { base = base.substr(0, bl - 5) } }
  return base
}

// A NAMESPACE import (`import kite::a::b`) engages the real module system (mangling + visibility).
// A QUOTED import (`import "x.kite"`) is a FLAT TEXTUAL INCLUDE done by resolveImports (no mangling) —
// that is how the compiler assembles ITSELF (dogfooding its own import) without renaming its own
// cross-file calls. isNsImport tells them apart; hasNamespaceImport routes the input in lowerInput.
fun isNsImport(line: String): Bool {
  if (impIsImport(line) == false) { return false }
  if (impExtractQuoted(line) != "") { return false } // quoted → flat include, not a module
  if (impExtractPath(line) != "") { return true } // a resolvable kite:: path
  return false
}

// true iff some line is a namespace import (nested ifs keep out-of-bounds guarded — `&&` is bitwise).
fun hasNamespaceImport(src: String): Bool {
  var line = ""
  var i = 0
  val n = src.len()
  while (i < n) {
    val c = src.charAt(i)
    if (c == 10) { if (isNsImport(line)) { return true }; line = "" }
    else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  if (isNsImport(line)) { return true }
  return false
}

// gather the transitive set of imported files as modules (deps before dependents, path-deduped),
// then append the root as module "" (its raw source, unmodified).
fun collectModLine(line: String, seen: List, mods: List): Int {
  if (impIsImport(line) == false) { return 0 }
  val path = impExtractPath(line)
  if (path == "") { return 0 }
  if (memListL(seen, path)) { return 0 }
  seen.push(path)
  val f = readFile(path)
  collectModImports(f, seen, mods)
  mods.push(Mod(modName(path), f))
  return 0
}

fun collectModImports(src: String, seen: List, mods: List): Int {
  var line = ""
  var i = 0
  val n = src.len()
  while (i < n) {
    val c = src.charAt(i)
    if (c == 10) { collectModLine(line, seen, mods); line = "" }
    else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  collectModLine(line, seen, mods)
  return 0
}

fun collectModules(rawInput: String): List {
  val mods = list()
  val seen = list()
  // Prelude modules (compiler/prelude.conf) are auto-injected ONCE via injectHelpers; seed `seen` with
  // their paths so a module that is BOTH prelude-injected AND explicitly (pub-)imported is not collected
  // (and thus lowered) a second time. E.g. `import kite::alloc::collections` pub-imports list & map, which
  // are already prelude modules — dedup by path keeps List/Map defined exactly once (no double definition).
  val pre = preludeConfPaths()
  var pi = 0
  while (pi < pre.len()) { seen.push(pre.get(pi)); pi = pi + 1 }
  collectModImports(rawInput, seen, mods)
  mods.push(Mod("", rawInput))
  return mods
}

// ---- scope-aware reference rename (mirrors fvExpr binder tracking exactly) ----
fun renResolve(rc: Ren, bound: List, nm: String): String {
  if (memListL(bound, nm)) { return nm }
  if (memListL(rc.L, nm)) { return mangleMod(rc.m, nm) }
  val i = indexOfL(rc.aN, nm)
  if (i >= 0) { return rc.aT.get(i) }
  return nm
}

fun renStatic(rc: Ren, bound: List, a: FExpr, nm: String): FExpr {
  return when (a) {
    FEIdent(md) -> if (memListL(rc.MODS, md)) { FEIdent(mangleMod(md, nm)) } else { FEStatic(renExpr(rc, bound, a), nm) }
    else -> FEStatic(renExpr(rc, bound, a), nm)
  }
}

fun renArgs(rc: Ren, bound: List, args: List): List {
  val out = list()
  var i = 0
  while (i < args.len()) { val ar: FArg = args.get(i); out.push(FArg(ar.name, renExpr(rc, bound, ar.expr))); i = i + 1 }
  return out
}

fun renExprList(rc: Ren, bound: List, es: List): List {
  val out = list()
  var i = 0
  while (i < es.len()) { out.push(renExpr(rc, bound, es.get(i))); i = i + 1 }
  return out
}

fun renMap(rc: Ren, bound: List, ents: List): List {
  val out = list()
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); out.push(FMapEnt(renExpr(rc, bound, en.k), renExpr(rc, bound, en.v))); i = i + 1 }
  return out
}

fun renParts(rc: Ren, bound: List, parts: List): List {
  val out = list()
  var i = 0
  while (i < parts.len()) {
    val pt: FIPart = parts.get(i)
    val np = when (pt) { FIExpr(e) -> FIExpr(renExpr(rc, bound, e)); else -> pt }
    out.push(np)
    i = i + 1
  }
  return out
}

fun renArms(rc: Ren, bound: List, arms: List): List {
  val out = list()
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    var b = bound
    if (a.kind == 2) { var j = 0; while (j < a.pats.len()) { b = extendB(b, patVars(a.pats.get(j))); j = j + 1 } }
    val nlhs = if (a.kind == 0) { renExpr(rc, b, a.lhs) } else { a.lhs }
    val nguard = if (isNoResF(a.guard)) { a.guard } else { renExpr(rc, b, a.guard) }
    out.push(FArm(a.kind, nlhs, a.pats, nguard, renExpr(rc, b, a.body)))
    i = i + 1
  }
  return out
}

fun renStmtInto(rc: Ren, bound: List, s: FStmt, out: List): List {
  return when (s) {
    FSLet(isVar, nm, ty, init) -> { out.push(FSLet(isVar, nm, ty, renExpr(rc, bound, init))); extendB(bound, one(nm)) }
    FSExprS(e) -> { out.push(FSExprS(renExpr(rc, bound, e))); bound }
    FSAssign(l, r) -> { out.push(FSAssign(renExpr(rc, bound, l), renExpr(rc, bound, r))); bound }
    FSReturnV(e) -> { out.push(FSReturnV(renExpr(rc, bound, e))); bound }
    FSReturnU -> { out.push(FSReturnU); bound }
    FSWhile(c, bd) -> { out.push(FSWhile(renExpr(rc, bound, c), renExpr(rc, bound, bd))); bound }
    FSFor(v, it, bd) -> { out.push(FSFor(v, renExpr(rc, bound, it), renExpr(rc, extendB(bound, one(v)), bd))); bound }
    else -> { out.push(s); bound }
  }
}

fun renBlock(rc: Ren, bound: List, stmts: List, res: FExpr): FExpr {
  val out = list()
  var b = bound
  var i = 0
  while (i < stmts.len()) { b = renStmtInto(rc, b, stmts.get(i), out); i = i + 1 }
  return FEBlock(out, renExpr(rc, b, res))
}

fun renExpr(rc: Ren, bound: List, e: FExpr): FExpr {
  return when (e) {
    FEIdent(nm) -> FEIdent(renResolve(rc, bound, nm))
    FEUnary(op, x) -> FEUnary(op, renExpr(rc, bound, x))
    FEBin(op, a, b) -> FEBin(op, renExpr(rc, bound, a), renExpr(rc, bound, b))
    FEField(a, f) -> FEField(renExpr(rc, bound, a), f)
    FESafeField(a, f) -> FESafeField(renExpr(rc, bound, a), f)
    FEStatic(a, nm) -> renStatic(rc, bound, a, nm)
    FECall(callee, args) -> FECall(renExpr(rc, bound, callee), renArgs(rc, bound, args))
    FENotNull(a) -> FENotNull(renExpr(rc, bound, a))
    FEElvis(a, b) -> FEElvis(renExpr(rc, bound, a), renExpr(rc, bound, b))
    FEIndex(a, b) -> FEIndex(renExpr(rc, bound, a), renExpr(rc, bound, b))
    FETypeApp(a, t) -> FETypeApp(renExpr(rc, bound, a), t)
    FECast(a, ty) -> FECast(renExpr(rc, bound, a), ty)
    FEList(es) -> FEList(renExprList(rc, bound, es))
    FEMap(ents) -> FEMap(renMap(rc, bound, ents))
    FELambda(params, body) -> FELambda(params, renExpr(rc, extendB(bound, splitLamNames(params)), body))
    FEInterp(parts, r) -> FEInterp(renParts(rc, bound, parts), r)
    FEBlock(stmts, res) -> renBlock(rc, bound, stmts, res)
    FEIf(c, t, el) -> FEIf(renExpr(rc, bound, c), renExpr(rc, bound, t), renExpr(rc, bound, el))
    FEWhen(hasSubj, bind, subj, arms) -> FEWhen(hasSubj, bind, renExpr(rc, bound, subj), renArms(rc, bound, arms))
    FERet(x) -> FERet(renExpr(rc, bound, x))
    else -> e
  }
}

fun renFunc(rc: Ren, fd: FFunc): FFunc {
  val bound = list()
  if (fd.recv != "") { bound.push("this"); bound.push(fd.recv) }
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); bound.push(pp.name); i = i + 1 }
  return FFunc(fd.annos, mangleMod(rc.m, fd.name), fd.gen, fd.recv, fd.params, fd.ret, fd.whr, renExpr(rc, bound, fd.body))
}

// ---- parse one module's decls into a RawMod (no renaming yet; L = its free-function names) ----
fun nsLastSeg(s: String): String {
  val n = s.len()
  var start = 0
  var i = 0
  while (i < n) { if (s.charAt(i) == 58) { start = i + 1 }; i = i + 1 } // last ':' -> after it
  return s.substr(start, n - start)
}

fun parseModuleRaw(name: String, src: String): RawMod {
  val p = P(lex(src), 0)
  val funcs = list(); val tdecls = list(); val edecls = list()
  val traits = list(); val impls = list(); val consts = list()
  val uses = list(); val L = list(); val imps = list(); val impPub = list()
  var go = 1
  while (go == 1) {
    if (pk(p) == 0) { go = 0 }
    else {
      val annos = parseAnnos(p)
      var isPub = 0
      if (pk(p) == 56) { eat(p); isPub = 1 } // `pub` prefix (public re-export when on an import)
      val k = pk(p)
      if (k == 10) { val fd = parseFunc(p, annos); funcs.push(fd); L.push(fd.name) }
      else { if (k == 54) { tdecls.push(parseTypeDecl(p, annos, 0)) }
        else { if (k == 65) { tdecls.push(parseTypeDecl(p, annos, 1)) }
          else { if (k == 55) { edecls.push(parseEnum(p, annos)) }
            else { if (k == 66) { traits.push(parseTrait(p, annos)) }
              else { if (k == 67) { impls.push(parseImpl(p, annos)) }
                else { if (k == 58) { val ip = parseImport(p); imps.push(nsLastSeg(ip)); impPub.push(isPub) }
                  else { if (k == 80) { consts.push(parseConst(p)) }
                    else { if (k == 81) { uses.push(parseUse(p)) }
                      else { go = 0 } } } } } } } } }
    }
  }
  return RawMod(name, funcs, tdecls, edecls, traits, impls, consts, uses, L, imps, impPub)
}

// build a module's alias table: `use` aliases first (highest priority), then (root only) auto-import
// of every imported module's bare names (first module wins; never overrides own names or use aliases).
fun findRawMod(rawmods: List, name: String): Int {
  var i = 0
  while (i < rawmods.len()) { val rm: RawMod = rawmods.get(i); if (rm.name == name) { return i }; i = i + 1 }
  return 0 - 1
}

// EXPORT SURFACE of module `name` = its own free-fn names (mangled) + the surfaces of its `pub import`s.
// A plain `import` is a private dependency (its names are NOT re-exported). `seen` guards import cycles.
fun exportSurface(rawmods: List, name: String, outN: List, outT: List, seen: List): Int {
  if (memListL(seen, name)) { return 0 }
  seen.push(name)
  val idx = findRawMod(rawmods, name)
  if (idx < 0) { return 0 }
  val rm: RawMod = rawmods.get(idx)
  var i = 0
  while (i < rm.L.len()) { outN.push(rm.L.get(i)); outT.push(mangleMod(name, rm.L.get(i))); i = i + 1 }
  var j = 0
  while (j < rm.imps.len()) {
    if (rm.impPub.get(j) == 1) { exportSurface(rawmods, rm.imps.get(j), outN, outT, seen) }
    j = j + 1
  }
  return 0
}

// a module's alias table: `use` aliases first, then the EXPORT SURFACE of every module IT imports (pub or
// private — a module may use what it privately imports). Own names and use-aliases win over auto-imports.
fun buildRen(rm: RawMod, rawmods: List, MODS: List): Ren {
  val aN = list(); val aT = list()
  var i = 0
  while (i < rm.uses.len()) { val u: FUse = rm.uses.get(i); aN.push(u.name); aT.push(mangleMod(u.mod, u.name)); i = i + 1 }
  var mi = 0
  while (mi < rm.imps.len()) {
    val sN = list(); val sT = list(); val seen = list()
    exportSurface(rawmods, rm.imps.get(mi), sN, sT, seen)
    var si = 0
    while (si < sN.len()) {
      val nm: String = sN.get(si)
      if (memListL(aN, nm) == false) { if (memListL(rm.L, nm) == false) { aN.push(nm); aT.push(sT.get(si)) } }
      si = si + 1
    }
    mi = mi + 1
  }
  return Ren(rm.name, rm.L, MODS, aN, aT)
}

// rename this module's free functions and collect ALL its decls into the shared aggregate lists
fun collectModuleDecls(rc: Ren, rm: RawMod, pfuns: List, structN: List, structF: List, structFT: List, classN: List, traitN: List, traitDecls: List, implTrait: List, implType: List, constN: List, constExprs: List, variantN: List, variantTag: List, variantTys: List, variantOwn: List, fN: List, fR: List, deriveT: List, deriveTr: List): Int {
  var i = 0
  while (i < rm.funcs.len()) {
    val nfd = renFunc(rc, rm.funcs.get(i))
    pfuns.push(PFun("", nfd)); fN.push(nfd.name); fR.push(nfd.ret)
    i = i + 1
  }
  var ti = 0
  while (ti < rm.tdecls.len()) {
    val td: FTDecl = rm.tdecls.get(ti)
    collectStruct(td, structN, structF, structFT)
    if (td.kind == 1) { classN.push(td.name) }
    collectMethodSigs(td, pfuns, fN, fR)
    if (td.kind == 1) { collectDeinit(td, pfuns, fN, fR) }
    recordDerive(td.annos, td.name, deriveT, deriveTr)
    ti = ti + 1
  }
  var ei = 0
  while (ei < rm.edecls.len()) { val ed: FEDecl = rm.edecls.get(ei); collectEnum(ed, variantN, variantTag, variantTys, variantOwn); recordDerive(ed.annos, ed.name, deriveT, deriveTr); ei = ei + 1 }
  var tr = 0
  while (tr < rm.traits.len()) { val trd: FTraitDecl = rm.traits.get(tr); traitN.push(trd.name); traitDecls.push(trd); tr = tr + 1 }
  var ii = 0
  while (ii < rm.impls.len()) {
    val im: FImplDecl = rm.impls.get(ii)
    collectImplMethods(im, pfuns, fN, fR)
    if (im.traitName != "") { implTrait.push(im.traitName); implType.push(im.forTy) }
    ii = ii + 1
  }
  var ci = 0
  while (ci < rm.consts.len()) { val cd: FConstDecl = rm.consts.get(ci); constN.push(cd.name); constExprs.push(cd.expr); ci = ci + 1 }
  return 0
}

fun parseLowerModules(mods: List): LR {
  val rawmods = list()
  val MODS = list()
  var mp = 0
  while (mp < mods.len()) {
    val md: Mod = mods.get(mp)
    rawmods.push(parseModuleRaw(md.name, md.src))
    if (md.name != "") { MODS.push(md.name) }
    mp = mp + 1
  }
  val pfuns = list()
  val structN = list(); val structF = list(); val structFT = list()
  val classN = list()
  val traitN = list(); val traitDecls = list(); val implTrait = list(); val implType = list()
  val constN = list(); val constExprs = list()
  val variantN = list(); val variantTag = list(); val variantTys = list(); val variantOwn = list()
  val fN = list(); val fR = list()
  val roleK = list(); val roleV = list()
  val arcE = list()
  val deriveT = list(); val deriveTr = list()
  // The namespace-module path does not yet collect `@mono` templates (collectModuleDecls has no mono hook);
  // monomorphized generics are reached via quoted includes / inline decls (parseLower). Empty here -> inert.
  val monoN = list(); val monoP = list()
  injectHelpers(pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, deriveT, deriveTr, monoN, monoP)
  var rj = 0
  while (rj < rawmods.len()) {
    val rm: RawMod = rawmods.get(rj)
    val rc = buildRen(rm, rawmods, MODS)
    collectModuleDecls(rc, rm, pfuns, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, fN, fR, deriveT, deriveTr)
    rj = rj + 1
  }
  return finishLower(pfuns, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, fN, fR, roleK, roleV, arcE, deriveT, deriveTr, monoN, monoP)
}

// Route the input: the module pipeline (mangling + visibility) when it has a NAMESPACE import; else the
// flat path — resolveImports expands any quoted `import "..."` as plain text (the compiler's own case),
// then parseLower. A quoted-only input (like the compiler assembling itself) never touches the module
// machinery, so its cross-file calls keep their global names.
// Flatten quoted includes FIRST (they inline into whichever module contains them), then decide the
// path: if namespace imports remain, engage the module system on the flattened source; otherwise it's
// a pure quoted/flat program. A file may freely MIX quoted includes (its own files) with namespace
// imports (the standard library). The compiler itself uses only quoted includes, so `flat` has no
// namespace imports and this stays byte-identical to the old quoted-only path.
fun lowerInput(raw: String): LR {
  val flat = resolveImports(raw, list())
  if (hasNamespaceImport(flat)) { return parseLowerModules(collectModules(flat)) }
  return parseLower(lex(flat))
}

// concatenate every module's source (namespace-import inputs) so the checker sees lib definitions too
// and doesn't false-flag lib names as "unresolved".
fun concatModuleSrcs(mods: List): String {
  var s = ""
  var i = 0
  while (i < mods.len()) { val m: Mod = mods.get(i); s = s + (m.src + "\n"); i = i + 1 }
  return s
}

fun gateDiags(raw: String): List {
  // Mirror lowerInput: flatten quoted includes FIRST, then decide on namespace modules. A namespace
  // import may be buried inside a quoted-included file (mixed imports), so it only becomes visible
  // after flattening — checking `raw` directly would miss it and false-flag stdlib names as unresolved.
  val flat = resolveImports(raw, list())
  val nsImp = hasNamespaceImport(flat)
  val checkSrc = if (nsImp) { concatModuleSrcs(collectModules(flat)) } else { flat }
  val skipDup = if (nsImp) { 1 } else { 0 }
  return checkDiags(lex(checkSrc), skipDup)
}

// Render a collected checker/parser diagnostic list through the ONE Diagnostic sink (Phase 0.5, §3h): each
// accumulated message becomes an error Diagnostic emitted to STDERR via the single renderer, then the count
// trailer. FORMAT-PRESERVING — the message already carries its own "line N: " prefix, so renderDiag
// reproduces the exact legacy "error: line N: <msg>" text and the committed goldens stay byte-valid (the
// check harness captures 2>&1, so moving diagnostics off stdout onto stderr is capture-safe).
fun reportDiags(cdiags: List, trailer: String): Int {
  var di = 0
  while (di < cdiags.len()) { emitDiag(diagError(cdiags.get(di))); di = di + 1 }
  eprintln(cdiags.len().toStr() + trailer)
  return 0
}

// compile inPath -> a signed native binary at outPath. Gated by the type-checker unless noGate;
// the peephole optimizer runs unless opt==0.
fun compileFile(inPath: String, outPath: String, noGate: Int, opt: Int): Int {
  val raw = readFile(inPath)
  if (noGate == 0) {
    val cdiags = gateDiags(raw)
    if (cdiags.len() > 0) {
      reportDiags(cdiags, " error(s); no binary written")
      return cdiags.len()
    }
  }
  val lr = lowerInput(raw)
  val gen = genProgramG(lr.funcs, lr.structN, lr.structF, lr.structFT, lr.variantN, lr.variantTag, lr.variantTys, lr.funN, lr.funRet, lr.arcE)
  val code = if (opt == 1) { optimize(gen.code) } else { gen.code }
  val asmR = assembleReloc(code)
  val cs = buildCstr(gen.cstrN, gen.cstrV)
  val externals = externalsOf(asmR.relocs)
  val entry = entryOffset(code, "_main")
  writeBytes(outPath, buildExeFull(asmR.words, asmR.relocs, cs, externals, entry, "_main", "kcout"))
  return 0
}

// `kitec check <file>`: type-check only, print diagnostics (no binary).
fun checkOnly(inPath: String): Int {
  val cdiags = gateDiags(readFile(inPath))
  if (cdiags.len() == 0) { println("ok"); return 0 }
  reportDiags(cdiags, " error(s)")
  return cdiags.len()
}

// default output = input path with a trailing ".kite" stripped ("foo.kite" -> "foo", in the cwd).
fun defaultOut(p: String): String {
  val n = p.len()
  if (n >= 5) { if (p.substr(n - 5, 5) == ".kite") { return p.substr(0, n - 5) } }
  return p + ".out"
}

fun printUsage(): Int {
  println("kitec - the Kite compiler (arm64 / Mach-O)")
  println("")
  println("usage: kitec [options] <input.kite>")
  println("")
  println("options:")
  println("  -o <file>      output path (default: the input with '.kite' stripped, in the cwd)")
  println("  check          type-check only, write no binary")
  println("  --no-check     skip the type-check pass")
  println("  --emit-funcs   print the lowered function/struct counts")
  println("  -O0 / -O1      disable / enable the peephole optimizer (default -O1)")
  println("  --version      print the compiler version")
  println("  -h, --help     show this help")
  return 0
}

// REAL CLI. macOS passes argc in x0 and argv (char**) in x1 to _main, so main receives them directly;
// __argv(argv, i) reads argv[i] as a String. Output defaults to the CURRENT DIRECTORY (no /tmp).
fun main(argc: Int, argv: Int): Int {
  var input = ""
  var output = ""
  var mode = 0
  var noGate = 0
  var opt = 1
  var emitFuncs = 0
  var i = 1
  while (i < argc) {
    val a = __argv(argv, i)
    var consumed = 0
    if (a == "-h") { return printUsage() }
    if (a == "--help") { return printUsage() }
    if (a == "--version") { println("kitec 0.1 - self-hosted Kite compiler (arm64/Mach-O)"); return 0 }
    if (a == "-o") { i = i + 1; if (i < argc) { output = __argv(argv, i) }; consumed = 1 }
    if (a == "check") { mode = 1; consumed = 1 }
    if (a == "--check") { mode = 1; consumed = 1 }
    if (a == "--no-check") { noGate = 1; consumed = 1 }
    if (a == "--emit-funcs") { emitFuncs = 1; consumed = 1 }
    if (a == "-O0") { opt = 0; consumed = 1 }
    if (a == "-O1") { opt = 1; consumed = 1 }
    // positionals: first = input, second = output (so `kitec in out` works like `kitec in -o out`)
    if (consumed == 0) { if (input == "") { input = a } else { output = a } }
    i = i + 1
  }
  if (input == "") { println("kitec: no input file (try --help)"); return 1 }
  if (mode == 1) { return checkOnly(input) }
  if (output == "") { output = defaultOut(input) }
  val rc = compileFile(input, output, noGate, opt)
  if (rc == 0) { if (emitFuncs == 1) { println("wrote " + output) } }
  return rc
}
