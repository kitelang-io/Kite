// Phase-8 literal FLIP: a `[..]` list literal is now a first-class monomorphized Vec<T> (was the erased
// IntBuf kernel). T is inferred from the elements; empty `[]` takes T from a Vec<T> annotation. This
// exercises push/get/len/for-in/index on the literal, Vec-ONLY methods (getOr/contains/pop/isEmpty — proving
// the value really is a Vec, not IntBuf), a Vec<String> literal (element method dispatch through the loop
// var), a class-element literal (Vec<Box>, container-element ARC), and the empty-annotated case.
// Exit code = 17 (count of passed assertions).
class Box(val v: Int) {}

fun main(): Int {
  var acc = 0

  // [1,2,3] is a Vec<Int>: push, get, len, for-in, index get/set.
  val xs = [1, 2, 3]
  xs.push(4)                                  // [1,2,3,4]
  if (xs.len() == 4) { acc = acc + 1 }        // 1
  if (xs.get(0) == 1) { acc = acc + 1 }       // 2
  if (xs[3] == 4) { acc = acc + 1 }           // 3
  var s = 0
  for (x in xs) { s = s + x }                 // 1+2+3+4 = 10
  if (s == 10) { acc = acc + 1 }              // 4
  xs[1] = 20                                  // [1,20,3,4]
  if (xs[1] == 20) { acc = acc + 1 }          // 5

  // Vec-ONLY methods (absent on the IntBuf kernel) — proof the literal is really a Vec<Int>.
  if (xs.getOr(99, 7) == 7) { acc = acc + 1 } // 6  (out-of-range default)
  if (xs.contains(20)) { acc = acc + 1 }      // 7
  when (xs.pop()) { Some(v) -> { if (v == 4) { acc = acc + 1 } }; None -> 0 }  // 8
  if (xs.len() == 3) { acc = acc + 1 }        // 9  (pop shrank it -> [1,20,3])

  // Vec<String> literal; the loop var dispatches String_len through the Vec element type.
  val ws = ["ab", "cde", "f"]
  var tot = 0
  for (w in ws) { tot = tot + w.len() }       // 2+3+1 = 6
  if (tot == 6) { acc = acc + 1 }             // 10
  if (ws.len() == 3) { acc = acc + 1 }        // 11

  // Vec<Box> literal (class/reference elements): index + get, then field read.
  val bs = [Box(100), Box(200)]
  if (bs[0].v == 100) { acc = acc + 1 }       // 12
  if (bs.get(1).v == 200) { acc = acc + 1 }   // 13
  if (bs.len() == 2) { acc = acc + 1 }        // 14

  // empty `[]` bound to a Vec<Int> annotation -> a real empty Vec (T from the annotation), then grow it.
  val es: Vec<Int> = []
  if (es.isEmpty()) { acc = acc + 1 }         // 15
  es.push(5) es.push(6)
  if (es.len() == 2) { acc = acc + 1 }        // 16
  if (es[1] == 6) { acc = acc + 1 }           // 17

  return acc
}
