// mono-vararg — `@mono` generic FREE FUNCTIONS with a `vararg` parameter now COMPOSE: the call site both
// (1) specializes the template per turbofish type-args AND (2) collects the trailing args into the concrete
// `Array<E>`. Two things had to line up (see klower runFnMono / monoFnMangle):
//   * a 0-arg `hashMap::<K,V>()` and a variadic `hashMap::<K,V>(vararg entries: Pair<K,V>)` are TWO @mono
//     overloads of one name — they get per-overload-DISTINCT mono mangles (`hashMap$K_V$a0` vs
//     `hashMap$K_V$v0`) instead of colliding on one arity-blind `hashMap$K_V`; the call site RESOLVES which
//     overload by arity (exact fixed-arity wins, else vararg), Kotlin-style;
//   * the vararg overload keeps its `vararg` last param through specialization, so the vararg registry
//     re-registers the specialized symbol and the call site collects the tail into `Array<Pair<Int,Int>>`.
//
// `hashMap(vararg)` is the acceptance case; `vecOf<T>(vararg xs: T)` proves the general capability (a second,
// single-type-param @mono vararg factory) for two concrete T. main returns the passed-check count (asserted 18).
import kite::alloc::collections::hashmap
import kite::alloc::collections::vec

// second @mono vararg free function — a variadic Vec<T> builder (one type param, element type IS the param).
@mono
fun vecOf<T>(vararg xs: T): Vec<T> {
  val v = Vec::<T>(0, 0, RawBuf(0))
  var i = 0
  while (i < xs.size()) { v.push(xs.get(i)) i = i + 1 }
  return v
}

fun main(argc: Int, argv: USize): Int {
  var acc = 0

  // (A) hashMap::<Int,Int>(vararg) — the acceptance case: build from Pair entries, read both back.
  val mi = hashMap::<Int, Int>(1 to 10, 2 to 20)
  if (mi.size() == 2) { acc = acc + 1 }          // 1
  if (mi.getOr(1, 0) == 10) { acc = acc + 1 }    // 2
  if (mi.getOr(2, 0) == 20) { acc = acc + 1 }    // 3
  if (mi.containsKey(1)) { acc = acc + 1 }               // 4
  if (mi.containsKey(9) == false) { acc = acc + 1 }      // 5

  // (B) hashMap::<String,Int>(vararg) with a SINGLE entry — a different instantiation, content-keyed.
  val ms = hashMap::<String, Int>("a" to 1)
  if (ms.size() == 1) { acc = acc + 1 }          // 6
  if (ms.getOr("a", 0) == 1) { acc = acc + 1 }   // 7
  if (ms.getOr("b", 0) == 0) { acc = acc + 1 }   // 8

  // (C) the 0-arg `hashMap::<K,V>()` overload STILL works (exact fixed-arity wins over the vararg).
  val m0 = hashMap::<Int, Int>()
  m0.set(7, 70)
  m0.set(8, 80)
  if (m0.size() == 2) { acc = acc + 1 }          // 9
  if (m0.getOr(7, 0) == 70) { acc = acc + 1 }    // 10
  if (m0.getOr(8, 0) == 80) { acc = acc + 1 }    // 11

  // (D) vecOf::<Int>(vararg) — the second @mono vararg factory, first concrete T.
  val vi = vecOf::<Int>(3, 5, 7, 9)
  if (vi.size() == 4) { acc = acc + 1 }           // 12
  if (vi.get(0) == 3) { acc = acc + 1 }          // 13
  if (vi.get(3) == 9) { acc = acc + 1 }          // 14

  // (E) vecOf::<String>(vararg) — the same @mono vararg factory, a DIFFERENT concrete T.
  val vs = vecOf::<String>("hi", "yo")
  val s0: String = vs.get(0)
  val s1: String = vs.get(1)
  if (vs.size() == 2) { acc = acc + 1 }           // 15
  if (s0.length() == 2) { acc = acc + 1 }           // 16
  if (s1 == "yo") { acc = acc + 1 }              // 17

  // (F) a 0-arg vecOf::<Int>() also resolves to the vararg overload (fixed 0 <= 0 args), yielding empty.
  val ve = vecOf::<Int>()
  if (ve.size() == 0) { acc = acc + 1 }           // 18

  println(acc)
  return acc
}
