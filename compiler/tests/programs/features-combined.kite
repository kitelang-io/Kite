import kite::alloc

trait Describable { fun tag(self): Int }

class Handle(val id: Int)

struct Point(val x: Int, val y: Int)

impl Describable for Point {
  fun tag(self): Int = self.x + self.y
}

fun getHandle(flag: Int): Handle {
  if (flag == 1) { return Handle(99) }
  return null
}

fun main(): Int {
  val sz = comptime(4 * 8)
  val p = Point(3, 4)
  val t = p.tag()
  val h = getHandle(1)
  val hid = h?.id ?: 0
  val n = getHandle(0)
  val nid = n?.id ?: 7
  val s = rangeList(4).map({ k -> k * k }).sum()
  return sz + t + hid + nid + s - 100
}
