// compiler/klower.kite — the integration driver: lowers kfront's full-language surface AST (F*)
// into kenc's codegen AST, then runs the backend (codegen -> assemble -> Mach-O -> sign).
// Build: kitec run compiler/kfront.kite compiler/kenc.kite compiler/klower.kite
// Real CLI: `kitec [options] <input.kite>` (see docs/CLI.md); default output = input minus ".kite".
//
// TYPE-DIRECTED: a per-function context Lo carries a fresh-name counter + a coarse local type
// env + global fun-return/struct-field maps, so lowering can pick intToStr-vs-string for
// interpolation and listGet-vs-charAt for indexing. parseLower is 2-phase (collect all sigs,
// then lower) so forward references resolve. Constructs outside kenc's codegen (lambdas, floats,
// map literals, traits/impl, nullable ops) are still reported via lowFail.

// ---------- per-type MEMBER TABLE (Phase M0: BUILT alongside the flat lists, READ by nothing yet) ----------
// TODAY a type's members live in ~30 parallel flat lists keyed by the `Owner_member` mangle. This table is a
// SINGLE per-type index the checker will later consult to resolve a selector (`x.push`, `Int::MAX`) without
// re-deriving it from the mangle. It is populated at the ONE collection point (collectDecl), so user-source
// and lib/prelude decls land in it identically (decouple preserved). One entry per member, each carrying an
// explicit back-link to its owning type. Nothing in M0 consults it — all dispatch still goes through fN/mangle.
//   types      : every nominal type name seen (struct/class/enum/trait/@prim), for prefix attribution.
//   aliasFrom/To: @alias views (I8 -> Byte, Never -> Nothing): one canonical primary + alias views.
//   owner      : owning type name of the member ("" = a true free/global function or top-level const).
//   sel        : the SELECTOR — the surface name used after `.`/`::` (field/method/variant/const name).
//   kind       : "field" | "method" | "assocfn" | "traitmethod" | "variant" | "freefn" | "const".
//   inst       : 1 = instance member (needs a receiver), 0 = associated/free.
//   sym        : the EMITTED symbol (codegen back-link): owner-mangled for members, bare for free/variant.
//   info       : auxiliary — a field's type+flags, a fn's return type, or a variant's tag number.
struct MTab(val types: IntBuf, val aliasFrom: IntBuf, val aliasTo: IntBuf, val owner: IntBuf, val sel: IntBuf, val kind: IntBuf, val inst: IntBuf, val sym: IntBuf, val info: IntBuf)

struct Lo(val ctr: IntBuf, val locN: IntBuf, val locT: IntBuf, val fN: IntBuf, val fR: IntBuf, val sN: IntBuf, val sFN: IntBuf, val sFT: IntBuf, val lifted: IntBuf, val gctr: IntBuf, val classN: IntBuf, val arcOwned: IntBuf, val traitN: IntBuf, val constN: IntBuf, val constV: IntBuf, val cfuncs: IntBuf, val traitMethN: IntBuf, val traitMethT: IntBuf, val pmN: IntBuf, val pmM: IntBuf, val variantN: IntBuf, val variantTys: IntBuf, val variantOwn: IntBuf, val roleK: IntBuf, val roleV: IntBuf, val arcE: IntBuf, val valueE: IntBuf, val prim: PReg, val fpN: IntBuf, val fpT: IntBuf, val mt: MTab, val vareg: VaReg)

struct PFun(val owner: String, val fd: FFunc) // owner "" = free function; else the struct type

fun lastSeg(path: String): String {
  var i = path.len() - 1
  while (i >= 1) { if (path.charAt(i - 1) == 58 && path.charAt(i) == 58) { return path.substr(i + 1, path.len() - i - 1) } i = i - 1 }
  return path
}

// An unsupported construct is a HARD build failure, not a silent one. Before Phase 0.5 this printed to
// STDOUT and returned 0, so lowering continued and emitted a garbage binary that "built" successfully
// (redesign §3h). Now it emits a real error Diagnostic to STDERR (through the single sink) and aborts the
// process with a non-zero exit via __abort() — no binary is written. The `return 0` is unreachable, kept
// only so the type-checker sees an Int result at lowFail's many expression-position call sites.
fun lowFail(msg: String): Int {
  emitDiag(diagError("klower: unsupported construct: " + msg))
  __abort()
  return 0
}

fun memListL(l: IntBuf, n: String): Bool {
  var i = 0
  while (i < l.len()) { val x: String = l.get(i); if (x == n) { return true }; i = i + 1 }
  return false
}

fun freshName(lo: Lo, pre: String): String { val n: Int = lo.ctr.get(0); lo.ctr.set(0, n + 1); return pre + n.toStr() }

fun bindLoc(lo: Lo, nm: String, tag: String): Int { lo.locN.push(nm); lo.locT.push(tag); return 0 }

// ---------- coarse type tags ----------
// normalize a type string to a coarse tag: "IntBuf<Int>"->"IntBuf", "Int?"->"Int", "a::B"->"B", ""->"?"
fun tyTag(s: String): String {
  if (s == "") { return "?" }
  var stop = s.len()
  var i = 0
  while (i < s.len()) { val c = s.charAt(i); if (c == 60 || c == 63 || c == 32) { stop = i; i = s.len() } else { i = i + 1 } }
  return lastSeg(s.substr(0, stop))
}

// COARSE runtime tag of a declared type string. Like tyTag, but collapses the float family {Double,Float}
// to the single "Float" coarse tag — Double and Float are distinct nominal classes yet share ONE erased
// 64-bit runtime representation and one coarse tag (matching FEFloat/FECast/toFloat). Use this ONLY where a
// declared type becomes a *tag* consumed by tagOf (method dispatch + float print-routing), NEVER where the
// exact type name is needed (method mangling, sizeOfTy width). Without it a `val d: Double = 3.5` bound its
// tag as "Double", so println(d) missed the Float print-path and printed raw bits.
fun tyTagR(s: String): String { val t = tyTag(s); if (t == "Double") { return "Float" }; return t }

// a param type carries an ownership-mode prefix ("consuming "=transfer, "inout "=borrow-mutable, none=borrow).
// paramMode returns the mode keyword; stripMode returns the bare type (so tyTag sees the real type, not the mode).
fun paramMode(ty: String): String {
  val n = ty.len()
  if (n >= 10) { if (ty.substr(0, 10) == "consuming ") { return "consuming" } }
  if (n >= 6) { if (ty.substr(0, 6) == "inout ") { return "inout" } }
  return ""
}

fun stripMode(ty: String): String {
  val n = ty.len()
  if (n >= 10) { if (ty.substr(0, 10) == "consuming ") { return ty.substr(10, n - 10) } }
  if (n >= 6) { if (ty.substr(0, 6) == "inout ") { return ty.substr(6, n - 6) } }
  return ty
}

fun localTag(lo: Lo, nm: String): String {
  var i = lo.locN.len() - 1
  while (i >= 0) { if (lo.locN.get(i) == nm) { return lo.locT.get(i) }; i = i - 1 }
  return "?"
}

// tag of a bare identifier: a local's static tag, else — for a nullary enum variant used as a value
// (e.g. `Unit`, `None`) — the owning enum type, so `Unit.debug()` and `x == Unit` resolve. "?" otherwise.
fun identTag(lo: Lo, nm: String): String {
  val lt = localTag(lo, nm)
  if (lt != "?") { return lt }
  val vo = variantOwnerIn(lo.variantN, lo.variantOwn, nm)
  if (vo != "") { return vo }
  return "?"
}

// builtinRetTag: the return tag of a type-carrying INTRINSIC (no Kite body). Sourced from codegen's ONE
// manifest floorRetTag so it can never drift from typeNameOf. The pure-Kite prelude functions
// (intToStr/concat/substr/strLen/charAt/listLen/listPush/listSet) are no longer listed here — their tags
// resolve through the collected fN/fR signatures in funRetTag below, so this stopped being a second copy.
fun builtinRetTag(nm: String): String { return floorRetTag(nm) }

// The INTRINSIC FLOOR: names with NO Kite definition anywhere. The compiler emits them directly (the
// per-name dispatch in codegen's genCall) or folds them at lower time (comptime). The floor name set is
// defined ONCE, in codegen's intrinsicFloor() — the machine-lowered names — and this predicate DERIVES
// from it, adding only `comptime` (a lower-time-only fold that never reaches codegen). The M2 checker's
// isBuiltin (kcheck.kite) defers to this predicate, so the lowerer, the checker, and codegen can never
// disagree about the floor. Everything else a program can call is a real Kite function: a prelude module
// (preludeConfPaths) or the user's own source.
fun isIntrinsic(nm: String): Bool {
  if (nm == "comptime") { return true }
  // Phase 6 monomorphization intrinsics — folded at LOWER time (never reach codegen), like comptime:
  //   sizeOf::<T>()            -> the packed byte size of T (Int literal)
  //   __packedGet::<T>(p, i)   -> the width/sign-correct sized load at stride sizeOf<T>()
  //   __packedSet::<T>(p, i, v)-> the width-truncating sized store at stride sizeOf<T>()
  // The compiler's own sources use none of these, so this is inert for the self-host build.
  if (nm == "sizeOf" || nm == "__packedGet" || nm == "__packedSet") { return true }
  return memListL(intrinsicFloor(), nm)
}

fun funRetTag(lo: Lo, nm: String): String {
  val b = builtinRetTag(nm)
  if (b != "") { return b }
  var i = 0
  while (i < lo.fN.len()) { if (lo.fN.get(i) == nm) { return tyTagR(lo.fR.get(i)) }; i = i + 1 }
  if (memListL(lo.sN, nm)) { return nm } // struct constructor
  val vo = variantOwnerIn(lo.variantN, lo.variantOwn, nm)
  if (vo != "") { return vo } // enum variant constructor -> its owning enum type
  return "?"
}

// owning enum type of a variant constructor name (parallel variantN/variantOwn tables); "" if not a variant.
fun variantOwnerIn(variantN: IntBuf, variantOwn: IntBuf, nm: String): String {
  var i = 0
  while (i < variantN.len()) { if (variantN.get(i) == nm) { return variantOwn.get(i) }; i = i + 1 }
  return ""
}

fun fieldTag(lo: Lo, a: FExpr, f: String): String {
  // `Type.member` (a static read via dot, e.g. `Int.MAX`) tags as the mangled static's return type — mirror
  // the FEStatic VALUE tag so a `val m = Int.MAX` infers Int (variants are constructed via `::`, never here).
  if (isTypeDotBase(lo, a)) { if (isQualVariant(lo, a, f) == false) { return funRetTag(lo, staticCallee(lo, a, f)) } }
  val at = tagOf(lo, a)
  var i = 0
  while (i < lo.sN.len()) {
    if (lo.sN.get(i) == at) {
      val fns: IntBuf = lo.sFN.get(i)
      val fts: IntBuf = lo.sFT.get(i)
      var j = 0
      while (j < fns.len()) { if (fns.get(j) == f) { return tyTagR(fts.get(j)) }; j = j + 1 }
      return "?"
    }
    i = i + 1
  }
  return "?"
}

// Is `f` a DECLARED field of struct/class type `recvTag`? Distinguishes a real field access from a
// property getter/setter (a bare `obj.name` where `name` is a nullary convention method, not a field).
fun isFieldOf(lo: Lo, recvTag: String, f: String): Bool {
  var i = 0
  while (i < lo.sN.len()) {
    if (lo.sN.get(i) == recvTag) {
      val fns: IntBuf = lo.sFN.get(i)
      var j = 0
      while (j < fns.len()) { if (fns.get(j) == f) { return true }; j = j + 1 }
      return false
    }
    i = i + 1
  }
  return false
}

fun tagBin(lo: Lo, op: String, a: FExpr, b: FExpr): String {
  if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") { return "Bool" }
  if (op == ".." || op == "..<") { return "Range" }
  // overloaded arithmetic operator: the result tag is the operator method's RETURN type, so a subsequent
  // method dispatch on the result (`(a + b).m()`) resolves against that type instead of falling to a bare
  // undefined symbol. Guarded on a concretely-defined `<T>_<op>` (opMangledFor) whose return tag is known;
  // primitive Int/Float and String `+` (no method, or String_add returning "String") are unchanged, so
  // self-host IR emission stays byte-identical.
  if (isOverloadableOp(op)) {
    val om = opMangledFor(lo, op, a, b)
    if (om != "") { val rt = funRetTag(lo, om); if (rt != "?") { return rt } }
  }
  val fl = tagOf(lo, a) == "Float" || tagOf(lo, b) == "Float"
  if (op == "+") { if (fl) { return "Float" } if (tagOf(lo, a) == "String" || tagOf(lo, b) == "String") { return "String" } return "Int" }
  if (fl) { return "Float" }
  return "Int"
}

fun isArithOrCmp(op: String): Bool {
  return op == "+" || op == "-" || op == "*" || op == "/" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!="
}

// ---------- the desugar role table: the compiler's SINGLE SOURCE OF TRUTH for stdlib symbols ----------
// The ~6 desugaring sites (list/map literals, index get/set, for-in, string interpolation, operator
// overloading) do NOT bake in stdlib symbol names anymore — they ask this table for a symbol BY ROLE.
// Binding is by NAME CONVENTION: a role maps to the exact free-function / method / operator-method name
// the lowerer emits today. The table is now SOURCED FROM lib/: each prelude decl carries a user-facing
// `@lang("<role>")` attribute, collected during injectHelpers (the pre-lowering prelude pass) into the
// lo.roleK/lo.roleV parallel lists. roleSym looks the role up there; the hardcoded roleSymFallback below
// is kept ONLY as a never-hit safety net for an un-annotated role. Each role MUST resolve to the exact
// symbol emitted before this refactor, so IR/emission for every program is unchanged (self-reproduction
// kcc2==kcc3 holds byte-for-byte).
fun roleLookup(roleK: IntBuf, roleV: IntBuf, role: String): String {
  var i = 0
  while (i < roleK.len()) { if (roleK.get(i) == role) { return roleV.get(i) }; i = i + 1 }
  return ""
}

fun roleSym(lo: Lo, role: String): String {
  val s = roleLookup(lo.roleK, lo.roleV, role)
  if (s != "") { return s }
  return roleSymFallback(role)
}

fun roleSymFallback(role: String): String {
  // list literals `[..]` / for-in / a[i] on a IntBuf
  if (role == "intbuf.new") { return "intBuf" } // [..] constructor
  if (role == "intbuf.push") { return "IntBuf_push" } // [..] element append
  if (role == "intbuf.get") { return "IntBuf_get" } // a[i] load / for-in element
  if (role == "intbuf.set") { return "IntBuf_set" } // a[i] = v store
  if (role == "intbuf.len") { return "IntBuf_len" } // for-in bound
  // string index / interpolation
  if (role == "str.get") { return "String_charAt" } // s[i] on a String
  if (role == "str.show") { return "Int_toStr" } // $expr -> Int_toStr(expr)
  if (role == "str.concat") { return "String_add" } // two-piece interpolation join
  // string builder (interpolation of >=2 pieces lowers onto ONE StrBuilder, then finish())
  if (role == "str.build.new") { return "strNew" } // fresh StrBuilder
  if (role == "str.build.push") { return "StrBuilder_pushStr" } // append a piece, returns the builder
  if (role == "str.build.finish") { return "StrBuilder_finish" } // seal to a String
  // map literals `{..}` / m[k] / m[k]=v — the map.put role (append) is realized by mapPutInto below
  if (role == "rawmap.new") { return "rawMap" } // {..} constructor
  if (role == "rawmap.putList") { return "IntBuf_push" } // append into a parallel word-list (map.put)
  if (role == "rawmap.getS") { return "RawMap_get" } // m[k] load, String key
  if (role == "rawmap.getI") { return "RawMap_getI" } // m[k] load, Int key
  if (role == "rawmap.setS") { return "RawMap_set" } // m[k] = v store, String key
  if (role == "rawmap.setI") { return "RawMap_setI" } // m[k] = v store, Int key
  // operator overloading: `a op b` -> mangled `<T>_<method>` (method name only; owner mangled by caller)
  if (role == "op.+") { return "add" }
  if (role == "op.-") { return "sub" }
  if (role == "op.*") { return "mul" }
  if (role == "op./") { return "div" }
  if (role == "op.%") { return "rem" }
  if (role == "op.==") { return "eq" } // `a == b`/`a != b` on String -> <T>_eq
  return ""
}

// operator overloading: the arithmetic operators map to trait methods (+ -> add, - -> sub, * -> mul,
// / -> div, % -> rem). isOverloadableOp gates the desugar; opMethodName is the method name for `op`,
// resolved through the role table (roles op.+ .. op.%).
fun isOverloadableOp(op: String): Bool {
  return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
}

fun opMethodName(lo: Lo, op: String): String { return roleSym(lo, "op." + op) }

// float arithmetic/comparison (either operand Float) -> EFBin; otherwise the integer EBin.
// OPERATOR OVERLOADING: `a op b` desugars to the operator method when the LEFT operand's type has a
// CONCRETE impl of it (String_add, V2_add, ...). We resolve DIRECTLY to the mangled static method with
// both operands already-lowered as args — NOT via methodCallee (which, once `add` is a trait method,
// would dynamic-dispatch `__dyn_Add_add` for ANY operand incl. Int -> a bad switch on a header-less Int).
// So we guard strictly on the concrete mangled method existing (funDefined). Int/Float with no impl fall
// through to the primitive EFBin/EBin below — zero-cost for the numeric core (self-host stays byte-identical
// because the compiler's own sources only ever `+` integers, whose type tag is "Int", never a defined op method).
// resolve `a op b` to the mangled operator method `<T>_<m>` when EITHER operand's concrete type defines it
// (left first, then right). Two operands, one method: the left-first rule matches the trait convention, and
// the right fallback lets an erased/untyped LEFT still route when the RIGHT is a concrete String (e.g.
// `xs.get(i) + ("_" + m)` — left erased, right String). Returns "" when neither side has the method.
fun opMangledFor(lo: Lo, op: String, l: FExpr, r: FExpr): String {
  val ol = mangleMethod(tagOf(lo, l), opMethodName(lo, op))
  if (funDefined(lo, ol)) { return ol }
  val orr = mangleMethod(tagOf(lo, r), opMethodName(lo, op))
  if (funDefined(lo, orr)) { return orr }
  return ""
}

// Ord ordering-operator desugar (Phase 4): `a < b` (and <=, >, >=) route through the LEFT (else RIGHT)
// operand's `<T>_cmp` when one is defined, comparing the -1/0/1 result against 0. Fires ONLY when a
// concrete `cmp` method exists — Int/Char/every scalar has none, so the compiler's own integer
// comparisons stay machine `cmp`+condition-codes and the self-host fixpoint is unaffected.
fun isOrderingOp(op: String): Bool { return op == "<" || op == "<=" || op == ">" || op == ">=" }

fun cmpMangledFor(lo: Lo, l: FExpr, r: FExpr): String {
  val ol = mangleMethod(tagOf(lo, l), "cmp")
  if (funDefined(lo, ol)) { return ol }
  val olp = mangleMethod(tagOf(lo, l), "partialCmp")
  if (funDefined(lo, olp)) { return olp }
  val orr = mangleMethod(tagOf(lo, r), "cmp")
  if (funDefined(lo, orr)) { return orr }
  val orp = mangleMethod(tagOf(lo, r), "partialCmp")
  if (funDefined(lo, orp)) { return orp }
  return ""
}

// operand of a String `+` (concatenation): a String operand passes through unchanged; a GENUINE integer
// scalar (Int/sized-int/Bool/Char) is rendered to its string form via str.show (Int_toStr) so that
// `"s" + 5` yields "s5" instead of dereferencing the raw Int 5 as a char* (SIGSEGV). Float/Double are
// excluded (Int_toStr cannot render them) and fall through untouched.
//
// A concat operand is auto-stringified only when it is a GENUINE numeric value, not a heap word pulled
// from erased storage. Kite conflates `Int` with erased pointers: a word read from an IntBuf (via `.get()`,
// index, or a field/call returning an erased element) is TAGGED `Int` but may actually be a `String*` — the
// compiler's own `traitMethT.get(i) + "_show"` idiom depends on that word flowing through concat UNCHANGED
// (String_add treats it as the pointer it is). Converting such a word with Int_toStr would bake its decimal
// address into the output. So we restrict conversion to expression shapes that CANNOT be an erased word:
// literals (Int/Char/Bool), arithmetic (a genuine Int result), and plain identifiers/`this` (a named local of
// declared scalar type). Calls, indexing, field access, and static access are excluded — those are the exact
// shapes that produce erased words. This keeps self-compilation byte-identical (its 5 concat sites are all
// `.get()` calls, now left untouched) while `"s" + n` (n an Int variable) still renders as "s5".
fun concatConvertible(e: FExpr): Bool {
  return when (e) {
    FEInt(t) -> true
    FEChar(t) -> true
    FEBool(b) -> true
    FEIdent(nm) -> true
    FEThis -> true
    FEBin(op, a, b) -> isArithOrCmp(op)
    FEUnary(op, x) -> true
    else -> false
  }
}

fun concatPiece(lo: Lo, e: FExpr): Expr {
  val t = tagOf(lo, e)
  if (deriveIsScalar(t) && t != "Float" && t != "Double" && concatConvertible(e)) {
    val a = intBuf(); a.push(lowerExpr(lo, e))
    return ECall(roleSym(lo, "str.show"), a)
  }
  return lowerExpr(lo, e)
}

fun lowerBin(lo: Lo, op: String, l: FExpr, r: FExpr): Expr {
  if (isOverloadableOp(op)) {
    val om = opMangledFor(lo, op, l, r)
    if (om != "") {
      if (op == "+" && om == roleSym(lo, "str.concat")) {
        val ca = intBuf(); ca.push(concatPiece(lo, l)); ca.push(concatPiece(lo, r))
        return ECall(om, ca)
      }
      val ca = intBuf(); ca.push(lowerExpr(lo, l)); ca.push(lowerExpr(lo, r))
      return ECall(om, ca)
    }
  }
  // String value-equality: `a == b`/`a != b` route to the Eq method (String_eq) ONLY when an operand is
  // concretely String (opMangledFor resolves the mangled method from whichever side is String, else "").
  // Int/Char/Float/other `==` has no Eq impl -> falls through to the primitive machine compare below.
  if (op == "==" || op == "!=") {
    val em = opMangledFor(lo, "==", l, r)
    if (em != "") {
      val ca = intBuf(); ca.push(lowerExpr(lo, l)); ca.push(lowerExpr(lo, r))
      val eq = ECall(em, ca)
      if (op == "!=") { return EUnary("not !", eq) }
      return eq
    }
  }
  if (isOrderingOp(op)) {
    val cm = cmpMangledFor(lo, l, r)
    if (cm != "") {
      val ca = intBuf(); ca.push(lowerExpr(lo, l)); ca.push(lowerExpr(lo, r))
      return EBin(op, ECall(cm, ca), EInt("0"))
    }
  }
  if (isArithOrCmp(op) && (tagOf(lo, l) == "Float" || tagOf(lo, r) == "Float")) {
    return EFBin(op, lowerExpr(lo, l), lowerExpr(lo, r))
  }
  return EBin(op, lowerExpr(lo, l), lowerExpr(lo, r))
}

// methods (struct-body / trait-impl / inherent-impl) are mangled by their owner type so that
// same-named methods on different types don't collide: `area` on Circle -> `Circle_area`. Free
// functions (owner "") keep their bare name.
fun mangleMethod(owner: String, name: String): String {
  if (owner == "") { return name }
  return owner + ("_" + name)
}

// ---------- OVERLOADING (M5, contained) ----------
// A (owner,name) with more than one definition is an OVERLOAD SET. Each definition's SELECTOR is rewritten
// to encode its full parameter SIGNATURE — `of` with params (Int,Int) becomes selector `of__2__Int_Int`,
// mangling to `Point_of__2__Int_Int`. The arity segment (`__2__`) makes arity-first resolution robust even
// when a coarse type tag itself contains `_`. A name with a SINGLE definition keeps its plain selector, so a
// program with NO overloads (the compiler itself) is byte-identical. Resolution at a call site tries the
// plain mangle first (fast path), then the exact sig-mangle from the arg tags, then the unique same-arity
// candidate; an un-inferable same-arity tie is the 'ambiguous overload' error.

// coarse tag list of a function's declared param types, joined with "_" ("Int_Int"); "" for a nullary fn.
fun paramSigList(fd: FFunc): String {
  var s = ""
  var i = 0
  while (i < fd.params.len()) {
    val p: FParam = fd.params.get(i)
    val t = tyTag(stripMode(p.ty))
    if (i == 0) { s = t } else { s = s + ("_" + t) }
    i = i + 1
  }
  return s
}

// the signature-mangled SELECTOR for one overload-set member: `<name>__<arity>__<paramTags>`.
fun sigSelector(name: String, fd: FFunc): String {
  return name + ("__" + (fd.params.len().toStr() + ("__" + paramSigList(fd))))
}

// coarse tag list of the ARGUMENTS at a call site, joined with "_" — the call-site mirror of paramSigList.
fun argSigList(lo: Lo, args: IntBuf): String {
  var s = ""
  var i = 0
  while (i < args.len()) {
    val a: FArg = args.get(i)
    val t = tagOf(lo, a.expr)
    if (i == 0) { s = t } else { s = s + ("_" + t) }
    i = i + 1
  }
  return s
}

// count fN entries beginning with `pref`; capture the single match into out.get(0) when the count is 1.
fun ovCountPrefix(fN: IntBuf, pref: String, out: IntBuf): Int {
  var c = 0
  var i = 0
  val pl = pref.len()
  while (i < fN.len()) {
    val nm: String = fN.get(i)
    if (nm.len() >= pl) { if (nm.substr(0, pl) == pref) { c = c + 1; out.set(0, nm) } }
    i = i + 1
  }
  return c
}

// resolve a call to `<owner>::<name>(args)` / `recv.<name>(args)` / `<name>(args)` against the OVERLOAD SET.
// `owner` "" for a free function. Returns the overload-variant symbol to emit, or "" when `name` is NOT
// overloaded (the plain mangle is defined — the compiler's every call — or no sig-mangled variant exists).
// Resolution is arity-first: the exact arg-tag match wins; failing that, a UNIQUE same-arity candidate wins;
// an un-inferable same-arity tie hard-aborts with the locked 'ambiguous overload' diagnostic.
fun ovResolveVariant(lo: Lo, owner: String, name: String, args: IntBuf): String {
  if (funDefined(lo, mangleMethod(owner, name))) { return "" } // non-overloaded plain symbol exists
  val ar = args.len()
  val exact = mangleMethod(owner, name + ("__" + (ar.toStr() + ("__" + argSigList(lo, args)))))
  if (funDefined(lo, exact)) { return exact }
  val pref = mangleMethod(owner, name + ("__" + (ar.toStr() + "__")))
  val cap = intBuf(); cap.push("")
  val c = ovCountPrefix(lo.fN, pref, cap)
  if (c == 1) { return cap.get(0) }
  if (c > 1) { lowFail("ambiguous overload: `" + (name + "` — annotate the arguments or use a named factory")) }
  return ""
}

// a fresh FFunc identical to `fd` but with a new selector name (used to rewrite an overload-set member's
// selector to its signature-mangled form before lowering).
fun renameFn(fd: FFunc, nm: String): FFunc { return FFunc(fd.annos, nm, fd.gen, fd.recv, fd.params, fd.ret, fd.whr, fd.body) }

// OVERLOAD-SET remangle: a (owner,name) with MORE THAN ONE DISTINCT parameter signature among pfuns is a
// genuine overload set — rewrite each such member's SELECTOR to its signature-mangled form, keeping fN/fR
// index-aligned. A (owner,name) with a single signature (whether once or REPEATED — a module both prelude-
// injected and explicitly imported re-includes identical definitions) is left untouched, so downstream
// dedup handles benign re-inclusion exactly as before and non-overloaded programs (the compiler itself)
// are byte-identical. Genuine same-signature user CLASHES are caught upstream by the checker's signature-
// keyed defineGKey. Only runs when fN is index-aligned with pfuns (the invariant the collectors maintain).
fun overloadRemangle(pfuns: IntBuf, fN: IntBuf, fR: IntBuf, roleK: IntBuf, roleV: IntBuf, mt: MTab): Int {
  if (fN.len() != pfuns.len()) { return 0 }
  val gkeys = intBuf(); val gsigs = intBuf()
  var i = 0
  while (i < pfuns.len()) {
    val pf: PFun = pfuns.get(i)
    val gk = pf.owner + ("#" + pf.fd.name)
    val sel = sigSelector(pf.fd.name, pf.fd)
    val gi = indexOfL(gkeys, gk)
    if (gi < 0) { gkeys.push(gk); val l = intBuf(); l.push(sel); gsigs.push(l) }
    else { val l: IntBuf = gsigs.get(gi); if (memListL(l, sel) == false) { l.push(sel) } }
    i = i + 1
  }
  var m = 0
  while (m < pfuns.len()) {
    val pf: PFun = pfuns.get(m)
    val gk = pf.owner + ("#" + pf.fd.name)
    val gi = indexOfL(gkeys, gk)
    val l: IntBuf = gsigs.get(gi)
    if (l.len() >= 2) {
      val sel = sigSelector(pf.fd.name, pf.fd)
      val full = mangleMethod(pf.owner, sel)
      pfuns.set(m, PFun(pf.owner, renameFn(pf.fd, sel)))
      fN.set(m, full)
      remangleRoles(pf.fd.annos, full, roleK, roleV)
      val inst = if (pf.fd.recv == "") { 0 } else { 1 }
      mtAdd(mt, pf.owner, pf.fd.name, "overload", inst, full, paramSigList(pf.fd))
    }
    m = m + 1
  }
  return 0
}

// IntBuf/String/RawMap are nominal builtins: method calls on them mangle to type-scoped wrappers
// (List_push, String_charAt, ...) that are injected as thin wrappers over the builtins. This set is
// exactly the ARC-EXEMPT set, so isBuiltinNominal defers to the shared isArcExempt predicate (defined
// once, in codegen.kite) — the exempt types live in exactly one place, consulted by both ARC sites.
fun isBuiltinNominal(lo: Lo, t: String): Bool { return isArcExemptIn(lo.arcE, t) }

// is `nm` a known nominal TYPE name (struct/class, enum, trait, builtin-nominal, or primitive)? Used to
// recognize a `Type.sel` DOT as a STATIC access, resolved like `Type::sel`.
fun isKnownTypeName(lo: Lo, nm: String): Bool {
  if (memListL(lo.sN, nm)) { return true }
  if (isEnumType(lo.variantOwn, nm)) { return true }
  if (memListL(lo.traitN, nm)) { return true }
  if (isBuiltinNominal(lo, nm)) { return true }
  if (isPrimReg(lo.prim, nm)) { return true }
  return false
}

// `Type.sel` where `Type` is a bare type NAME (not shadowed by a local) is a STATIC access via dot — the
// LOCKED rule binds static methods (and const/assoc reads) on a type with BOTH `.` and `::`. Guarding on
// "not a local" keeps a value named the same as a type on the ordinary instance/field path.
fun isTypeDotBase(lo: Lo, recv: FExpr): Bool {
  val bn = when (recv) { FEIdent(x) -> x; else -> "" }
  if (bn == "") { return false }
  if (localTag(lo, bn) != "?") { return false }
  // A bare VARIANT name (`Unit.debug()`, `Unit.hash()`) is a value expression, NOT a `Type.static` access —
  // even when the variant name collides with a primitive type name (`Unit` is both). Keep it on the value path.
  if (variantOwnerIn(lo.variantN, lo.variantOwn, bn) != "") { return false }
  return isKnownTypeName(lo, bn)
}

// A `Type.Variant` / `Type.Variant(args)` — a DOT-qualified enum-variant construction — is the locked
// cross-use error: variants bind with `::` (`Enum::Variant`), never `.`. Fired in the lowerer so it also
// catches the module-import surface (where the semantic checker is bypassed) — hard-aborts, no binary.
fun rejectDotVariant(m: String): Int { lowFail("enum variant `" + (m + "` must be constructed with `::` not `.`")); return 0 }

// return-type tag of a call, resolving `recv.method(..)` to the mangled method when recv's static
// type is a known struct/class; otherwise the bare callee name (free fn / builtin).
fun funDefined(lo: Lo, nm: String): Bool { return memListL(lo.fN, nm) }

// MODULE-AWARE method resolution (Phase M6). An extension function `fun Int.gcd(..)` / `fun String.charAt(..)`
// desugars (kfront) to a FREE function whose name is the owner-mangle (`Int_gcd`, `String_charAt`). Under a
// NAMESPACE import (`import kite::core::math`) the module system further mangles that free name to
// `<mod>__Int_gcd` (renFunc), while a method call `x.gcd()` computes only the un-mangled `Int_gcd`. Direct
// lookup then misses and method sugar would not bind — the historical "intra-module method-sugar binding
// limitation". resolveFun bridges it: try the un-mangled name directly (the FLAT prelude / self-host path,
// so the compiler's own resolution is byte-identical — the scan below never runs when the direct hit
// succeeds), else find the UNIQUE module-mangled `*__<mangled>` in fN. `__` appears only from module
// mangling and the `__<arity>__` overload segment; an overload variant ends in its param tags, never in
// `__<Type>_<sel>`, so the suffix match is unambiguous. Returns the real emit symbol, or "" if none.
fun resolveFun(lo: Lo, mangled: String): String {
  if (funDefined(lo, mangled)) { return mangled }
  val suf = "__" + mangled
  val sl = suf.len()
  var found = ""
  var c = 0
  var i = 0
  while (i < lo.fN.len()) {
    val fn: String = lo.fN.get(i)
    if (fn.len() > sl) { if (fn.substr(fn.len() - sl, sl) == suf) { found = fn; c = c + 1 } }
    i = i + 1
  }
  if (c == 1) { return found }
  return ""
}

// PRIMITIVE method resolution across the alias<->primary boundary. The checker's canonPrim makes a width
// alias (I8) and its primary (Byte) freely interchangeable, so a value typed as one may legitimately call
// a method declared on the OTHER (`fun Byte.twice` called on an I8, or `impl Hash for U8` called on a
// UByte). But UFCS mangling keys on the RAW receiver-type name, so `x: I8; x.twice()` mangled `I8_twice`
// while the decl emitted `Byte_twice` — the miss slips past both checker and codegen, and codegen then
// emits an owner-less bare `twice` external that dies at dyld load (exit 134, "check ok" masking a crash).
// Route BOTH the call-site owner and the decl owner through the SAME lib-sourced @alias canonicalization
// (lo.prim, the checker's table): try the receiver tag as written, then its canonical PRIMARY, then every
// sibling alias of that primary. Returns the defined mangled name, or "" if none is defined.
fun primMethodCallee(lo: Lo, rt: String, m: String): String {
  val direct = resolveFun(lo, mangleMethod(rt, m))
  if (direct != "") { return direct }
  val prim = canonPrim(lo.prim, rt)
  val pm = resolveFun(lo, mangleMethod(prim, m))
  if (pm != "") { return pm }
  var i = 0
  while (i < lo.prim.aliasFrom.len()) {
    if (lo.prim.aliasTo.get(i) == prim) {
      val am = resolveFun(lo, mangleMethod(lo.prim.aliasFrom.get(i), m))
      if (am != "") { return am }
    }
    i = i + 1
  }
  return ""
}

// resolve `recv.m` to a real method `<Type>_m` when one is defined; otherwise the bare `m`
// (UFCS: `recv.m(a)` calls free function `m(recv, a)`, e.g. `acc.mean()` -> `mean(acc)`).
fun methodCallee(lo: Lo, recv: FExpr, m: String): String {
  val rt = tagOf(lo, recv)
  // trait-typed receiver -> dynamic dispatch through the generated ___dyn_<Trait>_<m> switch
  if (memListL(lo.traitN, rt)) { return "__dyn_" + (rt + ("_" + m)) }
  val mangled = mangleMethod(rt, m)
  // module-aware: an extension `fun Type.m` desugars to a free fn that a namespace import module-mangles;
  // resolveFun finds it (direct hit for the flat/self-host path, else the unique `*__<mangled>`).
  val res = resolveFun(lo, mangled)
  if (memListL(lo.sN, rt) && res != "") { return res }
  if (isBuiltinNominal(lo, rt) && res != "") { return res }
  // enum receiver with a concrete method (e.g. a derived `<Enum>_clone`/`_hash`/`_debug`): dispatch to it.
  if (isEnumType(lo.variantOwn, rt) && res != "") { return res }
  // concrete method defined for THIS receiver tag but the tag is neither struct/class, builtin-nominal, nor
  // enum — i.e. a PRIMITIVE receiver with an inherent/trait impl (`impl Hash for Int` -> `Int_hash`, used by
  // the monomorphized HashMap<Int,_>). Prefer the static impl over the erased dynamic fallback below, which
  // would read a type-id header off a non-pointer word and crash. rt="?" (unknown) never has `?_m` defined,
  // so a truly erased receiver still falls through. The compiler's own sources call no methods on primitives,
  // so this branch never fires for the self-host build (fixpoint untouched). For a primitive receiver the
  // owner may be spelled as the alias or the primary on either side, so canonicalize before mangling.
  if (isPrimReg(lo.prim, rt)) { val pmc = primMethodCallee(lo, rt, m); if (pmc != "") { return pmc } }
  if (res != "") { return res }
  // erased / unknown-typed receiver (e.g. an element pulled from a IntBuf<Shape>): if `m` is a trait method,
  // still dynamic-dispatch on the object's type-id header. Concrete + free-fn cases were handled above.
  val ti = indexOfL(lo.traitMethN, m)
  if (ti >= 0) { return "__dyn_" + (lo.traitMethT.get(ti) + ("_" + m)) }
  // GENERIC EXTENSION (`fun <A,B> A.to(..)`): its single type-erased symbol serves any receiver, so route
  // `x.to(..)` here when no concrete `<rt>_to` matched. Guarded on the bare selector NOT being a defined
  // free fn or intrinsic so an ordinary UFCS free call is never overridden. Inert for the self-host build.
  if (funDefined(lo, m) == false) { if (isIntrinsic(m) == false) { val gx = mtGenExtSym(lo.mt, m); if (gx != "") { return gx } } }
  return m
}

// Phase M3 `--no-check` backstop (item 3). methodCallee's UFCS fallback returns the bare selector `m` for
// `recv.m(..)` == `m(recv, ..)`. When that bare `m` is neither a DEFINED free function nor an intrinsic, the
// emitted call targets an UNDEFINED external symbol — the instance-method arm of the bare-undefined-symbol
// bug family. The M3 checker rejects it before lowering, but a `--no-check` build would otherwise still emit
// a dangling call (dyld crash / garbage). Hard-abort here so NO corrupt binary is produced even without the
// checker. Provably inert for the self-host build: the compiler+stdlib emit no undefined calls (they build
// AND run), so `cal == m` there is always a real free fn / intrinsic and this never fires.
fun requireResolvedMethodCallee(lo: Lo, m: String, cal: String): Int {
  if (cal == m) { if (funDefined(lo, m) == false) { if (isIntrinsic(m) == false) { lowFail("no such method or function `" + (m + "`")) } } }
  return 0
}

// PROPERTY GETTER: a bare `obj.name` (no parens) where `name` is NOT a field resolves to the nullary
// convention method `<Type>_name(obj)` when one is DEFINED. Mirrors methodCallee's "definite method"
// branches (trait-typed / struct-method / builtin-nominal-method / erased-trait-method) but EXCLUDES
// the bare-UFCS fallback: a getter fires only when a real accessor method exists, so plain field
// access and unresolved names keep their existing lowering (this makes the feature purely additive).
fun hasGetterMethod(lo: Lo, recv: FExpr, m: String): Bool {
  val rt = tagOf(lo, recv)
  if (memListL(lo.traitN, rt)) { return true }
  val mangled = mangleMethod(rt, m)
  if (memListL(lo.sN, rt) && funDefined(lo, mangled)) { return true }
  if (isBuiltinNominal(lo, rt) && funDefined(lo, mangled)) { return true }
  if (indexOfL(lo.traitMethN, m) >= 0) { return true }
  return false
}

// PROPERTY SETTER: `obj.name = v` where `name` is NOT a field resolves to the setter convention method
// `<Type>_name_set(obj, v)` when one is DEFINED. Returns "" when there is no setter (caller keeps the
// existing field-store path). Uses the same resolution shape as the getter, on the `<name>_set` method.
fun setterCallee(lo: Lo, recv: FExpr, m: String): String {
  val sm = m + "_set"
  val rt = tagOf(lo, recv)
  if (memListL(lo.traitN, rt)) { val mgd = "__dyn_" + (rt + ("_" + sm)); if (funDefined(lo, mgd)) { return mgd }; return "" }
  val mangled = mangleMethod(rt, sm)
  if (memListL(lo.sN, rt) && funDefined(lo, mangled)) { return mangled }
  if (isBuiltinNominal(lo, rt) && funDefined(lo, mangled)) { return mangled }
  return ""
}

fun hasSetter(lo: Lo, recv: FExpr, m: String): Bool { return setterCallee(lo, recv, m) != "" }

// `Type::method` resolves to the owner-mangled static `Type_method` when one is defined (a derived
// `Point::default` -> `Point_default`, an assoc const `Int::MAX` -> `Int_MAX`). Used by BOTH the call
// lowering and the return-tag inference so a `val d = Type::method()` local infers the right type.
// Phase M3 REMOVED the old bare-symbol fallback (`return m`): a `Type::sel` whose mangle is undefined is no
// longer silently emitted as a bare `sel` symbol (a dangling reference / dyld crash). ENUM-variant `::`
// construction is routed AWAY from here by an isQualVariant guard at every call site, so a miss here is a
// genuine no-such-static — already rejected by the M3 checker before lowering; on a --no-check build it
// hard-aborts (no binary) rather than miscompiling. The trailing `return m` is unreachable (lowFail aborts).
fun staticCallee(lo: Lo, b: FExpr, m: String): String {
  val bn = when (b) { FEIdent(x) -> x; else -> "" }
  val mgd = mangleMethod(bn, m)
  if (bn != "" && funDefined(lo, mgd)) { return mgd }
  lowFail("no such associated member `" + (m + ("` on type " + bn)))
  return m
}

// overload-aware `Type::method(args)` / `Type.method(args)` static resolution: an OVERLOADED static resolves
// against the argument signature first; otherwise it defers to the plain staticCallee (which aborts on a
// genuine miss). Keeps every non-overloaded static call byte-identical.
fun staticCalleeOv(lo: Lo, b: FExpr, m: String, args: IntBuf): String {
  val bn = when (b) { FEIdent(x) -> x; else -> "" }
  val ov = ovResolveVariant(lo, bn, m, args)
  if (ov != "") { return ov }
  return staticCallee(lo, b, m)
}

// `Enum.Variant(args)` (a FEField whose base names the owning enum and whose selector is one of its variants)
// is enum CONSTRUCTION, not a method call. Without this the FEField lowering treats it as UFCS and PREPENDS
// the base `Enum` as arg0 (stored into the payload, dropping the real args) — a silent payload miscompile.
fun isQualVariant(lo: Lo, recv: FExpr, m: String): Bool {
  val rn = when (recv) { FEIdent(x) -> x; else -> "" }
  if (rn == "") { return false }
  return variantOwnerIn(lo.variantN, lo.variantOwn, m) == rn
}

// the emitted SYMBOL a bare free call `nm(args)` resolves to — mirrors lowerFreeIdentCall's resolution
// (overload sig-mangle, then vararg overload) so a call's RETURN TAG is looked up under the SAME symbol the
// lowerer will actually emit. For a non-overloaded, non-vararg name this returns `nm` unchanged, so the
// compiler's own build (no overloads, no vararg) resolves every tag exactly as before — byte-identical.
fun freeCallRetSym(lo: Lo, nm: String, args: IntBuf): String {
  val ov = ovResolveVariant(lo, "", nm, args)
  val base0 = if (ov != "") { ov } else { nm }
  val vsym = varargCalleeSym(lo, "", nm, args.len(), base0)
  if (vsym != "") { return vsym }
  return base0
}
fun callRetTag(lo: Lo, callee: FExpr, args: IntBuf): String {
  return when (callee) {
    FEField(recv, m) -> if (isQualVariant(lo, recv, m)) { variantOwnerIn(lo.variantN, lo.variantOwn, m) } else { if (isTypeDotBase(lo, recv)) { funRetTag(lo, staticCallee(lo, recv, m)) } else { funRetTag(lo, methodCallee(lo, recv, m)) } }
    FEStatic(b, m) -> if (isQualVariant(lo, b, m)) { variantOwnerIn(lo.variantN, lo.variantOwn, m) } else { funRetTag(lo, staticCallee(lo, b, m)) }
    FETypeApp(inner, ta) -> callRetTag(lo, inner, args)
    FEIdent(nm) -> funRetTag(lo, freeCallRetSym(lo, nm, args))
    else -> funRetTag(lo, calleeName(callee))
  }
}

// ---------- [..] list-literal element-type inference (Phase-8 literal FLIP: [..] -> Vec<T>) ----------
// The element type of a `[..]` literal, computed WITHOUT a Lo (only the struct/class-name table `sN`) so
// the SAME routine drives BOTH the pre-lowering mono seeding pass (which has no Lo) and the lowerer. Only
// literal + constructor elements yield a concrete element type; a variable/complex first element, or a
// heterogeneous list, yields "?" (the literal then falls back to the erased IntBuf kernel). An EMPTY list
// yields "" — the caller resolves T from the expected type (a `Vec<T>`-typed let), else keeps IntBuf.
// FEFloat maps to the concrete `Double` (not the coarse "Float" tag) so the mono suffix / sizeOf are exact.
fun litElemLeaf(sN: IntBuf, e: FExpr): String {
  return when (e) {
    FEInt(t) -> "Int"
    FEChar(t) -> "Char"
    FEBool(b) -> "Bool"
    FEFloat(t) -> "Double"
    FEStr(t, r) -> "String"
    FECall(callee, args) -> { val cn = calleeName(callee); if (memListL(sN, cn)) { cn } else { "?" } }
    else -> "?"
  }
}
fun litElemTy(sN: IntBuf, es: IntBuf): String {
  if (es.len() == 0) { return "" }
  val t0 = litElemLeaf(sN, es.get(0))
  if (t0 == "?") { return "?" }
  var i = 1
  while (i < es.len()) { if (litElemLeaf(sN, es.get(i)) != t0) { return "?" }; i = i + 1 }
  return t0
}

// The static tag of a `[..]` literal: the monomorphized `Vec$T` when T is a concrete element type AND that
// specialization was actually instantiated (the mono seeding registered `Vec$T_push`), else the erased
// "IntBuf" fallback (empty `[]`, unknown/heterogeneous elements). The `funDefined` gate makes the existence
// of `Vec$T` the single source of truth shared with lowerList, so tag and lowering can never disagree.
fun listLitTag(lo: Lo, es: IntBuf): String {
  val t = litElemTy(lo.sN, es)
  if (t == "?" || t == "") { return "IntBuf" }
  val mangled = monoMangleTag("Vec", t)
  if (funDefined(lo, mangleMethod(mangled, "push"))) { return mangled }
  return "IntBuf"
}

// ---------- {..} map-literal key/value-type inference (Phase-8 literal FLIP: {k:v} -> HashMap<K,V>) ----------
// The key/value types of a `[k0: v0, ...]` map literal, computed WITHOUT a Lo (only `sN`) so the SAME
// routines drive BOTH the pre-lowering mono seeding pass and the lowerer — mirroring litElemTy for lists.
// Only literal + constructor keys/values yield a concrete type; a variable/complex or heterogeneous
// key (or value) column yields "?", and the literal falls back to the erased RawMap kernel. The map syntax
// `[k:v]` never parses empty (`[]` is an empty LIST), so a FEMap always has >= 1 entry — the len()==0 guard
// is defensive only. Both columns must be concrete AND homogeneous for the literal to flip to HashMap.
fun mapKeyTy(sN: IntBuf, ents: IntBuf): String {
  if (ents.len() == 0) { return "" }
  val e0: FMapEnt = ents.get(0)
  val t0 = litElemLeaf(sN, e0.k)
  if (t0 == "?") { return "?" }
  var i = 1
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); if (litElemLeaf(sN, en.k) != t0) { return "?" }; i = i + 1 }
  return t0
}
fun mapValTy(sN: IntBuf, ents: IntBuf): String {
  if (ents.len() == 0) { return "" }
  val e0: FMapEnt = ents.get(0)
  val t0 = litElemLeaf(sN, e0.v)
  if (t0 == "?") { return "?" }
  var i = 1
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); if (litElemLeaf(sN, en.v) != t0) { return "?" }; i = i + 1 }
  return t0
}
// a monomorphized `HashMap$K_V` map tag (its base type is the `@mono` HashMap template).
fun isHashMapMonoTag(tag: String): Bool { return tag.len() >= 8 && tag.substr(0, 8) == "HashMap$" }

// The static tag of a `[k:v]` map literal: the monomorphized `HashMap$K_V` when K and V are both concrete
// types AND that specialization was instantiated (the mono seeding registered `HashMap$K_V_set`), else the
// erased "RawMap" fallback (unknown/heterogeneous keys or values). The `funDefined` gate makes the existence
// of `HashMap$K_V` the single source of truth shared with lowerMap, so tag and lowering can never disagree.
fun mapLitTag(lo: Lo, ents: IntBuf): String {
  val kt = mapKeyTy(lo.sN, ents)
  val vt = mapValTy(lo.sN, ents)
  if (kt == "?" || kt == "" || vt == "?" || vt == "") { return "RawMap" }
  val mangled = monoMangleTag("HashMap", kt + (", " + vt))
  if (funDefined(lo, mangleMethod(mangled, "set"))) { return mangled }
  return "RawMap"
}

fun tagOf(lo: Lo, e: FExpr): String {
  return when (e) {
    FEInt(t) -> "Int"
    FEChar(t) -> "Char"
    FEBool(b) -> "Bool"
    FEFloat(t) -> "Float"
    FEStr(t, r) -> "String"
    FEInterp(parts, r) -> "String"
    FEList(es) -> listLitTag(lo, es)
    FEMap(ents) -> mapLitTag(lo, ents)
    FEIdent(nm) -> identTag(lo, nm)
    FEThis -> localTag(lo, "this")
    FEUnary(op, x) -> if (op == "not !") { "Bool" } else { tagOf(lo, x) }
    FECast(x, ty) -> if (ty == "Double" || ty == "Float") { "Float" } else { ty }
    FEBin(op, a, b) -> tagBin(lo, op, a, b)
    FECall(callee, args) -> callRetTag(lo, callee, args)
    FEField(a, f) -> fieldTag(lo, a, f)
    FEIndex(a, ix) -> indexTag(lo, a)
    FENotNull(x) -> tagOf(lo, x)
    // if/when result tag: prefer a CONCRETE branch tag. Needed so a `val nm = when {..-> s; else -> ""}`
    // tags as String, which is what routes an `nm == other` to String_eq (else both operands read "?" and
    // `==` wrongly stays a pointer compare — the exact hazard the strEq->== rewrite must avoid).
    FEIf(c, t, el) -> tagJoin2(tagOf(lo, t), tagOf(lo, el))
    FEWhen(hs, bs, subj, arms) -> tagOfArms(lo, arms)
    else -> "?"
  }
}

// the coarse tag of `a[ix]`: `Option` when `a` is a monomorphized HashMap (Kotlin `map[k]: V?`), so
// `m[k].getOr(d)` / `m[k].isSome()` / a `val x = m[k]` binding dispatch to the Option surface. Every other
// receiver keeps "?" — the pre-flip index tag (RawMap/String/Vec/IntBuf indexing is unchanged).
fun indexTag(lo: Lo, a: FExpr): String {
  if (isHashMapMonoTag(tagOf(lo, a))) { return "Option" }
  return "?"
}

// join two coarse tags: prefer a concrete (non-"?") tag. Used to infer if/when result tags.
fun tagJoin2(a: String, b: String): String { if (a == "?") { return b }; return a }

fun tagOfArms(lo: Lo, arms: IntBuf): String {
  var i = 0
  while (i < arms.len()) { val a: FArm = arms.get(i); val t = tagOf(lo, a.body); if (t == "?") { } else { return t }; i = i + 1 }
  return "?"
}

// ---------- expression lowering ----------
fun calleeName(callee: FExpr): String {
  return when (callee) {
    FEIdent(nm) -> nm
    FEField(b, m) -> m
    FEStatic(b, m) -> m
    FETypeApp(inner, ta) -> calleeName(inner)
    else -> ""
  }
}

fun consFront(x: Expr, rest: IntBuf): IntBuf {
  val out = intBuf()
  out.push(x)
  var i = 0
  while (i < rest.len()) { out.push(rest.get(i)); i = i + 1 }
  return out
}

// ---------- closures: lift lambdas + capture enclosing locals ----------
fun one(x: String): IntBuf { val l = intBuf(); l.push(x); return l }

fun extendB(bound: IntBuf, names: IntBuf): IntBuf {
  val nb = intBuf()
  var i = 0
  while (i < bound.len()) { nb.push(bound.get(i)); i = i + 1 }
  var j = 0
  while (j < names.len()) { nb.push(names.get(j)); j = j + 1 }
  return nb
}

fun splitLamNames(s: String): IntBuf {
  val out = intBuf()
  if (s == "") { return out }
  val n = s.len(); var i = 0; var start = 0
  while (i <= n) {
    if (i == n || s.charAt(i) == 44) {
      var e = start; while (e < i && s.charAt(e) == 32) { e = e + 1 }
      var stop = e; while (stop < i && s.charAt(stop) != 58) { stop = stop + 1 }
      out.push(s.substr(e, stop - e)); start = i + 1
    }
    i = i + 1
  }
  return out
}

// per-param annotated type from a lambda header string ("x: Int, y" -> ["Int", ""]); parallel to
// splitLamNames, which extracts the NAMES. "" for a param that carries no `: Ty` annotation. Used so an
// explicit `{ x: Int -> }` types the lambda param even without an expected-type from the call context.
fun splitLamTypes(s: String): IntBuf {
  val out = intBuf()
  if (s == "") { return out }
  val n = s.len(); var i = 0; var start = 0
  while (i <= n) {
    if (i == n || s.charAt(i) == 44) {
      var e = start; while (e < i && s.charAt(e) == 32) { e = e + 1 }
      var col = e; while (col < i && s.charAt(col) != 58) { col = col + 1 }
      if (col < i) { var t = col + 1; while (t < i && s.charAt(t) == 32) { t = t + 1 }; out.push(s.substr(t, i - t)) }
      else { out.push("") }
      start = i + 1
    }
    i = i + 1
  }
  return out
}

fun trimSp(s: String): String {
  val n = s.len(); var a = 0; while (a < n && s.charAt(a) == 32) { a = a + 1 }
  var b = n; while (b > a && s.charAt(b - 1) == 32) { b = b - 1 }
  return s.substr(a, b - a)
}

// domain tags of a function type "(T1, T2) -> R" -> [tyTag(T1), tyTag(T2)]; empty when `ty` is not a
// function type (no "->"). This drives EXPECTED-TYPE lambda-param typing: a lambda passed where the callee
// declares a `(Int) -> Bool` param gets its param bound to Int, so `x.isEven()` inside resolves to Int_isEven.
fun lamDomainTags(ty: String): IntBuf {
  val out = intBuf()
  val n = ty.len()
  var ar = -1; var i = 0
  while (i + 1 < n) { if (ty.charAt(i) == 45 && ty.charAt(i + 1) == 62) { ar = i; i = n + 1 } else { i = i + 1 } }
  if (ar < 0) { return out }
  var dom = trimSp(ty.substr(0, ar))
  val dn = dom.len()
  if (dn >= 2 && dom.charAt(0) == 40 && dom.charAt(dn - 1) == 41) { dom = dom.substr(1, dn - 2) }
  val m = dom.len(); var s = 0; var j = 0
  while (j <= m) {
    if (j == m || dom.charAt(j) == 44) { val seg = trimSp(dom.substr(s, j - s)); if (seg != "") { out.push(tyTag(seg)) }; s = j + 1 }
    j = j + 1
  }
  return out
}

fun patVarsInto(pat: FPat, out: IntBuf): Int {
  when (pat) {
    FPBind(s) -> out.push(s)
    FPCtor(pth, subs) -> { var i = 0; while (i < subs.len()) { patVarsInto(subs.get(i), out); i = i + 1 } 0 }
    FPRecord(pth, flds, hasRest) -> { var i = 0; while (i < flds.len()) { val f: FRFld = flds.get(i); if (f.hasPat == 1) { patVarsInto(f.pat, out) } else { out.push(f.name) }; i = i + 1 } 0 }
    else -> 0
  }
  return 0
}

fun patVars(pat: FPat): IntBuf { val out = intBuf(); patVarsInto(pat, out); return out }

// collect free variables of `e` (referenced idents that are enclosing locals, not bound within `e`)
fun fvArgs(lo: Lo, bound: IntBuf, args: IntBuf, out: IntBuf): Int {
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); fvExpr(lo, bound, a.expr, out); i = i + 1 }
  return 0
}

fun fvList(lo: Lo, bound: IntBuf, es: IntBuf, out: IntBuf): Int {
  var i = 0
  while (i < es.len()) { fvExpr(lo, bound, es.get(i), out); i = i + 1 }
  return 0
}

fun fvInterp(lo: Lo, bound: IntBuf, parts: IntBuf, out: IntBuf): Int {
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); when (pt) { FIExpr(e) -> fvExpr(lo, bound, e, out); else -> 0 }; i = i + 1 }
  return 0
}

fun fvStmt(lo: Lo, bound: IntBuf, s: FStmt, out: IntBuf): IntBuf {
  return when (s) {
    FSLet(isVar, nm, ty, init) -> { fvExpr(lo, bound, init, out); extendB(bound, one(nm)) }
    FSExprS(e) -> { fvExpr(lo, bound, e, out); bound }
    FSAssign(l, r) -> { fvExpr(lo, bound, l, out); fvExpr(lo, bound, r, out); bound }
    FSReturnV(e) -> { fvExpr(lo, bound, e, out); bound }
    FSWhile(c, bd) -> { fvExpr(lo, bound, c, out); fvExpr(lo, bound, bd, out); bound }
    FSFor(v, it, bd) -> { fvExpr(lo, bound, it, out); fvExpr(lo, extendB(bound, one(v)), bd, out); bound }
    else -> bound
  }
}

fun fvBlock(lo: Lo, bound: IntBuf, stmts: IntBuf, res: FExpr, out: IntBuf): Int {
  var b = bound
  var i = 0
  while (i < stmts.len()) { b = fvStmt(lo, b, stmts.get(i), out); i = i + 1 }
  fvExpr(lo, b, res, out)
  return 0
}

fun fvWhen(lo: Lo, bound: IntBuf, hasSubj: Int, subj: FExpr, arms: IntBuf, out: IntBuf): Int {
  if (hasSubj == 1) { fvExpr(lo, bound, subj, out) }
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    var b = bound
    if (a.kind == 2) { var j = 0; while (j < a.pats.len()) { b = extendB(b, patVars(a.pats.get(j))); j = j + 1 } }
    else { if (a.kind == 0) { fvExpr(lo, b, a.lhs, out) } }
    if (isNoResF(a.guard) == false) { fvExpr(lo, b, a.guard, out) }
    fvExpr(lo, b, a.body, out)
    i = i + 1
  }
  return 0
}

fun fvExpr(lo: Lo, bound: IntBuf, e: FExpr, out: IntBuf): Int {
  when (e) {
    FEIdent(nm) -> { if (memListL(bound, nm) == false && memListL(lo.locN, nm) && memListL(out, nm) == false) { out.push(nm) } 0 }
    FEThis -> { if (memListL(bound, "this") == false && memListL(lo.locN, "this") && memListL(out, "this") == false) { out.push("this") } 0 }
    FEUnary(op, x) -> fvExpr(lo, bound, x, out)
    FEBin(op, a, b) -> { fvExpr(lo, bound, a, out); fvExpr(lo, bound, b, out) }
    FEField(a, f) -> fvExpr(lo, bound, a, out)
    FESafeField(a, f) -> fvExpr(lo, bound, a, out)
    FEStatic(a, f) -> fvExpr(lo, bound, a, out)
    FETypeApp(a, t) -> fvExpr(lo, bound, a, out)
    FECast(a, ty) -> fvExpr(lo, bound, a, out)
    FEQuestion(a) -> fvExpr(lo, bound, a, out)
    FENotNull(a) -> fvExpr(lo, bound, a, out)
    FEElvis(a, b) -> { fvExpr(lo, bound, a, out); fvExpr(lo, bound, b, out) }
    FEIndex(a, b) -> { fvExpr(lo, bound, a, out); fvExpr(lo, bound, b, out) }
    FECall(callee, args) -> { fvExpr(lo, bound, callee, out); fvArgs(lo, bound, args, out) }
    FEList(es) -> fvList(lo, bound, es, out)
    FEInterp(parts, r) -> fvInterp(lo, bound, parts, out)
    FERet(x) -> fvExpr(lo, bound, x, out)
    FEIf(c, t, el) -> { fvExpr(lo, bound, c, out); fvExpr(lo, bound, t, out); fvExpr(lo, bound, el, out) }
    FELambda(params, body) -> fvExpr(lo, extendB(bound, splitLamNames(params)), body, out)
    FEBlock(stmts, res) -> fvBlock(lo, bound, stmts, res, out)
    FEWhen(hasSubj, bind, subj, arms) -> fvWhen(lo, bound, hasSubj, subj, arms, out)
    else -> 0
  }
  return 0
}

// { params -> body }  ->  lift a top-level __lamN(env, params) that reads captures from env;
// the site evaluates to a closure __closNew("__lamN", cap0, cap1, ...).
// tag for lambda param i: an explicit annotation (`{ x: Int -> }`) wins, else the expected domain tag from
// the call context (expTags), else "?" (unknown, as before). This is what makes method-sugar on a lambda
// param resolve — the param now has a concrete tag in the lifted body's local env.
fun lamParamTag(ptypes: IntBuf, expTags: IntBuf, i: Int): String {
  if (i < ptypes.len()) { val a: String = ptypes.get(i); if (a != "") { return tyTag(a) } }
  if (i < expTags.len()) { return expTags.get(i) }
  return "?"
}

fun lowerLambda(lo: Lo, params: String, body: FExpr, expTags: IntBuf): Expr {
  val id: Int = lo.gctr.get(0); lo.gctr.set(0, id + 1)
  val name = "__lam" + id.toStr()
  val pnames = splitLamNames(params)
  val ptypes = splitLamTypes(params)
  val bound = intBuf()
  var pi = 0; while (pi < pnames.len()) { bound.push(pnames.get(pi)); pi = pi + 1 }
  val caps = intBuf()
  fvExpr(lo, bound, body, caps)
  // lifted function: params = env + lambda params; body loads captures then runs
  val lnames = intBuf(); lnames.push("env")
  val ltys = intBuf(); ltys.push("?")
  var qi = 0; while (qi < pnames.len()) { lnames.push(pnames.get(qi)); ltys.push("?"); qi = qi + 1 }
  val lctr = intBuf(); lctr.push(0)
  val llo = Lo(lctr, intBuf(), intBuf(), lo.fN, lo.fR, lo.sN, lo.sFN, lo.sFT, lo.lifted, lo.gctr, lo.classN, intBuf(), lo.traitN, lo.constN, lo.constV, lo.cfuncs, lo.traitMethN, lo.traitMethT, lo.pmN, lo.pmM, lo.variantN, lo.variantTys, lo.variantOwn, lo.roleK, lo.roleV, lo.arcE, lo.valueE, lo.prim, lo.fpN, lo.fpT, lo.mt, lo.vareg)
  bindLoc(llo, "env", "?")
  var ri = 0; while (ri < pnames.len()) { bindLoc(llo, pnames.get(ri), lamParamTag(ptypes, expTags, ri)); ri = ri + 1 }
  val lstmts = intBuf()
  var ci = 0
  while (ci < caps.len()) {
    val cn: String = caps.get(ci)
    bindLoc(llo, cn, localTag(lo, cn))
    val ga = intBuf(); ga.push(EIdent("env")); ga.push(EInt(ci.toStr()))
    lstmts.push(SLet(cn, ECall("__closGet", ga)))
    ci = ci + 1
  }
  val lbody = lowerExpr(llo, body)
  lo.lifted.push(Func(name, lnames, ltys, EBlock(lstmts, lbody)))
  // closure value: __closNew("__lamN", cap0, cap1, ...)
  val cargs = intBuf(); cargs.push(EStr(name))
  var di = 0; while (di < caps.len()) { cargs.push(EIdent(caps.get(di))); di = di + 1 }
  return ECall("__closNew", cargs)
}

// a bare NAMED-FUNCTION reference in value position (e.g. `dbl` in `xs.map(dbl)`) is a first-class
// function value. The closure ABI passes the closure block itself as arg0 (env) then the real args, and
// blr's [env+0]; a top-level `fun dbl(x)` has NO env param, so we cannot point the closure straight at it.
// Synthesize a thin THUNK `__frefN(env, __a0..__a{k-1}) { dbl(__a0, ..) }` that drops env and forwards to
// the named function, then hand back `__closNew("__frefN")` (no captures). k = the callback's arity, taken
// from the expected function-type param slot. This lets `xs.map(dbl).sum()` work exactly like a lambda.
fun funRefClosure(lo: Lo, nm: String, arity: Int): Expr {
  val id: Int = lo.gctr.get(0); lo.gctr.set(0, id + 1)
  val fname = "__fref" + id.toStr()
  val lnames = intBuf(); lnames.push("env")
  val ltys = intBuf(); ltys.push("?")
  val callArgs = intBuf()
  var i = 0
  while (i < arity) { val pn = "__a" + i.toStr(); lnames.push(pn); ltys.push("?"); callArgs.push(EIdent(pn)); i = i + 1 }
  lo.lifted.push(Func(fname, lnames, ltys, EBlock(intBuf(), ECall(nm, callArgs))))
  val cargs = intBuf(); cargs.push(EStr(fname))
  return ECall("__closNew", cargs)
}

// argument in call-position `pidx` of `callee` that is a bare identifier: when it names a top-level FUNCTION
// (not a local closure value, not a const) AND the callee declares this slot as a function type, lower it to
// a named-function-reference closure (funRefClosure). Otherwise it is an ordinary value ident.
fun lowerArgIdent(lo: Lo, callee: String, pidx: Int, nm: String): Expr {
  if (memListL(lo.locN, nm) == false && funDefined(lo, nm)) {
    val dom = lamDomainFor(lo, callee, pidx)
    if (dom.len() > 0) { return funRefClosure(lo, nm, dom.len()) }
  }
  return lowerExpr(lo, FEIdent(nm))
}

fun closCall(lo: Lo, envE: Expr, args: IntBuf): Expr { return ECall("__closCall", consFront(envE, lowerArgs(lo, args))) }

fun lowerArgs(lo: Lo, args: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < args.len()) {
    val a: FArg = args.get(i)
    var e = lowerExpr(lo, a.expr)
    // @value CoW: an existing value-type lvalue passed as an argument (a non-receiver call operand, incl.
    // constructor fields) is passed by value COPY, so the callee owns its own handle and cannot alias-mutate
    // the caller's. A fresh temporary already owns its buffer and moves in. (The method receiver is lowered
    // separately, never through here, so `self` is a borrow and mutations write back.)
    val t = tagOf(lo, a.expr)
    if (isValueTag(lo, t)) { if (isCopyLvalue(a.expr)) { val ca = intBuf(); ca.push(e); e = ECall(mangleMethod(t, "copy"), ca) } }
    out.push(e)
    i = i + 1
  }
  return out
}

fun argExprAt(args: IntBuf, i: Int): FExpr { val a: FArg = args.get(i); return a.expr }

// declared type of parameter `i` of function `fname` (mangled), from the whole-program param-type table
// (fpN/fpT, built in finishLower over every pfun). "" when unknown (name absent / index past the arity),
// in which case a lambda arg falls back to "?" params — the pre-fix behavior.
fun funParamTypeAt(lo: Lo, fname: String, i: Int): String {
  var k = 0
  while (k < lo.fpN.len()) {
    if (lo.fpN.get(k) == fname) { val tys: IntBuf = lo.fpT.get(k); if (i < tys.len()) { return tys.get(i) }; return "" }
    k = k + 1
  }
  return ""
}

// declared parameter arity of function `fname` (mangled), from the whole-program param-type table; -1 when
// `fname` is not a defined function. An assoc const `Int::MAX` is emitted as a NULLARY function `Int_MAX()`,
// so `funArity(lo, "Int_MAX") == 0` marks a `Type::sel` VALUE that must be CALLED to yield the constant (a
// bare `EIdent` would be the function's ADDRESS, not its value — the Int::MAX miscompile).
fun funArity(lo: Lo, fname: String): Int {
  var k = 0
  while (k < lo.fpN.len()) { if (lo.fpN.get(k) == fname) { val tys: IntBuf = lo.fpT.get(k); return tys.len() }; k = k + 1 }
  return 0 - 1
}

// expected-type domain tags for a lambda arg at call-position `paramIdx` of `callee`: parse the callee's
// declared param type as a function type and return its domain tags (empty when not a function type).
fun lamDomainFor(lo: Lo, callee: String, paramIdx: Int): IntBuf { return lamDomainTags(funParamTypeAt(lo, callee, paramIdx)) }

// argument lowering that types LAMBDA args from the callee's declared parameter types. `offset` is the gap
// between the arg list and the callee's param list: 1 for a method/UFCS call (the receiver is param 0 and is
// lowered separately), 0 for a plain/static call. Every NON-lambda arg lowers exactly as lowerArgs does
// (same lowerExpr + @value CoW copy), so this is byte-identical except where a lambda param gains a tag.
fun lowerArgsFor(lo: Lo, callee: String, offset: Int, args: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < args.len()) {
    val a: FArg = args.get(i)
    var e = when (a.expr) {
      FELambda(params, body) -> lowerLambda(lo, params, body, lamDomainFor(lo, callee, i + offset))
      FEIdent(nm) -> lowerArgIdent(lo, callee, i + offset, nm)
      else -> lowerExpr(lo, a.expr)
    }
    val t = tagOf(lo, a.expr)
    if (isValueTag(lo, t)) { if (isCopyLvalue(a.expr)) { val ca = intBuf(); ca.push(e); e = ECall(mangleMethod(t, "copy"), ca) } }
    out.push(e)
    i = i + 1
  }
  return out
}

// true iff the call has exactly one Float argument. NOTE: `&&` is NOT short-circuit here (bitwise), so
// this MUST guard the length internally before touching args[0] — else a zero-arg call reads out of bounds.
fun oneFloatArg(lo: Lo, args: IntBuf): Bool {
  if (args.len() != 1) { return false }
  return tagOf(lo, argExprAt(args, 0)) == "Float"
}

// A bare ident that is a LOCAL is a closure value -> indirect call; otherwise a direct call to a
// top-level function/ctor. obj.m(args) is a method (UFCS). Any other callee is a closure value.
// ---------- comptime: fold a constant expression at compile time ----------
// `comptime(expr)` is evaluated by the compiler and replaced by its integer-literal result, so the
// runtime never computes it. v1 grammar: int/bool/char literals, unary minus, and the binary
// arithmetic/bitwise/shift/comparison operators — all constant-foldable. (Compile-time evaluation of
// user function calls is future work.)
fun cevalBin(op: String, a: Int, b: Int): Int {
  if (op == "+") { return a + b }
  if (op == "-") { return a - b }
  if (op == "*") { return a * b }
  if (op == "/") { return a / b }
  if (op == "%") { return a - (a / b) * b }
  if (op == "<<") { return a << b }
  if (op == ">>") { return a >> b }
  if (op == "&") { return a & b }
  if (op == "|") { return a | b }
  if (op == "^") { return a ^ b }
  if (op == "==") { if (a == b) { return 1 } return 0 }
  if (op == "!=") { if (a != b) { return 1 } return 0 }
  if (op == "<") { if (a < b) { return 1 } return 0 }
  if (op == ">") { if (a > b) { return 1 } return 0 }
  if (op == "<=") { if (a <= b) { return 1 } return 0 }
  if (op == ">=") { if (a >= b) { return 1 } return 0 }
  return 0
}

// A small compile-time INTEGER interpreter. `comptime(expr)` / `const NAME = expr` are evaluated here and
// replaced by their integer result. Supports literals, arithmetic/bitwise/compare, params/locals (val/var),
// if, while, return, and CALLS to pure integer functions (incl. recursion), via the function table `funcs`.
// Pure-integer only: no heap (lists/strings/structs), no side effects. `names`/`vals` are the variable env.
fun ceVarGet(names: IntBuf, vals: IntBuf, nm: String): Int {
  var i = names.len() - 1
  while (i >= 0) { if (names.get(i) == nm) { return vals.get(i) }; i = i - 1 }
  return 0
}

fun ceVarSet(names: IntBuf, vals: IntBuf, nm: String, v: Int): Int {
  var i = names.len() - 1
  while (i >= 0) { if (names.get(i) == nm) { vals.set(i, v); return 0 }; i = i - 1 }
  return 0
}

fun ceFindFunc(funcs: IntBuf, nm: String): Int {
  var i = 0
  while (i < funcs.len()) { val f: FFunc = funcs.get(i); if (f.name == nm) { return i }; i = i + 1 }
  return 0 - 1
}

// The compile-time interpreter carries REAL Kite heap values (strings, lists) as machine words through
// `Int` — legitimate in the boxed/erased model (a word is a word). So `comptime(...)` may COMPUTE strings and
// lists (build a list in a loop, concat strings, ...) and reduce an Int-valued result. FEStr yields the string
// word; FEList builds a real list by evaluating each element; the string/list builtins run for real.
fun ceBuildList(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, es: IntBuf): Int {
  val l = ceLNew()
  var i = 0
  while (i < es.len()) { ceLPush(l, ceEval(names, vals, kinds, funcs, es.get(i))); i = i + 1 }
  return l
}

// coarse comptime value KIND ("String" / "IntBuf" / "Int"): the erased-word interpreter has no runtime type
// tag, and now that String's ops are methods, `.len()`/`.length` are defined on BOTH String and IntBuf — so
// they are routed by the RECEIVER'S kind, inferred from its expression shape plus the parallel `kinds` env
// (bound per variable at let/param time). charAt/substr/toStr (String-only) and get/set/push (IntBuf-only)
// stay unambiguous by name.
fun ceKindFromTy(ty: String): String {
  val tg = tyTag(stripMode(ty))
  if (tg == "String") { return "String" }
  if (tg == "IntBuf") { return "IntBuf" }
  return "Int"
}

fun ceKindGet(names: IntBuf, kinds: IntBuf, nm: String): String {
  var i = names.len() - 1
  while (i >= 0) { if (names.get(i) == nm) { return kinds.get(i) }; i = i - 1 }
  return "Int"
}

fun ceCallKind(callee: FExpr): String {
  return when (callee) {
    FEField(recv, m) -> if (m == "substr" || m == "toStr") { "String" } else { "Int" }
    FEIdent(nm) -> if (nm == "intBuf") { "IntBuf" } else { "Int" }
    else -> "Int"
  }
}

fun ceKindOf(names: IntBuf, kinds: IntBuf, funcs: IntBuf, e: FExpr): String {
  return when (e) {
    FEStr(t, r) -> "String"
    FEInterp(parts, r) -> "String"
    FEList(es) -> "IntBuf"
    FEIdent(nm) -> ceKindGet(names, kinds, nm)
    FEBin(op, a, b) -> if (op == "+" && (ceKindOf(names, kinds, funcs, a) == "String" || ceKindOf(names, kinds, funcs, b) == "String")) { "String" } else { "Int" }
    FECall(callee, args) -> ceCallKind(callee)
    else -> "Int"
  }
}

fun ceEval(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, e: FExpr): Int {
  return when (e) {
    FEInt(t) -> parseIntK(litNum(t))
    FEChar(t) -> parseIntK(t)
    FEBool(b) -> if (b == "true") { 1 } else { 0 }
    // The comptime interpreter models a string as a RAW NUL-terminated C-string pointer throughout (ceSLen /
    // ceSConcat / ceSubstr / ceIntToStr all read+produce raw buffers). Under the boxed `class String`, a
    // literal `t` is a `String(n,data)` box, so hand the interpreter its `.data` pointer — keeping the erased
    // comptime-string word RAW and consistent with the computed-string results.
    FEStr(t, r) -> t.data
    FEList(es) -> ceBuildList(names, vals, kinds, funcs, es)
    FEIdent(nm) -> ceVarGet(names, vals, nm)
    FEUnary(op, x) -> 0 - ceEval(names, vals, kinds, funcs, x)
    FEBin(op, a, b) -> ceEvalBin(names, vals, kinds, funcs, op, a, b)
    FEIf(c, t, el) -> if (ceEval(names, vals, kinds, funcs, c) != 0) { ceEval(names, vals, kinds, funcs, t) } else { ceEval(names, vals, kinds, funcs, el) }
    FECall(callee, args) -> ceCall(names, vals, kinds, funcs, callee, args)
    FEBlock(stmts, res) -> ceRunBody(names, vals, kinds, funcs, e)
    // A no-result expression (an else-less `if`'s empty else branch, an empty block tail) evaluates to
    // the unit value 0 at comptime. Before Phase 0.5's lowFail hard-abort this fell through to lowFail and
    // silently returned 0 anyway; now it must be handled explicitly so a valid comptime fn (e.g. fib's
    // `if (n<2){return n}`) does not abort the build.
    FENoRes -> 0
    else -> { lowFail("comptime: unsupported expression"); 0 }
  }
}

// `+` with a String operand is concatenation (String_add on the erased words); otherwise integer arithmetic.
fun ceEvalBin(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, op: String, a: FExpr, b: FExpr): Int {
  val va = ceEval(names, vals, kinds, funcs, a)
  val vb = ceEval(names, vals, kinds, funcs, b)
  if (op == "+" && (ceKindOf(names, kinds, funcs, a) == "String" || ceKindOf(names, kinds, funcs, b) == "String")) { return ceSConcat(va, vb) }
  return cevalBin(op, va, vb)
}

// comptime string concatenation on the erased words. Mirrors `impl Add for String` (String_add), but is
// spelled with the raw-memory intrinsics + the raw ceSLen so no String-typed value flows through the
// erased Int word (the checker does not expose the impl-mangled String_add as a callable free name, and
// arg-type-checks String_len's String parameter).
fun ceSConcat(a: Int, b: Int): Int {
  val la = ceSLen(a)
  val lb = ceSLen(b)
  val r = __rawAlloc(la + lb + 1)
  var i = 0
  while (i < la) { __rawStoreByte(r, i, __rawLoadByte(a, i)) i = i + 1 }
  var j = 0
  while (j < lb) { __rawStoreByte(r, la + j, __rawLoadByte(b, j)) j = j + 1 }
  __rawStoreByte(r, la + lb, 0)
  return r
}

fun ceArg(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, args: IntBuf, i: Int): Int { val a: FArg = args.get(i); return ceEval(names, vals, kinds, funcs, a.expr) }

// list builtins for the comptime interpreter. It threads erased IntBuf words through `Int`, so these read
// and write the word directly via the raw-memory intrinsics on IntBuf's layout {n@0, cap@8, data@16} (see
// lib/alloc/collections/list.kite). Intrinsics are untyped to the checker, so the Int word passes with no
// IntBuf-typed reinterpret cast (a compiler-source `l: IntBuf` param would reject the Int arg). ceLPush
// mirrors IntBuf.push's grow-if-full.
fun ceLLen(w: Int): Int { return __rawLoad(w, 0) }

fun ceLGet(w: Int, i: Int): Int { return __rawLoad(__rawLoad(w, 16), i * 8) }

fun ceLSet(w: Int, i: Int, x: Int): Int { __rawStore(__rawLoad(w, 16), i * 8, x) return 0 }

fun ceLPush(w: Int, x: Int): Int {
  var n = __rawLoad(w, 0)
  var cap = __rawLoad(w, 8)
  var data = __rawLoad(w, 16)
  if (n == cap) { if (cap == 0) { cap = 4 } else { cap = cap * 2 } data = __rawRealloc(data, cap * 8) __rawStore(w, 8, cap) __rawStore(w, 16, data) }
  __rawStore(data, n * 8, x)
  __rawStore(w, 0, n + 1)
  return 0
}

// Raw Int-word String helpers for the comptime interpreter — the String counterparts of ceLLen/ceLGet/
// ceLPush. They compute on the erased word with ONLY the untyped raw-memory intrinsics, so a String-typed
// value never flows through the universal `Int` word (which the checker, once it arg-type-checks prelude
// calls, would reject if the erased word were handed to String_len/String_charAt/… directly). Bodies
// mirror lib/core/string.kite's String_len / String_substr / Int_toStr.
fun ceSLen(w: Int): Int { var i = 0 while (__rawLoadByte(w, i) != 0) { i = i + 1 } return i }

fun ceSubstr(w: Int, st: Int, len: Int): Int {
  val r = __rawAlloc(len + 1)
  var i = 0
  while (i < len) { __rawStoreByte(r, i, __rawLoadByte(w, st + i)) i = i + 1 }
  __rawStoreByte(r, len, 0)
  return r
}

fun ceIntToStr(n: Int): Int {
  if (n == 0) { val z = __rawAlloc(2) __rawStoreByte(z, 0, 48) __rawStoreByte(z, 1, 0) return z }
  var neg = 0
  var m = n
  if (n < 0) { neg = 1 m = 0 - n }
  var digits = 0
  var t = m
  while (t > 0) { digits = digits + 1 t = t / 10 }
  val total = digits + neg
  val r = __rawAlloc(total + 1)
  __rawStoreByte(r, total, 0)
  var pos = total - 1
  var mm = m
  while (mm > 0) { val d = mm - (mm / 10) * 10 __rawStoreByte(r, pos, 48 + d) pos = pos - 1 mm = mm / 10 }
  if (neg == 1) { __rawStoreByte(r, 0, 45) }
  return r
}

// A fresh empty comptime IntBuf as an erased Int word, laid out {n@0, cap@8, data@16} exactly like intBuf()
// (lib/alloc/collections/list.kite) so ceLGet/ceLSet/ceLPush/ceLLen operate on it. Header-less (the
// comptime evaluator never releases these — leak-managed like the rest).
fun ceLNew(): Int { val w = __rawAlloc(24) __rawStore(w, 0, 0) __rawStore(w, 8, 4) __rawStore(w, 16, __rawAlloc(32)) return w }

// method-call form `recv.m(args)` in comptime code. String methods run the raw-word ops on the erased
// word; IntBuf methods (the [..]/index desugar methods) run the raw-layout ops; `.len()`/`.length` (on both)
// is routed by the receiver's inferred kind.
fun ceMethodCall(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, recv: FExpr, m: String, args: IntBuf): Int {
  val r = ceEval(names, vals, kinds, funcs, recv)
  if (m == "charAt" && args.len() == 1) { return __rawLoadByte(r, ceArg(names, vals, kinds, funcs, args, 0)) }
  if (m == "substr" && args.len() == 2) { return ceSubstr(r, ceArg(names, vals, kinds, funcs, args, 0), ceArg(names, vals, kinds, funcs, args, 1)) }
  if (m == "toStr" && args.len() == 0) { return ceIntToStr(r) }
  if (m == "push" && args.len() == 1) { return ceLPush(r, ceArg(names, vals, kinds, funcs, args, 0)) }
  if (m == "get" && args.len() == 1) { return ceLGet(r, ceArg(names, vals, kinds, funcs, args, 0)) }
  if (m == "set" && args.len() == 2) { return ceLSet(r, ceArg(names, vals, kinds, funcs, args, 0), ceArg(names, vals, kinds, funcs, args, 1)) }
  if ((m == "len" || m == "length") && args.len() == 0) {
    if (ceKindOf(names, kinds, funcs, recv) == "String") { return ceSLen(r) }
    return ceLLen(r)
  }
  return 0
}

fun ceCall(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, callee: FExpr, args: IntBuf): Int {
  return when (callee) {
    FEField(recv, m) -> ceMethodCall(names, vals, kinds, funcs, recv, m, args)
    else -> ceFreeCall(names, vals, kinds, funcs, calleeName(callee), args)
  }
}

fun ceFreeCall(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, fn: String, args: IntBuf): Int {
  if (fn == "intBuf" && args.len() == 0) { return ceLNew() }
  val idx = ceFindFunc(funcs, fn)
  if (idx < 0) { return 0 }
  val fd: FFunc = funcs.get(idx)
  val pn = intBuf(); val pv = intBuf(); val pk = intBuf()
  var i = 0
  while (i < fd.params.len()) {
    val pp: FParam = fd.params.get(i); val av: FArg = args.get(i)
    pn.push(pp.name); pv.push(ceEval(names, vals, kinds, funcs, av.expr)); pk.push(ceKindFromTy(pp.ty)); i = i + 1
  }
  return ceRunBody(pn, pv, pk, funcs, fd.body)
}

fun ceRunBody(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, body: FExpr): Int {
  return when (body) {
    FEBlock(stmts, res) -> {
      val ret = intBuf(); ret.push(0); ret.push(0) // [returned?, value]
      ceExec(names, vals, kinds, funcs, stmts, ret)
      if (ret.get(0) == 1) { ret.get(1) } else { if (isNoResF(res)) { 0 } else { ceEval(names, vals, kinds, funcs, res) } }
    }
    else -> ceEval(names, vals, kinds, funcs, body)
  }
}

// execute an expression in STATEMENT position, propagating `return` up through nested if/blocks via the
// shared `ret` cell (so `if (c) { return x }` returns from the enclosing function, not just the block).
fun ceExecExpr(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, e: FExpr, ret: IntBuf): Int {
  when (e) {
    FEIf(c, t, el) -> { if (ceEval(names, vals, kinds, funcs, c) != 0) { ceExecExpr(names, vals, kinds, funcs, t, ret) } else { ceExecExpr(names, vals, kinds, funcs, el, ret) } }
    FEBlock(stmts, res) -> { ceExec(names, vals, kinds, funcs, stmts, ret); if (isNoResF(res) == false && ret.get(0) == 0) { ceExecExpr(names, vals, kinds, funcs, res, ret) }; 0 }
    FERet(x) -> { ret.set(1, ceEval(names, vals, kinds, funcs, x)); ret.set(0, 1); 0 }
    else -> { ceEval(names, vals, kinds, funcs, e); 0 }
  }
  return 0
}

fun ceExec(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, stmts: IntBuf, ret: IntBuf): Int {
  var i = 0
  while (i < stmts.len() && ret.get(0) == 0) {
    val s: FStmt = stmts.get(i)
    when (s) {
      FSLet(isVar, nm, ty, init) -> { val v = ceEval(names, vals, kinds, funcs, init); val kd = ceKindOf(names, kinds, funcs, init); names.push(nm); vals.push(v); kinds.push(kd); 0 }
      FSReturnV(x) -> { ret.set(1, ceEval(names, vals, kinds, funcs, x)); ret.set(0, 1); 0 }
      FSReturnU -> { ret.set(0, 1); 0 }
      FSAssign(lhs, rhs) -> { val v = ceEval(names, vals, kinds, funcs, rhs); ceExecAssign(names, vals, lhs, v); 0 }
      FSWhile(c, b) -> { ceWhile(names, vals, kinds, funcs, c, b, ret); 0 }
      FSExprS(x) -> { ceExecExpr(names, vals, kinds, funcs, x, ret); 0 }
      else -> 0
    }
    i = i + 1
  }
  return 0
}

fun ceExecAssign(names: IntBuf, vals: IntBuf, lhs: FExpr, v: Int): Int {
  when (lhs) { FEIdent(nm) -> { ceVarSet(names, vals, nm, v); 0 } else -> 0 }
  return 0
}

fun ceWhile(names: IntBuf, vals: IntBuf, kinds: IntBuf, funcs: IntBuf, c: FExpr, body: FExpr, ret: IntBuf): Int {
  while (ceEval(names, vals, kinds, funcs, c) != 0 && ret.get(0) == 0) {
    ceExecExpr(names, vals, kinds, funcs, body, ret)
  }
  return 0
}

// top-level constant-expression eval (empty variable env)
fun ceval(funcs: IntBuf, e: FExpr): Int { return ceEval(intBuf(), intBuf(), intBuf(), funcs, e) }

// comptime eval that seeds the env with the program's consts (so comptime(SOME_CONST + 1) works)
fun cevalWithConsts(lo: Lo, e: FExpr): Int {
  val en = intBuf(); val ev = intBuf(); val ek = intBuf()
  var i = 0
  while (i < lo.constN.len()) { en.push(lo.constN.get(i)); ev.push(parseIntK(lo.constV.get(i))); ek.push("Int"); i = i + 1 }
  return ceEval(en, ev, ek, lo.cfuncs, e)
}

fun paramModeAt(lo: Lo, fname: String, i: Int): String {
  var k = 0
  while (k < lo.pmN.len()) {
    if (lo.pmN.get(k) == fname) { val modes: IntBuf = lo.pmM.get(k); if (i < modes.len()) { return modes.get(i) }; return "" }
    k = k + 1
  }
  return ""
}

// a builtin whose arg is STORED (transferred), so the caller must NOT release the temp it passes.
fun isStoringBuiltin(nm: String): Bool {
  return nm == "IntBuf_push" || nm == "IntBuf_set" || nm == "__rawStore" || nm == "__rawStoreByte" || nm == "__closNew"
}

// a class-typed fresh constructor passed as an argument is an owned temporary needing lifetime handling.
fun argIsClassTemp(lo: Lo, e: FExpr): Bool {
  if (isFreshCtor(lo, e) == false) { return false }
  return isClassTag(lo, tagOf(lo, e))
}

// TRANSFER (callee takes ownership, do NOT release): a constructor, a storing builtin, or a `consuming` param.
// Otherwise BORROW: the caller keeps ownership and must release the temp after the call.
fun argTransfers(lo: Lo, nm: String, i: Int): Bool {
  if (memListL(lo.sN, nm)) { return true }
  if (isStoringBuiltin(nm)) { return true }
  if (paramModeAt(lo, nm, i) == "consuming") { return true }
  return false
}

// Plain free-function call. If any class-temp arg is BORROWED, spill EVERY arg to a temp (preserving
// left-to-right evaluation order), call, then release the borrowed temps after the call. No class temps
// => emit the plain ECall unchanged (so the class-free compiler self-hosts byte-for-byte on this path).
// a borrow-temp is released after the call ONLY if the callee CANNOT alias it into its result — i.e. the
// callee returns a non-class. If the callee returns a class, its result may BE the arg (identity/passthrough),
// so releasing would be a use-after-free; we conservatively leak instead (never a double-free/UAF).
fun argNeedsRelease(lo: Lo, nm: String, i: Int, e: FExpr): Bool {
  if (argIsClassTemp(lo, e) == false) { return false }
  if (argTransfers(lo, nm, i)) { return false }
  if (isClassTag(lo, funRetTag(lo, nm))) { return false }
  return true
}

fun lowerPlainCall(lo: Lo, nm: String, args: IntBuf): Expr {
  var need = 0
  var i = 0
  while (i < args.len()) { if (argNeedsRelease(lo, nm, i, argExprAt(args, i))) { need = 1 }; i = i + 1 }
  if (need == 0) { return ECall(nm, lowerArgsFor(lo, nm, 0, args)) }
  val stmts = intBuf()
  val callArgs = intBuf()
  val rels = intBuf()
  var j = 0
  while (j < args.len()) {
    val ae = argExprAt(args, j)
    val t = freshName(lo, "_at")
    stmts.push(SLet(t, lowerExpr(lo, ae)))
    callArgs.push(EIdent(t))
    if (argNeedsRelease(lo, nm, j, ae)) { rels.push(t) }
    j = j + 1
  }
  val rn = freshName(lo, "_ar")
  stmts.push(SLet(rn, ECall(nm, callArgs)))
  var r = 0
  while (r < rels.len()) { val ra = intBuf(); ra.push(EIdent(rels.get(r))); stmts.push(SExprS(ECall("__release", ra))); r = r + 1 }
  return EBlock(stmts, EIdent(rn))
}

// ---------- Phase 6: comptime sizeOf<T>() + packed element access (the monomorphization keystone) ----------
// The packed byte size of a type: scalars from the primitive registry (an integer strides by its width,
// Bool 1, Char 4, Double one word, Unit 0), a struct by the sum of its (packed) field sizes, and a class /
// erased / unknown type by one reference word. This is what Vec<T> strides its inline storage by, so
// `sizeOf::<U16>()` is 2 and `Vec<U16>` packs two bytes per element instead of IntBuf's eight.
fun sizeOfTy(lo: Lo, ty: String): Int {
  val t = tyTag(stripMode(ty))
  val k = primKind(lo.prim, t)
  if (k == 1 || k == 2) { return primBits(lo.prim, t) / 8 }
  if (k == 3) { return 8 }
  if (k == 4) { return 1 }
  if (k == 5) { return 4 }
  if (k == 6) { return 8 }
  if (k == 7) { return 0 }
  if (k == 9) { return 16 }
  // A reference CLASS packs as ONE pointer word. A `class` is also recorded in sN (for construction), so
  // without this it would fall through to the struct-field SUM below and stride by its inline field bytes
  // (e.g. `class Box(v: Int)` -> 4) — truncating the 8-byte element pointer on the packed 32-bit store/load
  // and corrupting it. ARC-exempt collections (String/IntBuf/RawMap) are excluded (isClassTag is false for
  // them) so they keep their established packing; INERT for the compiler's own build (no class-element mono).
  if (isClassTag(lo, t)) { return 8 }
  val si = indexOfL(lo.sN, t)
  if (si >= 0) {
    val fts: IntBuf = lo.sFT.get(si)
    var sum = 0
    var i = 0
    while (i < fts.len()) { sum = sum + sizeOfTy(lo, fts.get(i)); i = i + 1 }
    return sum
  }
  return 8
}

// The width/sign-correct raw load intrinsic for an element of type T: unsigned zero-extends, signed
// sign-extends, an 8-byte element is the plain word load. Element ops are DIRECT (a concrete sized load
// chosen at instantiation from the fully-known T), not a runtime dispatch on a stored size — the point of
// monomorphization.
fun packedLoadName(lo: Lo, ty: String): String {
  val t = tyTag(stripMode(ty))
  val sz = sizeOfTy(lo, t)
  val signed = primIsSigned(lo.prim, t)
  if (sz == 1) { if (signed) { return "__rawLoad8S" } else { return "__rawLoadByte" } }
  if (sz == 2) { if (signed) { return "__rawLoad16S" } else { return "__rawLoad16" } }
  if (sz == 4) { if (signed) { return "__rawLoad32S" } else { return "__rawLoad32" } }
  return "__rawLoad"
}

// The width-truncating raw store intrinsic for an element of type T (the hardware width store drops the
// high bits, so no explicit mask is needed).
fun packedStoreName(lo: Lo, ty: String): String {
  val sz = sizeOfTy(lo, tyTag(stripMode(ty)))
  if (sz == 1) { return "__rawStoreByte" }
  if (sz == 2) { return "__rawStore16" }
  if (sz == 4) { return "__rawStore32" }
  return "__rawStore"
}

// byte offset of element `idx` in a T-strided buffer: idx * sizeOf<T> (idx itself when the stride is 1).
fun packedOff(idx: FExpr, sz: Int): FExpr {
  if (sz == 1) { return idx }
  return FEBin("*", idx, FEInt(sz.toStr()))
}

// CLASS-element leak-model ARC (matches @arc(manual) collections). A packed buffer stores/loads a class
// element through RAW sized load/store the auto-ARC analysis cannot see as a move — so the buffer's copy
// would be a dangling pointer once the incoming `consuming` element (set) or the borrowed reference (get)
// is released at scope end. We over-RETAIN so the buffer / the caller owns an INDEPENDENT +1: never a
// double-free / UAF (elements leak on container drop — acceptable, consistent with String/IntBuf/RawMap).
// INERT for non-class elements (Int / primitives / @value structs / ARC-exempt String·IntBuf·RawMap) and
// for the compiler's own build (it instantiates no class-element containers) — that path is byte-identical.
fun lowerPackedGet(lo: Lo, ty: String, args: IntBuf): Expr {
  val sz = sizeOfTy(lo, tyTag(stripMode(ty)))
  val ca = intBuf(); ca.push(lowerExpr(lo, argExprAt(args, 0))); ca.push(lowerExpr(lo, packedOff(argExprAt(args, 1), sz)))
  val load = ECall(packedLoadName(lo, ty), ca)
  if (isClassTag(lo, tyTag(stripMode(ty)))) {
    // { val r = __rawLoad(ptr, off) ; __retain(r) ; r } — the caller owns a +1 copy independent of the buffer.
    val stmts = intBuf()
    val r = freshName(lo, "_pg")
    stmts.push(SLet(r, load))
    val ra = intBuf(); ra.push(EIdent(r)); stmts.push(SExprS(ECall("__retain", ra)))
    return EBlock(stmts, EIdent(r))
  }
  return load
}

fun lowerPackedSet(lo: Lo, ty: String, args: IntBuf): Expr {
  val sz = sizeOfTy(lo, tyTag(stripMode(ty)))
  if (isClassTag(lo, tyTag(stripMode(ty)))) {
    // { val v = <value> ; __retain(v) ; __rawStore(ptr, off, v) } — the buffer owns a +1 that survives the
    // scope-end release of the incoming `consuming` element. ptr/off/value keep left-to-right eval order.
    val ptr = lowerExpr(lo, argExprAt(args, 0))
    val off = lowerExpr(lo, packedOff(argExprAt(args, 1), sz))
    val stmts = intBuf()
    val v = freshName(lo, "_ps")
    stmts.push(SLet(v, lowerExpr(lo, argExprAt(args, 2))))
    val ra = intBuf(); ra.push(EIdent(v)); stmts.push(SExprS(ECall("__retain", ra)))
    val ca = intBuf(); ca.push(ptr); ca.push(off); ca.push(EIdent(v))
    return EBlock(stmts, ECall(packedStoreName(lo, ty), ca))
  }
  val ca = intBuf(); ca.push(lowerExpr(lo, argExprAt(args, 0))); ca.push(lowerExpr(lo, packedOff(argExprAt(args, 1), sz))); ca.push(lowerExpr(lo, argExprAt(args, 2)))
  return ECall(packedStoreName(lo, ty), ca)
}

// number of fields the primary (field-list) constructor of struct/class `nm` takes; -1 if not a struct.
fun structFieldCount(lo: Lo, nm: String): Int {
  var i = 0
  while (i < lo.sN.len()) { if (lo.sN.get(i) == nm) { val fns: IntBuf = lo.sFN.get(i); return fns.len() }; i = i + 1 }
  return 0 - 1
}

// SECONDARY-CONSTRUCTOR dispatch at an `Owner(args)` call. When `nm` is a struct/class whose primary ctor
// takes a DIFFERENT number of fields than `args` supplies, and a secondary ctor `Owner___ctor_<arity>` is
// defined for that arity, route the call to that synthesized factory. Returns "" (keep the primary
// field-list construction) when nm is not a struct, the arity matches the primary, or no secondary exists.
fun ctorCallee(lo: Lo, nm: String, args: IntBuf): String {
  val fc = structFieldCount(lo, nm)
  if (fc < 0) { return "" }
  if (args.len() == fc) { return "" }
  val sym = mangleMethod(nm, "__ctor_" + args.len().toStr())
  if (funDefined(lo, sym)) { return sym }
  return ""
}

// Phase M6 SURFACE ENFORCEMENT: `<Type>_<member>` is no longer a valid SURFACE identifier. A cheap
// pre-filter: only a name that STARTS uppercase and contains an `_` can be an owner-mangle, so the vast
// majority of identifiers (locals, lowercase free fns) skip the member-table scan entirely.
fun looksMangled(nm: String): Bool {
  if (nm.len() == 0) { return false }
  val c0 = nm.charAt(0)
  if ((c0 >= 65 && c0 <= 90) == false) { return false }
  var i = 1
  while (i < nm.len()) { if (nm.charAt(i) == 95) { return true }; i = i + 1 }
  return false
}

// Is `nm` the emitted symbol of a real MEMBER (owner != "" in the member table — a method / associated
// function / associated const / field)? Such a name is INTERNAL: codegen still computes it, but the surface
// must spell the member (`x.member(..)` / `Type::member`). Enum-variant constructors (`variant` kind, sym =
// bare name) and plain free functions (owner "") are NOT members and stay callable by name.
fun isMangledMember(lo: Lo, nm: String): Bool {
  val mt = lo.mt
  var i = 0
  while (i < mt.sym.len()) {
    if (mt.sym.get(i) == nm) { if (mt.owner.get(i) != "") { return true } }
    i = i + 1
  }
  return false
}

// Hard-reject a bare `<Type>_<member>` surface use (Phase M6). Fires only for a name that both looks mangled
// AND resolves to a member-table member — so the migrated stdlib + the compiler's own sources (which use the
// member forms exclusively) never trip it, and the self-host fixpoint is unaffected.
fun rejectMangledSurface(lo: Lo, nm: String): Int {
  if (looksMangled(nm)) { if (isMangledMember(lo, nm)) {
    lowFail("`" + (nm + "` is not a valid identifier — a `<Type>_<member>` name is internal; call it as `x.member(..)` or `Type::member`")) } }
  return 0
}

// ---------- VARARG (variadic) parameters ----------
// A `fun f(fixed.., vararg xs: E)` call `f(a.., e0..en)` binds the fixed args and COLLECTS the trailing
// args into a FRESH fixed-length `Array<E>` (sized alloc + per-element .set), passed as the single `xs`
// argument. n is statically known at the call site, so the array is built at exactly length n (no push
// loop). The vararg registry (lo.vareg, built in finishLower) drives it; empty for the compiler's own
// build (no vararg anywhere), so every function here is inert on the self-host path.
//
// The four parallel registry lists are bundled in ONE struct so the whole-program tables stay a SINGLE
// threaded field on Lo / a single param on the lowering helpers (keeping their arity + frame small — a
// large frame miscompiles under the bootstrap seed). sym = the callable symbol; key = mangleMethod(owner,
// base) for call-site lookup; fix = fixed-param count; elem = the vararg element type E.
struct VaReg(val sym: IntBuf, val key: IntBuf, val fix: IntBuf, val elem: IntBuf)

// the BASE name of an (possibly overload-remangled) selector: the text before the first "__" segment
// (`f__1__Array$Int` -> `f`); a plain name is returned unchanged (`sum` -> `sum`).
fun selectorBase(name: String): String {
  val n = name.len()
  var i = 0
  while (i + 1 < n) { if (name.charAt(i) == 95 && name.charAt(i + 1) == 95) { return name.substr(0, i) } i = i + 1 }
  return name
}

// the ELEMENT type E from a vararg param's Array carrier type string, either surface `Array<Int>` (`<`..`>`)
// or the mono-mangled `Array$Int` (`$` suffix). "" when neither form is present.
fun vaElemFromArrTy(ty: String): String {
  val n = ty.len()
  var i = 0
  while (i < n) {
    if (ty.charAt(i) == 60) { // '<'
      var j = n - 1
      while (j > i) { if (ty.charAt(j) == 62) { return ty.substr(i + 1, j - i - 1) } j = j - 1 } // '>'
      return ty.substr(i + 1, n - i - 1)
    }
    i = i + 1
  }
  var k = 0
  while (k < n) { if (ty.charAt(k) == 36) { return ty.substr(k + 1, n - k - 1) } k = k + 1 } // '$'
  return ""
}

fun varargInfoIdx(lo: Lo, sym: String): Int {
  var i = 0
  while (i < lo.vareg.sym.len()) { if (lo.vareg.sym.get(i) == sym) { return i } i = i + 1 }
  return 0 - 1
}
fun isVarargSym(lo: Lo, sym: String): Bool { return varargInfoIdx(lo, sym) >= 0 }

// Decide whether a call to `(owner, base)` with `nargs` surface args is a VARARG call, returning the vararg
// symbol to emit, or "" for the ordinary path. (1) When the resolver already landed on a vararg symbol,
// apply it (the lone-vararg case). (2) Otherwise, only when NO defined non-vararg symbol was resolved, pick
// a vararg overload of (owner, base) with fixed count <= nargs. An EXACT fixed-arity non-vararg overload is
// always returned by the resolver as a DEFINED `resolvedSym`, so it wins over the vararg (Kotlin semantics).
fun varargCalleeSym(lo: Lo, owner: String, base: String, nargs: Int, resolvedSym: String): String {
  if (resolvedSym != "") { if (isVarargSym(lo, resolvedSym)) { return resolvedSym } }
  if (resolvedSym == "" || funDefined(lo, resolvedSym) == false) {
    val key = mangleMethod(owner, base)
    var i = 0
    while (i < lo.vareg.sym.len()) {
      if (lo.vareg.key.get(i) == key) { if (nargs >= lo.vareg.fix.get(i)) { return lo.vareg.sym.get(i) } }
      i = i + 1
    }
  }
  return ""
}

// build a fresh, statically-sized `Array<E>` holding `args[start..]`: allocate n*sizeOf<E> bytes into a
// RawBuf, construct the monomorphized `Array$E(n, buf)`, then `.set(i, ei)` each trailing arg. n==0 uses a
// null buffer (no allocation) — mirrors Array.ensureUnique's empty-buffer guard.
fun buildVarargArray(lo: Lo, elem: String, args: IntBuf, start: Int): Expr {
  val n = args.len() - start
  val arrTy = "Array$" + monoArgSuffix(elem)
  val setSym = arrTy + "_set"
  val sz = sizeOfTy(lo, elem)
  val nm = freshName(lo, "__va")
  val stmts = intBuf()
  val dataE = if (n == 0) { EInt("0") } else { val aa = intBuf(); aa.push(EInt((n * sz).toStr())); ECall("__rawAlloc", aa) }
  val bufA = intBuf(); bufA.push(dataE)
  val ctorA = intBuf(); ctorA.push(EInt(n.toStr())); ctorA.push(ECall("RawBuf", bufA))
  stmts.push(SLet(nm, ECall(arrTy, ctorA)))
  var i = 0
  while (i < n) {
    val sa = intBuf(); sa.push(EIdent(nm)); sa.push(EInt(i.toStr())); sa.push(lowerExpr(lo, argExprAt(args, start + i)))
    stmts.push(SExprS(ECall(setSym, sa)))
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// emit a vararg free call: lower the `fixed` leading args, then append the collected Array<E>.
fun lowerVarargFree(lo: Lo, sym: String, args: IntBuf): Expr {
  val idx = varargInfoIdx(lo, sym)
  val fix = lo.vareg.fix.get(idx)
  val ca = intBuf()
  var i = 0
  while (i < fix) { ca.push(lowerExpr(lo, argExprAt(args, i))); i = i + 1 }
  ca.push(buildVarargArray(lo, lo.vareg.elem.get(idx), args, fix))
  return ECall(sym, ca)
}

// Resolve + lower a bare `nm(args)` free/ctor/overload/vararg call. Kept OFF lowerCall's frame (its own
// locals here don't add to lowerCall's, which a large bootstrap-seed frame otherwise miscompiles).
fun lowerFreeIdentCall(lo: Lo, nm: String, args: IntBuf): Expr {
  rejectMangledSurface(lo, nm)
  val cc = ctorCallee(lo, nm, args)
  if (cc != "") { return lowerPlainCall(lo, cc, args) }
  val ov = ovResolveVariant(lo, "", nm, args)
  val base0 = if (ov != "") { ov } else { nm }
  val vsym = varargCalleeSym(lo, "", nm, args.len(), base0)
  if (vsym != "") { return lowerVarargFree(lo, vsym, args) }
  return lowerPlainCall(lo, base0, args)
}

// Resolve + lower an instance/UFCS `recv.m(args)` call (method overload + vararg). Also off lowerCall's frame.
fun lowerInstanceCall(lo: Lo, recv: FExpr, m: String, args: IntBuf): Expr {
  val cal0 = methodCallee(lo, recv, m)
  val cal = if (cal0 == m) { val ov = ovResolveVariant(lo, tagOf(lo, recv), m, args); if (ov != "") { ov } else { cal0 } } else { cal0 }
  val vsym = varargCalleeSym(lo, tagOf(lo, recv), m, args.len(), cal)
  if (vsym != "") { return lowerVarargMethod(lo, vsym, lowerExpr(lo, recv), args) }
  requireResolvedMethodCallee(lo, m, cal)
  return ECall(cal, consFront(lowerExpr(lo, recv), lowerArgsFor(lo, cal, 1, args)))
}

// emit a vararg method/UFCS call: the receiver is arg0, then the `fixed` leading args, then the Array<E>.
fun lowerVarargMethod(lo: Lo, sym: String, recvE: Expr, args: IntBuf): Expr {
  val idx = varargInfoIdx(lo, sym)
  val fix = lo.vareg.fix.get(idx)
  val ca = intBuf(); ca.push(recvE)
  var i = 0
  while (i < fix) { ca.push(lowerExpr(lo, argExprAt(args, i))); i = i + 1 }
  ca.push(buildVarargArray(lo, lo.vareg.elem.get(idx), args, fix))
  return ECall(sym, ca)
}

fun lowerCall(lo: Lo, callee: FExpr, args: IntBuf): Expr {
  return when (callee) {
    FEIdent(nm) -> {
      if (nm == "comptime" && args.len() == 1) { val fa: FArg = args.get(0); EInt(cevalWithConsts(lo, fa.expr).toStr()) }
      else { if ((nm == "println" || nm == "print") && oneFloatArg(lo, args)) { ECall(nm + "F", lowerArgs(lo, args)) }
        else { if (memListL(lo.locN, nm)) { closCall(lo, EIdent(nm), args) }
          else { lowerFreeIdentCall(lo, nm, args) } } }
    }
    // `recv.m(args)`. A DOT-qualified variant construction (`Enum.Variant(args)`) is the locked cross-use
    // error (variants use `::`). A `Type.m(args)` whose base is a bare type name is a STATIC method call via
    // dot — resolved through staticCallee exactly like `Type::m(args)`, NOT UFCS (which would wrongly prepend
    // the type name as arg0). Otherwise it is an ordinary instance/UFCS call.
    FEField(recv, m) -> if (isQualVariant(lo, recv, m)) { rejectDotVariant(m); ECall(m, lowerArgs(lo, args)) }
      else { if (isTypeDotBase(lo, recv)) { val sc = staticCalleeOv(lo, recv, m, args); ECall(sc, lowerArgsFor(lo, sc, 0, args)) }
        else { lowerInstanceCall(lo, recv, m, args) } }
    // `Type::method(args)` binds to the owner-mangled static method `Type_method` when one is defined
    // (e.g. a derived `Point::default()` -> `Point_default()`). An `Enum::Variant(args)` construction is
    // routed to the bare variant constructor FIRST (isQualVariant), so it never reaches staticCallee's
    // now-fatal miss path; a genuine no-such-static aborts there instead of emitting a bare symbol.
    FEStatic(b, m) -> if (isQualVariant(lo, b, m)) { ECall(m, lowerArgs(lo, args)) } else { val sc = staticCalleeOv(lo, b, m, args); ECall(sc, lowerArgsFor(lo, sc, 0, args)) }
    // Phase 6 monomorphization intrinsics carry their element type as a turbofish arg; fold them here with
    // T fully concrete (the monomorphizer has already substituted it). A monomorphized-type constructor
    // turbofish (`Vec::<U16>(..)`) is never seen here — the mono rewrite turned it into a plain call to
    // the specialized `Vec$U16` before lowering — so a leftover turbofish is a generic-fn call (types erase).
    FETypeApp(inner, ta) -> {
      val cn = calleeName(inner)
      if (cn == "sizeOf") { EInt(sizeOfTy(lo, ta).toStr()) }
      else { if (cn == "__packedGet") { lowerPackedGet(lo, ta, args) }
        else { if (cn == "__packedSet") { lowerPackedSet(lo, ta, args) }
          else { lowerCall(lo, inner, args) } } }
    }
    else -> closCall(lo, lowerExpr(lo, callee), args)
  }
}

// Phase-8 literal FLIP. A `[a, b, c]` literal desugars to a fresh monomorphized `Vec<T>`, built through
// the SAME @mono machinery an explicit `Vec::<T>(..)` uses: `{ val _v = Vec$T(0, 0, RawBuf(0)); _v.push(a);
// ...; _v }`. The element type T is inferred from the (homogeneous, literal/ctor) elements (litElemTy) and
// the specialization is registered by the mono seeding pass, so `Vec$T` + `Vec$T_push` exist by lower time.
// When T is unknown/heterogeneous or the list is EMPTY (no expected type here to resolve T from) the literal
// falls back to the erased IntBuf kernel — the pre-flip behavior — so `val xs = []` stays an empty IntBuf.
// The two paths agree with tagOf via the SAME `funDefined(Vec$T_push)` gate.
// a fresh empty monomorphized `Vec$T(0, 0, RawBuf(0))` — the zero-length, unallocated handle. Shared by the
// literal desugar and the empty-`[]`-with-`Vec<T>`-annotation case in lowerLet.
fun emptyVecCtor(vt: String): Expr {
  val bufA = intBuf(); bufA.push(EInt("0"))
  val ctorA = intBuf(); ctorA.push(EInt("0")); ctorA.push(EInt("0")); ctorA.push(ECall("RawBuf", bufA))
  return ECall(vt, ctorA)
}
fun isEmptyListF(e: FExpr): Bool { return when (e) { FEList(es) -> es.len() == 0; else -> false } }
// a monomorphized `Vec$...` element-container tag (its base type is the `@mono` Vec template).
fun isVecMonoTag(tag: String): Bool { return tag.len() >= 4 && tag.substr(0, 4) == "Vec$" }

fun lowerVecLit(lo: Lo, vt: String, es: IntBuf): Expr {
  val nm = freshName(lo, "__vec")
  val stmts = intBuf()
  stmts.push(SLet(nm, emptyVecCtor(vt)))
  val pushSym = mangleMethod(vt, "push")
  var i = 0
  while (i < es.len()) {
    val a2 = intBuf(); a2.push(EIdent(nm)); a2.push(lowerExpr(lo, es.get(i)))
    stmts.push(SExprS(ECall(pushSym, a2)))
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// [a, b, c] -> a fresh Vec<T> (see lowerVecLit); an unknown-element / empty literal keeps the IntBuf
// fallback: `{ val _l = intBuf() ; _l.push(a) ; ... ; _l }` (the free listNew/listPush are retired).
fun lowerList(lo: Lo, es: IntBuf): Expr {
  val t = litElemTy(lo.sN, es)
  if (t != "?" && t != "") {
    val vt = monoMangleTag("Vec", t)
    if (funDefined(lo, mangleMethod(vt, "push"))) { return lowerVecLit(lo, vt, es) }
  }
  val nm = freshName(lo, "__lst")
  val stmts = intBuf()
  stmts.push(SLet(nm, ECall(roleSym(lo, "intbuf.new"), intBuf())))
  var i = 0
  while (i < es.len()) {
    val a2 = intBuf(); a2.push(EIdent(nm)); a2.push(lowerExpr(lo, es.get(i)))
    stmts.push(SExprS(ECall(roleSym(lo, "intbuf.push"), a2)))
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// map.put role — the ONE place that knows RawMap's internal storage layout. Appends a (k, v) pair into the
// map bound to `nm`: a pure append into the two parallel word-lists (NO key comparison), correct for both
// Int and String keys (comparison only happens later at m[k]/m[k]=v via the map.get/set roles). This is
// the sole reference to RawMap's `.keys`/`.vals` internals in the lowerer — if RawMap's layout changes, only
// this helper changes, not lowerMap. `nm`'s codegen local-type is inferred as RawMap from mapNewM()'s return,
// so the field offsets resolve. Emits, per entry: listPush(_m.keys, k); listPush(_m.vals, v).
fun mapPutInto(lo: Lo, out: IntBuf, nm: String, k: FExpr, v: FExpr): Int {
  val ka = intBuf(); ka.push(EField(EIdent(nm), "keys")); ka.push(lowerExpr(lo, k))
  out.push(SExprS(ECall(roleSym(lo, "rawmap.putList"), ka)))
  val va = intBuf(); va.push(EField(EIdent(nm), "vals")); va.push(lowerExpr(lo, v))
  out.push(SExprS(ECall(roleSym(lo, "rawmap.putList"), va)))
  return 0
}

// Phase-8 literal FLIP. A `[k0: v0, k1: v1]` map literal desugars to a fresh monomorphized `HashMap<K,V>`,
// built through the SAME @mono machinery an explicit `HashMap::<K,V>(0,0,0,0,0,0)` uses: a fresh empty map
// then `.set(k, v)` each entry (HashMap.set dedups + preserves insertion order). K,V are inferred from the
// (homogeneous, literal/ctor) entries (mapKeyTy/mapValTy) and the specialization is registered by the mono
// seeding pass, so `HashMap$K_V` + `HashMap$K_V_set` exist by lower time. When K/V is unknown/heterogeneous
// the literal falls back to the erased RawMap kernel — the pre-flip behavior. Both paths agree with tagOf
// via the SAME `funDefined(HashMap$K_V_set)` gate. There is no empty-map literal (`[]` is an empty LIST).
// a fresh empty monomorphized `HashMap$K_V(0, 0, 0, 0, 0, 0)` — the zero-length, unallocated six-word handle.
fun emptyHashMapCtor(ht: String): Expr {
  val ctorA = intBuf()
  ctorA.push(EInt("0")); ctorA.push(EInt("0")); ctorA.push(EInt("0"))
  ctorA.push(EInt("0")); ctorA.push(EInt("0")); ctorA.push(EInt("0"))
  return ECall(ht, ctorA)
}
fun lowerHashMapLit(lo: Lo, ht: String, ents: IntBuf): Expr {
  val nm = freshName(lo, "__hm")
  val stmts = intBuf()
  stmts.push(SLet(nm, emptyHashMapCtor(ht)))
  val setSym = mangleMethod(ht, "set")
  var i = 0
  while (i < ents.len()) {
    val en: FMapEnt = ents.get(i)
    val a2 = intBuf(); a2.push(EIdent(nm)); a2.push(lowerExpr(lo, en.k)); a2.push(lowerExpr(lo, en.v))
    stmts.push(SExprS(ECall(setSym, a2)))
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// [k0: v0, k1: v1] -> a fresh HashMap<K,V> (see lowerHashMapLit); an unknown-key/value literal keeps the
// RawMap fallback: `{ val _m = rawMap(); listPush(_m.keys,k0); listPush(_m.vals,v0); ...; _m }` — lowerMap
// only emits the map.new + map.put roles for that path (mapPutInto owns RawMap's internal layout).
fun lowerMap(lo: Lo, ents: IntBuf): Expr {
  val kt = mapKeyTy(lo.sN, ents)
  val vt = mapValTy(lo.sN, ents)
  if (kt != "?" && kt != "" && vt != "?" && vt != "") {
    val ht = monoMangleTag("HashMap", kt + (", " + vt))
    if (funDefined(lo, mangleMethod(ht, "set"))) { return lowerHashMapLit(lo, ht, ents) }
  }
  val nm = freshName(lo, "__map")
  val stmts = intBuf()
  stmts.push(SLet(nm, ECall(roleSym(lo, "rawmap.new"), intBuf())))
  var i = 0
  while (i < ents.len()) {
    val en: FMapEnt = ents.get(i)
    mapPutInto(lo, stmts, nm, en.k, en.v)
    i = i + 1
  }
  return EBlock(stmts, EIdent(nm))
}

// a[i] -> charAt (String) / __mapGetS|I (RawMap, by key type) / listGet (IntBuf/default)
fun lowerIndex(lo: Lo, a: FExpr, ix: FExpr): Expr {
  val at = tagOf(lo, a)
  val args = intBuf(); args.push(lowerExpr(lo, a)); args.push(lowerExpr(lo, ix))
  if (at == "String") { return ECall(roleSym(lo, "str.get"), args) }
  if (at == "RawMap") {
    if (tagOf(lo, ix) == "String") { return ECall(roleSym(lo, "rawmap.getS"), args) }
    return ECall(roleSym(lo, "rawmap.getI"), args)
  }
  // Phase 8 literal flip: a target-tier nominal (Vec/Array/…) with a concrete `<T>_get` method drives
  // `a[i]` through it by convention (§3c), so indexing follows the static element type off the bootstrap
  // IntBuf. IntBuf and unknown "?" tags keep the default list role — byte-identical for the self-host.
  if (!isDefaultSeqTag(at)) { val m = mangleMethod(at, "get"); if (funDefined(lo, m)) { return ECall(m, args) } }
  return ECall(roleSym(lo, "intbuf.get"), args)
}

// string interpolation -> concat chain; each $expr becomes intToStr(expr) unless it is a String
fun interpPiece(lo: Lo, e: FExpr): Expr {
  if (tagOf(lo, e) == "String") { return lowerExpr(lo, e) }
  val a = intBuf(); a.push(lowerExpr(lo, e))
  return ECall(roleSym(lo, "str.show"), a)
}

// string interpolation lowers onto ONE StrBuilder: `finish(pushStr(pushStr(strNew(), p0), p1) ...)` —
// amortized O(n) instead of a left-folded `concat` chain (O(n^2) copies + a leak per intermediate). Each
// piece is a String (a literal chunk, or `$expr` rendered via interpPiece/str.show). The 0-piece and
// 1-piece cases short-circuit to the piece itself (no builder allocation for a plain string).
fun lowerInterp(lo: Lo, parts: IntBuf): Expr {
  val pieces = intBuf()
  var i = 0
  while (i < parts.len()) {
    val pt: FIPart = parts.get(i)
    val piece = when (pt) { FILit(s) -> EStr(s); FIExpr(e) -> interpPiece(lo, e); else -> EStr("") }
    pieces.push(piece)
    i = i + 1
  }
  if (pieces.len() == 0) { return EStr("") }
  if (pieces.len() == 1) { val only: Expr = pieces.get(0); return only }
  var acc = ECall(roleSym(lo, "str.build.new"), intBuf())
  var j = 0
  while (j < pieces.len()) {
    val pj: Expr = pieces.get(j)
    val pa = intBuf(); pa.push(acc); pa.push(pj)
    acc = ECall(roleSym(lo, "str.build.push"), pa)
    j = j + 1
  }
  val fa = intBuf(); fa.push(acc)
  return ECall(roleSym(lo, "str.build.finish"), fa)
}

// `e?` desugars to a subject `when` that unwraps the happy variant and early-returns the sad one, exactly
// the code a user would hand-write:  Result -> when(e){ Ok(v) -> v ; Err(x) -> { return Err(x) } }, and the
// Option analog  when(e){ Some(v) -> v ; None -> { return None } }. The static tag of `e` (tagOf) picks the
// pair; anything not tagged `Option` defaults to Result. Produced at FExpr level so the normal when/pattern
// lowering (single subject eval, pattern bind, arm bodies) handles the rest with zero new codegen.
fun desugarQuestion(lo: Lo, inner: FExpr): FExpr {
  var okC = "Ok"
  var sadC = "Err"
  var sadNullary = 0
  if (tagOf(lo, inner) == "Option") { okC = "Some"; sadC = "None"; sadNullary = 1 }
  val okBind = intBuf(); okBind.push(FPBind("__q_v"))
  val okPats = intBuf(); okPats.push(FPCtor(okC, okBind))
  val okArm = FArm(2, FENoRes, okPats, FENoRes, FEIdent("__q_v"))
  val sadPats = intBuf()
  val sadStmts = intBuf()
  if (sadNullary == 1) {
    sadPats.push(FPPath(sadC))
    sadStmts.push(FSReturnV(FEIdent(sadC)))
  } else {
    val eb = intBuf(); eb.push(FPBind("__q_e"))
    sadPats.push(FPCtor(sadC, eb))
    val cargs = intBuf(); cargs.push(FArg("", FEIdent("__q_e")))
    sadStmts.push(FSReturnV(FECall(FEIdent(sadC), cargs)))
  }
  val sadArm = FArm(2, FENoRes, sadPats, FENoRes, FEBlock(sadStmts, FENoRes))
  val arms = intBuf(); arms.push(okArm); arms.push(sadArm)
  return FEWhen(1, "", inner, arms)
}

fun lowerExpr(lo: Lo, e: FExpr): Expr {
  return when (e) {
    FEInt(t) -> EInt(litNum(t))
    FEChar(t) -> EInt(t)
    FEBool(b) -> if (b == "true") { EInt("1") } else { EInt("0") }
    FENull -> EInt("0")
    FEStr(t, r) -> EStr(t)
    FEInterp(parts, r) -> lowerInterp(lo, parts)
    FEIdent(nm) -> { val ci = indexOfL(lo.constN, nm); if (ci >= 0) { EInt(lo.constV.get(ci)) } else { if (localTag(lo, nm) == "?") { rejectMangledSurface(lo, nm) }; EIdent(nm) } }
    FEThis -> EIdent("this")
    FEFloat(t) -> EFLit(t)
    FEUnary(op, x) -> EUnary(op, lowerExpr(lo, x))
    FEBin(op, l, r) -> lowerBin(lo, op, l, r)
    // A non-call `x.nm`. A DOT-qualified variant (`Color.Red`) is the locked cross-use error (variants use
    // `::`) — reject in the lowerer so the module-import surface (checker bypassed) can't emit a dangling
    // `EField(EIdent(Color), Red)` that segfaults. A `Type.nm` on a bare type name is a STATIC read via dot,
    // lowered exactly like the `Type::nm` VALUE below (a nullary assoc-const/static is CALLED to yield it).
    FEField(x, nm) -> if (isQualVariant(lo, x, nm)) { rejectDotVariant(nm); EInt("0") }
    else { if (isTypeDotBase(lo, x)) { val sc = staticCallee(lo, x, nm); if (funArity(lo, sc) == 0) { ECall(sc, intBuf()) } else { EIdent(sc) } }
      else { if (isFieldOf(lo, tagOf(lo, x), nm)) { EField(lowerExpr(lo, x), nm) }
        else { if (hasGetterMethod(lo, x, nm)) { ECall(methodCallee(lo, x, nm), consFront(lowerExpr(lo, x), intBuf())) }
          else { EField(lowerExpr(lo, x), nm) } } } }
    // A non-call `Type::sel` VALUE. An enum variant (`Color::Green`, `Ordering::Greater`) is the bare
    // variant constructor. Phase M3 STOPS the old blanket base-erasure (`EIdent(nm)`) for the rest: a
    // resolved `Type::sel` KEEPS its base via staticCallee, so an assoc const/static lowers to the real
    // `Type_sel` symbol instead of a dangling bare `sel` (e.g. `Int::MAX` was mis-lowered to undefined MAX).
    // An assoc const is emitted as a NULLARY function (`Int_MAX()`), so a `Type::sel` VALUE whose mangle is
    // nullary is CALLED to yield the constant — a bare `EIdent(Int_MAX)` would be the function ADDRESS, the
    // Int::MAX-as-value miscompile. A static METHOD used first-class (arity > 0) still lowers to its symbol.
    FEStatic(x, nm) -> if (isQualVariant(lo, x, nm)) { EIdent(nm) } else { val sc = staticCallee(lo, x, nm); if (funArity(lo, sc) == 0) { ECall(sc, intBuf()) } else { EIdent(sc) } }
    FECall(callee, args) -> lowerCall(lo, callee, args)
    FEIndex(a, ix) -> lowerIndex(lo, a, ix)
    FELambda(params, body) -> lowerLambda(lo, params, body, intBuf())
    FEList(es) -> lowerList(lo, es)
    FEMap(ents) -> lowerMap(lo, ents)
    FEBlock(stmts, res) -> EBlock(lowerStmts(lo, stmts), lowerExpr(lo, res))
    FEIf(c, t, el) -> EIf(lowerExpr(lo, c), lowerExpr(lo, t), lowerExpr(lo, el))
    FEWhen(hasSubj, bind, subj, arms) -> EWhen(lowerExpr(lo, subj), lowerArms(lo, arms))
    FERet(x) -> ERet(lowerExpr(lo, x))
    FETypeApp(inner, ta) -> lowerExpr(lo, inner) // types erase: x<T> lowers to x
    FECast(inner, ty) -> ECast(lowerExpr(lo, inner), ty) // `e as T` numeric conversion (Phase 3)
    FEQuestion(inner) -> lowerExpr(lo, desugarQuestion(lo, inner)) // `e?` Result/Option early-return (Phase 8)
    FESafeField(a, f) -> lowerSafe(lo, a, f)
    FENotNull(a) -> lowerNotNull(lo, a)
    FEElvis(a, b) -> lowerElvis(lo, a, b)
    FENoRes -> ENoRes
    FEBrk -> EBrk
    FECont -> ECont
    else -> { lowFail("expression"); ENoRes }
  }
}

// nullable sugar: null is the 0 pointer. Each op binds the receiver to one temp (single eval),
// then branches on `== 0`.   a?.f -> t=a; t==0 ? null : t.f    a?:b -> t=a; t==0 ? b : t
// a!! -> t=a; t==0 ? abort() : t
fun guardTemp(lo: Lo, a: FExpr, pre: String): String {
  val t = freshName(lo, pre); bindLoc(lo, t, "?")
  return t
}

fun lowerSafe(lo: Lo, a: FExpr, f: String): Expr {
  val t = guardTemp(lo, a, "_sf")
  val stmts = intBuf(); stmts.push(SLet(t, lowerExpr(lo, a)))
  val cond = EBin("==", EIdent(t), EInt("0"))
  return EBlock(stmts, EIf(cond, EInt("0"), EField(EIdent(t), f)))
}

fun lowerNotNull(lo: Lo, a: FExpr): Expr {
  val t = guardTemp(lo, a, "_nn")
  val stmts = intBuf(); stmts.push(SLet(t, lowerExpr(lo, a)))
  val cond = EBin("==", EIdent(t), EInt("0"))
  return EBlock(stmts, EIf(cond, ECall("__abort", intBuf()), EIdent(t)))
}

fun lowerElvis(lo: Lo, a: FExpr, b: FExpr): Expr {
  val t = guardTemp(lo, a, "_ev")
  val stmts = intBuf(); stmts.push(SLet(t, lowerExpr(lo, a)))
  val cond = EBin("==", EIdent(t), EInt("0"))
  return EBlock(stmts, EIf(cond, lowerExpr(lo, b), EIdent(t)))
}

// ---------- statement lowering ----------
// reassigning an owned class variable must balance ARC: retain the new value (or take a fresh ctor's +1),
// release the OLD value, then store. Order is eval-new -> release-old -> store, which is safe even for
// self-assignment (`x = x`) and for a rhs that reads the old x.
fun lowerAssignInto(lo: Lo, out: IntBuf, nm: String, rhs: FExpr): Int {
  val tmp = freshName(lo, "_rc")
  var rv = lowerExpr(lo, rhs)
  if (isFreshCtor(lo, rhs) == false) { val a = intBuf(); a.push(rv); rv = ECall("__retain", a) }
  out.push(SLet(tmp, rv))
  val relA = intBuf(); relA.push(EIdent(nm))
  out.push(SExprS(ECall("__release", relA)))
  out.push(SAssign(nm, EIdent(tmp)))
  return 0
}

fun isOwnedClassAssign(lo: Lo, lhs: FExpr): Bool {
  return when (lhs) { FEIdent(nm) -> memListL(lo.arcOwned, nm); else -> false }
}

// storing into a CLASS-typed field must balance ARC just like a var reassignment: retain the new value
// (or take a fresh ctor's +1), release the field's OLD value, then store. The object expression is
// evaluated ONCE into a temp so a side-effecting `obj` isn't run twice (old-release + store).
fun lowerFieldAssignInto(lo: Lo, out: IntBuf, obj: FExpr, f: String, rhs: FExpr): Int {
  val dst = freshName(lo, "_ro")
  out.push(SLet(dst, lowerExpr(lo, obj)))
  var rv = lowerExpr(lo, rhs)
  if (isFreshCtor(lo, rhs) == false) { val a = intBuf(); a.push(rv); rv = ECall("__retain", a) }
  val tn = freshName(lo, "_rn")
  out.push(SLet(tn, rv))
  val relA = intBuf(); relA.push(EField(EIdent(dst), f))
  out.push(SExprS(ECall("__release", relA)))
  out.push(SAssignF(EIdent(dst), f, EIdent(tn)))
  return 0
}

// route an assignment: owned-class var -> balanced var-reassign; class-typed field -> balanced field
// store; everything else -> plain lowering. (The compiler is class-free, so this never fires for it.)
fun lowerAssignStmtInto(lo: Lo, out: IntBuf, s: FStmt, lhs: FExpr, rhs: FExpr): Int {
  return when (lhs) {
    FEIdent(nm) -> if (memListL(lo.arcOwned, nm)) { lowerAssignInto(lo, out, nm, rhs) } else { out.push(lowerStmt(lo, s)); 0 }
    FEField(obj, f) -> if (isClassTag(lo, fieldTag(lo, obj, f))) { lowerFieldAssignInto(lo, out, obj, f, rhs) } else { out.push(lowerStmt(lo, s)); 0 }
    else -> { out.push(lowerStmt(lo, s)); 0 }
  }
}

fun lowerStmtInto(lo: Lo, out: IntBuf, s: FStmt): Int {
  return when (s) {
    FSFor(v, it, b) -> lowerForInto(lo, out, v, it, b)
    FSAssign(lhs, rhs) -> lowerAssignStmtInto(lo, out, s, lhs, rhs)
    else -> { out.push(lowerStmt(lo, s)); 0 }
  }
}

fun assignName(lhs: FExpr): String { return when (lhs) { FEIdent(nm) -> nm; else -> "" } }

fun lowerStmts(lo: Lo, stmts: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < stmts.len()) { lowerStmtInto(lo, out, stmts.get(i)); i = i + 1 }
  return out
}

fun lowerBodyInto(lo: Lo, out: IntBuf, body: FExpr): Int {
  return when (body) {
    FEBlock(bstmts, res) -> {
      var i = 0
      while (i < bstmts.len()) { lowerStmtInto(lo, out, bstmts.get(i)); i = i + 1 }
      if (isNoResF(res) == false) { out.push(SExprS(lowerExpr(lo, res))) }
      0
    }
    else -> { out.push(SExprS(lowerExpr(lo, body))); 0 }
  }
}

fun lowerForInto(lo: Lo, out: IntBuf, v: String, it: FExpr, body: FExpr): Int {
  return when (it) {
    FEBin(op, lo2, hi) ->
    if (op == "..") { lowerForRange(lo, out, v, lo2, hi, body, "<=") }
    else { if (op == "..<") { lowerForRange(lo, out, v, lo2, hi, body, "<") }
      else { lowerForEach(lo, out, v, it, body) } }
    else -> lowerForEach(lo, out, v, it, body)
  }
}

// `for (v in a..b)` / `a..<b` -> a counted loop. cmp is "<=" for inclusive `..`, "<" for exclusive `..<`.
// The `v = v + 1` increment is the loop STEP (emitted at the continue target), so `continue` advances v.
fun lowerForRange(lo: Lo, out: IntBuf, v: String, loE: FExpr, hi: FExpr, body: FExpr, cmp: String): Int {
  bindLoc(lo, v, "Int")
  val stmts = intBuf()
  lowerBodyInto(lo, stmts, body)
  val step = SAssign(v, EBin("+", EIdent(v), EInt("1")))
  out.push(SLet(v, lowerExpr(lo, loE)))
  out.push(SLoop(EBin(cmp, EIdent(v), lowerExpr(lo, hi)), EBlock(stmts, ENoRes), step))
  return 0
}

// seq.get / seq.len role dispatch for `for x in xs` (Phase 8, convention-by-name §3c). The iterable opts
// in by providing len/get: the bootstrap IntBuf (and any unknown "?" tag) keeps the default list roles —
// byte-identical for the self-hosted compiler, whose loops all iterate IntBuf; a String iterates its bytes
// via String_charAt/String_len; any other nominal type with concrete `<T>_get`/`<T>_len` methods (Vec,
// Array, Deque, …) drives the loop through those, so `for x in vec` works with zero codegen change.
fun isDefaultSeqTag(tag: String): Bool { return tag == "" || tag == "?" || tag == "IntBuf" }

fun seqGetName(lo: Lo, tag: String): String {
  if (isDefaultSeqTag(tag)) { return roleSym(lo, "intbuf.get") }
  if (tag == "String") { return roleSym(lo, "str.get") }
  // A `for (k in map)` over a monomorphized HashMap iterates its KEYS in insertion order (Kotlin's
  // `for (k in map.keys)`) — `get`/`set` on a HashMap are key-lookups, so iteration MUST route through the
  // dense-index surface `keyAt`/`size`, never the key-typed `get`. Fires only for a HashMap$ tag (the
  // compiler never iterates one), so its loops stay byte-identical.
  if (isHashMapMonoTag(tag)) { val ka = mangleMethod(tag, "keyAt"); if (funDefined(lo, ka)) { return ka } }
  val m = mangleMethod(tag, "get")
  if (funDefined(lo, m)) { return m }
  return roleSym(lo, "intbuf.get")
}

fun seqLenName(lo: Lo, tag: String): String {
  if (isDefaultSeqTag(tag)) { return roleSym(lo, "intbuf.len") }
  if (tag == "String") { return "String_len" }
  if (isHashMapMonoTag(tag)) { val sz = mangleMethod(tag, "size"); if (funDefined(lo, sz)) { return sz } }
  val m = mangleMethod(tag, "len")
  if (funDefined(lo, m)) { return m }
  return roleSym(lo, "intbuf.len")
}

// PROVENANCE-SAFE element tag of a for-in iterable: only when the element type is STATICALLY KNOWN do we
// give the loop var a concrete tag (so `x.isEven()` dispatches to `Int_isEven`, not the bare undefined
// `isEven`). This fires for (1) a LIST LITERAL whose elements all share one known coarse tag — e.g.
// `[2,4,6]` (all Int) — and (2) an iterable whose STATIC tag is a monomorphized `Vec$T` (a `[..]` literal
// bound to a `val`, or an explicit `Vec::<T>(..)`), whose element type T is read straight off the mono
// suffix so `for (s in ss) { s.len() }` dispatches String_len. It deliberately does NOT tag the var when
// iterating an arbitrary/variable IntBuf: IntBuf is a type-erased Int raw buffer and the compiler iterates
// many `for v in <IntBuf-of-objects>` loops, so blanket-tagging would misroute dispatch and break
// self-host (the compiler uses IntBuf, never Vec, so its loops stay "?" and its bytes are unchanged).
// the KEY type of a monomorphized `HashMap$K_V` tag: the suffix segment before the first `_` (K and V are
// concrete scalar/class names carrying no underscore). Used to tag a `for (k in map)` loop var with K.
fun hashMapKeyOfTag(tag: String): String {
  val suf = tag.substr(8, tag.len() - 8)
  var i = 0
  while (i < suf.len()) { if (suf.charAt(i) == 95) { return suf.substr(0, i) } else { i = i + 1 } }
  return suf
}
fun forElemTag(lo: Lo, it: FExpr): String {
  return when (it) {
    FEList(es) -> litListElemTag(lo, es)
    else -> { val t = tagOf(lo, it); if (isVecMonoTag(t)) { t.substr(4, t.len() - 4) } else { if (isHashMapMonoTag(t)) { hashMapKeyOfTag(t) } else { "?" } } }
  }
}

fun litListElemTag(lo: Lo, es: IntBuf): String {
  if (es.len() == 0) { return "?" }
  val t0 = tagOf(lo, es.get(0))
  if (t0 == "?") { return "?" }
  var i = 1
  while (i < es.len()) { if (tagOf(lo, es.get(i)) != t0) { return "?" }; i = i + 1 }
  return t0
}

fun lowerForEach(lo: Lo, out: IntBuf, v: String, it: FExpr, body: FExpr): Int {
  bindLoc(lo, v, forElemTag(lo, it))
  val seqTag = tagOf(lo, it)
  val getC = seqGetName(lo, seqTag)
  val lenC = seqLenName(lo, seqTag)
  val lst = freshName(lo, "__it")
  val idx = freshName(lo, "__i")
  out.push(SLet(lst, lowerExpr(lo, it)))
  out.push(SLet(idx, EInt("0")))
  val ga = intBuf(); ga.push(EIdent(lst)); ga.push(EIdent(idx))
  val stmts = intBuf()
  stmts.push(SLet(v, ECall(getC, ga)))
  lowerBodyInto(lo, stmts, body)
  val la = intBuf(); la.push(EIdent(lst))
  val step = SAssign(idx, EBin("+", EIdent(idx), EInt("1")))
  out.push(SLoop(EBin("<", EIdent(idx), ECall(lenC, la)), EBlock(stmts, ENoRes), step))
  return 0
}

// index STORE `a[i] = v`, mirroring lowerIndex's load dispatch: IntBuf -> listSet, RawMap -> __mapSet(S/I),
// String is immutable so it's rejected.
fun lowerIndexStore(lo: Lo, a: FExpr, ix: FExpr, rhs: FExpr): Stmt {
  val at = tagOf(lo, a)
  val args = intBuf()
  args.push(lowerExpr(lo, a)); args.push(lowerExpr(lo, ix)); args.push(lowerExpr(lo, rhs))
  if (at == "String") { lowFail("cannot store into an immutable String index"); return SExprS(EInt("0")) }
  if (at == "RawMap") {
    if (tagOf(lo, ix) == "String") { return SExprS(ECall(roleSym(lo, "rawmap.setS"), args)) }
    return SExprS(ECall(roleSym(lo, "rawmap.setI"), args))
  }
  // Phase 8 literal flip: a target-tier nominal (Vec/Array/…) with a concrete `<T>_set` method drives
  // `a[i] = v` through it, mirroring lowerIndex's load dispatch. Default IntBuf/unknown keep list.set.
  if (!isDefaultSeqTag(at)) { val m = mangleMethod(at, "set"); if (funDefined(lo, m)) { return SExprS(ECall(m, args)) } }
  return SExprS(ECall(roleSym(lo, "intbuf.set"), args))
}

fun pairE(a: Expr, b: Expr): IntBuf { val l = intBuf(); l.push(a); l.push(b); return l }

fun lowerAssign(lo: Lo, lhs: FExpr, rhs: FExpr): Stmt {
  return when (lhs) {
    FEIdent(nm) -> { val t = tagOf(lo, lhs); var rv = lowerExpr(lo, rhs)
      if (isValueTag(lo, t)) { if (isCopyLvalue(rhs)) { val a = intBuf(); a.push(rv); rv = ECall(mangleMethod(t, "copy"), a) } }
      SAssign(nm, rv) }
    FEField(b, f) -> if (isFieldOf(lo, tagOf(lo, b), f)) { SAssignF(lowerExpr(lo, b), f, lowerExpr(lo, rhs)) }
    else { if (hasSetter(lo, b, f)) { SExprS(ECall(setterCallee(lo, b, f), pairE(lowerExpr(lo, b), lowerExpr(lo, rhs)))) }
      else { SAssignF(lowerExpr(lo, b), f, lowerExpr(lo, rhs)) } }
    FEIndex(a, ix) -> lowerIndexStore(lo, a, ix, rhs)
    else -> { lowFail("assignment target"); SExprS(lowerExpr(lo, rhs)) }
  }
}

fun lowerLet(lo: Lo, nm: String, ty: String, init: FExpr): Stmt {
  val tag = if (ty == "") { tagOf(lo, init) } else { tyTagR(ty) }
  // Empty `[]` bound to a `Vec<T>` annotation: the literal itself carries no element type, so resolve T
  // from the DECLARED tag and construct an empty `Vec$T` (the mono seeding registered it from the
  // annotation). Without this the empty literal would lower to the IntBuf fallback and mismatch the tag.
  var initE = if (isEmptyListF(init) && isVecMonoTag(tag) && funDefined(lo, mangleMethod(tag, "push"))) { emptyVecCtor(tag) } else { lowerExpr(lo, init) }
  // @value CoW: binding an existing value-type lvalue takes a value COPY (its `copy` method deep-retains
  // the shared RawBuf so a later mutation copy-on-writes) — a fresh temporary already owns its buffer.
  if (isValueTag(lo, tag)) {
    if (isCopyLvalue(init)) { val a = intBuf(); a.push(initE); initE = ECall(mangleMethod(tag, "copy"), a) }
  } else {
    // class ARC: a class-typed local is an owned reference. A fresh constructor already carries its
    // +1; binding an EXISTING class value (alias) takes a new co-ownership, so retain it.
    if (isClassTag(lo, tag)) {
      lo.arcOwned.push(nm)
      // Boxed String / StrView: a String-producing RHS (literal, `+` concat, substr, Int_toStr, readFile,
      // StrBuilder.finish — anything that is NOT a bare alias) yields a FRESH +1 box that MOVES into the
      // binding with no retain. Only aliasing an existing String/StrView value (a bare identifier or field
      // read) co-owns and retains. (String is @arc(manual)-exempt, so its scope-exit release is inert — the
      // box leaks rather than being freed; see lib/core/string.kite for why exemption is required.)
      val isAlias = when (init) { FEIdent(x) -> true; FEField(ab, af) -> true; else -> false }
      val movesIn = if (tag == "String" || tag == "StrView") { isAlias == false } else { isFreshCtor(lo, init) }
      if (movesIn == false) { val a = intBuf(); a.push(initE); initE = ECall("__retain", a) }
    }
  }
  bindLoc(lo, nm, tag)
  if (ty == "") { return SLet(nm, initE) }
  return SLetT(nm, ty, initE)
}

fun lowerStmt(lo: Lo, s: FStmt): Stmt {
  return when (s) {
    FSLet(isVar, nm, ty, init) -> lowerLet(lo, nm, ty, init)
    FSReturnV(x) -> SReturnV(lowerExpr(lo, x))
    FSReturnU -> SReturnU
    FSExprS(x) -> SExprS(lowerExpr(lo, x))
    FSAssign(lhs, rhs) -> lowerAssign(lo, lhs, rhs)
    FSWhile(c, b) -> SLoop(lowerExpr(lo, c), lowerExpr(lo, b), SExprS(ENoRes)) // empty step: `continue` re-tests the condition
    else -> { lowFail("statement"); SReturnU }
  }
}

// ---------- pattern lowering ----------
fun lowerPats(subs: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < subs.len()) { val s: FPat = subs.get(i); out.push(lowerPat(s)); i = i + 1 }
  return out
}

fun lowerPat(p: FPat): Pat {
  return when (p) {
    FPWild -> PWild
    FPBind(s) -> PBindP(s)
    FPInt(t) -> PIntP(litNum(t))
    FPCharP(t) -> PIntP(t)
    FPBoolP(b) -> if (b == "true") { PIntP("1") } else { PIntP("0") }
    FPNullP -> PIntP("0")
    FPPath(pth) -> PVarP(lastSeg(pth))
    FPCtor(pth, subs) -> PCtorP(lastSeg(pth), lowerPats(subs))
    else -> { lowFail("pattern"); PWild }
  }
}

// payload types declared for an enum constructor (e.g. JArr -> ["IntBuf"]); empty if unknown.
fun ctorPayloadTys(lo: Lo, ctorName: String): IntBuf {
  var i = 0
  while (i < lo.variantN.len()) { if (lo.variantN.get(i) == ctorName) { return lo.variantTys.get(i) }; i = i + 1 }
  return intBuf()
}

// bind a single pattern variable with a known type (a leaf FPBind); recurse for a nested constructor.
fun bindPatVarTyped(lo: Lo, pat: FPat, ty: String): Int {
  when (pat) {
    FPBind(s) -> bindLoc(lo, s, ty)
    else -> bindPatVars(lo, pat)
  }
  return 0
}

// Bind the variables a pattern introduces, tagging each with its STATIC type so method dispatch on a
// destructured payload works (e.g. `when (j) { JArr(xs) -> xs.len() }` mangles to List_len, not a bare
// unresolved `len`). Constructor payload types come from the enum's variant table (ctorPayloadTys).
fun bindPatVars(lo: Lo, pat: FPat): Int {
  when (pat) {
    FPBind(s) -> bindLoc(lo, s, "?")
    FPCtor(pth, subs) -> {
      val ptys = ctorPayloadTys(lo, pth)
      var i = 0
      while (i < subs.len()) {
        val ty = if (i < ptys.len()) { tyTag(ptys.get(i)) } else { "?" }
        bindPatVarTyped(lo, subs.get(i), ty)
        i = i + 1
      }
      0
    }
    FPRecord(pth, flds, hasRest) -> {
      var i = 0
      while (i < flds.len()) { val f: FRFld = flds.get(i); if (f.hasPat == 1) { bindPatVars(lo, f.pat) } else { bindLoc(lo, f.name, "?") }; i = i + 1 }
      0
    }
    else -> 0
  }
  return 0
}

fun lowerArm(lo: Lo, a: FArm): Arm {
  if (a.kind == 1) { return Arm(1, PWild, lowerExpr(lo, a.body)) }
  if (a.kind == 0) { lowFail("subjectless when arm"); return Arm(1, PWild, lowerExpr(lo, a.body)) }
  val first: FPat = a.pats.get(0)
  bindPatVars(lo, first)
  return Arm(0, lowerPat(first), lowerExpr(lo, a.body))
}

fun lowerArms(lo: Lo, arms: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < arms.len()) { val a: FArm = arms.get(i); out.push(lowerArm(lo, a)); i = i + 1 }
  return out
}

// ---------- declaration collection (2-phase) ----------
fun collectStruct(td: FTDecl, structN: IntBuf, structF: IntBuf, structFT: IntBuf): Int {
  val fields = intBuf()
  val ftys = intBuf()
  var i = 0
  while (i < td.fields.len()) { val f: FFld = td.fields.get(i); fields.push(f.name); ftys.push(f.ty); i = i + 1 }
  structN.push(td.name); structF.push(fields); structFT.push(ftys)
  return 0
}

fun collectMethodSigs(td: FTDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < td.methods.len()) {
    val m: FFunc = td.methods.get(i)
    pfuns.push(PFun(td.name, m)); fN.push(mangleMethod(td.name, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// register enum-body `fun` decls owned by the enum, exactly like collectMethodSigs does for a class/struct.
// A member `fun m(self)` (recv set) lowers with `this: <Enum>` injected (lowerFuncFull: owner!="" && recv!="")
// and dispatches through methodCallee for enum receivers; an associated `fun m()` (recv "") resolves via
// `<Enum>::m()`. Both mangle to `<Enum>_<name>`, so a bad decl fails to link loudly (never silent).
fun collectMethodSigsEnum(ed: FEDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < ed.methods.len()) {
    val m: FFunc = ed.methods.get(i)
    pfuns.push(PFun(ed.name, m)); fN.push(mangleMethod(ed.name, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// register a list of synthesized static assoc functions (enum-body `const val` members) as owner-scoped
// nullary functions `<Owner>_<name>`, exactly like collectMethodSigs does for a type's body methods.
fun collectAssocConsts(owner: String, fns: IntBuf, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < fns.len()) {
    val m: FFunc = fns.get(i)
    pfuns.push(PFun(owner, m)); fN.push(mangleMethod(owner, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// a class `deinit { ... }` becomes a method `<Class>_deinit(this)`; the generated recursive-release
// routine calls it when the last reference drops (see codegen buildRelRoutine / hasDeinit).
fun collectDeinit(td: FTDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  if (isNoResF(td.dtor)) { return 0 }
  val df = FFunc(intBuf(), "deinit", "", "self", intBuf(), "Int", "", td.dtor)
  pfuns.push(PFun(td.name, df)); fN.push(mangleMethod(td.name, "deinit")); fR.push("Int")
  return 0
}

// impl-block methods (trait impls or inherent impls) register exactly like struct-body methods,
// owned by the `for` type. traitName is only a contract marker — static dispatch needs only the type.
fun collectImplMethods(im: FImplDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < im.methods.len()) {
    val m: FFunc = im.methods.get(i)
    pfuns.push(PFun(im.forTy, m)); fN.push(mangleMethod(im.forTy, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

fun collectEnum(ed: FEDecl, variantN: IntBuf, variantTag: IntBuf, variantTys: IntBuf, variantOwn: IntBuf): Int {
  var tag = 0
  var i = 0
  while (i < ed.variants.len()) {
    val v: FVariant = ed.variants.get(i)
    variantN.push(v.name); variantTag.push(tag); variantTys.push(v.tys); variantOwn.push(ed.name); tag = tag + 1
    i = i + 1
  }
  return 0
}

// ---------- class ARC: automatic retain/release insertion for reference (class) types ----------
// SAFE BY CONSTRUCTION: the compiler is written entirely in struct/enum, never `class`, so every
// compiler function has an empty owned-class-local set and arcInjectBody returns its body UNCHANGED
// -> the self-hosting fixpoint is structurally untouched. Only class-using (user) code is rewritten.
// Model: a class local created by a constructor owns +1; aliasing an existing class value retains it;
// owned class locals are released at scope exit; a returned local transfers ownership (not released).
// v1 limitation: only fall-through + TOP-LEVEL return statements are cleaned up (a return nested inside
// if/when leaks its owned locals — safe, never a double-free). `var` reassignment isn't balanced yet.
// A class gets automatic retain/release, but the built-in container nominals (IntBuf/RawMap) are EXEMPT:
// they are word-lists whose elements are type-erased Int words, so listPush can't retain a class
// element, and the compiler stores lists-inside-lists (structF/funP/variantTys) whose inner list a
// naive release would free while the outer still holds the raw pointer (UAF). So IntBuf/RawMap stay
// leak-managed exactly as when they were opaque builtins — declaring `class IntBuf` only gives them a
// visible layout + methods, never ARC. Real user classes are unaffected.
fun isClassTag(lo: Lo, t: String): Bool { return memListL(lo.classN, t) && (isArcExemptIn(lo.arcE, t) == false) }

// value-type (@value) recognition: a monomorphized tag like `Vec$Int` traces to its template base `Vec`,
// which carries the @value mark. Copy-on-bind (below) fires only for these — inert for the compiler's own
// types (none @value), so the self-host fixpoint is untouched.
fun baseTagName(t: String): String {
  var i = 0
  while (i < t.len()) { if (t.charAt(i) == 36) { return t.substr(0, i) } i = i + 1 }
  return t
}
fun isValueTag(lo: Lo, t: String): Bool { return memListL(lo.valueE, baseTagName(t)) }
// an lvalue (existing binding / field / element) whose value-type binding takes a co-owning COPY, vs a
// fresh temporary (constructor / call result) which is already unique and moves in without a copy.
fun isCopyLvalue(e: FExpr): Bool { return when (e) { FEIdent(n) -> true; FEField(a, f) -> true; FEIndex(a, b) -> true; else -> false } }

fun isCtorCallee(lo: Lo, callee: FExpr): Bool {
  return when (callee) { FEIdent(nm) -> memListL(lo.sN, nm); else -> false }
}

fun isFreshCtor(lo: Lo, e: FExpr): Bool {
  return when (e) { FECall(callee, args) -> isCtorCallee(lo, callee); else -> false }
}

fun arcReleaseInto(out: IntBuf, cls: IntBuf, exceptNm: String): Int {
  var i = 0
  while (i < cls.len()) {
    val c: String = cls.get(i)
    if (c != exceptNm) { val a = intBuf(); a.push(EIdent(c)); out.push(SExprS(ECall("__release", a))) }
    i = i + 1
  }
  return 0
}

fun arcRetName(e: Expr): String { return when (e) { EIdent(n) -> n; else -> "" } }

fun arcRelList(cls: IntBuf, exceptNm: String): IntBuf { val out = intBuf(); arcReleaseInto(out, cls, exceptNm); return out }

fun arcZeroInto(out: IntBuf, cls: IntBuf): Int {
  var i = 0
  while (i < cls.len()) { out.push(SAssign(cls.get(i), EInt("0"))); i = i + 1 }
  return 0
}

// recursive rewrite: release owned class locals before EVERY return (top-level + nested in if/when/blocks).
// Zero-init at entry (arcZeroInto) makes releasing a not-yet-declared local a nil-safe no-op, so we can
// release the whole owned set at any exit without flow-sensitive scope tracking. A returned local is
// excluded (ownership transfers to the caller); any other returned value is spilled to a temp first.
fun arcRet(lo: Lo, cls: IntBuf, v: Expr): Expr {
  val rn = arcRetName(v)
  if (memListL(cls, rn)) { return EBlock(arcRelList(cls, rn), v) }
  val t = freshName(lo, "_ar")
  val ss = intBuf(); ss.push(SLet(t, v)); arcReleaseInto(ss, cls, "")
  return EBlock(ss, EIdent(t))
}

fun arcRwArms(lo: Lo, cls: IntBuf, arms: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < arms.len()) { val a: Arm = arms.get(i); out.push(Arm(a.isElse, a.pat, arcRwExpr(lo, cls, a.body))); i = i + 1 }
  return out
}

fun arcRwExpr(lo: Lo, cls: IntBuf, e: Expr): Expr {
  return when (e) {
    ERet(v) -> ERet(arcRet(lo, cls, v))
    EIf(c, t, el) -> EIf(c, arcRwExpr(lo, cls, t), arcRwExpr(lo, cls, el))
    EWhen(subj, arms) -> EWhen(subj, arcRwArms(lo, cls, arms))
    EBlock(stmts, res) -> EBlock(arcRwStmts(lo, cls, stmts), arcRwExpr(lo, cls, res))
    else -> e
  }
}

fun arcRwStmts(lo: Lo, cls: IntBuf, stmts: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < stmts.len()) {
    val s: Stmt = stmts.get(i)
    when (s) {
      SReturnV(e) -> {
        val rn = arcRetName(e)
        if (memListL(cls, rn)) { arcReleaseInto(out, cls, rn); out.push(SReturnV(e)) }
        else { val t = freshName(lo, "_ar"); out.push(SLet(t, e)); arcReleaseInto(out, cls, ""); out.push(SReturnV(EIdent(t))) }
      }
      SReturnU -> { arcReleaseInto(out, cls, ""); out.push(SReturnU) }
      SExprS(e) -> { out.push(SExprS(arcRwExpr(lo, cls, e))); 0 }
      SWhile(c, b) -> { out.push(SWhile(c, arcRwExpr(lo, cls, b))); 0 }
      SLoop(c, b, st) -> { out.push(SLoop(c, arcRwExpr(lo, cls, b), st)); 0 }
      else -> { out.push(s); 0 }
    }
    i = i + 1
  }
  return out
}

fun arcInjectBody(lo: Lo, body: Expr, cls: IntBuf): Expr {
  if (cls.len() == 0) { return body }
  return when (body) {
    EBlock(stmts, res) -> {
      val out = intBuf()
      arcZeroInto(out, cls)
      val rw = arcRwStmts(lo, cls, stmts)
      var i = 0
      while (i < rw.len()) { out.push(rw.get(i)); i = i + 1 }
      if (isNoRes(res)) { arcReleaseInto(out, cls, ""); EBlock(out, ENoRes) }
      else {
        val r2 = arcRwExpr(lo, cls, res)
        val rn = arcRetName(r2)
        if (memListL(cls, rn)) { arcReleaseInto(out, cls, rn); EBlock(out, r2) }
        else { val t = freshName(lo, "_ar"); out.push(SLet(t, r2)); arcReleaseInto(out, cls, ""); EBlock(out, EIdent(t)) }
      }
    }
    else -> {
      val out = intBuf()
      arcZeroInto(out, cls)
      val t = freshName(lo, "_ar"); out.push(SLet(t, arcRwExpr(lo, cls, body))); arcReleaseInto(out, cls, "")
      EBlock(out, EIdent(t))
    }
  }
}

// ---------- dynamic trait dispatch: generate a ___dyn_<Trait>_<m> switch over the object's type-id ----------
fun indexOfL(l: IntBuf, n: String): Int {
  var i = 0
  while (i < l.len()) { if (l.get(i) == n) { return i }; i = i + 1 }
  return 0 - 1
}

fun findTraitDeclIdx(traitDecls: IntBuf, name: String): Int {
  var i = 0
  while (i < traitDecls.len()) { val tr: FTraitDecl = traitDecls.get(i); if (tr.name == name) { return i }; i = i + 1 }
  return 0 - 1
}

fun oneStmt(s: Stmt): IntBuf { val l = intBuf(); l.push(s); return l }

// implementations of trait `tn` (parallel implTrait/implType lists) -> the list of impl type names
fun implTypesOf(implTrait: IntBuf, implType: IntBuf, tn: String): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < implTrait.len()) { if (implTrait.get(i) == tn) { out.push(implType.get(i)) }; i = i + 1 }
  return out
}

// build  fun ___dyn_T_m(obj, <method params>): Ret { val __t = __typeId(obj)
//   if (__t == id(Ty0)) return Ty0_m(obj, params) ; ... ; return 0 }
fun buildDispatcher(traitName: String, m: FFunc, implTypes: IntBuf, structN: IntBuf): Func {
  val pnames = intBuf(); pnames.push("obj")
  val ptys = intBuf(); ptys.push(traitName)
  var i = 0
  while (i < m.params.len()) { val pp: FParam = m.params.get(i); pnames.push(pp.name); ptys.push(pp.ty); i = i + 1 }
  val stmts = intBuf()
  val tArgs = intBuf(); tArgs.push(EIdent("obj"))
  stmts.push(SLet("__t", ECall("__typeId", tArgs)))
  var j = 0
  while (j < implTypes.len()) {
    val ty: String = implTypes.get(j)
    val id = indexOfL(structN, ty)
    val cargs = intBuf(); cargs.push(EIdent("obj"))
    var k = 0
    while (k < m.params.len()) { val pp: FParam = m.params.get(k); cargs.push(EIdent(pp.name)); k = k + 1 }
    val callE = ECall(mangleMethod(ty, m.name), cargs)
    val cond = EBin("==", EIdent("__t"), EInt(id.toStr()))
    stmts.push(SExprS(EIf(cond, EBlock(oneStmt(SReturnV(callE)), ENoRes), ENoRes)))
    j = j + 1
  }
  // No impl matched the runtime type-id: this is a hard error (a trait method invoked on a type that
  // does not implement it), not a silently-wrong 0. Abort the process; the trailing return is unreachable
  // but keeps the function value-returning for the checker/codegen (STDLIB-REDESIGN §2b, Phase 4).
  stmts.push(SExprS(ECall("__abort", intBuf())))
  stmts.push(SReturnV(EInt("0")))
  return Func("__dyn_" + (traitName + ("_" + m.name)), pnames, ptys, EBlock(stmts, ENoRes))
}

// generate every trait method's dispatcher; register names/returns so calls resolve during lowering
fun genDispatchers(traitDecls: IntBuf, implTrait: IntBuf, implType: IntBuf, structN: IntBuf, fN: IntBuf, fR: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < traitDecls.len()) {
    val tr: FTraitDecl = traitDecls.get(i)
    val impls = implTypesOf(implTrait, implType, tr.name)
    var j = 0
    while (j < tr.methods.len()) {
      val m: FFunc = tr.methods.get(j)
      val d = buildDispatcher(tr.name, m, impls, structN)
      out.push(d); fN.push(d.name); fR.push(m.ret)
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// ---------- @derive: monomorphizing structural-impl synthesis (STDLIB-REDESIGN §2b, Phase 4) ----------
// A `@derive(Tr, ...)` on a struct/class synthesizes a concrete `<Type>_<method>` FFunc by structural
// recursion over the declared fields, registered exactly like a hand-written impl so the static desugar
// (==/</cmp), method dispatch, and dynamic dispatch all resolve to it. Auto-derivable trait set:
//   Eq PartialEq -> eq(self,other):Bool      Ord PartialOrd -> cmp(self,other):Int
//   Hash -> hash(self):Int                   Clone -> clone(self):Self
//   Debug -> debug(self):String             Default -> default():Self     Copy -> marker (no method)
// Requesting a non-derivable trait (Display/From/Iterator/an operator trait) is a hard build error.
// The compiler's own sources use no @derive, so this pass is inert for the self-host build.

// `t` is a leaf scalar whose eq/cmp/hash/clone/debug lower inline (no per-field method call).
fun deriveIsScalar(t: String): Bool {
  val b = tyTag(t)
  return b == "Int" || b == "Long" || b == "Short" || b == "Byte" || b == "ISize" || b == "USize" ||
  b == "UByte" || b == "UShort" || b == "UInt" || b == "ULong" ||
  b == "I8" || b == "I16" || b == "I32" || b == "I64" ||
  b == "U8" || b == "U16" || b == "U32" || b == "U64" ||
  b == "Bool" || b == "Char" || b == "Float" || b == "Double"
}

fun deriveIsString(t: String): Bool { return tyTag(t) == "String" }

fun deriveThisF(fn: String): FExpr { return FEField(FEThis, fn) }

fun deriveOtherF(fn: String): FExpr { return FEField(FEIdent("other"), fn) }

// eq body: conjunction of `self.fi == other.fi`. The synthesized `==` re-enters lowerBin so scalar fields
// machine-compare, String fields route to String_eq, and nested derived structs to their own <T>_eq.
fun deriveEqBody(fields: IntBuf): FExpr {
  if (fields.len() == 0) { return FEBlock(oneStmt(FSReturnV(FEBool("true"))), FENoRes) }
  var acc = FEBin("==", deriveThisF(fields.get(0)), deriveOtherF(fields.get(0)))
  var i = 1
  while (i < fields.len()) {
    val fn: String = fields.get(i)
    acc = FEBin("&&", acc, FEBin("==", deriveThisF(fn), deriveOtherF(fn)))
    i = i + 1
  }
  return FEBlock(oneStmt(FSReturnV(acc)), FENoRes)
}

// cmp body: lexicographic over fields, returning -1/0/1. Uses only `<`, which re-enters lowerBin so a
// nested field routes to its own <T>_cmp (Ord desugar) while scalar fields machine-compare.
fun deriveCmpBody(fields: IntBuf): FExpr {
  val stmts = intBuf()
  var i = 0
  while (i < fields.len()) {
    val fn: String = fields.get(i)
    val ltCond = FEBin("<", deriveThisF(fn), deriveOtherF(fn))
    stmts.push(FSExprS(FEIf(ltCond, FEBlock(oneStmt(FSReturnV(FEBin("-", FEInt("0"), FEInt("1")))), FENoRes), FENoRes)))
    val gtCond = FEBin("<", deriveOtherF(fn), deriveThisF(fn))
    stmts.push(FSExprS(FEIf(gtCond, FEBlock(oneStmt(FSReturnV(FEInt("1"))), FENoRes), FENoRes)))
    i = i + 1
  }
  stmts.push(FSReturnV(FEInt("0")))
  return FEBlock(stmts, FENoRes)
}

// per-field hash contribution as an INT surrogate: the FNV mix folds it through integer `*`/`+`, so the
// contribution must be Int-typed — feeding a String (routes `+` to concat, deref-crash) or a boxed Double
// (would IMul a pointer) into that arithmetic corrupts/crashes. String -> its byte length (.len()); a
// Double/Float -> toInt() truncation; other scalars (Int/Bool/Char/…) are already a raw Int word; a nested
// derived type -> its own <T>_hash(). A proper byte-fold String hash arrives with the Phase 5 String work.
fun deriveHashOf(fn: String, ft: String): FExpr {
  val b = tyTag(ft)
  if (b == "String") { return FECall(FEField(deriveThisF(fn), "len"), intBuf()) }
  if (b == "Float" || b == "Double") { val ta = intBuf(); ta.push(FArg("", deriveThisF(fn))); return FECall(FEIdent("toInt"), ta) }
  if (deriveIsScalar(ft)) { return deriveThisF(fn) }
  return FECall(FEField(deriveThisF(fn), "hash"), intBuf())
}

// hash body: FNV-style mix  var __h = 0 ; __h = __h*31 + hash(fi) ; ... ; return __h
fun deriveHashBody(fields: IntBuf, ftys: IntBuf): FExpr {
  val stmts = intBuf()
  stmts.push(FSLet(1, "__h", "Int", FEInt("0")))
  var i = 0
  while (i < fields.len()) {
    val h = deriveHashOf(fields.get(i), ftys.get(i))
    stmts.push(FSAssign(FEIdent("__h"), FEBin("+", FEBin("*", FEIdent("__h"), FEInt("31")), h)))
    i = i + 1
  }
  stmts.push(FSReturnV(FEIdent("__h")))
  return FEBlock(stmts, FENoRes)
}

// clone body: reconstruct the struct; scalar/String fields copy the word, nested fields deep-clone.
fun deriveCloneBody(tyName: String, fields: IntBuf, ftys: IntBuf): FExpr {
  val args = intBuf()
  var i = 0
  while (i < fields.len()) {
    val fn: String = fields.get(i); val ft: String = ftys.get(i)
    if (deriveIsScalar(ft) || deriveIsString(ft)) { args.push(FArg("", deriveThisF(fn))) }
    else { args.push(FArg("", FECall(FEField(deriveThisF(fn), "clone"), intBuf()))) }
    i = i + 1
  }
  return FEBlock(oneStmt(FSReturnV(FECall(FEIdent(tyName), args))), FENoRes)
}

// debug body: `TypeName(f0, f1, ...)` via interpolation. Scalars render via str.show (Int_toStr), String
// fields render directly, nested fields render via their own <T>_debug() (a String).
fun deriveDebugBody(tyName: String, fields: IntBuf, ftys: IntBuf): FExpr {
  val parts = intBuf()
  parts.push(FILit(tyName + "("))
  var i = 0
  while (i < fields.len()) {
    if (i > 0) { parts.push(FILit(", ")) }
    val fn: String = fields.get(i); val ft: String = ftys.get(i)
    if (deriveIsScalar(ft) || deriveIsString(ft)) { parts.push(FIExpr(deriveThisF(fn))) }
    else { parts.push(FIExpr(FECall(FEField(deriveThisF(fn), "debug"), intBuf()))) }
    i = i + 1
  }
  parts.push(FILit(")"))
  return FEBlock(oneStmt(FSReturnV(FEInterp(parts, 0))), FENoRes)
}

// default body: construct from each field's default (0 for scalars, "" for String, <T>::default() nested).
fun deriveDefaultBody(tyName: String, fields: IntBuf, ftys: IntBuf): FExpr {
  val args = intBuf()
  var i = 0
  while (i < fields.len()) {
    val ft: String = ftys.get(i)
    if (deriveIsScalar(ft)) { args.push(FArg("", FEInt("0"))) }
    else { if (deriveIsString(ft)) { args.push(FArg("", FEStr("", 0))) }
      else { args.push(FArg("", FECall(FEStatic(FEIdent(tyTag(ft)), "default"), intBuf()))) } }
    i = i + 1
  }
  return FEBlock(oneStmt(FSReturnV(FECall(FEIdent(tyName), args))), FENoRes)
}

// ---------- @derive over ENUMS (STDLIB-REDESIGN §2b, Phase 4) ----------
// An enum value is a boxed {tag@0, payload@8+8j}. A derived method matches on the variant (a `when` over
// self, and — for the binary Eq/Ord — a nested `when` over other) so the tag is compared first and the
// payloads structurally. The subject is FEThis (the recv `self` binds to `this`), never a param literally
// named `self` (a free-fn param named `self` is a known codegen hazard). Per-arm the payload binders are
// __s0.. (self) / __o0.. (other), typed from the variant table so `__sJ == __oJ` routes by payload type.

// one-element FPat list (an arm's pattern-alternatives list holds a single ctor pattern).
fun oneP(p: FPat): IntBuf { val l = intBuf(); l.push(p); return l }

// ctor pattern `V(__<pre>0, __<pre>1, ...)` binding `n` positional payload holes.
fun deriveBindPats(pre: String, n: Int): IntBuf {
  val ps = intBuf()
  var j = 0
  while (j < n) { ps.push(FPBind("__" + (pre + j.toStr()))); j = j + 1 }
  return ps
}

// gather one enum's variant names (declaration order) from the flat variant table (filtered by owner).
fun enumVariantNamesOf(variantN: IntBuf, variantOwn: IntBuf, en: String): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < variantN.len()) { if (variantOwn.get(i) == en) { out.push(variantN.get(i)) }; i = i + 1 }
  return out
}

// gather the parallel per-variant payload-type lists for one enum.
fun enumVariantTysOf(variantN: IntBuf, variantOwn: IntBuf, variantTys: IntBuf, en: String): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < variantN.len()) { if (variantOwn.get(i) == en) { out.push(variantTys.get(i)) }; i = i + 1 }
  return out
}

// eq conjunction over the payload binders `__s0..__o0..`: AND of `__sJ == __oJ`; empty payload -> true.
fun deriveEnumEqConj(n: Int): FExpr {
  if (n == 0) { return FEBool("true") }
  var acc = FEBin("==", FEIdent("__s0"), FEIdent("__o0"))
  var j = 1
  while (j < n) { acc = FEBin("&&", acc, FEBin("==", FEIdent("__s" + j.toStr()), FEIdent("__o" + j.toStr()))); j = j + 1 }
  return acc
}

// enum eq: `when (self) { V(s..) -> when (other) { V(o..) -> AND(s==o) ; else -> false } ... else -> false }`.
fun deriveEnumEqBody(vnames: IntBuf, vtys: IntBuf): FExpr {
  val arms = intBuf()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: IntBuf = vtys.get(i)
    val innerArms = intBuf()
    innerArms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("o", tys.len()))), FENoRes, deriveEnumEqConj(tys.len())))
    innerArms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEBool("false")))
    val inner = FEWhen(1, "", FEIdent("other"), innerArms)
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, inner))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEBool("false")))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// lexicographic payload compare of `__s0..` vs `__o0..` as a value: nested if returning -1/0/1.
fun deriveEnumCmpPayload(n: Int, i: Int): FExpr {
  if (i >= n) { return FEInt("0") }
  val sJ = FEIdent("__s" + i.toStr()); val oJ = FEIdent("__o" + i.toStr())
  val neg = FEBin("-", FEInt("0"), FEInt("1"))
  return FEIf(FEBin("<", sJ, oJ), neg, FEIf(FEBin("<", oJ, sJ), FEInt("1"), deriveEnumCmpPayload(n, i + 1)))
}

// enum cmp: variant declaration order first, then payloads. For outer variant `oi`, the inner `when (other)`
// returns 1 for an EARLIER variant (self greater), the payload compare for the SAME variant, -1 for a LATER
// variant. Every variant is covered; an else -> 0 backstops.
fun deriveEnumCmpBody(vnames: IntBuf, vtys: IntBuf): FExpr {
  val arms = intBuf()
  var oi = 0
  while (oi < vnames.len()) {
    val vn: String = vnames.get(oi)
    val tys: IntBuf = vtys.get(oi)
    val innerArms = intBuf()
    var ii = 0
    while (ii < vnames.len()) {
      val ivn: String = vnames.get(ii)
      val itys: IntBuf = vtys.get(ii)
      val body = if (ii == oi) { deriveEnumCmpPayload(tys.len(), 0) } else { if (ii < oi) { FEInt("1") } else { FEBin("-", FEInt("0"), FEInt("1")) } }
      innerArms.push(FArm(2, FENoRes, oneP(FPCtor(ivn, deriveBindPats("o", itys.len()))), FENoRes, body))
      ii = ii + 1
    }
    innerArms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEInt("0")))
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, FEWhen(1, "", FEIdent("other"), innerArms)))
    oi = oi + 1
  }
  arms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEInt("0")))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// per-payload-local hash surrogate (Int): String -> .len(), Double -> toInt(), scalar -> the word, nested -> .hash().
fun deriveEnumHashOf(nm: String, ft: String): FExpr {
  val b = tyTag(ft)
  if (b == "String") { return FECall(FEField(FEIdent(nm), "len"), intBuf()) }
  if (b == "Float" || b == "Double") { val ta = intBuf(); ta.push(FArg("", FEIdent(nm))); return FECall(FEIdent("toInt"), ta) }
  if (deriveIsScalar(ft)) { return FEIdent(nm) }
  return FECall(FEField(FEIdent(nm), "hash"), intBuf())
}

// enum hash: `when (self) { V(s..) -> FNV-mix(<variant-index>, hash(s0), ...) }`. The variant index seeds the
// mix so distinct variants (even with equal payloads) hash apart; equal values hash equal (matches derived eq).
fun deriveEnumHashBody(vnames: IntBuf, vtys: IntBuf): FExpr {
  val arms = intBuf()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: IntBuf = vtys.get(i)
    var acc = FEBin("+", FEBin("*", FEInt("0"), FEInt("31")), FEInt(i.toStr()))
    var j = 0
    while (j < tys.len()) {
      acc = FEBin("+", FEBin("*", acc, FEInt("31")), deriveEnumHashOf("__s" + j.toStr(), tys.get(j)))
      j = j + 1
    }
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, acc))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEInt("0")))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// enum clone: `when (self) { V(s..) -> V(clone(s0), ...) }`. Scalar/String copy the word, nested deep-clone.
fun deriveEnumCloneBody(vnames: IntBuf, vtys: IntBuf): FExpr {
  val arms = intBuf()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: IntBuf = vtys.get(i)
    val cargs = intBuf()
    var j = 0
    while (j < tys.len()) {
      val ft: String = tys.get(j); val nm = "__s" + j.toStr()
      if (deriveIsScalar(ft) || deriveIsString(ft)) { cargs.push(FArg("", FEIdent(nm))) }
      else { cargs.push(FArg("", FECall(FEField(FEIdent(nm), "clone"), intBuf()))) }
      j = j + 1
    }
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, FECall(FEIdent(vn), cargs)))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEThis))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// enum debug: `when (self) { V(s..) -> "V(s0, s1)" }` via interpolation. Scalar/String render directly,
// nested via their own <T>_debug().
fun deriveEnumDebugBody(vnames: IntBuf, vtys: IntBuf): FExpr {
  val arms = intBuf()
  var i = 0
  while (i < vnames.len()) {
    val vn: String = vnames.get(i)
    val tys: IntBuf = vtys.get(i)
    val parts = intBuf()
    if (tys.len() == 0) { parts.push(FILit(vn)) }
    else {
      parts.push(FILit(vn + "("))
      var j = 0
      while (j < tys.len()) {
        if (j > 0) { parts.push(FILit(", ")) }
        val ft: String = tys.get(j); val nm = "__s" + j.toStr()
        if (deriveIsScalar(ft) || deriveIsString(ft)) { parts.push(FIExpr(FEIdent(nm))) }
        else { parts.push(FIExpr(FECall(FEField(FEIdent(nm), "debug"), intBuf()))) }
        j = j + 1
      }
      parts.push(FILit(")"))
    }
    arms.push(FArm(2, FENoRes, oneP(FPCtor(vn, deriveBindPats("s", tys.len()))), FENoRes, FEInterp(parts, 0)))
    i = i + 1
  }
  arms.push(FArm(1, FENoRes, intBuf(), FENoRes, FEStr("", 0)))
  return FEBlock(oneStmt(FSReturnV(FEWhen(1, "", FEThis, arms))), FENoRes)
}

// enum default: the FIRST variant, each payload at its own default (0 / "" / <T>::default()).
fun deriveEnumDefaultBody(vnames: IntBuf, vtys: IntBuf): FExpr {
  val vn: String = vnames.get(0)
  val tys: IntBuf = vtys.get(0)
  val args = intBuf()
  var j = 0
  while (j < tys.len()) {
    val ft: String = tys.get(j)
    if (deriveIsScalar(ft)) { args.push(FArg("", FEInt("0"))) }
    else { if (deriveIsString(ft)) { args.push(FArg("", FEStr("", 0))) }
      else { args.push(FArg("", FECall(FEStatic(FEIdent(tyTag(ft)), "default"), intBuf()))) } }
    j = j + 1
  }
  return FEBlock(oneStmt(FSReturnV(FECall(FEIdent(vn), args))), FENoRes)
}

// synthesize the method(s) for one `@derive(tr)` on ENUM `enName` with the given variant names / payload-ty lists.
fun deriveOneEnum(pfuns: IntBuf, fN: IntBuf, fR: IntBuf, implTrait: IntBuf, implType: IntBuf, enName: String, tr: String, vnames: IntBuf, vtys: IntBuf): Int {
  if (deriveIsKnown(tr) == false) { lowFail("cannot @derive(" + (tr + (") for " + (enName + " — not an auto-derivable trait")))); return 0 }
  if (tr == "Eq" || tr == "PartialEq") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "eq", "Bool", FFunc(intBuf(), "eq", "", "self", cons1P(FParam("other", enName, 0)), "Bool", "", deriveEnumEqBody(vnames, vtys)))
  }
  if (tr == "Ord") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "cmp", "Int", FFunc(intBuf(), "cmp", "", "self", cons1P(FParam("other", enName, 0)), "Int", "", deriveEnumCmpBody(vnames, vtys)))
  }
  if (tr == "PartialOrd") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "partialCmp", "Int", FFunc(intBuf(), "partialCmp", "", "self", cons1P(FParam("other", enName, 0)), "Int", "", deriveEnumCmpBody(vnames, vtys)))
  }
  if (tr == "Hash") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "hash", "Int", FFunc(intBuf(), "hash", "", "self", intBuf(), "Int", "", deriveEnumHashBody(vnames, vtys)))
  }
  if (tr == "Clone") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "clone", enName, FFunc(intBuf(), "clone", "", "self", intBuf(), enName, "", deriveEnumCloneBody(vnames, vtys)))
  }
  if (tr == "Debug") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "debug", "String", FFunc(intBuf(), "debug", "", "self", intBuf(), "String", "", deriveEnumDebugBody(vnames, vtys)))
  }
  if (tr == "Default") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, enName, tr, "default", enName, FFunc(intBuf(), "default", "", "", intBuf(), enName, "", deriveEnumDefaultBody(vnames, vtys)))
  }
  // Copy is a marker: nothing to synthesize.
  return 0
}

// §2b well-formedness for an ENUM derive: every payload type of every variant must be scalar/String or itself
// carry the trait's method; Double payloads are rejected for the compare/print/default derives. Hard-aborts
// (exit 134, no binary) — the same silent-pointer-compare hazard the struct field check guards.
fun deriveCheckWFEnum(fN: IntBuf, enName: String, tr: String, vnames: IntBuf, vtys: IntBuf): Int {
  val m = deriveMethodFor(tr)
  if (m == "") { return 0 }
  var i = 0
  while (i < vnames.len()) {
    val tys: IntBuf = vtys.get(i)
    var j = 0
    while (j < tys.len()) {
      val ft: String = tys.get(j)
      val b = tyTag(ft)
      if (b == "Float" || b == "Double") {
        if (deriveFloatUnsafe(tr)) {
          lowFail("cannot @derive(" + (tr + (") for " + (enName + (": " + (vnames.get(i) + " payload — floating-point fields are not derivable until Double is unboxed"))))))
        }
      } else {
        if (deriveIsScalar(ft) == false && deriveIsString(ft) == false) {
          if (memListL(fN, mangleMethod(b, m)) == false) {
            lowFail("cannot @derive(" + (tr + (") for " + (enName + (": " + (vnames.get(i) + (" payload of type " + (ft + (" does not implement " + tr)))))))))
          }
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return 0
}

// membership in the auto-derivable trait set (rejects Display/From/Iterator/operator traits).
fun deriveIsKnown(tr: String): Bool {
  return tr == "Eq" || tr == "PartialEq" || tr == "Ord" || tr == "PartialOrd" ||
  tr == "Hash" || tr == "Clone" || tr == "Copy" || tr == "Default" || tr == "Debug"
}

// register one synthesized derive method (deduped against hand impls / prior derives). Records the impl in
// implTrait/implType too, so the trait's dispatcher (when the trait decl is present) includes this type.
fun deriveEmit(pfuns: IntBuf, fN: IntBuf, fR: IntBuf, implTrait: IntBuf, implType: IntBuf, tyName: String, tr: String, mName: String, ret: String, fn: FFunc): Int {
  val mangled = mangleMethod(tyName, mName)
  if (memListL(fN, mangled) == false) {
    pfuns.push(PFun(tyName, fn)); fN.push(mangled); fR.push(ret)
  }
  implTrait.push(tr); implType.push(tyName)
  return 0
}

// synthesize the method(s) for one `@derive(tr)` on struct `tyName` with the given fields/types.
fun deriveOne(pfuns: IntBuf, fN: IntBuf, fR: IntBuf, implTrait: IntBuf, implType: IntBuf, tyName: String, tr: String, fields: IntBuf, ftys: IntBuf): Int {
  if (deriveIsKnown(tr) == false) { lowFail("cannot @derive(" + (tr + (") for " + (tyName + " — not an auto-derivable trait")))); return 0 }
  if (tr == "Eq" || tr == "PartialEq") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "eq", "Bool", FFunc(intBuf(), "eq", "", "self", cons1P(FParam("other", tyName, 0)), "Bool", "", deriveEqBody(fields)))
  }
  // Ord's declared method is `cmp`; PartialOrd's is `partialCmp` (lib/core/cmp.kite). Emit under the
  // trait's ACTUAL method name so its dispatcher (__dyn_<Tr>_<m>) resolves to a real <T>_<m> — deriving
  // under the wrong name left __dyn_PartialOrd_partialCmp calling a never-synthesized <T>_partialCmp
  // (dangling symbol, non-loadable binary). The </<=/>/>= desugar (cmpMangledFor) resolves either name.
  if (tr == "Ord") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "cmp", "Int", FFunc(intBuf(), "cmp", "", "self", cons1P(FParam("other", tyName, 0)), "Int", "", deriveCmpBody(fields)))
  }
  if (tr == "PartialOrd") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "partialCmp", "Int", FFunc(intBuf(), "partialCmp", "", "self", cons1P(FParam("other", tyName, 0)), "Int", "", deriveCmpBody(fields)))
  }
  if (tr == "Hash") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "hash", "Int", FFunc(intBuf(), "hash", "", "self", intBuf(), "Int", "", deriveHashBody(fields, ftys)))
  }
  if (tr == "Clone") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "clone", tyName, FFunc(intBuf(), "clone", "", "self", intBuf(), tyName, "", deriveCloneBody(tyName, fields, ftys)))
  }
  if (tr == "Debug") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "debug", "String", FFunc(intBuf(), "debug", "", "self", intBuf(), "String", "", deriveDebugBody(tyName, fields, ftys)))
  }
  if (tr == "Default") {
    deriveEmit(pfuns, fN, fR, implTrait, implType, tyName, tr, "default", tyName, FFunc(intBuf(), "default", "", "", intBuf(), tyName, "", deriveDefaultBody(tyName, fields, ftys)))
  }
  // Copy is a marker: nothing to synthesize (value structs already copy bitwise on assignment).
  return 0
}

// one-element FParam list helper (mirrors oneStmt).
fun cons1P(p: FParam): IntBuf { val l = intBuf(); l.push(p); return l }

// the concrete method a nested field must provide so its <T>_<method> resolves during structural
// recursion (Eq/PartialEq->eq, Ord->cmp, PartialOrd->partialCmp, Hash->hash, Clone->clone, Debug->debug,
// Default->default). Copy is a marker with no per-field requirement -> "".
fun deriveMethodFor(tr: String): String {
  if (tr == "Eq" || tr == "PartialEq") { return "eq" }
  if (tr == "Ord") { return "cmp" }
  if (tr == "PartialOrd") { return "partialCmp" }
  if (tr == "Hash") { return "hash" }
  if (tr == "Clone") { return "clone" }
  if (tr == "Debug") { return "debug" }
  if (tr == "Default") { return "default" }
  return ""
}

// derived Eq/Ord/PartialOrd/Debug/Default over a Double/Float field silently MISCOMPILES today: tagOf
// cannot infer `self.<field>: Double`, so the synthesized `==`/`<` emit an INTEGER compare of the boxed
// pointers (Debug prints the box pointer; Default stores an Int 0 into a Double slot). Hash is safe (it
// folds a toInt() surrogate) and Clone/Copy copy the (immutable) word. Until Double is unboxed (Phase 10),
// reject these derives over a float field rather than emit wrong code. Root cause is pre-existing (a
// hand-written `self.c == other.c` over a Double field fails identically); this stops the silent-wrong.
fun deriveFloatUnsafe(tr: String): Bool {
  return tr == "Eq" || tr == "PartialEq" || tr == "Ord" || tr == "PartialOrd" || tr == "Debug" || tr == "Default"
}

// §2b well-formedness: a derive is rejected if any field type is not derivable for the trait. A scalar or
// String the synthesizer handles inline; any other field type must itself carry an impl/derive of the same
// trait (its `<Tag>_<method>` is registered in fN). A field lacking it would silently pointer-compare
// (garbage `==`), so we hard-abort here (exit 134, no binary) — the same path as the non-derivable-trait
// rejection. Float/Double fields are rejected for the compare/print/default derives (see deriveFloatUnsafe).
// Runs AFTER all synthesis so nested derives (e.g. Line over a derived Point) are already registered.
fun deriveCheckWF(fN: IntBuf, tyName: String, tr: String, fields: IntBuf, ftys: IntBuf): Int {
  val m = deriveMethodFor(tr)
  if (m == "") { return 0 }
  var i = 0
  while (i < fields.len()) {
    val fn: String = fields.get(i)
    val ft: String = ftys.get(i)
    val b = tyTag(ft)
    if (b == "Float" || b == "Double") {
      if (deriveFloatUnsafe(tr)) {
        lowFail("cannot @derive(" + (tr + (") for " + (tyName + (": field " + (fn + " — floating-point fields are not derivable until Double is unboxed"))))))
      }
    } else {
      if (deriveIsScalar(ft) == false && deriveIsString(ft) == false) {
        if (memListL(fN, mangleMethod(b, m)) == false) {
          lowFail("cannot @derive(" + (tr + (") for " + (tyName + (": field " + (fn + (" of type " + (ft + (" does not implement " + tr)))))))))
        }
      }
    }
    i = i + 1
  }
  return 0
}

// find struct `tyName`'s field-name / field-type lists; returns index into structN or -1.
fun deriveStructIdx(structN: IntBuf, name: String): Int {
  var i = 0
  while (i < structN.len()) { if (structN.get(i) == name) { return i }; i = i + 1 }
  return 0 - 1
}

// is `name` a declared enum (i.e. it owns at least one variant)?
fun isEnumType(variantOwn: IntBuf, name: String): Bool { return memListL(variantOwn, name) }

// run every collected @derive: for each (type, trait) pair, synthesize + register the concrete impl.
// A struct/class derives by structural recursion over its fields; an ENUM by matching on the variant (tag
// then payloads). A derive on a type that is NEITHER a known struct nor a known enum hard-aborts below via
// deriveOne's non-derivable path only if it is a struct — a stray name is dropped (no such surface exists).
fun runDerives(deriveT: IntBuf, deriveTr: IntBuf, pfuns: IntBuf, fN: IntBuf, fR: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, variantN: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, implTrait: IntBuf, implType: IntBuf): Int {
  var i = 0
  while (i < deriveT.len()) {
    val tyName: String = deriveT.get(i)
    val tr: String = deriveTr.get(i)
    val si = deriveStructIdx(structN, tyName)
    if (si >= 0) {
      deriveOne(pfuns, fN, fR, implTrait, implType, tyName, tr, structF.get(si), structFT.get(si))
    } else { if (isEnumType(variantOwn, tyName)) {
        deriveOneEnum(pfuns, fN, fR, implTrait, implType, tyName, tr, enumVariantNamesOf(variantN, variantOwn, tyName), enumVariantTysOf(variantN, variantOwn, variantTys, tyName))
      } }
    i = i + 1
  }
  // §2b well-formedness — SECOND pass, after every derive is synthesized so nested-field methods
  // (a derived Point used inside a derived Line, or a struct payload inside a derived enum) are already
  // registered in fN. Any field/payload that is neither a scalar/String nor a type carrying the trait's
  // method hard-aborts (no binary) — this is what stops the silent pointer-compare for enums too.
  var w = 0
  while (w < deriveT.len()) {
    val wtn: String = deriveT.get(w)
    val wtr: String = deriveTr.get(w)
    val wsi = deriveStructIdx(structN, wtn)
    if (wsi >= 0) { deriveCheckWF(fN, wtn, wtr, structF.get(wsi), structFT.get(wsi)) }
    else { if (isEnumType(variantOwn, wtn)) { deriveCheckWFEnum(fN, wtn, wtr, enumVariantNamesOf(variantN, variantOwn, wtn), enumVariantTysOf(variantN, variantOwn, variantTys, wtn)) } }
    w = w + 1
  }
  return 0
}

// record @derive(Tr, ...) annotations on a type decl into the parallel (type,trait) worklists.
fun recordDerive(annos: IntBuf, tyName: String, deriveT: IntBuf, deriveTr: IntBuf): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "derive") {
      var j = 0
      while (j < a.args.len()) {
        val ax: FExpr = a.args.get(j)
        val trn = when (ax) { FEIdent(n) -> n; else -> "" }
        if (trn != "") { deriveT.push(tyName); deriveTr.push(trn) }
        j = j + 1
      }
    }
    i = i + 1
  }
  return 0
}

fun lowerFuncFull(pf: PFun, fN: IntBuf, fR: IntBuf, sN: IntBuf, sFN: IntBuf, sFT: IntBuf, lifted: IntBuf, gctr: IntBuf, classN: IntBuf, traitN: IntBuf, constN: IntBuf, constV: IntBuf, cfuncs: IntBuf, traitMethN: IntBuf, traitMethT: IntBuf, pmN: IntBuf, pmM: IntBuf, variantN: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, roleK: IntBuf, roleV: IntBuf, arcE: IntBuf, valueE: IntBuf, prim: PReg, fpN: IntBuf, fpT: IntBuf, mt: MTab, vareg: VaReg): Func {
  val fd = pf.fd
  val ctr = intBuf(); ctr.push(0)
  val lo = Lo(ctr, intBuf(), intBuf(), fN, fR, sN, sFN, sFT, lifted, gctr, classN, intBuf(), traitN, constN, constV, cfuncs, traitMethN, traitMethT, pmN, pmM, variantN, variantTys, variantOwn, roleK, roleV, arcE, valueE, prim, fpN, fpT, mt, vareg)
  val names = intBuf()
  val tys = intBuf()
  if (pf.owner != "" && fd.recv != "") { names.push("this"); tys.push(pf.owner); bindLoc(lo, "this", pf.owner) }
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); val bt = stripMode(pp.ty); names.push(pp.name); tys.push(bt); bindLoc(lo, pp.name, tyTagR(bt)); i = i + 1 }
  val bodyE = lowerExpr(lo, fd.body)
  return Func(mangleMethod(pf.owner, fd.name), names, tys, arcInjectBody(lo, bodyE, lo.arcOwned))
}

// The implicit prelude (IntBuf/RawMap runtime + nominal methods) is auto-included into every program.
// It is CONFIGURATION-driven: compiler/prelude.conf NAMES the standard-library modules to inject
// (like C/C++ default availability). The compiler is NOT coupled to lib/ — it has no hardcoded
// prelude; it only reads the config and the lib modules the config names. Each `kite::` line resolves
// through the SAME `::`->/ + kite/->lib/ mapping as a normal import.
// (Paths are cwd-relative for now; a real install would resolve them near the binary.)
// A conf line is a COMMENT (skipped) when its first non-space char is `#`, or it is blank. This check
// MUST run before impExtractPath: impExtractQuoted() would otherwise pull a path out of a double-quoted
// word inside a comment (e.g. `# ... a "sugar" package`) → a bogus path → readFile null → segfault.
fun confIsComment(line: String): Int {
  val n = line.len()
  var i = 0
  var go = 1
  while (go == 1) { if (i >= n) { go = 0 } else { if (line.charAt(i) == 32) { i = i + 1 } else { go = 0 } } }
  if (i >= n) { return 1 }
  if (line.charAt(i) == 35) { return 1 }
  return 0
}

// preludeConfPaths: parse compiler/prelude.conf and return the auto-included module paths (comments skipped).
// This is the SINGLE source of truth for the default prelude — the lowerer (injectHelpers), the checker
// (preludeDeclList), and collectModules all read it. String is unconditionally the boxed `class String`
// (kite::core::string — now the ONE String module, transforms included — + kite::core::strbuilder), so there
// is no representation swap here — the list is exactly prelude.conf's non-comment lines.
fun preludeConfPaths(): IntBuf {
  val out = intBuf()
  val src = readFile("compiler/prelude.conf")
  val n = src.len()
  var i = 0
  var line = ""
  while (i <= n) {
    var brk = 0
    if (i == n) { brk = 1 } else { if (src.charAt(i) == 10) { brk = 1 } }
    if (brk == 1) {
      if (confIsComment(line) == 0) {
        val p = impExtractPath("import " + line)
        if (p != "") { out.push(p) }
      }
      line = ""
    } else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  return out
}

// The set of infix-fun method names declared across ALL auto-injected prelude modules (compiler/prelude.conf).
// A prelude module (e.g. lib/core/pair.kite's `infix fun A.to`) declares an infix operator the user can write
// WITHOUT importing anything, so the user-program parser (parseLower / parseProgramLn / parseModuleRaw) must
// seed its infix-name set with these before scanning the user's own tokens. Scans the same lib sources the
// prelude injects; deduped. Empty when no prelude module declares an infix fun.
fun preludeInfixNames(): IntBuf {
  val out = intBuf()
  val paths = preludeConfPaths()
  var i = 0
  while (i < paths.len()) { scanInfixNames(lex(readFile(paths.get(i))), out); i = i + 1 }
  return out
}

// ---------- @lang collection: source the desugar role table from lib/ annotations ----------
// A prelude decl may carry `@lang("<role>")`; we record role -> the symbol the compiler EMITS for that
// decl, so the desugar sites (roleSym) resolve exactly the symbol they baked in before. Symbol rule:
// a free function emits its bare name; a class/struct method emits its owner-mangled name (List_push);
// a trait method emits its bare method name (the operand's type is mangled in at the use site). These
// three rules mirror how the rest of the lowerer names those callees, so the map equals the old table.
fun annoStr(e: FExpr): String { return when (e) { FEStr(t, r) -> t; else -> "" } }

fun recordLang(annos: IntBuf, sym: String, roleK: IntBuf, roleV: IntBuf): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "lang" && a.args.len() > 0) { roleK.push(annoStr(a.args.get(0))); roleV.push(sym) }
    i = i + 1
  }
  return 0
}

// Re-point every `@lang(role)` a function DECLARES from its old symbol to `full`. Used by overloadRemangle:
// when a role-annotated free function (e.g. `@lang("intbuf.new") fun intBuf()`) joins an overload set, its
// selector is sig-mangled (`intBuf` -> `intBuf__0__`), so the role table — consulted by the `[..]`/`{..}`
// desugar (roleSym) to emit the constructor call — must follow the rename or it would emit a dangling
// symbol. Keyed on the roles THIS function carries (not on the old symbol), so a same-named vararg overload
// that carries no role never mis-points anything, regardless of overload-set processing order.
fun remangleRoles(annos: IntBuf, full: String, roleK: IntBuf, roleV: IntBuf): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "lang" && a.args.len() > 0) {
      val role = annoStr(a.args.get(0))
      var j = 0
      while (j < roleK.len()) { if (roleK.get(j) == role) { roleV.set(j, full) } j = j + 1 }
    }
    i = i + 1
  }
  return 0
}
// scan a method list; symbol = owner-mangled (mangle==1, class/struct) or bare method name (mangle==0, trait).
fun recordLangMethods(methods: IntBuf, owner: String, mangle: Int, roleK: IntBuf, roleV: IntBuf): Int {
  var i = 0
  while (i < methods.len()) {
    val m: FFunc = methods.get(i)
    val sym = if (mangle == 1) { mangleMethod(owner, m.name) } else { m.name }
    recordLang(m.annos, sym, roleK, roleV)
    i = i + 1
  }
  return 0
}

// @arc(manual): does this decl's annotation list mark it as manually ARC-managed (exempt from auto-ARC)?
fun hasArcManual(annos: IntBuf): Bool {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "arc" && a.args.len() > 0) {
      val e0: FExpr = a.args.get(0)
      val m = when (e0) { FEIdent(s) -> s; else -> "" }
      if (m == "manual") { return true }
    }
    i = i + 1
  }
  return false
}

fun recordArc(annos: IntBuf, name: String, arcE: IntBuf): Int {
  if (hasArcManual(annos)) { arcE.push(name) }
  return 0
}

// @value: does this decl's annotation list mark it a value type (CoW value semantics — copied on bind,
// not aliased)? The compiler's own types carry no @value, so the copy-on-bind machinery is inert for the
// self-host build and the fixpoint is untouched (STDLIB-REDESIGN §5 phase 7 / §124 Vec CoW-over-ARC).
fun hasValueAttr(annos: IntBuf): Bool {
  var i = 0
  while (i < annos.len()) { val a: Anno = annos.get(i); if (a.name == "value") { return true }; i = i + 1 }
  return false
}
fun recordValue(annos: IntBuf, name: String, valueE: IntBuf): Int {
  if (hasValueAttr(annos)) { valueE.push(name) }
  return 0
}

// @prim: is this decl a PRIMITIVE-scalar declaration (its @prim marker names Kite's machine
// classification, e.g. `@prim("sint",64) class Int`)? A @prim struct/class is NOT a heap type: it is
// DIVERTED away from structN/classN below so it never boxes, mallocs, or auto-ARCs — it exists purely to
// carry the scalar's name into the checker's primitive registry, identical to the older `@prim fun Int()`.
fun hasPrim(annos: IntBuf): Bool {
  var i = 0
  while (i < annos.len()) { val a: Anno = annos.get(i); if (a.name == "prim") { return true }; i = i + 1 }
  return false
}

// A @prim struct/class is registered EXACTLY as the older `@prim fun Int()` was: a signature-only PFun
// that carries the @prim annotation into `pfuns` (so finishLower's `recordPrim` scan builds the SAME
// primitive registry that drives sizeOf<T>()/packed strides) and a name entry in fN — but is kept OUT of
// structN/classN, so it never heap-allocates, mallocs, or auto-ARCs. Its body methods (if any) still
// register under the normal owner-mangled convention.
fun collectPrim(td: FTDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  val sig = FFunc(td.annos, td.name, "", "", intBuf(), "", "", FENoRes)
  pfuns.push(PFun("", sig)); fN.push(td.name); fR.push("")
  collectMethodSigs(td, pfuns, fN, fR)
  return 0
}

// ---------- member-table population helpers (Phase M0) ----------
fun mtNew(): MTab { return MTab(intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf()) }

fun mtType(mt: MTab, name: String): Int { if (memListL(mt.types, name) == false) { mt.types.push(name) }; return 0 }

fun mtAdd(mt: MTab, owner: String, sel: String, kind: String, inst: Int, sym: String, info: String): Int {
  mt.owner.push(owner); mt.sel.push(sel); mt.kind.push(kind); mt.inst.push(inst); mt.sym.push(sym); mt.info.push(info)
  return 0
}

// the single erased symbol of a GENERIC extension (`fun <A> A.sel(..)`) registered for selector `sel`, or
// "" if none. Since generics are type-erased, one such body serves any receiver — so a `recv.sel(..)` whose
// concrete `<Recv>_sel` is undefined resolves here (see methodCallee). Empty in the compiler's own build
// (it declares no generic extensions) → the methodCallee fallback is inert and the fixpoint is untouched.
fun mtGenExtSym(mt: MTab, sel: String): String {
  var i = 0
  while (i < mt.sel.len()) { if (mt.kind.get(i) == "genext") { if (mt.sel.get(i) == sel) { return mt.sym.get(i) } }; i = i + 1 }
  return ""
}

// record every `@alias("<Primary>")` marker on a decl into the alias views (I8 -> Byte, Never -> Nothing).
fun mtRecordAlias(mt: MTab, annos: IntBuf, name: String): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "alias" && a.args.len() >= 1) { mt.aliasFrom.push(name); mt.aliasTo.push(annoStr(a.args.get(0))) }
    i = i + 1
  }
  return 0
}

// the isPub/isVar flags a field carries (collectStruct drops them), rendered "[pub ]val|var". Built via
// the accumulator-concat pattern (a String `var` + string literal) — concatenating two `if`-expression
// string results directly trips klower's coarse string-tag inference and integer-adds the two pointers.
fun fldFlags(f: FFld): String {
  var s = ""
  if (f.isPub == 1) { s = s + "pub " }
  if (f.isVar == 1) { s = s + "var" } else { s = s + "val" }
  return s
}

// a type's struct fields become INSTANCE members, RE-THREADING the isPub/isVar that collectStruct drops
// (info = "<fieldType> | <flags>").
fun mtFields(mt: MTab, td: FTDecl): Int {
  var i = 0
  while (i < td.fields.len()) {
    val f: FFld = td.fields.get(i)
    mtAdd(mt, td.name, f.name, "field", 1, "", f.ty + (" | " + fldFlags(f)))
    i = i + 1
  }
  return 0
}

// a struct/class body or impl-block method list: recv non-empty => instance ("method"); recv empty =>
// associated ("assocfn"). The emitted symbol is the owner-mangle, exactly as codegen names it.
fun mtMethods(mt: MTab, owner: String, methods: IntBuf): Int {
  var i = 0
  while (i < methods.len()) {
    val m: FFunc = methods.get(i)
    if (isConstValFn(m.annos)) { mtAdd(mt, owner, m.name, "const", 0, mangleMethod(owner, m.name), m.ret) }
    else { if (m.recv == "") { mtAdd(mt, owner, m.name, "assocfn", 0, mangleMethod(owner, m.name), m.ret) }
    else { mtAdd(mt, owner, m.name, "method", 1, mangleMethod(owner, m.name), m.ret) } }
    i = i + 1
  }
  return 0
}

// trait methods are members of the trait; the emitted callee is the BARE method name (dynamic dispatch
// mangles the concrete type in at the use site), so sym is the bare name, not an owner-mangle.
fun mtTraitMethods(mt: MTab, owner: String, methods: IntBuf): Int {
  var i = 0
  while (i < methods.len()) {
    val m: FFunc = methods.get(i)
    val inst = if (m.recv == "") { 0 } else { 1 }
    mtAdd(mt, owner, m.name, "traitmethod", inst, m.name, m.ret)
    i = i + 1
  }
  return 0
}

// enum variant CONSTRUCTORS are ASSOCIATED members of the owning enum; sym is the bare constructor name
// (that is what `.`/`::`/bare-call all emit), info carries the discriminant tag.
fun mtVariants(mt: MTab, ed: FEDecl): Int {
  var tag = 0
  var i = 0
  while (i < ed.variants.len()) {
    val v: FVariant = ed.variants.get(i)
    mtAdd(mt, ed.name, v.name, "variant", 0, v.name, tag.toStr())
    tag = tag + 1
    i = i + 1
  }
  return 0
}

fun firstUnderscore(s: String): Int {
  var i = 0
  while (i < s.len()) { if (s.charAt(i) == 95) { return i }; i = i + 1 }
  return 0 - 1
}

// classify a free `fun` at collect time:
//   - EXTENSION fn: `fun Type.m(..)` desugared (kfront) to a free fn whose FIRST param is named "this"; its
//     receiver TYPE is that param's mode-stripped type and the selector is the method name recovered by
//     dropping the KNOWN "<Recv>_" prefix (using the receiver's length — never a guessed prefix split, which
//     the doc warns is ambiguous with a real free fn named Foo_bar). Recorded as an instance method of Recv.
//   - PLAIN free fn: a true global (owner ""), recorded "freefn". ADDITIONALLY, when its name is
//     "<KnownType>_<rest>" (the associated-const / static-method mangle convention, e.g. Int_MAX) an
//     ASSOCIATED VIEW is attributed to that already-recorded nominal type so `Int::MAX` resolves — the same
//     rule staticCallee uses. Gating the split on a KNOWN type prevents a false positive on an ordinary
//     free fn whose name merely contains an underscore.
fun mtFreeFun(mt: MTab, fd: FFunc): Int {
  if (fd.params.len() > 0) {
    val p0: FParam = fd.params.get(0)
    if (p0.name == "this") {
      val recv = stripMode(p0.ty)
      val sel = if (fd.name.len() > recv.len() + 1) { fd.name.substr(recv.len() + 1, fd.name.len() - recv.len() - 1) } else { fd.name }
      // A GENERIC extension (`fun <A,B> A.to(..)`, receiver a type PARAMETER) is universally callable via
      // type erasure — ONE compiled body `<A>_to(..)` serves every receiver type. Record it with a distinct
      // "genext" kind keyed on the selector so methodCallee can resolve `x.to(..)` (any x) to that one symbol,
      // rather than attributing it to the phantom type "A" (which no real receiver tag ever matches).
      if (isTypeParam(recv)) { mtAdd(mt, recv, sel, "genext", 1, fd.name, fd.ret) }
      else { mtAdd(mt, recv, sel, "method", 1, fd.name, fd.ret) }
      return 0
    }
  }
  mtAdd(mt, "", fd.name, "freefn", 0, fd.name, fd.ret)
  val us = firstUnderscore(fd.name)
  if (us > 0) {
    val pre = fd.name.substr(0, us)
    if (memListL(mt.types, pre)) { mtAdd(mt, pre, fd.name.substr(us + 1, fd.name.len() - us - 1), "assocfn", 0, fd.name, fd.ret) }
  }
  return 0
}

// Collect ONE top-level declaration at the cursor into the sig/type tables, returning 1 if it consumed
// a known decl or 0 if the token isn't a decl-start (caller stops). Shared by parseLower's main loop AND
// injectHelpers, so the prelude can carry ANY declaration (class/struct/enum/trait/impl/const), not just
// functions — this is what lets `class IntBuf` live in lib/ as a real stdlib type. roleK/roleV accumulate
// the @lang role table from every decl (only prelude decls carry @lang today; user code carries none).
fun collectDecl(p: P, annos: IntBuf, pfuns: IntBuf, fN: IntBuf, fR: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, traitN: IntBuf, traitDecls: IntBuf, implTrait: IntBuf, implType: IntBuf, constN: IntBuf, constExprs: IntBuf, variantN: IntBuf, variantTag: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, roleK: IntBuf, roleV: IntBuf, arcE: IntBuf, valueE: IntBuf, deriveT: IntBuf, deriveTr: IntBuf, monoN: IntBuf, monoP: IntBuf, mt: MTab): Int {
  val k = pk(p)
  if (k == 10 || k == 88) { val fd = parseFunc(p, annos); pfuns.push(PFun("", fd)); fN.push(fd.name); fR.push(fd.ret); recordLang(fd.annos, fd.name, roleK, roleV)
    // member table: a @prim FUN (String/Unit/Nothing/Never) names a builtin NOMINAL, not a callable free
    // fn — record it as a type (+ its @alias view); everything else classifies as free/extension/assoc.
    if (hasPrim(fd.annos)) { mtType(mt, fd.name); mtRecordAlias(mt, fd.annos, fd.name) } else { mtFreeFun(mt, fd) }
    return 1 }
  if (k == 54) { val td0 = parseTypeDecl(p, annos, 0); if (hasPrim(annos)) { collectPrim(td0, pfuns, fN, fR); recordLangMethods(td0.methods, td0.name, 1, roleK, roleV); mtType(mt, td0.name); mtRecordAlias(mt, annos, td0.name); mtMethods(mt, td0.name, td0.methods); return 1 } collectStruct(td0, structN, structF, structFT); collectMethodSigs(td0, pfuns, fN, fR); recordLangMethods(td0.methods, td0.name, 1, roleK, roleV); recordArc(annos, td0.name, arcE); recordValue(annos, td0.name, valueE); recordDerive(annos, td0.name, deriveT, deriveTr); recordMono(annos, td0.name, td0.gen, monoN, monoP); mtType(mt, td0.name); mtFields(mt, td0); mtMethods(mt, td0.name, td0.methods); return 1 }
  if (k == 65) { val td1 = parseTypeDecl(p, annos, 1); if (hasPrim(annos)) { collectPrim(td1, pfuns, fN, fR); recordLangMethods(td1.methods, td1.name, 1, roleK, roleV); mtType(mt, td1.name); mtRecordAlias(mt, annos, td1.name); mtMethods(mt, td1.name, td1.methods); return 1 } collectStruct(td1, structN, structF, structFT); classN.push(td1.name); collectMethodSigs(td1, pfuns, fN, fR); collectDeinit(td1, pfuns, fN, fR); recordLangMethods(td1.methods, td1.name, 1, roleK, roleV); recordArc(annos, td1.name, arcE); recordValue(annos, td1.name, valueE); recordDerive(annos, td1.name, deriveT, deriveTr); recordMono(annos, td1.name, td1.gen, monoN, monoP); mtType(mt, td1.name); mtFields(mt, td1); mtMethods(mt, td1.name, td1.methods); if (isNoResF(td1.dtor) == false) { mtAdd(mt, td1.name, "deinit", "method", 1, mangleMethod(td1.name, "deinit"), "Int") }; return 1 }
  if (k == 55) { val ed = parseEnum(p, annos); collectEnum(ed, variantN, variantTag, variantTys, variantOwn); recordDerive(ed.annos, ed.name, deriveT, deriveTr); mtType(mt, ed.name); mtVariants(mt, ed); collectAssocConsts(ed.name, ed.consts, pfuns, fN, fR); mtMethods(mt, ed.name, ed.consts); collectMethodSigsEnum(ed, pfuns, fN, fR); recordLangMethods(ed.methods, ed.name, 1, roleK, roleV); mtMethods(mt, ed.name, ed.methods); return 1 }
  if (k == 66) { val tr = parseTrait(p, annos); traitN.push(tr.name); traitDecls.push(tr); recordLangMethods(tr.methods, "", 0, roleK, roleV); mtType(mt, tr.name); mtTraitMethods(mt, tr.name, tr.methods); return 1 }
  if (k == 67) { val im = parseImpl(p, annos); collectImplMethods(im, pfuns, fN, fR); if (im.traitName != "") { implTrait.push(im.traitName); implType.push(im.forTy) }; recordLangMethods(im.methods, im.forTy, 1, roleK, roleV); recordArc(annos, im.forTy, arcE); mtMethods(mt, im.forTy, im.methods); return 1 }
  if (k == 58) { parseImport(p); return 1 }
  if (k == 80) { val cd = parseConst(p); constN.push(cd.name); constExprs.push(cd.expr); mtAdd(mt, "", cd.name, "const", 0, cd.name, ""); return 1 }
  return 0
}

// parse the injected library helpers (prelude modules) into the sig/type tables. A module may declare
// types (e.g. `class IntBuf`) as well as functions; collectDecl handles every decl kind.
fun injectHelpers(pfuns: IntBuf, fN: IntBuf, fR: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, traitN: IntBuf, traitDecls: IntBuf, implTrait: IntBuf, implType: IntBuf, constN: IntBuf, constExprs: IntBuf, variantN: IntBuf, variantTag: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, roleK: IntBuf, roleV: IntBuf, arcE: IntBuf, valueE: IntBuf, deriveT: IntBuf, deriveTr: IntBuf, monoN: IntBuf, monoP: IntBuf, mt: MTab): Int {
  val paths = preludeConfPaths()
  var pi = 0
  while (pi < paths.len()) {
    val hp = mkP(lex(readFile(paths.get(pi))))
    var go = 1
    while (go == 1) {
      if (pk(hp) == 0) { go = 0 }
      else { val annos = parseAnnos(hp); if (collectDecl(hp, annos, pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, valueE, deriveT, deriveTr, monoN, monoP, mt) == 0) { go = 0 } }
    }
    pi = pi + 1
  }
  return 0
}

struct LR(val funcs: IntBuf, val structN: IntBuf, val structF: IntBuf, val structFT: IntBuf, val variantN: IntBuf, val variantTag: IntBuf, val variantTys: IntBuf, val funN: IntBuf, val funRet: IntBuf, val arcE: IntBuf)

fun parseLower(toks: IntBuf): LR {
  // Seed with the prelude's infix funs (e.g. `to`) so user code parses `a to b` as an infix call even
  // though `to` is declared in an auto-injected prelude module whose tokens are not in `toks`.
  val p = mkPSeed(toks, preludeInfixNames())
  val pfuns = intBuf()
  val structN = intBuf(); val structF = intBuf(); val structFT = intBuf()
  val classN = intBuf()
  val traitN = intBuf(); val traitDecls = intBuf(); val implTrait = intBuf(); val implType = intBuf()
  val constN = intBuf(); val constExprs = intBuf()
  val variantN = intBuf(); val variantTag = intBuf(); val variantTys = intBuf(); val variantOwn = intBuf()
  val fN = intBuf(); val fR = intBuf()
  val roleK = intBuf(); val roleV = intBuf()
  val arcE = intBuf()
  val valueE = intBuf()
  val deriveT = intBuf(); val deriveTr = intBuf()
  val monoN = intBuf(); val monoP = intBuf()
  val mt = mtNew()
  injectHelpers(pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, valueE, deriveT, deriveTr, monoN, monoP, mt)
  // phase 1: parse, collect signatures, keep functions unlowered
  var go = 1
  while (go == 1) {
    if (pk(p) == 0) { go = 0 }
    else {
      val annos = parseAnnos(p)
      if (collectDecl(p, annos, pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, valueE, deriveT, deriveTr, monoN, monoP, mt) == 0) { go = 0 }
    }
  }
  return finishLower(pfuns, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, fN, fR, roleK, roleV, arcE, valueE, deriveT, deriveTr, monoN, monoP, mt)
}

// ---------- Phase 6: monomorphization — one specialized body per concrete `@mono` type instantiation ----------
// A `@mono class Vec<T>` is a TEMPLATE: the compiler emits nothing for the generic form. For each concrete
// turbofish construction `Vec::<U16>(..)` in the program the pass INSTANTIATES a specialized type `Vec$U16`
// (fields copied, every method copied with the type parameter substituted so sizeOf<T>()/__packedGet<T>
// fold to the concrete width and stride) and REWRITES the construction plus every `Vec<U16>` annotation onto
// that concrete name. This is @derive's structural-specialization move (STDLIB-REDESIGN §2b) generalized to
// value generics. The compiler's own sources carry no `@mono`, so the whole pass is inert (monoN empty ->
// every helper below is a no-op) and the self-host fixpoint is untouched.

fun hasMono(annos: IntBuf): Bool {
  var i = 0
  while (i < annos.len()) { val a: Anno = annos.get(i); if (a.name == "mono") { return true }; i = i + 1 }
  return false
}

// index of the next ',' or '>' at or after i (the end of a bound/default clause); len if none.
fun boundEnd(gen: String, i: Int): Int {
  var j = i
  while (j < gen.len()) { val d = gen.charAt(j); if (d == 44 || d == 62) { return j } j = j + 1 }
  return gen.len()
}

// ALL type-parameter names of a generic clause, comma-joined and bound/default-stripped:
// "<T>"->"T", "<T: Show>"->"T", "<K, V>"->"K,V", "<K: Hash, V>"->"K,V". A `@mono` template is
// specialized per param (K,V…) so a two-parameter `HashMap<K,V>` substitutes both, not just the head.
fun allTparams(gen: String): String {
  if (gen.len() == 0) { return "" }
  var i = 0
  if (gen.charAt(0) == 60) { i = 1 }
  var out = ""
  var cur = ""
  var first = 1
  var go = 1
  while (go == 1) {
    if (i >= gen.len()) { go = 0 }
    else { val c = gen.charAt(i)
      if (c == 62) { go = 0 }
      else { if (c == 44) {
          if (cur != "") { if (first == 1) { out = cur; first = 0 } else { out = out + ("," + cur) }; cur = "" }
          i = i + 1
        } else { if (c == 32) { if (cur == "") { i = i + 1 } else { i = boundEnd(gen, i) } }
          else { if (c == 58 || c == 61) { i = boundEnd(gen, i) }
            else { cur = cur + gen.substr(i, 1); i = i + 1 } } } }
    }
  }
  if (cur != "") { if (first == 1) { out = cur } else { out = out + ("," + cur) } }
  return out
}

// split a comma-list ("K,V" / "Int, String") into trimmed segments; interior spaces dropped (type args
// carry none) so "Int, String" -> ["Int","String"].
fun splitCsvL(s: String): IntBuf {
  val out = intBuf()
  var cur = ""
  var i = 0
  while (i < s.len()) { val c = s.charAt(i); if (c == 44) { out.push(cur); cur = "" } else { if (c != 32) { cur = cur + s.substr(i, 1) } }; i = i + 1 }
  out.push(cur)
  return out
}

// substitute EVERY template param for its concrete arg in one type string (sequential; concrete args
// never name a param, so order is immaterial). Mode prefix preserved by monoSubTyParam.
fun subAllTypeStr(params: IntBuf, concretes: IntBuf, ty: String): String {
  var t = ty
  var i = 0
  while (i < params.len()) { t = monoSubTyParam(params.get(i), concretes.get(i), t); i = i + 1 }
  return t
}

fun recordMono(annos: IntBuf, name: String, gen: String, monoN: IntBuf, monoP: IntBuf): Int {
  if (hasMono(annos)) { monoN.push(name); monoP.push(allTparams(gen)) }
  return 0
}

// symbol-safe suffix for a concrete type-arg string: "U16"->"U16", "K, V"->"K_V".
fun monoArgSuffix(ta: String): String {
  var s = ""
  var i = 0
  val n = ta.len()
  while (i < n) {
    val c = ta.charAt(i)
    if (c == 32) { i = i + 1 }
    else { if (c == 44) { s = s + "_"; i = i + 1 } else { s = s + ta.substr(i, 1); i = i + 1 } }
  }
  return s
}

fun monoMangleTag(nm: String, ta: String): String { return nm + ("$" + monoArgSuffix(ta)) }

// substitute the template parameter for the concrete arg in ONE type string, preserving a mode prefix.
fun monoSubTyParam(param: String, concrete: String, ty: String): String {
  val mode = paramMode(ty)
  val base = stripMode(ty)
  var nb = base
  if (base == param) { nb = concrete }
  if (mode == "") { return nb }
  return mode + (" " + nb)
}

// mangle a mono-type annotation `Vec<U16>` -> `Vec$U16` (mode-preserving); non-mono types unchanged.
fun monoMangleTy(monoN: IntBuf, ty: String): String {
  val mode = paramMode(ty)
  val base = stripMode(ty)
  val lt = base.len()
  var lt2 = lt
  var i = 0
  while (i < base.len()) { if (base.charAt(i) == 60) { lt2 = i; i = base.len() } else { i = i + 1 } }
  if (lt2 == lt) { return ty }
  val head = base.substr(0, lt2)
  if (memListL(monoN, head) == false) { return ty }
  var end = lt
  var j = base.len() - 1
  var found = 0
  while (j >= 0 && found == 0) { if (base.charAt(j) == 62) { end = j; found = 1 } else { j = j - 1 } }
  val inner = base.substr(lt2 + 1, end - lt2 - 1)
  val mg = monoMangleTag(head, inner)
  if (mode == "") { return mg }
  return mode + (" " + mg)
}

// is `callee` the turbofish construction of a `@mono` template? returns the template name or "".
fun monoCtorName(monoN: IntBuf, callee: FExpr): String {
  return when (callee) {
    FETypeApp(inner, ta) -> when (inner) { FEIdent(nm) -> if (memListL(monoN, nm)) { nm } else { "" }; else -> "" }
    else -> ""
  }
}
fun monoCtorArg(callee: FExpr): String { return when (callee) { FETypeApp(inner, ta) -> ta; else -> "" } }

// ---- instantiation collection: record each unique (template, type-arg) turbofish construction ----
fun monoAddInst(instN: IntBuf, instA: IntBuf, nm: String, ta: String): Int {
  var i = 0
  while (i < instN.len()) { if (instN.get(i) == nm) { if (instA.get(i) == ta) { return 0 } }; i = i + 1 }
  instN.push(nm); instA.push(ta)
  return 0
}
// `sN` (the struct/class-name table) is threaded through so the collector can seed `[..]` list-literal
// Vec instantiations: a `[a, b, c]` literal needs a specialized `Vec$T` even though its surface node is an
// FEList (never a `Vec::<T>(..)` turbofish), so litElemTy infers T and monoAddInst registers (Vec, T) here.
fun monoCollectArgs(monoN: IntBuf, sN: IntBuf, args: IntBuf, instN: IntBuf, instA: IntBuf): Int {
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); monoCollectExpr(monoN, sN, a.expr, instN, instA); i = i + 1 }
  return 0
}
fun monoCollectList(monoN: IntBuf, sN: IntBuf, es: IntBuf, instN: IntBuf, instA: IntBuf): Int {
  var i = 0
  while (i < es.len()) { monoCollectExpr(monoN, sN, es.get(i), instN, instA); i = i + 1 }
  return 0
}
fun monoCollectMap(monoN: IntBuf, sN: IntBuf, ents: IntBuf, instN: IntBuf, instA: IntBuf): Int {
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); monoCollectExpr(monoN, sN, en.k, instN, instA); monoCollectExpr(monoN, sN, en.v, instN, instA); i = i + 1 }
  return 0
}
fun monoCollectParts(monoN: IntBuf, sN: IntBuf, parts: IntBuf, instN: IntBuf, instA: IntBuf): Int {
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); when (pt) { FIExpr(e) -> monoCollectExpr(monoN, sN, e, instN, instA); else -> 0 }; i = i + 1 }
  return 0
}
fun monoCollectArms(monoN: IntBuf, sN: IntBuf, arms: IntBuf, instN: IntBuf, instA: IntBuf): Int {
  var i = 0
  while (i < arms.len()) { val a: FArm = arms.get(i); if (a.kind == 0) { monoCollectExpr(monoN, sN, a.lhs, instN, instA) }; if (isNoResF(a.guard) == false) { monoCollectExpr(monoN, sN, a.guard, instN, instA) }; monoCollectExpr(monoN, sN, a.body, instN, instA); i = i + 1 }
  return 0
}
fun monoCollectStmts(monoN: IntBuf, sN: IntBuf, stmts: IntBuf, instN: IntBuf, instA: IntBuf): Int {
  var i = 0
  while (i < stmts.len()) {
    val s: FStmt = stmts.get(i)
    when (s) {
      // an EMPTY `[]` bound to a `@mono Vec<T>` annotation carries no element type in the literal, so seed
      // the (Vec, T) instantiation from the DECLARED type-arg — lowerLet then constructs the empty Vec$T.
      FSLet(iv, nm, ty, init) -> { if (isEmptyListF(init)) { val h = monoTyHead(ty); if (memListL(monoN, h)) { monoAddInst(instN, instA, h, monoTyArg(ty)) } }; monoCollectExpr(monoN, sN, init, instN, instA) }
      FSExprS(e) -> monoCollectExpr(monoN, sN, e, instN, instA)
      FSAssign(l, r) -> { monoCollectExpr(monoN, sN, l, instN, instA); monoCollectExpr(monoN, sN, r, instN, instA) }
      FSReturnV(e) -> monoCollectExpr(monoN, sN, e, instN, instA)
      FSWhile(c, bd) -> { monoCollectExpr(monoN, sN, c, instN, instA); monoCollectExpr(monoN, sN, bd, instN, instA) }
      FSFor(v, it, bd) -> { monoCollectExpr(monoN, sN, it, instN, instA); monoCollectExpr(monoN, sN, bd, instN, instA) }
      else -> 0
    }
    i = i + 1
  }
  return 0
}
fun monoCollectExpr(monoN: IntBuf, sN: IntBuf, e: FExpr, instN: IntBuf, instA: IntBuf): Int {
  when (e) {
    FEUnary(op, x) -> monoCollectExpr(monoN, sN, x, instN, instA)
    FEBin(op, a, b) -> { monoCollectExpr(monoN, sN, a, instN, instA); monoCollectExpr(monoN, sN, b, instN, instA) }
    FEField(a, f) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FESafeField(a, f) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FEStatic(a, f) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FETypeApp(a, t) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FENotNull(a) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FEElvis(a, b) -> { monoCollectExpr(monoN, sN, a, instN, instA); monoCollectExpr(monoN, sN, b, instN, instA) }
    FEIndex(a, b) -> { monoCollectExpr(monoN, sN, a, instN, instA); monoCollectExpr(monoN, sN, b, instN, instA) }
    FECast(a, ty) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FEQuestion(a) -> monoCollectExpr(monoN, sN, a, instN, instA)
    FECall(callee, args) -> {
      val cn = monoCtorName(monoN, callee)
      if (cn != "") { monoAddInst(instN, instA, cn, monoCtorArg(callee)) }
      monoCollectExpr(monoN, sN, callee, instN, instA); monoCollectArgs(monoN, sN, args, instN, instA)
    }
    FEList(es) -> { val et = litElemTy(sN, es); if (et != "?" && et != "" && memListL(monoN, "Vec")) { monoAddInst(instN, instA, "Vec", et) }; monoCollectList(monoN, sN, es, instN, instA) }
    FEMap(ents) -> { val kt = mapKeyTy(sN, ents); val vt = mapValTy(sN, ents); if (kt != "?" && kt != "" && vt != "?" && vt != "" && memListL(monoN, "HashMap")) { monoAddInst(instN, instA, "HashMap", kt + (", " + vt)) }; monoCollectMap(monoN, sN, ents, instN, instA) }
    FELambda(params, body) -> monoCollectExpr(monoN, sN, body, instN, instA)
    FEInterp(parts, r) -> monoCollectParts(monoN, sN, parts, instN, instA)
    FEBlock(stmts, res) -> { monoCollectStmts(monoN, sN, stmts, instN, instA); monoCollectExpr(monoN, sN, res, instN, instA) }
    FEIf(c, t, el) -> { monoCollectExpr(monoN, sN, c, instN, instA); monoCollectExpr(monoN, sN, t, instN, instA); monoCollectExpr(monoN, sN, el, instN, instA) }
    FEWhen(hs, bind, subj, arms) -> { monoCollectExpr(monoN, sN, subj, instN, instA); monoCollectArms(monoN, sN, arms, instN, instA) }
    FERet(x) -> monoCollectExpr(monoN, sN, x, instN, instA)
    else -> 0
  }
  return 0
}

// ---- body rewrite: substitute the type parameter (param!="") and retarget mono constructions ----
fun monoFixArgs(monoN: IntBuf, param: String, concrete: String, args: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); out.push(FArg(a.name, monoFixExpr(monoN, param, concrete, a.expr))); i = i + 1 }
  return out
}
fun monoFixList(monoN: IntBuf, param: String, concrete: String, es: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < es.len()) { out.push(monoFixExpr(monoN, param, concrete, es.get(i))); i = i + 1 }
  return out
}
fun monoFixMap(monoN: IntBuf, param: String, concrete: String, ents: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); out.push(FMapEnt(monoFixExpr(monoN, param, concrete, en.k), monoFixExpr(monoN, param, concrete, en.v))); i = i + 1 }
  return out
}
fun monoFixParts(monoN: IntBuf, param: String, concrete: String, parts: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); val np = when (pt) { FIExpr(e) -> FIExpr(monoFixExpr(monoN, param, concrete, e)); else -> pt }; out.push(np); i = i + 1 }
  return out
}
fun monoFixArms(monoN: IntBuf, param: String, concrete: String, arms: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    val nlhs = if (a.kind == 0) { monoFixExpr(monoN, param, concrete, a.lhs) } else { a.lhs }
    val ng = if (isNoResF(a.guard)) { a.guard } else { monoFixExpr(monoN, param, concrete, a.guard) }
    out.push(FArm(a.kind, nlhs, a.pats, ng, monoFixExpr(monoN, param, concrete, a.body)))
    i = i + 1
  }
  return out
}
fun monoFixStmts(monoN: IntBuf, param: String, concrete: String, stmts: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < stmts.len()) {
    val s: FStmt = stmts.get(i)
    val ns = when (s) {
      FSLet(iv, nm, ty, init) -> FSLet(iv, nm, monoMangleTy(monoN, monoSubTyParam(param, concrete, ty)), monoFixExpr(monoN, param, concrete, init))
      FSExprS(e) -> FSExprS(monoFixExpr(monoN, param, concrete, e))
      FSAssign(l, r) -> FSAssign(monoFixExpr(monoN, param, concrete, l), monoFixExpr(monoN, param, concrete, r))
      FSReturnV(e) -> FSReturnV(monoFixExpr(monoN, param, concrete, e))
      FSWhile(c, bd) -> FSWhile(monoFixExpr(monoN, param, concrete, c), monoFixExpr(monoN, param, concrete, bd))
      FSFor(v, it, bd) -> FSFor(v, monoFixExpr(monoN, param, concrete, it), monoFixExpr(monoN, param, concrete, bd))
      else -> s
    }
    out.push(ns)
    i = i + 1
  }
  return out
}
// substitute the parameter inside a turbofish type-arg string (only when a template is being specialized).
fun monoFixTa(param: String, concrete: String, ta: String): String {
  if (param == "") { return ta }
  if (ta == param) { return concrete }
  return ta
}
fun monoFixExpr(monoN: IntBuf, param: String, concrete: String, e: FExpr): FExpr {
  return when (e) {
    FEUnary(op, x) -> FEUnary(op, monoFixExpr(monoN, param, concrete, x))
    FEBin(op, a, b) -> FEBin(op, monoFixExpr(monoN, param, concrete, a), monoFixExpr(monoN, param, concrete, b))
    FEField(a, f) -> FEField(monoFixExpr(monoN, param, concrete, a), f)
    FESafeField(a, f) -> FESafeField(monoFixExpr(monoN, param, concrete, a), f)
    FEStatic(a, f) -> FEStatic(monoFixExpr(monoN, param, concrete, a), f)
    FENotNull(a) -> FENotNull(monoFixExpr(monoN, param, concrete, a))
    FEElvis(a, b) -> FEElvis(monoFixExpr(monoN, param, concrete, a), monoFixExpr(monoN, param, concrete, b))
    FEIndex(a, b) -> FEIndex(monoFixExpr(monoN, param, concrete, a), monoFixExpr(monoN, param, concrete, b))
    FECast(a, ty) -> FECast(monoFixExpr(monoN, param, concrete, a), monoMangleTy(monoN, monoSubTyParam(param, concrete, ty)))
    FEQuestion(a) -> FEQuestion(monoFixExpr(monoN, param, concrete, a))
    FETypeApp(a, t) -> FETypeApp(monoFixExpr(monoN, param, concrete, a), monoFixTa(param, concrete, t))
    FECall(callee, args) -> {
      val cn = monoCtorName(monoN, callee)
      if (cn != "") { FECall(FEIdent(monoMangleTag(cn, monoFixTa(param, concrete, monoCtorArg(callee)))), monoFixArgs(monoN, param, concrete, args)) }
      else { FECall(monoFixExpr(monoN, param, concrete, callee), monoFixArgs(monoN, param, concrete, args)) }
    }
    FEList(es) -> FEList(monoFixList(monoN, param, concrete, es))
    FEMap(ents) -> FEMap(monoFixMap(monoN, param, concrete, ents))
    FELambda(params, body) -> FELambda(params, monoFixExpr(monoN, param, concrete, body))
    FEInterp(parts, r) -> FEInterp(monoFixParts(monoN, param, concrete, parts), r)
    FEBlock(stmts, res) -> FEBlock(monoFixStmts(monoN, param, concrete, stmts), monoFixExpr(monoN, param, concrete, res))
    FEIf(c, t, el) -> FEIf(monoFixExpr(monoN, param, concrete, c), monoFixExpr(monoN, param, concrete, t), monoFixExpr(monoN, param, concrete, el))
    FEWhen(hs, bind, subj, arms) -> FEWhen(hs, bind, monoFixExpr(monoN, param, concrete, subj), monoFixArms(monoN, param, concrete, arms))
    FERet(x) -> FERet(monoFixExpr(monoN, param, concrete, x))
    else -> e
  }
}

// specialize the template's params/return/body for the full concrete-arg tuple, producing e.g. the
// `HashMap$Int_String`-owned method. Type strings substitute ALL params then mangle once; the body is
// rewritten per param (sequential monoFixExpr; only single-level element types appear in a template body).
fun monoSpecMethod(monoN: IntBuf, params: IntBuf, concretes: IntBuf, m: FFunc): FFunc {
  val nps = intBuf()
  var i = 0
  while (i < m.params.len()) { val pp: FParam = m.params.get(i); nps.push(FParam(pp.name, monoMangleTy(monoN, subAllTypeStr(params, concretes, pp.ty)), pp.isVararg)); i = i + 1 }
  val nret = monoMangleTy(monoN, subAllTypeStr(params, concretes, m.ret))
  var body = m.body
  var j = 0
  while (j < params.len()) { body = monoFixExpr(monoN, params.get(j), concretes.get(j), body); j = j + 1 }
  return FFunc(m.annos, m.name, "", m.recv, nps, nret, m.whr, body)
}

// instantiate every collected (template, type-arg): register the specialized struct + its methods.
fun monoInstantiate(monoN: IntBuf, monoP: IntBuf, pfuns: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, fN: IntBuf, fR: IntBuf, arcE: IntBuf): Int {
  val instN = intBuf(); val instA = intBuf()
  var pi = 0
  // Collect instantiations from NON-template bodies only: a template's own body uses the symbolic param
  // (a self-construction `Vec::<T>(..)` in Vec's copy method would otherwise instantiate a bogus `Vec$T`).
  // Real instantiations come from user code; a specialized body's self-construction is an already-mangled
  // plain call (`Vec$Int(..)`), not a turbofish, so it needs no further collection.
  while (pi < pfuns.len()) { val pf: PFun = pfuns.get(pi); if (memListL(monoN, pf.owner) == false) { monoCollectExpr(monoN, structN, pf.fd.body, instN, instA) }; pi = pi + 1 }
  // VARARG carriers: a `vararg xs: E` param declares its in-body type as `Array<E>`, but the Array<E> is
  // constructed at the CALL SITE (lowered later, after this pass), so the turbofish never appears in a body
  // here. Seed the (Array, E) instantiation directly from each vararg param's declared carrier type so the
  // specialized `Array$E` struct + get/set/len/fill methods exist for both the call-site build and the
  // callee's `xs.get(i)`/`xs.len()`. E is concrete in this version (no generic-E vararg).
  var vpi = 0
  while (vpi < pfuns.len()) {
    val vpf: PFun = pfuns.get(vpi)
    if (memListL(monoN, vpf.owner) == false) {
      val vps: IntBuf = vpf.fd.params
      if (vps.len() > 0) {
        val vlast: FParam = vps.get(vps.len() - 1)
        if (vlast.isVararg == 1) {
          val head = monoTyHead(vlast.ty)
          if (memListL(monoN, head)) { monoAddInst(instN, instA, head, vaElemFromArrTy(vlast.ty)) }
        }
      }
    }
    vpi = vpi + 1
  }
  var ii = 0
  while (ii < instN.len()) {
    val nm: String = instN.get(ii)
    val ta: String = instA.get(ii)
    val mangled = monoMangleTag(nm, ta)
    if (memListL(structN, mangled) == false) {
      val ti = indexOfL(monoN, nm)
      val params = splitCsvL(monoP.get(ti))
      val concretes = splitCsvL(ta)
      val si = indexOfL(structN, nm)
      // specialized struct: field names copied; field types param-substituted (Vec's are plain Int).
      val flds: IntBuf = structF.get(si)
      val ftys: IntBuf = structFT.get(si)
      val nfl = intBuf(); val nft = intBuf()
      var fi = 0
      while (fi < flds.len()) { nfl.push(flds.get(fi)); nft.push(subAllTypeStr(params, concretes, ftys.get(fi))); fi = fi + 1 }
      structN.push(mangled); structF.push(nfl); structFT.push(nft)
      if (memListL(classN, nm)) { classN.push(mangled) }
      if (memListL(arcE, nm)) { arcE.push(mangled) }
      // specialized methods: one concrete body per template method.
      var mi = 0
      while (mi < pfuns.len()) {
        val pf: PFun = pfuns.get(mi)
        if (pf.owner == nm) {
          val sm = monoSpecMethod(monoN, params, concretes, pf.fd)
          pfuns.push(PFun(mangled, sm)); fN.push(mangleMethod(mangled, sm.name)); fR.push(sm.ret)
        }
        mi = mi + 1
      }
    }
    ii = ii + 1
  }
  return 0
}

// rewrite every NON-template function: retarget mono constructions to the specialized names and mangle
// mono-type annotations in params/return/local types. Template-owned methods are dropped later (never
// lowered), so they are skipped here. `fR` is the RETURN-TYPE table method dispatch / type-inference reads
// for an inferred-type binding (`val w = make()` looks up `make` in fN/fR to type `w`); it is parallel to
// `pfuns` and MUST be re-mangled in lockstep with the PFun's own `fd.ret`, else `w.get(0)` would infer the
// un-specialized head `Vec` and dispatch to the DROPPED template method `Vec_get` — a silent load-time
// miscompile (undefined symbol, dyld abort).
fun monoRewriteAll(monoN: IntBuf, pfuns: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < pfuns.len()) {
    val pf: PFun = pfuns.get(i)
    if (memListL(monoN, pf.owner) == false) {
      val fd = pf.fd
      val nps = intBuf()
      var j = 0
      while (j < fd.params.len()) { val pp: FParam = fd.params.get(j); nps.push(FParam(pp.name, monoMangleTy(monoN, pp.ty), pp.isVararg)); j = j + 1 }
      val nret = monoMangleTy(monoN, fd.ret)
      val nfd = FFunc(fd.annos, fd.name, fd.gen, fd.recv, nps, nret, fd.whr, monoFixExpr(monoN, "", "", fd.body))
      pfuns.set(i, PFun(pf.owner, nfd))
      if (i < fR.len()) { fR.set(i, monoMangleTy(monoN, fR.get(i))) }
    }
    i = i + 1
  }
  return 0
}

// mangle every mono-type annotation that appears as a STRUCT/CLASS FIELD type. Without this a `@mono`
// type used as a field-type annotation (`struct Box(v: Vec<Int>)`) keeps the un-specialized template
// name, so `box.v`'s static type resolves method dispatch to the DROPPED template method (never lowered)
// and the call jumps to a bad address — a silent miscompile (rc=0, segfault). Covers every collected
// struct/class, both @mono-instantiated (`Vec$U16`, whose Int fields are unaffected) and plain.
fun monoRewriteFields(monoN: IntBuf, structN: IntBuf, structFT: IntBuf): Int {
  var si = 0
  while (si < structN.len()) {
    val ftys: IntBuf = structFT.get(si)
    var fi = 0
    while (fi < ftys.len()) { ftys.set(fi, monoMangleTy(monoN, ftys.get(fi))); fi = fi + 1 }
    si = si + 1
  }
  return 0
}

// the head type name of an annotation `Vec<U16>` -> `Vec` (mode-stripped, before the first `<`); a bare
// type is returned unchanged. Used by the residual assertion to spot an un-mangled `@mono` template name.
fun monoTyHead(ty: String): String {
  val base = stripMode(ty)
  var i = 0
  while (i < base.len()) { if (base.charAt(i) == 60) { return base.substr(0, i) } else { i = i + 1 } }
  return base
}

// the (single) type-argument of an annotation `Vec<Int>` -> `Int` (between the first `<` and the last `>`);
// "" when the type carries no `<..>`. Used to seed an empty-`[]`-with-`Vec<T>`-annotation instantiation.
fun monoTyArg(ty: String): String {
  val base = stripMode(ty)
  var lt = 0 - 1
  var i = 0
  while (i < base.len()) { if (base.charAt(i) == 60) { lt = i; i = base.len() } else { i = i + 1 } }
  if (lt < 0) { return "" }
  var end = base.len()
  var j = base.len() - 1
  var found = 0
  while (j >= 0 && found == 0) { if (base.charAt(j) == 62) { end = j; found = 1 } else { j = j - 1 } }
  return base.substr(lt + 1, end - lt - 1)
}

// HARD-ABORT if any un-monomorphized `@mono` template name survives into a lowered type position (a field
// type, or a non-template function's param/return type). Mirrors the Phase-0.5/Phase-4 discipline: a
// residual template name would otherwise dispatch to a dropped method body and silently miscompile, so we
// exit 134 with a diagnostic and emit no binary instead.
fun monoAssertNoResidual(monoN: IntBuf, structN: IntBuf, structFT: IntBuf, pfuns: IntBuf): Int {
  var si = 0
  while (si < structN.len()) {
    if (memListL(monoN, structN.get(si)) == false) {
      val ftys: IntBuf = structFT.get(si)
      var fi = 0
      while (fi < ftys.len()) {
        if (memListL(monoN, monoTyHead(ftys.get(fi)))) { lowFail("un-monomorphized @mono type " + (ftys.get(fi) + (" in field of " + structN.get(si)))) }
        fi = fi + 1
      }
    }
    si = si + 1
  }
  var pi = 0
  while (pi < pfuns.len()) {
    val pf: PFun = pfuns.get(pi)
    if (memListL(monoN, pf.owner) == false) {
      val fd = pf.fd
      if (memListL(monoN, monoTyHead(fd.ret))) { lowFail("un-monomorphized @mono type " + (fd.ret + (" in return of " + fd.name))) }
      var j = 0
      while (j < fd.params.len()) { val pp: FParam = fd.params.get(j); if (memListL(monoN, monoTyHead(pp.ty))) { lowFail("un-monomorphized @mono type " + (pp.ty + (" in param of " + fd.name))) }; j = j + 1 }
    }
    pi = pi + 1
  }
  return 0
}

// ---------- Phase 6b: monomorphization of `@mono` generic FREE FUNCTIONS ----------
// Opt-in, mirroring the `@mono` TYPE pass above but on the FUNCTION dimension. A `@mono fun f<K,V>(..)` is a
// TEMPLATE: for each unique call-site turbofish `f::<A,B>(..)` the pass substitutes (K,V)->(A,B) through the
// function's param types, return type and BODY — leaving any nested `@mono` TYPE construction (`HashMap::<K,V>`
// -> `HashMap::<A,B>`) as a still-concrete turbofish, so the EXISTING type pass (monoInstantiate/monoRewriteAll,
// which run AFTER this) cascades to instantiate `HashMap$A_B`. It emits `f$A_B` and rewrites the call to it.
// UNMARKED generic functions keep erasing (one body serves all receivers) — the generic `to` extension relies
// on that and is untouched here. The compiler's own sources carry no `@mono` function, so monoFN is empty and
// this whole pass is INERT for the self-host build (guarded off in runMono). v1 requires an explicit turbofish
// at every call; a bare `@mono`-fn call is a clean hard error (no expected-type inference), never a segfault.

// token-aware type substitution: replace each template param token with its concrete arg wherever it appears as
// a WHOLE identifier inside a type string (handles compound `HashMap<K, V>` -> `HashMap<Int, Int>`, `Vec<T>` ->
// `Vec<Int>`, bare `K` -> `Int`), preserving a `consuming`/`inout` mode prefix. The whole-string monoSubTyParam
// above only substitutes a bare param; this reaches the type ARGUMENTS a function's return type exposes.
fun subTyTokens(params: IntBuf, concretes: IntBuf, ty: String): String {
  val mode = paramMode(ty)
  val base = stripMode(ty)
  var out = ""
  var i = 0
  val n = base.len()
  while (i < n) {
    val c = base.charAt(i)
    if (isAlpha(c)) {
      var tok = ""
      while (i < n && isAlnum(base.charAt(i))) { tok = tok + base.substr(i, 1); i = i + 1 }
      val idx = indexOfL(params, tok)
      if (idx >= 0) { out = out + concretes.get(idx) } else { out = out + tok }
    } else { out = out + base.substr(i, 1); i = i + 1 }
  }
  if (mode == "") { return out }
  return mode + (" " + out)
}

// scan the collected function table for `@mono` generic FREE functions (owner "", a `@mono` anno, a generic
// clause). Records the (possibly module-mangled) symbol name + its comma-joined type params. Pure read.
fun collectFnTemplates(pfuns: IntBuf, monoFN: IntBuf, monoFP: IntBuf): Int {
  var i = 0
  while (i < pfuns.len()) {
    val pf: PFun = pfuns.get(i)
    if (pf.owner == "") { if (hasMono(pf.fd.annos)) { if (pf.fd.gen != "") {
      monoFN.push(pf.fd.name); monoFP.push(allTparams(pf.fd.gen))
    } } }
    i = i + 1
  }
  return 0
}

// is this PFun a `@mono` function TEMPLATE (a free function whose name is registered in monoFN)?
fun isFnTemplate(monoFN: IntBuf, pf: PFun): Bool { return pf.owner == "" && memListL(monoFN, pf.fd.name) }

// locate a `@mono` function template's FFunc by symbol name.
fun fnTemplateFd(pfuns: IntBuf, nm: String): FFunc {
  var i = 0
  while (i < pfuns.len()) { val pf: PFun = pfuns.get(i); if (pf.owner == "" && pf.fd.name == nm) { return pf.fd }; i = i + 1 }
  return FFunc(intBuf(), nm, "", "", intBuf(), "Int", "", FEInt("0"))
}

// ---- the ONE walker: substitute type params (params/concretes; empty => identity) AND retarget `@mono`
// function turbofish calls to their mangled specialized name, recording each unique instantiation. Type
// arguments on EVERY turbofish are param-substituted so nested `Vec::<T>`/`HashMap::<K,V>`/`__packedGet::<K>`
// become concrete. A bare `@mono`-fn call (no turbofish) is a hard compile error, not a silent erase-and-segfault.
fun fnMonoArgs(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, args: IntBuf, instN: IntBuf, instA: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); out.push(FArg(a.name, fnMono(params, concretes, monoFN, a.expr, instN, instA))); i = i + 1 }
  return out
}
fun fnMonoList(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, es: IntBuf, instN: IntBuf, instA: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < es.len()) { out.push(fnMono(params, concretes, monoFN, es.get(i), instN, instA)); i = i + 1 }
  return out
}
fun fnMonoMap(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, ents: IntBuf, instN: IntBuf, instA: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); out.push(FMapEnt(fnMono(params, concretes, monoFN, en.k, instN, instA), fnMono(params, concretes, monoFN, en.v, instN, instA))); i = i + 1 }
  return out
}
fun fnMonoParts(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, parts: IntBuf, instN: IntBuf, instA: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); val np = when (pt) { FIExpr(e) -> FIExpr(fnMono(params, concretes, monoFN, e, instN, instA)); else -> pt }; out.push(np); i = i + 1 }
  return out
}
fun fnMonoArms(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, arms: IntBuf, instN: IntBuf, instA: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    val nlhs = if (a.kind == 0) { fnMono(params, concretes, monoFN, a.lhs, instN, instA) } else { a.lhs }
    val ng = if (isNoResF(a.guard)) { a.guard } else { fnMono(params, concretes, monoFN, a.guard, instN, instA) }
    out.push(FArm(a.kind, nlhs, a.pats, ng, fnMono(params, concretes, monoFN, a.body, instN, instA)))
    i = i + 1
  }
  return out
}
fun fnMonoStmts(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, stmts: IntBuf, instN: IntBuf, instA: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < stmts.len()) {
    val s: FStmt = stmts.get(i)
    val ns = when (s) {
      FSLet(iv, nm, ty, init) -> FSLet(iv, nm, subTyTokens(params, concretes, ty), fnMono(params, concretes, monoFN, init, instN, instA))
      FSExprS(e) -> FSExprS(fnMono(params, concretes, monoFN, e, instN, instA))
      FSAssign(l, r) -> FSAssign(fnMono(params, concretes, monoFN, l, instN, instA), fnMono(params, concretes, monoFN, r, instN, instA))
      FSReturnV(e) -> FSReturnV(fnMono(params, concretes, monoFN, e, instN, instA))
      FSWhile(c, bd) -> FSWhile(fnMono(params, concretes, monoFN, c, instN, instA), fnMono(params, concretes, monoFN, bd, instN, instA))
      FSFor(v, it, bd) -> FSFor(v, fnMono(params, concretes, monoFN, it, instN, instA), fnMono(params, concretes, monoFN, bd, instN, instA))
      else -> s
    }
    out.push(ns)
    i = i + 1
  }
  return out
}
fun fnMono(params: IntBuf, concretes: IntBuf, monoFN: IntBuf, e: FExpr, instN: IntBuf, instA: IntBuf): FExpr {
  return when (e) {
    FEUnary(op, x) -> FEUnary(op, fnMono(params, concretes, monoFN, x, instN, instA))
    FEBin(op, a, b) -> FEBin(op, fnMono(params, concretes, monoFN, a, instN, instA), fnMono(params, concretes, monoFN, b, instN, instA))
    FEField(a, f) -> FEField(fnMono(params, concretes, monoFN, a, instN, instA), f)
    FESafeField(a, f) -> FESafeField(fnMono(params, concretes, monoFN, a, instN, instA), f)
    FEStatic(a, f) -> FEStatic(fnMono(params, concretes, monoFN, a, instN, instA), f)
    FENotNull(a) -> FENotNull(fnMono(params, concretes, monoFN, a, instN, instA))
    FEElvis(a, b) -> FEElvis(fnMono(params, concretes, monoFN, a, instN, instA), fnMono(params, concretes, monoFN, b, instN, instA))
    FEIndex(a, b) -> FEIndex(fnMono(params, concretes, monoFN, a, instN, instA), fnMono(params, concretes, monoFN, b, instN, instA))
    FECast(a, ty) -> FECast(fnMono(params, concretes, monoFN, a, instN, instA), subTyTokens(params, concretes, ty))
    FEQuestion(a) -> FEQuestion(fnMono(params, concretes, monoFN, a, instN, instA))
    FETypeApp(a, t) -> FETypeApp(fnMono(params, concretes, monoFN, a, instN, instA), subTyTokens(params, concretes, t))
    FECall(callee, args) -> when (callee) {
      FETypeApp(inner, ta) -> when (inner) {
        FEIdent(nm) -> if (memListL(monoFN, nm)) {
            val sta = subTyTokens(params, concretes, ta)
            monoAddInst(instN, instA, nm, sta)
            FECall(FEIdent(monoMangleTag(nm, sta)), fnMonoArgs(params, concretes, monoFN, args, instN, instA))
          } else { FECall(FETypeApp(inner, subTyTokens(params, concretes, ta)), fnMonoArgs(params, concretes, monoFN, args, instN, instA)) }
        else -> FECall(FETypeApp(fnMono(params, concretes, monoFN, inner, instN, instA), subTyTokens(params, concretes, ta)), fnMonoArgs(params, concretes, monoFN, args, instN, instA))
      }
      FEIdent(nm) -> if (memListL(monoFN, nm)) { lowFail("@mono function `" + (nm + "` must be called with an explicit turbofish, e.g. `" + (nm + "::<..>()`"))); FECall(FEIdent(nm), fnMonoArgs(params, concretes, monoFN, args, instN, instA)) }
        else { FECall(FEIdent(nm), fnMonoArgs(params, concretes, monoFN, args, instN, instA)) }
      else -> FECall(fnMono(params, concretes, monoFN, callee, instN, instA), fnMonoArgs(params, concretes, monoFN, args, instN, instA))
    }
    FEList(es) -> FEList(fnMonoList(params, concretes, monoFN, es, instN, instA))
    FEMap(ents) -> FEMap(fnMonoMap(params, concretes, monoFN, ents, instN, instA))
    FELambda(ps, body) -> FELambda(ps, fnMono(params, concretes, monoFN, body, instN, instA))
    FEInterp(parts, r) -> FEInterp(fnMonoParts(params, concretes, monoFN, parts, instN, instA), r)
    FEBlock(stmts, res) -> FEBlock(fnMonoStmts(params, concretes, monoFN, stmts, instN, instA), fnMono(params, concretes, monoFN, res, instN, instA))
    FEIf(c, t, el) -> FEIf(fnMono(params, concretes, monoFN, c, instN, instA), fnMono(params, concretes, monoFN, t, instN, instA), fnMono(params, concretes, monoFN, el, instN, instA))
    FEWhen(hs, bind, subj, arms) -> FEWhen(hs, bind, fnMono(params, concretes, monoFN, subj, instN, instA), fnMonoArms(params, concretes, monoFN, arms, instN, instA))
    FERet(x) -> FERet(fnMono(params, concretes, monoFN, x, instN, instA))
    else -> e
  }
}

// specialize one `@mono` function template for a concrete type-arg tuple: substitute the params through the
// param types, return type and body (leaving nested `@mono` TYPE turbofishes concrete for the later type pass),
// and rename to the mangled `f$A_B`. gen is cleared (no longer generic); annos dropped (no longer a template).
fun fnSpecialize(monoFN: IntBuf, tfd: FFunc, mangled: String, params: IntBuf, concretes: IntBuf, instN: IntBuf, instA: IntBuf): FFunc {
  val nps = intBuf()
  var i = 0
  while (i < tfd.params.len()) { val pp: FParam = tfd.params.get(i); nps.push(FParam(pp.name, subTyTokens(params, concretes, pp.ty), pp.isVararg)); i = i + 1 }
  val nret = subTyTokens(params, concretes, tfd.ret)
  val nbody = fnMono(params, concretes, monoFN, tfd.body, instN, instA)
  return FFunc(intBuf(), mangled, "", tfd.recv, nps, nret, tfd.whr, nbody)
}

fun runFnMono(monoFN: IntBuf, monoFP: IntBuf, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  val emptyP = intBuf(); val emptyC = intBuf()
  val instN = intBuf(); val instA = intBuf()
  // A. rewrite call sites (+ collect instantiations) in every NON-template body. Template bodies are skipped:
  // their turbofishes are symbolic and would collect a bogus `f$K_V`.
  var i = 0
  while (i < pfuns.len()) {
    val pf: PFun = pfuns.get(i)
    if (isFnTemplate(monoFN, pf) == false) {
      val fd = pf.fd
      val nb = fnMono(emptyP, emptyC, monoFN, fd.body, instN, instA)
      pfuns.set(i, PFun(pf.owner, FFunc(fd.annos, fd.name, fd.gen, fd.recv, fd.params, fd.ret, fd.whr, nb)))
    }
    i = i + 1
  }
  // B. specialize each unique instantiation collected from the ORIGINAL program (snapshot the count so a
  // specialized body's own nested turbofish — v1 single-level — doesn't extend the worklist).
  val cnt = instN.len()
  var j = 0
  while (j < cnt) {
    val nm: String = instN.get(j)
    val ta: String = instA.get(j)
    val mangled = monoMangleTag(nm, ta)
    if (memListL(fN, mangled) == false) {
      val ti = indexOfL(monoFN, nm)
      val prms = splitCsvL(monoFP.get(ti))
      val concretes = splitCsvL(ta)
      val tfd = fnTemplateFd(pfuns, nm)
      val throwN = intBuf(); val throwA = intBuf()
      val spec = fnSpecialize(monoFN, tfd, mangled, prms, concretes, throwN, throwA)
      pfuns.push(PFun("", spec)); fN.push(mangled); fR.push(spec.ret)
    }
    j = j + 1
  }
  // C. neutralize each template in place (every call was rewritten to a specialized name, so the bare symbol is
  // dead) — a trivial `f(): Int { return 0 }`. This makes the template inert for the downstream type pass and
  // lowering without needing a monoFN skip threaded through every one of them.
  var k = 0
  while (k < pfuns.len()) {
    val pf: PFun = pfuns.get(k)
    if (isFnTemplate(monoFN, pf)) {
      pfuns.set(k, PFun("", FFunc(intBuf(), pf.fd.name, "", "", intBuf(), "Int", "", FEBlock(oneStmt(FSReturnV(FEInt("0"))), FENoRes))))
      if (k < fR.len()) { fR.set(k, "Int") }
    }
    k = k + 1
  }
  return 0
}

fun runMono(monoN: IntBuf, monoP: IntBuf, pfuns: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, fN: IntBuf, fR: IntBuf, arcE: IntBuf): Int {
  val monoFN = intBuf(); val monoFP = intBuf()
  collectFnTemplates(pfuns, monoFN, monoFP)
  if (monoN.len() == 0 && monoFN.len() == 0) { return 0 }
  if (monoFN.len() > 0) { runFnMono(monoFN, monoFP, pfuns, fN, fR) }
  if (monoN.len() == 0) { return 0 }
  monoInstantiate(monoN, monoP, pfuns, structN, structF, structFT, classN, fN, fR, arcE)
  monoRewriteAll(monoN, pfuns, fR)
  monoRewriteFields(monoN, structN, structFT)
  monoAssertNoResidual(monoN, structN, structFT, pfuns)
  return 0
}

// phase 2 (shared by parseLower and parseLowerModules): synthesize trait defaults, evaluate consts,
// register trait-method + dispatcher names, then lower every collected function.
// Populate the vararg registry (parallel vaSym/vaKey/vaFix/vaElem) from the FINAL pfuns (post
// overload-remangle + mono). A function whose LAST param is a vararg is variadic; its trailing `Array<E>`
// param has been mono-mangled to `Array$E`, so E is recovered from it. vaSym is the SAME symbol
// lowerFuncFull emits (mangleMethod(owner, name)); vaKey is mangleMethod(owner, base) for call-site lookup.
// A no-op for a program with no vararg function (the compiler's own build) — every consumer is then inert.
fun buildVarargRegistry(pfuns: IntBuf, monoN: IntBuf, vareg: VaReg): Int {
  var vai = 0
  while (vai < pfuns.len()) {
    val vpf: PFun = pfuns.get(vai)
    if (memListL(monoN, vpf.owner) == false) {
      val vps: IntBuf = vpf.fd.params
      if (vps.len() > 0) {
        val vlast: FParam = vps.get(vps.len() - 1)
        if (vlast.isVararg == 1) {
          vareg.sym.push(mangleMethod(vpf.owner, vpf.fd.name))
          vareg.key.push(mangleMethod(vpf.owner, selectorBase(vpf.fd.name)))
          vareg.fix.push(vps.len() - 1); vareg.elem.push(vaElemFromArrTy(vlast.ty))
        }
      }
    }
    vai = vai + 1
  }
  return 0
}

fun finishLower(pfuns: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, traitN: IntBuf, traitDecls: IntBuf, implTrait: IntBuf, implType: IntBuf, constN: IntBuf, constExprs: IntBuf, variantN: IntBuf, variantTag: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, fN: IntBuf, fR: IntBuf, roleK: IntBuf, roleV: IntBuf, arcE: IntBuf, valueE: IntBuf, deriveT: IntBuf, deriveTr: IntBuf, monoN: IntBuf, monoP: IntBuf, mt: MTab): LR {
  val constV = intBuf()
  // Monomorphization keystone (Phase 6): instantiate every concrete `@mono` template use into a specialized
  // struct + methods and retarget the program onto them, BEFORE derive/dispatch/phase-2 so the concrete
  // instantiations are ordinary types downstream. No-op when nothing is `@mono` (the compiler's own build).
  runMono(monoN, monoP, pfuns, structN, structF, structFT, classN, fN, fR, arcE)
  // @derive pass (Phase 4): synthesize the requested structural impls BEFORE trait-default synthesis and
  // dispatchers, so a derived method is a hand-impl for every downstream stage (dedup guards against a
  // hand impl of the same method). No-op when nothing was @derived (the compiler's own build).
  runDerives(deriveT, deriveTr, pfuns, fN, fR, structN, structF, structFT, variantN, variantTys, variantOwn, implTrait, implType)
  // trait DEFAULT methods: for each `impl Trait for Type` that doesn't override a trait method carrying a
  // body, synthesize `<Type>_<method>` from that default body (bound to `this: Type`). Must run after all
  // impls are collected (so the override check is accurate) and before dispatchers/phase-2.
  var sdi = 0
  while (sdi < implTrait.len()) {
    val stn: String = implTrait.get(sdi)
    val sty: String = implType.get(sdi)
    val tdix = findTraitDeclIdx(traitDecls, stn)
    if (tdix >= 0) {
      val str: FTraitDecl = traitDecls.get(tdix)
      var smi = 0
      while (smi < str.methods.len()) {
        val sm: FFunc = str.methods.get(smi)
        if (isNoResF(sm.body) == false) {
          val smn = mangleMethod(sty, sm.name)
          if (memListL(fN, smn) == false) { pfuns.push(PFun(sty, sm)); fN.push(smn); fR.push(sm.ret) }
        }
        smi = smi + 1
      }
    }
    sdi = sdi + 1
  }
  // OVERLOADING (Phase M5): sig-mangle every (owner,name) that has more than one definition, keeping fN/fR
  // aligned, and hard-error on a same-signature clash. Runs after ALL definitions are collected (derives +
  // trait defaults included) so overload sets are complete, and before const eval / lowering so call sites
  // resolve against the final symbols. Inert (no rename) when nothing is overloaded — the compiler itself.
  overloadRemangle(pfuns, fN, fR, roleK, roleV, mt)
  // build the compile-time function table (free functions), then evaluate consts in order (a const may
  // reference earlier consts and any function) so `const N = fib(10)` and `comptime(...)` can run them.
  val cfuncs = intBuf()
  var cfi = 0
  while (cfi < pfuns.len()) { val pf: PFun = pfuns.get(cfi); if (pf.owner == "") { cfuncs.push(pf.fd) }; cfi = cfi + 1 }
  val ceEnvN = intBuf(); val ceEnvV = intBuf(); val ceEnvK = intBuf()
  var cei = 0
  while (cei < constExprs.len()) {
    val ce = constExprs.get(cei)
    val cv = ceEval(ceEnvN, ceEnvV, ceEnvK, cfuncs, ce)
    val ck = ceKindOf(ceEnvN, ceEnvK, cfuncs, ce)
    ceEnvN.push(constN.get(cei)); ceEnvV.push(cv); ceEnvK.push(ck); constV.push(cv.toStr())
    cei = cei + 1
  }
  // trait-method registry (method name -> owning trait) so an erased receiver's method call can dynamic-dispatch
  val traitMethN = intBuf(); val traitMethT = intBuf()
  var tmi = 0
  while (tmi < traitDecls.len()) {
    val tr: FTraitDecl = traitDecls.get(tmi)
    var tmj = 0
    while (tmj < tr.methods.len()) { val tm: FFunc = tr.methods.get(tmj); traitMethN.push(tm.name); traitMethT.push(tr.name); tmj = tmj + 1 }
    tmi = tmi + 1
  }
  // trait dispatchers: generated + name-registered BEFORE phase 2 so trait-typed method calls resolve
  val dispatchers = genDispatchers(traitDecls, implTrait, implType, structN, fN, fR)
  // ownership-mode table for TOP-LEVEL free functions (owner==""): name -> per-param mode list. Used by
  // lowerPlainCall to decide whether a class temp passed as an arg is BORROWED (release after) or
  // TRANSFERRED (consuming — callee owns it). Built once here; empty for the class-free compiler.
  val pmN = intBuf(); val pmM = intBuf()
  var pmi = 0
  while (pmi < pfuns.len()) {
    val pf0: PFun = pfuns.get(pmi)
    if (pf0.owner == "") {
      pmN.push(pf0.fd.name)
      val modes = intBuf()
      var ppi = 0
      while (ppi < pf0.fd.params.len()) { val pp0: FParam = pf0.fd.params.get(ppi); modes.push(paramMode(pp0.ty)); ppi = ppi + 1 }
      pmM.push(modes)
    }
    pmi = pmi + 1
  }
  // whole-program param-type table: mangled function name -> its declared param types (an IntBuf of type
  // strings, so a `(Int, Int) -> Int` type's own commas don't get split). Covers EVERY pfun (free fns AND
  // methods, unlike pmN which is free-fns only), so a method's callback param type drives lambda-arg typing.
  val fpN = intBuf(); val fpT = intBuf()
  var fpi = 0
  while (fpi < pfuns.len()) {
    val fpf: PFun = pfuns.get(fpi)
    fpN.push(mangleMethod(fpf.owner, fpf.fd.name))
    val ftys = intBuf()
    // a real method's receiver (`self`) lives in fd.recv, NOT fd.params — but the call site prepends the
    // receiver as arg0 (consFront) and the UFCS free-fn form carries its receiver as param0. Prepend a
    // receiver slot here for methods-with-self so BOTH forms align at a uniform offset of 1 on that path.
    if (fpf.owner != "" && fpf.fd.recv != "") { ftys.push(fpf.owner) }
    var fqi = 0
    while (fqi < fpf.fd.params.len()) { val fpp: FParam = fpf.fd.params.get(fqi); ftys.push(fpp.ty); fqi = fqi + 1 }
    fpT.push(ftys)
    fpi = fpi + 1
  }
  // primitive registry: source the numeric classification (sizeOf<T>() strides, packed sized loads) from
  // the lib @prim markers — the SAME table the checker builds. The prelude markers (lib/core/num.kite) are
  // in `pfuns` (injectHelpers pushed them), each FFunc carrying its @prim annotation, so one scan builds it.
  val prim = PReg(intBuf(), intBuf(), intBuf(), intBuf(), intBuf())
  var pri = 0
  while (pri < pfuns.len()) { val ppf: PFun = pfuns.get(pri); recordPrim(ppf.fd.annos, ppf.fd.name, prim); recordAlias(ppf.fd.annos, ppf.fd.name, prim); pri = pri + 1 }
  // VARARG registry: mangled-symbol -> (fixed-param count, element type E). Built in its own helper so
  // finishLower's frame stays small (a growing finishLower can trip an older bootstrap seed's frame limit).
  val vareg = VaReg(intBuf(), intBuf(), intBuf(), intBuf())
  buildVarargRegistry(pfuns, monoN, vareg)
  // phase 2: lower every function (in its own helper so finishLower's frame stays under the seed's limit).
  val funcs = lowerAllPfuns(pfuns, monoN, dispatchers, fN, fR, structN, structF, structFT, classN, traitN, constN, constV, cfuncs, traitMethN, traitMethT, pmN, pmM, variantN, variantTys, variantOwn, roleK, roleV, arcE, valueE, prim, fpN, fpT, mt, vareg)
  return LR(funcs, structN, structF, structFT, variantN, variantTag, variantTys, fN, fR, arcE)
}

// Phase-2 lowering loop, extracted from finishLower so its many locals (funcs/lifted/gctr + the loop
// cursors) live in THIS frame, not finishLower's — finishLower is close enough to the bootstrap seed's
// per-function frame ceiling that a few extra locals there miscompile it. Lowers every non-template pfun,
// appends the lifted lambda closures, then the trait dispatchers; returns the full Func list.
fun lowerAllPfuns(pfuns: IntBuf, monoN: IntBuf, dispatchers: IntBuf, fN: IntBuf, fR: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, traitN: IntBuf, constN: IntBuf, constV: IntBuf, cfuncs: IntBuf, traitMethN: IntBuf, traitMethT: IntBuf, pmN: IntBuf, pmM: IntBuf, variantN: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, roleK: IntBuf, roleV: IntBuf, arcE: IntBuf, valueE: IntBuf, prim: PReg, fpN: IntBuf, fpT: IntBuf, mt: MTab, vareg: VaReg): IntBuf {
  val funcs = intBuf()
  val lifted = intBuf()
  val gctr = intBuf(); gctr.push(0)
  var i = 0
  while (i < pfuns.len()) { val pf: PFun = pfuns.get(i); if (memListL(monoN, pf.owner)) { i = i + 1 } else { funcs.push(lowerFuncFull(pf, fN, fR, structN, structF, structFT, lifted, gctr, classN, traitN, constN, constV, cfuncs, traitMethN, traitMethT, pmN, pmM, variantN, variantTys, variantOwn, roleK, roleV, arcE, valueE, prim, fpN, fpT, mt, vareg)); i = i + 1 } }
  var j = 0
  while (j < lifted.len()) { funcs.push(lifted.get(j)); j = j + 1 }
  var d = 0
  while (d < dispatchers.len()) { funcs.push(dispatchers.get(d)); d = d + 1 }
  return funcs
}

// ---------- module system: `import "path"` resolved by inlining files, with transitive dedup ----------
// A line whose first non-space token is `import` (followed by a space or quote) is an import; its
// quoted path is read, its own imports resolved, and its content inlined in place of the line. A
// shared `seen` list dedups so a module included via several paths is emitted once. Import-free
// source is reconstructed byte-for-byte (so the compiler, which uses no imports, self-hosts unchanged).
fun impExtractQuoted(line: String): String {
  var i = 0
  val n = line.len()
  while (i < n && line.charAt(i) != 34) { i = i + 1 }
  if (i >= n) { return "" }
  i = i + 1
  var s = ""
  while (i < n && line.charAt(i) != 34) { s = s + line.substr(i, 1); i = i + 1 }
  return s
}

// skip leading spaces + an optional `pub ` prefix; returns the index where `import` should start.
fun impKwStart(line: String): Int {
  var i = 0
  val n = line.len()
  while (i < n && line.charAt(i) == 32) { i = i + 1 }
  if (i + 4 <= n) { if (line.substr(i, 4) == "pub ") { i = i + 4; while (i < n && line.charAt(i) == 32) { i = i + 1 } } }
  return i
}

fun impIsImport(line: String): Bool {
  val i = impKwStart(line)
  val n = line.len()
  if (i + 6 > n) { return false }
  if (line.substr(i, 6) != "import") { return false }
  val c = line.charAt(i + 6)
  return c == 32 || c == 34
}

fun impIdentChar(c: Int): Bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 }

// Resolve an import line to the FILE PATH it names, from EITHER form:
//   import "kite/core.kite"   -> "kite/core.kite"   (quoted = literal relative path, the escape hatch)
//   import kite::core         -> "kite/core.kite"   (namespace path: `::` -> `/`, append `.kite`)
// The module NAME downstream is modName(path) = last '/'-segment (so `import kite::core` -> module `core`).
fun impExtractPath(line: String): String {
  val q = impExtractQuoted(line)
  if (q != "") { return q }
  val n = line.len()
  var i = impKwStart(line) + 6 // skip [pub] 'import' (impIsImport matched it)
  while (i < n && line.charAt(i) == 32) { i = i + 1 } // spaces after 'import'
  var path = ""
  var go = 1
  while (i < n && go == 1) {
    val c = line.charAt(i)
    if (c == 58) { path = path + "/"; i = i + 1; if (i < n && line.charAt(i) == 58) { i = i + 1 } }
    else { if (impIdentChar(c)) { path = path + line.substr(i, 1); i = i + 1 } else { go = 0 } }
  }
  if (path == "") { return "" }
  // the `kite` root package maps to the lib/ directory (lib/ IS the kite standard library)
  if (path.len() >= 5) { if (path.substr(0, 5) == "kite/") { path = "lib/" + path.substr(5, path.len() - 5) } }
  return path + ".kite"
}

// Inline a QUOTED include flat; PRESERVE a namespace (`import kite::a::b`) import line so the module
// system can still see it downstream. This is what lets the two import kinds be MIXED in one file:
// quoted includes get flattened here, and any remaining namespace imports route the result to the
// module path. (Previously a namespace line was dropped, forcing an all-or-nothing choice.)
fun impProcLine(line: String, seen: IntBuf): String {
  if (impIsImport(line) == false) { return line }
  val q = impExtractQuoted(line)
  if (q == "") { return line } // namespace import -> keep the line for collectModules
  if (memListL(seen, q)) { return "" } // quoted include already inlined -> drop
  seen.push(q)
  return resolveImports(readFile(q), seen)
}

fun resolveImports(src: String, seen: IntBuf): String {
  var result = ""
  var line = ""
  var i = 0
  val n = src.len()
  while (i < n) {
    val c = src.charAt(i)
    if (c == 10) { result = result + (impProcLine(line, seen) + "\n"); line = "" }
    else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  return result + impProcLine(line, seen)
}

// ================= S1: real module system (namespaced imports) =================
// FIXPOINT-SAFE BY CONSTRUCTION: the compiler's own source contains no `import "..."`, so main()
// takes the else fast-path (today's exact resolveImports->parseLower) and NONE of the code below
// ever runs while compiling the compiler. Only inputs with a string-path import engage this path.
//
// Semantics: `import "std/x.kite"` names the file module "x" (last path segment sans .kite). Each
// module's top-level FREE FUNCTIONS are mangled `x__name` so two modules may share a name. Inside a
// module, an unqualified reference resolves to that module's own item first, else to a `use`/import
// alias, else global. `mod::name` resolves to the module-mangled item. `use mod::name` aliases bare
// `name` in the importing scope. The ROOT module additionally auto-imports every imported module's
// bare names (so plain `import` + unqualified use keeps working). v1 scope: only free functions are
// namespaced; types/enums/traits/impls/consts stay global (documented limitation).
struct Mod(val name: String, val src: String)

struct RawMod(val name: String, val funcs: IntBuf, val tdecls: IntBuf, val edecls: IntBuf, val traits: IntBuf, val impls: IntBuf, val consts: IntBuf, val uses: IntBuf, val L: IntBuf, val imps: IntBuf, val impPub: IntBuf)

struct Ren(val m: String, val L: IntBuf, val MODS: IntBuf, val aN: IntBuf, val aT: IntBuf)

fun mangleMod(m: String, n: String): String {
  if (m == "") { return n }
  return m + ("__" + n)
}

// last '/'-segment of a path, minus a trailing ".kite"
fun modName(path: String): String {
  val n = path.len()
  var slash = 0 - 1
  var i = 0
  while (i < n) { if (path.charAt(i) == 47) { slash = i }; i = i + 1 }
  val start = slash + 1
  var base = path.substr(start, n - start)
  val bl = base.len()
  if (bl >= 5) { if (base.substr(bl - 5, 5) == ".kite") { base = base.substr(0, bl - 5) } }
  return base
}

// A NAMESPACE import (`import kite::a::b`) engages the real module system (mangling + visibility).
// A QUOTED import (`import "x.kite"`) is a FLAT TEXTUAL INCLUDE done by resolveImports (no mangling) —
// that is how the compiler assembles ITSELF (dogfooding its own import) without renaming its own
// cross-file calls. isNsImport tells them apart; hasNamespaceImport routes the input in lowerInput.
fun isNsImport(line: String): Bool {
  if (impIsImport(line) == false) { return false }
  if (impExtractQuoted(line) != "") { return false } // quoted → flat include, not a module
  if (impExtractPath(line) != "") { return true } // a resolvable kite:: path
  return false
}

// true iff some line is a namespace import (nested ifs keep out-of-bounds guarded — `&&` is bitwise).
fun hasNamespaceImport(src: String): Bool {
  var line = ""
  var i = 0
  val n = src.len()
  while (i < n) {
    val c = src.charAt(i)
    if (c == 10) { if (isNsImport(line)) { return true }; line = "" }
    else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  if (isNsImport(line)) { return true }
  return false
}

// gather the transitive set of imported files as modules (deps before dependents, path-deduped),
// then append the root as module "" (its raw source, unmodified).
fun collectModLine(line: String, seen: IntBuf, mods: IntBuf): Int {
  if (impIsImport(line) == false) { return 0 }
  val path = impExtractPath(line)
  if (path == "") { return 0 }
  if (memListL(seen, path)) { return 0 }
  seen.push(path)
  val f = readFile(path)
  collectModImports(f, seen, mods)
  mods.push(Mod(modName(path), f))
  return 0
}

fun collectModImports(src: String, seen: IntBuf, mods: IntBuf): Int {
  var line = ""
  var i = 0
  val n = src.len()
  while (i < n) {
    val c = src.charAt(i)
    if (c == 10) { collectModLine(line, seen, mods); line = "" }
    else { line = line + src.substr(i, 1) }
    i = i + 1
  }
  collectModLine(line, seen, mods)
  return 0
}

fun collectModules(rawInput: String): IntBuf {
  val mods = intBuf()
  val seen = intBuf()
  // Prelude modules (compiler/prelude.conf) are auto-injected ONCE via injectHelpers; seed `seen` with
  // their paths so a module that is BOTH prelude-injected AND explicitly (pub-)imported is not collected
  // (and thus lowered) a second time. E.g. `import kite::alloc::collections` pub-imports list & map, which
  // are already prelude modules — dedup by path keeps IntBuf/RawMap defined exactly once (no double definition).
  val pre = preludeConfPaths()
  var pi = 0
  while (pi < pre.len()) { seen.push(pre.get(pi)); pi = pi + 1 }
  collectModImports(rawInput, seen, mods)
  mods.push(Mod("", rawInput))
  return mods
}

// ---- scope-aware reference rename (mirrors fvExpr binder tracking exactly) ----
fun renResolve(rc: Ren, bound: IntBuf, nm: String): String {
  if (memListL(bound, nm)) { return nm }
  if (memListL(rc.L, nm)) { return mangleMod(rc.m, nm) }
  val i = indexOfL(rc.aN, nm)
  if (i >= 0) { return rc.aT.get(i) }
  return nm
}

fun renStatic(rc: Ren, bound: IntBuf, a: FExpr, nm: String): FExpr {
  return when (a) {
    FEIdent(md) -> if (memListL(rc.MODS, md)) { FEIdent(mangleMod(md, nm)) } else { FEStatic(renExpr(rc, bound, a), nm) }
    else -> FEStatic(renExpr(rc, bound, a), nm)
  }
}

fun renArgs(rc: Ren, bound: IntBuf, args: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < args.len()) { val ar: FArg = args.get(i); out.push(FArg(ar.name, renExpr(rc, bound, ar.expr))); i = i + 1 }
  return out
}

fun renExprList(rc: Ren, bound: IntBuf, es: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < es.len()) { out.push(renExpr(rc, bound, es.get(i))); i = i + 1 }
  return out
}

fun renMap(rc: Ren, bound: IntBuf, ents: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); out.push(FMapEnt(renExpr(rc, bound, en.k), renExpr(rc, bound, en.v))); i = i + 1 }
  return out
}

fun renParts(rc: Ren, bound: IntBuf, parts: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < parts.len()) {
    val pt: FIPart = parts.get(i)
    val np = when (pt) { FIExpr(e) -> FIExpr(renExpr(rc, bound, e)); else -> pt }
    out.push(np)
    i = i + 1
  }
  return out
}

fun renArms(rc: Ren, bound: IntBuf, arms: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    var b = bound
    if (a.kind == 2) { var j = 0; while (j < a.pats.len()) { b = extendB(b, patVars(a.pats.get(j))); j = j + 1 } }
    val nlhs = if (a.kind == 0) { renExpr(rc, b, a.lhs) } else { a.lhs }
    val nguard = if (isNoResF(a.guard)) { a.guard } else { renExpr(rc, b, a.guard) }
    out.push(FArm(a.kind, nlhs, a.pats, nguard, renExpr(rc, b, a.body)))
    i = i + 1
  }
  return out
}

fun renStmtInto(rc: Ren, bound: IntBuf, s: FStmt, out: IntBuf): IntBuf {
  return when (s) {
    FSLet(isVar, nm, ty, init) -> { out.push(FSLet(isVar, nm, ty, renExpr(rc, bound, init))); extendB(bound, one(nm)) }
    FSExprS(e) -> { out.push(FSExprS(renExpr(rc, bound, e))); bound }
    FSAssign(l, r) -> { out.push(FSAssign(renExpr(rc, bound, l), renExpr(rc, bound, r))); bound }
    FSReturnV(e) -> { out.push(FSReturnV(renExpr(rc, bound, e))); bound }
    FSReturnU -> { out.push(FSReturnU); bound }
    FSWhile(c, bd) -> { out.push(FSWhile(renExpr(rc, bound, c), renExpr(rc, bound, bd))); bound }
    FSFor(v, it, bd) -> { out.push(FSFor(v, renExpr(rc, bound, it), renExpr(rc, extendB(bound, one(v)), bd))); bound }
    else -> { out.push(s); bound }
  }
}

fun renBlock(rc: Ren, bound: IntBuf, stmts: IntBuf, res: FExpr): FExpr {
  val out = intBuf()
  var b = bound
  var i = 0
  while (i < stmts.len()) { b = renStmtInto(rc, b, stmts.get(i), out); i = i + 1 }
  return FEBlock(out, renExpr(rc, b, res))
}

fun renExpr(rc: Ren, bound: IntBuf, e: FExpr): FExpr {
  return when (e) {
    FEIdent(nm) -> FEIdent(renResolve(rc, bound, nm))
    FEUnary(op, x) -> FEUnary(op, renExpr(rc, bound, x))
    FEBin(op, a, b) -> FEBin(op, renExpr(rc, bound, a), renExpr(rc, bound, b))
    FEField(a, f) -> FEField(renExpr(rc, bound, a), f)
    FESafeField(a, f) -> FESafeField(renExpr(rc, bound, a), f)
    FEStatic(a, nm) -> renStatic(rc, bound, a, nm)
    FECall(callee, args) -> FECall(renExpr(rc, bound, callee), renArgs(rc, bound, args))
    FENotNull(a) -> FENotNull(renExpr(rc, bound, a))
    FEElvis(a, b) -> FEElvis(renExpr(rc, bound, a), renExpr(rc, bound, b))
    FEIndex(a, b) -> FEIndex(renExpr(rc, bound, a), renExpr(rc, bound, b))
    FETypeApp(a, t) -> FETypeApp(renExpr(rc, bound, a), t)
    FECast(a, ty) -> FECast(renExpr(rc, bound, a), ty)
    FEQuestion(a) -> FEQuestion(renExpr(rc, bound, a))
    FEList(es) -> FEList(renExprList(rc, bound, es))
    FEMap(ents) -> FEMap(renMap(rc, bound, ents))
    FELambda(params, body) -> FELambda(params, renExpr(rc, extendB(bound, splitLamNames(params)), body))
    FEInterp(parts, r) -> FEInterp(renParts(rc, bound, parts), r)
    FEBlock(stmts, res) -> renBlock(rc, bound, stmts, res)
    FEIf(c, t, el) -> FEIf(renExpr(rc, bound, c), renExpr(rc, bound, t), renExpr(rc, bound, el))
    FEWhen(hasSubj, bind, subj, arms) -> FEWhen(hasSubj, bind, renExpr(rc, bound, subj), renArms(rc, bound, arms))
    FERet(x) -> FERet(renExpr(rc, bound, x))
    else -> e
  }
}

// An EXTENSION FUNCTION `fun Type.m(..)` desugars (kfront) to a free fn whose FIRST param is named "this"
// and whose name is the owner-mangle `Type_m`. Phase M6: such a function is a METHOD, not a module free
// function — it keeps its GLOBAL owner-mangled name (like a struct-body method, collectMethodSigsRen), is
// NOT module-mangled (`mod__Type_m`) and NOT added to the module's `L`, so `x.m()` binds to `Type_m`
// directly and the surface `Type_m` name stays rejectable by the member-table enforcement (never aliased
// back to a live `mod__Type_m`).
fun isExtFn(fd: FFunc): Bool {
  if (fd.params.len() == 0) { return false }
  val p0: FParam = fd.params.get(0)
  return p0.name == "this"
}

fun renFunc(rc: Ren, fd: FFunc): FFunc {
  val bound = intBuf()
  if (fd.recv != "") { bound.push("this"); bound.push(fd.recv) }
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); bound.push(pp.name); i = i + 1 }
  val nm = if (isExtFn(fd)) { fd.name } else { mangleMod(rc.m, fd.name) }
  return FFunc(fd.annos, nm, fd.gen, fd.recv, fd.params, fd.ret, fd.whr, renExpr(rc, bound, fd.body))
}

// Rename a METHOD/impl body (free-function references resolved through the owning module's scope) while
// KEEPING the method name (types stay global — a method is `<Type>_<name>`, not module-mangled). Types are
// declared in a module but their method bodies reference that module's own + imported free functions, so
// they must be renamed exactly like free functions — otherwise a `Vec` method calling `rawBufDrop` from an
// imported `rawbuf` module would emit the bare name and fail to link (undefined symbol). `self` is the
// receiver (recv), bound to `this`; params (incl. the trailing ones after self) are bound too.
fun renMethodBody(rc: Ren, m: FFunc): FFunc {
  val bound = intBuf()
  if (m.recv != "") { bound.push("this"); bound.push(m.recv) }
  var i = 0
  while (i < m.params.len()) { val pp: FParam = m.params.get(i); bound.push(pp.name); i = i + 1 }
  return FFunc(m.annos, m.name, m.gen, m.recv, m.params, m.ret, m.whr, renExpr(rc, bound, m.body))
}

// module-aware collectMethodSigs: register each method owned by the type, body scope-renamed for the module.
fun collectMethodSigsRen(rc: Ren, td: FTDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < td.methods.len()) {
    val m: FFunc = renMethodBody(rc, td.methods.get(i))
    pfuns.push(PFun(td.name, m)); fN.push(mangleMethod(td.name, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// module-aware collectMethodSigsEnum: each enum-body method owned by the enum, body scope-renamed for the module.
fun collectMethodSigsEnumRen(rc: Ren, ed: FEDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < ed.methods.len()) {
    val m: FFunc = renMethodBody(rc, ed.methods.get(i))
    pfuns.push(PFun(ed.name, m)); fN.push(mangleMethod(ed.name, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// module-aware collectDeinit: the class `deinit` body is scope-renamed for the module.
fun collectDeinitRen(rc: Ren, td: FTDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  if (isNoResF(td.dtor)) { return 0 }
  val bound = intBuf(); bound.push("this"); bound.push("self")
  val df = FFunc(intBuf(), "deinit", "", "self", intBuf(), "Int", "", renExpr(rc, bound, td.dtor))
  pfuns.push(PFun(td.name, df)); fN.push(mangleMethod(td.name, "deinit")); fR.push("Int")
  return 0
}

// module-aware collectImplMethods: impl methods (trait or inherent) body scope-renamed for the module.
fun collectImplMethodsRen(rc: Ren, im: FImplDecl, pfuns: IntBuf, fN: IntBuf, fR: IntBuf): Int {
  var i = 0
  while (i < im.methods.len()) {
    val m: FFunc = renMethodBody(rc, im.methods.get(i))
    pfuns.push(PFun(im.forTy, m)); fN.push(mangleMethod(im.forTy, m.name)); fR.push(m.ret)
    i = i + 1
  }
  return 0
}

// module-aware trait decl: each trait method's DEFAULT body is scope-renamed for the owning module so that
// finishLower's default-method synthesis (`impl Trait for T` not overriding a defaulted method emits
// `<T>_<m>` FROM this body) links a body that references the module's own / imported free functions against
// the module-mangled name — the same parity renMethodBody gives struct/impl method bodies. Signature-only
// methods (FENoRes body) pass through unchanged. Renaming a body never touches a method name, so the shared
// trait registries downstream (traitMethN, dispatchers) are byte-identical either way.
fun renTraitDecl(rc: Ren, trd: FTraitDecl): FTraitDecl {
  val ms = intBuf()
  var i = 0
  while (i < trd.methods.len()) { ms.push(renMethodBody(rc, trd.methods.get(i))); i = i + 1 }
  return FTraitDecl(trd.annos, trd.name, trd.gen, trd.supers, trd.whr, trd.assoc, ms)
}

// ---- parse one module's decls into a RawMod (no renaming yet; L = its free-function names) ----
fun nsLastSeg(s: String): String {
  val n = s.len()
  var start = 0
  var i = 0
  while (i < n) { if (s.charAt(i) == 58) { start = i + 1 }; i = i + 1 } // last ':' -> after it
  return s.substr(start, n - start)
}

fun parseModuleRaw(name: String, src: String): RawMod {
  val p = mkPSeed(lex(src), preludeInfixNames())
  val funcs = intBuf(); val tdecls = intBuf(); val edecls = intBuf()
  val traits = intBuf(); val impls = intBuf(); val consts = intBuf()
  val uses = intBuf(); val L = intBuf(); val imps = intBuf(); val impPub = intBuf()
  var go = 1
  while (go == 1) {
    if (pk(p) == 0) { go = 0 }
    else {
      val annos = parseAnnos(p)
      var isPub = 0
      if (pk(p) == 56) { eat(p); isPub = 1 } // `pub` prefix (public re-export when on an import)
      val k = pk(p)
      if (k == 10 || k == 88) { val fd = parseFunc(p, annos); funcs.push(fd); if (isExtFn(fd) == false) { L.push(fd.name) } }
      else { if (k == 54) { tdecls.push(parseTypeDecl(p, annos, 0)) }
        else { if (k == 65) { tdecls.push(parseTypeDecl(p, annos, 1)) }
          else { if (k == 55) { edecls.push(parseEnum(p, annos)) }
            else { if (k == 66) { traits.push(parseTrait(p, annos)) }
              else { if (k == 67) { impls.push(parseImpl(p, annos)) }
                else { if (k == 58) { val ip = parseImport(p); imps.push(nsLastSeg(ip)); impPub.push(isPub) }
                  else { if (k == 80) { consts.push(parseConst(p)) }
                    else { if (k == 81) { uses.push(parseUse(p)) }
                      else { go = 0 } } } } } } } } }
    }
  }
  return RawMod(name, funcs, tdecls, edecls, traits, impls, consts, uses, L, imps, impPub)
}

// build a module's alias table: `use` aliases first (highest priority), then (root only) auto-import
// of every imported module's bare names (first module wins; never overrides own names or use aliases).
fun findRawMod(rawmods: IntBuf, name: String): Int {
  var i = 0
  while (i < rawmods.len()) { val rm: RawMod = rawmods.get(i); if (rm.name == name) { return i }; i = i + 1 }
  return 0 - 1
}

// EXPORT SURFACE of module `name` = its own free-fn names (mangled) + the surfaces of its `pub import`s.
// A plain `import` is a private dependency (its names are NOT re-exported). `seen` guards import cycles.
fun exportSurface(rawmods: IntBuf, name: String, outN: IntBuf, outT: IntBuf, seen: IntBuf): Int {
  if (memListL(seen, name)) { return 0 }
  seen.push(name)
  val idx = findRawMod(rawmods, name)
  if (idx < 0) { return 0 }
  val rm: RawMod = rawmods.get(idx)
  var i = 0
  while (i < rm.L.len()) { outN.push(rm.L.get(i)); outT.push(mangleMod(name, rm.L.get(i))); i = i + 1 }
  var j = 0
  while (j < rm.imps.len()) {
    if (rm.impPub.get(j) == 1) { exportSurface(rawmods, rm.imps.get(j), outN, outT, seen) }
    j = j + 1
  }
  return 0
}

// a module's alias table: `use` aliases first, then the EXPORT SURFACE of every module IT imports (pub or
// private — a module may use what it privately imports). Own names and use-aliases win over auto-imports.
fun buildRen(rm: RawMod, rawmods: IntBuf, MODS: IntBuf): Ren {
  val aN = intBuf(); val aT = intBuf()
  var i = 0
  while (i < rm.uses.len()) { val u: FUse = rm.uses.get(i); aN.push(u.name); aT.push(mangleMod(u.mod, u.name)); i = i + 1 }
  var mi = 0
  while (mi < rm.imps.len()) {
    val sN = intBuf(); val sT = intBuf(); val seen = intBuf()
    exportSurface(rawmods, rm.imps.get(mi), sN, sT, seen)
    var si = 0
    while (si < sN.len()) {
      val nm: String = sN.get(si)
      if (memListL(aN, nm) == false) { if (memListL(rm.L, nm) == false) { aN.push(nm); aT.push(sT.get(si)) } }
      si = si + 1
    }
    mi = mi + 1
  }
  return Ren(rm.name, rm.L, MODS, aN, aT)
}

// rename this module's free functions and collect ALL its decls into the shared aggregate lists
fun collectModuleDecls(rc: Ren, rm: RawMod, pfuns: IntBuf, structN: IntBuf, structF: IntBuf, structFT: IntBuf, classN: IntBuf, traitN: IntBuf, traitDecls: IntBuf, implTrait: IntBuf, implType: IntBuf, constN: IntBuf, constExprs: IntBuf, variantN: IntBuf, variantTag: IntBuf, variantTys: IntBuf, variantOwn: IntBuf, fN: IntBuf, fR: IntBuf, deriveT: IntBuf, deriveTr: IntBuf, roleK: IntBuf, roleV: IntBuf, arcE: IntBuf, valueE: IntBuf, monoN: IntBuf, monoP: IntBuf, mt: MTab): Int {
  var i = 0
  while (i < rm.funcs.len()) {
    val nfd = renFunc(rc, rm.funcs.get(i))
    pfuns.push(PFun("", nfd)); fN.push(nfd.name); fR.push(nfd.ret)
    recordLang(nfd.annos, nfd.name, roleK, roleV)
    // Phase M6: mirror the module's decls into the member table (the flat path already does via collectDecl),
    // so the surface `<Type>_<member>` enforcement fires uniformly under namespace imports too. An extension
    // fn (renFunc kept it unmangled with its "this" param) registers as a method of its receiver type.
    if (hasPrim(nfd.annos)) { mtType(mt, nfd.name); mtRecordAlias(mt, nfd.annos, nfd.name) } else { mtFreeFun(mt, nfd) }
    i = i + 1
  }
  var ti = 0
  while (ti < rm.tdecls.len()) {
    val td: FTDecl = rm.tdecls.get(ti)
    collectStruct(td, structN, structF, structFT)
    if (td.kind == 1) { classN.push(td.name) }
    mtType(mt, td.name); mtRecordAlias(mt, td.annos, td.name); mtFields(mt, td); mtMethods(mt, td.name, td.methods)
    if (td.kind == 1) { if (isNoResF(td.dtor) == false) { mtAdd(mt, td.name, "deinit", "method", 1, mangleMethod(td.name, "deinit"), "Int") } }
    // method bodies are scope-renamed for the module (collectMethodSigsRen), so a type's method calling an
    // imported free function links against the module-mangled name — the parity with the flat/quoted path.
    collectMethodSigsRen(rc, td, pfuns, fN, fR)
    if (td.kind == 1) { collectDeinitRen(rc, td, pfuns, fN, fR) }
    recordLangMethods(td.methods, td.name, 1, roleK, roleV)
    recordArc(td.annos, td.name, arcE)
    recordValue(td.annos, td.name, valueE)
    recordDerive(td.annos, td.name, deriveT, deriveTr)
    // @mono: register the template so finishLower's runMono instantiates it — this is what lets a namespace
    // `import kite::alloc::collections::vec` + `Vec::<Int>(..)` monomorphize under the module pipeline, not just the
    // quoted/flat path. Without it the generic body links with an undefined element-typed symbol.
    recordMono(td.annos, td.name, td.gen, monoN, monoP)
    ti = ti + 1
  }
  var ei = 0
  while (ei < rm.edecls.len()) { val ed: FEDecl = rm.edecls.get(ei); collectEnum(ed, variantN, variantTag, variantTys, variantOwn); recordDerive(ed.annos, ed.name, deriveT, deriveTr); mtType(mt, ed.name); mtVariants(mt, ed); mtMethods(mt, ed.name, ed.consts); collectMethodSigsEnumRen(rc, ed, pfuns, fN, fR); recordLangMethods(ed.methods, ed.name, 1, roleK, roleV); mtMethods(mt, ed.name, ed.methods); ei = ei + 1 }
  var tr = 0
  while (tr < rm.traits.len()) { val trd: FTraitDecl = renTraitDecl(rc, rm.traits.get(tr)); traitN.push(trd.name); traitDecls.push(trd); recordLangMethods(trd.methods, "", 0, roleK, roleV); mtType(mt, trd.name); mtTraitMethods(mt, trd.name, trd.methods); tr = tr + 1 }
  var ii = 0
  while (ii < rm.impls.len()) {
    val im: FImplDecl = rm.impls.get(ii)
    collectImplMethodsRen(rc, im, pfuns, fN, fR)
    if (im.traitName != "") { implTrait.push(im.traitName); implType.push(im.forTy) }
    recordLangMethods(im.methods, im.forTy, 1, roleK, roleV)
    recordArc(im.annos, im.forTy, arcE)
    mtMethods(mt, im.forTy, im.methods)
    ii = ii + 1
  }
  var ci = 0
  while (ci < rm.consts.len()) { val cd: FConstDecl = rm.consts.get(ci); constN.push(cd.name); constExprs.push(cd.expr); mtAdd(mt, "", cd.name, "const", 0, cd.name, ""); ci = ci + 1 }
  return 0
}

fun parseLowerModules(mods: IntBuf): LR {
  val rawmods = intBuf()
  val MODS = intBuf()
  var mp = 0
  while (mp < mods.len()) {
    val md: Mod = mods.get(mp)
    rawmods.push(parseModuleRaw(md.name, md.src))
    if (md.name != "") { MODS.push(md.name) }
    mp = mp + 1
  }
  val pfuns = intBuf()
  val structN = intBuf(); val structF = intBuf(); val structFT = intBuf()
  val classN = intBuf()
  val traitN = intBuf(); val traitDecls = intBuf(); val implTrait = intBuf(); val implType = intBuf()
  val constN = intBuf(); val constExprs = intBuf()
  val variantN = intBuf(); val variantTag = intBuf(); val variantTys = intBuf(); val variantOwn = intBuf()
  val fN = intBuf(); val fR = intBuf()
  val roleK = intBuf(); val roleV = intBuf()
  val arcE = intBuf()
  val valueE = intBuf()
  val deriveT = intBuf(); val deriveTr = intBuf()
  // @mono templates ARE collected here (collectModuleDecls -> recordMono), so finishLower's runMono
  // instantiates a namespace-imported `@mono` collection (`import kite::alloc::collections::vec` + `Vec::<Int>(..)`)
  // exactly as the flat/quoted path does. Empty when no imported module is `@mono` (e.g. the jq stdlib).
  val monoN = intBuf(); val monoP = intBuf()
  // Member table: seeded from the auto-injected prelude via collectDecl (injectHelpers), then the
  // namespace/module user decls are mirrored in by collectModuleDecls (Phase M6) so the surface
  // `<Type>_<member>` enforcement + member resolution fire uniformly under namespace imports.
  val mt = mtNew()
  injectHelpers(pfuns, fN, fR, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, roleK, roleV, arcE, valueE, deriveT, deriveTr, monoN, monoP, mt)
  var rj = 0
  while (rj < rawmods.len()) {
    val rm: RawMod = rawmods.get(rj)
    val rc = buildRen(rm, rawmods, MODS)
    collectModuleDecls(rc, rm, pfuns, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, fN, fR, deriveT, deriveTr, roleK, roleV, arcE, valueE, monoN, monoP, mt)
    rj = rj + 1
  }
  return finishLower(pfuns, structN, structF, structFT, classN, traitN, traitDecls, implTrait, implType, constN, constExprs, variantN, variantTag, variantTys, variantOwn, fN, fR, roleK, roleV, arcE, valueE, deriveT, deriveTr, monoN, monoP, mt)
}

// Route the input: the module pipeline (mangling + visibility) when it has a NAMESPACE import; else the
// flat path — resolveImports expands any quoted `import "..."` as plain text (the compiler's own case),
// then parseLower. A quoted-only input (like the compiler assembling itself) never touches the module
// machinery, so its cross-file calls keep their global names.
// Flatten quoted includes FIRST (they inline into whichever module contains them), then decide the
// path: if namespace imports remain, engage the module system on the flattened source; otherwise it's
// a pure quoted/flat program. A file may freely MIX quoted includes (its own files) with namespace
// imports (the standard library). The compiler itself uses only quoted includes, so `flat` has no
// namespace imports and this stays byte-identical to the old quoted-only path.
// A fresh `seen` set pre-marked with every prelude module path, so a QUOTED `import "lib/.../vec.kite"` of a
// module that is ALSO auto-injected by the prelude (injectHelpers) is DROPPED rather than inlined a second
// time — which would double-define its types (e.g. `class Vec`). This generalizes collectModules' existing
// namespace-import dedup to the quoted/flat include path. FIXPOINT-SAFE: the compiler's own quoted includes
// name `compiler/*.kite`, never a `lib/` prelude path, so the seed never matches and `flat` is unchanged.
fun preludeSeededSeen(): IntBuf {
  val seen = intBuf()
  val pre = preludeConfPaths()
  var i = 0
  while (i < pre.len()) { seen.push(pre.get(i)); i = i + 1 }
  return seen
}

fun lowerInput(raw: String): LR {
  val flat = resolveImports(raw, preludeSeededSeen())
  if (hasNamespaceImport(flat)) { return parseLowerModules(collectModules(flat)) }
  return parseLower(lex(flat))
}

// concatenate every module's source (namespace-import inputs) so the checker sees lib definitions too
// and doesn't false-flag lib names as "unresolved".
fun concatModuleSrcs(mods: IntBuf): String {
  var s = ""
  var i = 0
  while (i < mods.len()) { val m: Mod = mods.get(i); s = s + (m.src + "\n"); i = i + 1 }
  return s
}

fun gateDiags(raw: String): IntBuf {
  // Mirror lowerInput: flatten quoted includes FIRST, then decide on namespace modules. A namespace
  // import may be buried inside a quoted-included file (mixed imports), so it only becomes visible
  // after flattening — checking `raw` directly would miss it and false-flag stdlib names as unresolved.
  val flat = resolveImports(raw, preludeSeededSeen())
  val nsImp = hasNamespaceImport(flat)
  val checkSrc = if (nsImp) { concatModuleSrcs(collectModules(flat)) } else { flat }
  val skipDup = if (nsImp) { 1 } else { 0 }
  return checkDiags(lex(checkSrc), skipDup)
}

// gateShadow (Phase M1): the SHADOW analogue of gateDiags — flatten quoted includes + resolve namespace
// modules exactly like the real check gate, then run the checker's member-table SHADOW pass and return the
// would-be no-member log lines. Never gates a build; consumed only by the `shadow` CLI command.
fun gateShadow(raw: String): IntBuf {
  val flat = resolveImports(raw, preludeSeededSeen())
  val nsImp = hasNamespaceImport(flat)
  val checkSrc = if (nsImp) { concatModuleSrcs(collectModules(flat)) } else { flat }
  return shadowDiags(lex(checkSrc))
}

// Render a collected checker/parser diagnostic list through the ONE Diagnostic sink (Phase 0.5, §3h): each
// accumulated message becomes an error Diagnostic emitted to STDERR via the single renderer, then the count
// trailer. FORMAT-PRESERVING — the message already carries its own "line N: " prefix, so renderDiag
// reproduces the exact legacy "error: line N: <msg>" text and the committed goldens stay byte-valid (the
// check harness captures 2>&1, so moving diagnostics off stdout onto stderr is capture-safe).
fun reportDiags(cdiags: IntBuf, trailer: String): Int {
  var di = 0
  while (di < cdiags.len()) { emitDiag(diagError(cdiags.get(di))); di = di + 1 }
  eprintln(cdiags.len().toStr() + trailer)
  return 0
}

// compile inPath -> a signed native binary at outPath. Gated by the type-checker unless noGate;
// the peephole optimizer runs unless opt==0.
fun compileFile(inPath: String, outPath: String, noGate: Int, opt: Int): Int {
  val raw = readFile(inPath)
  if (noGate == 0) {
    val cdiags = gateDiags(raw)
    if (cdiags.len() > 0) {
      reportDiags(cdiags, " error(s); no binary written")
      return cdiags.len()
    }
  }
  val lr = lowerInput(raw)
  val gen = genProgramG(lr.funcs, lr.structN, lr.structF, lr.structFT, lr.variantN, lr.variantTag, lr.variantTys, lr.funN, lr.funRet, lr.arcE)
  val code = if (opt == 1) { optimize(gen.code) } else { gen.code }
  val asmR = assembleReloc(code)
  val cs = buildCstr(gen.cstrN, gen.cstrV)
  val externals = externalsOf(asmR.relocs)
  val entry = entryOffset(code, "_main")
  writeBytes(outPath, buildExeFull(asmR.words, asmR.relocs, cs, externals, entry, "_main", "kcout"))
  return 0
}

// `kitec check <file>`: type-check only, print diagnostics (no binary).
fun checkOnly(inPath: String): Int {
  val cdiags = gateDiags(readFile(inPath))
  if (cdiags.len() == 0) { println("ok"); return 0 }
  reportDiags(cdiags, " error(s)")
  return cdiags.len()
}

// `kitec shadow <file>`: run the member-table SHADOW pass and print the would-be no-member log to STDOUT,
// one "SHADOW <path>: line N: ..." line per miss, then a "SHADOW-TOTAL <n>" trailer. Prints nothing fatal;
// exit 0 always. This is the M1 harness surface — it never affects check/compile and writes no binary.
fun shadowScan(inPath: String): Int {
  val sd = gateShadow(readFile(inPath))
  var i = 0
  while (i < sd.len()) { println("SHADOW " + (inPath + (": " + sd.get(i)))); i = i + 1 }
  println("SHADOW-TOTAL " + (inPath + (" " + sd.len().toStr())))
  return 0
}

// default output = input path with a trailing ".kite" stripped ("foo.kite" -> "foo", in the cwd).
fun defaultOut(p: String): String {
  val n = p.len()
  if (n >= 5) { if (p.substr(n - 5, 5) == ".kite") { return p.substr(0, n - 5) } }
  return p + ".out"
}

fun printUsage(): Int {
  println("kitec - the Kite compiler (arm64 / Mach-O)")
  println("")
  println("usage: kitec [options] <input.kite>")
  println("")
  println("options:")
  println("  -o <file>      output path (default: the input with '.kite' stripped, in the cwd)")
  println("  check          type-check only, write no binary")
  println("  --no-check     skip the type-check pass")
  println("  --emit-funcs   print the lowered function/struct counts")
  println("  -O0 / -O1      disable / enable the peephole optimizer (default -O1)")
  println("  --version      print the compiler version")
  println("  -h, --help     show this help")
  return 0
}

// REAL CLI. macOS passes argc in x0 and argv (char**) in x1 to _main, so main receives them directly;
// __argv(argv, i) reads argv[i] as a String. Output defaults to the CURRENT DIRECTORY (no /tmp).
fun main(argc: Int, argv: USize): Int {
  var input = ""
  var output = ""
  var mode = 0
  var noGate = 0
  var opt = 1
  var emitFuncs = 0
  var i = 1
  while (i < argc) {
    val a = __argv(argv, i)
    var consumed = 0
    if (a == "-h") { return printUsage() }
    if (a == "--help") { return printUsage() }
    if (a == "--version") { println("kitec 0.1 - self-hosted Kite compiler (arm64/Mach-O)"); return 0 }
    if (a == "-o") { i = i + 1; if (i < argc) { output = __argv(argv, i) }; consumed = 1 }
    if (a == "check") { mode = 1; consumed = 1 }
    if (a == "--check") { mode = 1; consumed = 1 }
    if (a == "shadow") { mode = 2; consumed = 1 }
    if (a == "--no-check") { noGate = 1; consumed = 1 }
    if (a == "--emit-funcs") { emitFuncs = 1; consumed = 1 }
    if (a == "-O0") { opt = 0; consumed = 1 }
    if (a == "-O1") { opt = 1; consumed = 1 }
    // positionals: first = input, second = output (so `kitec in out` works like `kitec in -o out`)
    if (consumed == 0) { if (input == "") { input = a } else { output = a } }
    i = i + 1
  }
  if (input == "") { println("kitec: no input file (try --help)"); return 1 }
  if (mode == 1) { return checkOnly(input) }
  if (mode == 2) { return shadowScan(input) }
  if (output == "") { output = defaultOut(input) }
  val rc = compileFile(input, output, noGate, opt)
  if (rc == 0) { if (emitFuncs == 1) { println("wrote " + output) } }
  return rc
}
