// kite::core::char — the String-T1 char tier (§2c): UTF-8 encode/decode over the byte-oriented String,
// plus ASCII classification, as extension methods. `Char` is `Int` (a 32-bit Unicode scalar) in both tiers;
// the compiler's own `charAt`/`byteAt` stay byte-oriented, and these helpers are the explicit decode/encode
// bridge to scalars. Convention-by-name: the bodies are the mangled `Int_`/`String_`/`StrBuilder_` methods,
// so `lead.utf8SeqLen()` / `cp.charUtf8Len()` / `s.decodeUtf8At(i)` / `sb.encodeUtf8(cp)` / `s.utf8CharCount()`
// and `c.isDigit()` / `c.toUpper()` resolve here via UFCS on the receiver's type.
// Not in the default prelude (import kite::core::char to use them) — purely additive, zero self-host cost.
//
// The bodies call their siblings and the String queries through METHOD SUGAR (self.isUpper(), s.byteAt(i)):
// the surface member form is the only spelling (Phase M6). The mangled `Int_`/`String_` names are no longer
// valid surface identifiers, and the lowerer's module-aware resolver binds the receiver method across the
// namespace-import module boundary.

// Number of UTF-8 bytes in the sequence whose lead byte is `lead` (1..4; 1 for a continuation/invalid byte).
fun Int.utf8SeqLen(): Int {
  if (self < 128) { return 1 }
  if (self < 224) { return 2 }
  if (self < 240) { return 3 }
  return 4
}

// Bytes needed to UTF-8 encode the scalar `cp`.
fun Int.charUtf8Len(): Int {
  if (self < 128) { return 1 }
  if (self < 2048) { return 2 }
  if (self < 65536) { return 3 }
  return 4
}

// Decode the Unicode scalar starting at byte offset `i` of the byte-string `s`. The caller advances by
// `s.byteAt(i).utf8SeqLen()`. Continuation bytes contribute their low 6 bits (b - 128). Byte access goes
// through `byteAt` so this is representation-agnostic: T0 (`self` is the raw pointer) and T1 (`self` is the
// boxed {len,data} — byteAt loads `self.data`) both decode correctly.
fun String.decodeUtf8At(i: Int): Int {
  val b = self.byteAt(i)
  if (b < 128) { return b }
  if (b < 224) {
    return (b - 192) * 64 + (self.byteAt(i + 1) - 128)
  }
  if (b < 240) {
    return (b - 224) * 4096 + (self.byteAt(i + 1) - 128) * 64 + (self.byteAt(i + 2) - 128)
  }
  return (b - 240) * 262144 + (self.byteAt(i + 1) - 128) * 4096 + (self.byteAt(i + 2) - 128) * 64 + (self.byteAt(i + 3) - 128)
}

// Append the UTF-8 encoding of the scalar `cp` onto a StrBuilder; returns the builder so pushes chain.
// StrBuilder's pushByte is a struct method (global, NOT module-mangled), so it is reached via method sugar
// on the `sb` receiver — the one internal call kept as `sb.push*` since a struct method has no free name.
fun StrBuilder.encodeUtf8(cp: Int): StrBuilder {
  if (cp < 128) { self.pushByte(cp) }
  else { if (cp < 2048) {
      self.pushByte(192 + (cp / 64))
      self.pushByte(128 + (cp - (cp / 64) * 64))
    }
    else { if (cp < 65536) {
        self.pushByte(224 + (cp / 4096))
        self.pushByte(128 + ((cp / 64) - (cp / 4096) * 64))
        self.pushByte(128 + (cp - (cp / 64) * 64))
      }
      else {
        self.pushByte(240 + (cp / 262144))
        self.pushByte(128 + ((cp / 4096) - (cp / 262144) * 64))
        self.pushByte(128 + ((cp / 64) - (cp / 4096) * 64))
        self.pushByte(128 + (cp - (cp / 64) * 64))
      } } }
  return self
}

// Count the Unicode scalars in a UTF-8 byte-string (O(n), one step per lead byte).
fun String.utf8CharCount(): Int {
  val n = self.len()
  var i = 0
  var count = 0
  while (i < n) { i = i + self.byteAt(i).utf8SeqLen(); count = count + 1 }
  return count
}

// --- ASCII classification (the byte tier), as methods on the byte/scalar Int ---
fun Int.isDigit(): Bool { return self >= 48 && self <= 57 }

fun Int.isUpper(): Bool { return self >= 65 && self <= 90 }

fun Int.isLower(): Bool { return self >= 97 && self <= 122 }

fun Int.isAlpha(): Bool { return self.isUpper() || self.isLower() }

fun Int.isAlnum(): Bool { return self.isAlpha() || self.isDigit() }

fun Int.isSpace(): Bool { return self == 32 || self == 9 || self == 10 || self == 13 }

fun Int.toUpper(): Int { if (self.isLower()) { return self - 32 } return self }

fun Int.toLower(): Int { if (self.isUpper()) { return self + 32 } return self }
