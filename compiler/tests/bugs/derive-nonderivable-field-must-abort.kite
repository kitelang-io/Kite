// Phase 4 §2b well-formedness: @derive is rejected when a field type is not itself derivable for the
// trait. `Inner` has no Eq (no impl, no derive), so `@derive(Eq) struct Outer` cannot structurally
// compare it — without this check the synthesized `self.inner == other.inner` silently pointer-compares
// (returns FALSE for equal values). The lowerer must hard-abort with a diagnostic and write no binary.
struct Inner(val v: Int)

@derive(Eq) struct Outer(val inner: Inner, val n: Int)

fun main(): Int {
  val a = Outer(Inner(1), 2)
  val b = Outer(Inner(1), 2)
  if (a == b) { return 1 }
  return 0
}
