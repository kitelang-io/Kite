// compiler/sema/kcheck_main.kite — the standalone `kitec check` tool's entry point.
// kcheck.kite is a library (no main); this file provides main so the checker can be built and run on
// its own (the differential test compiles kfront.kite + kcheck.kite + this). It prints diagnostics in
// the same format the OCaml oracle `kitec check` uses (path prefix aside). Reads the source path from
// argv (like the real `kitec check`), so it is parallel-safe with no shared /tmp. This standalone tool is
// superseded by `kitec check` (klower's checkOnly) but kept as a minimal checker-only entry point.
fun main(argc: Int, argv: Int): Int {
  if (argc < 2) { println("usage: kcheck <file.kite>") ; return 1 }
  val diags = checkDiags(lex(readFile(__argv(argv, 1))), 0)
  if (diags.len() == 0) { println("ok (name resolution + type check passed)") ; return 0 }
  var i = 0
  while (i < diags.len()) { val m: String = diags.get(i) ; println(concat("error: ", m)) ; i = i + 1 }
  println(concat(intToStr(diags.len()), " semantic error(s)"))
  return diags.len()
}
