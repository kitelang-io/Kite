// `x is <whole enum type>` is NOT runtime-decidable — every enum value shares header type-id -1, and only
// the tag at [obj+0] distinguishes variants. The checker must reject `v is Opt` with a loud diagnostic and
// emit NO binary; the user must name a concrete variant (`is Som`) instead. (Smart-cast Phase 1.)

enum Opt { Non; Som(Int) }

fun main(): Int {
  val v = Som(1)
  if (v is Opt) { return 1 }
  return 0
}
