import "lib/alloc/vec.kite"
fun main(): Int {
  val v = Vec::<Int>(0, 0, RawBuf(0))
  v.push(10) v.push(20) v.push(30)
  var acc = 0
  if (v.len() == 3) { acc = acc + 1 }
  if (v.get(1) == 20) { acc = acc + 1 }
  if (v.getOr(9, 77) == 77) { acc = acc + 1 }
  if (v.contains(30)) { acc = acc + 1 }
  when (v.indexOf(20)) { Some(i) -> { if (i == 1) { acc = acc + 1 } }; None -> 0 }
  when (v.pop()) { Some(x) -> { if (x == 30) { acc = acc + 1 } }; None -> 0 }
  if (v.len() == 2) { acc = acc + 1 }
  when (v.first()) { Some(x) -> { if (x == 10) { acc = acc + 1 } }; None -> 0 }
  when (v.last()) { Some(x) -> { if (x == 20) { acc = acc + 1 } }; None -> 0 }
  v.clear()
  if (v.isEmpty()) { acc = acc + 1 }
  return acc
}
