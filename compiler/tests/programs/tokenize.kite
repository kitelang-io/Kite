// stage1/tokenize.kite — a REAL tokenizer for a subset of Kite source, WRITTEN IN
// KITE and compiled by Fledge (stage-0). Scans a String and recognizes:
//   INT  one or more digits
//   ID   letter/underscore then letters/digits/underscore
//   KW   the identifiers fun val var if else while return true false
//   OP   ( ) { } , ; . + - * / = == != < > <= >=   (2-char ops matched greedily)
// Skips spaces/newlines/tabs. Prints one line per token; returns the token count.
// Structure mirrors stage1/lex.kite and stage1/calcast.kite: a mutable cursor
// struct L(val src, var pos) threaded through helper functions.

struct L(val src: String, var pos: Int)

// current char at the cursor, or 0 at/after end of input.
fun cur(l: L): Int {
  if (l.pos >= l.src.len()) {
    return 0
  }
  return l.src.charAt(l.pos)
}

// the char one position ahead, or 0 if that would be at/after end.
fun nxt(l: L): Int {
  if (l.pos + 1 >= l.src.len()) {
    return 0
  }
  return l.src.charAt(l.pos + 1)
}

fun isDigit(c: Int): Bool {
  return c >= 48 && c <= 57
}

// letter (A-Z, a-z) or underscore — valid identifier start.
fun isIdStart(c: Int): Bool {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

// identifier continuation: letter, underscore, or digit.
fun isAlnum(c: Int): Bool {
  return isIdStart(c) || isDigit(c)
}

fun isSpace(c: Int): Bool {
  return c == 32 || c == 10 || c == 9 || c == 13
}

// true when [c][d] form one of the two-char operators == != <= >=.
// (== is 61 61; != is 33 61; <= is 60 61; >= is 62 61)
fun isTwoChar(c: Int, d: Int): Bool {
  return (c == 61 && d == 61) || (c == 33 && d == 61) || (c == 60 && d == 61) || (c == 62 && d == 61)
}

// keyword check on an already-extracted identifier lexeme.
fun isKeyword(s: String): Bool {
  return s == "fun" || s == "val" || s == "var" || s == "if" || s == "else" || s == "while" || s == "return" || s == "true" || s == "false"
}

// scan the whole source, print each token, return the token count.
fun tokenize(src: String): Int {
  val l = L(src, 0)
  val n = src.len()
  var count = 0
  while (l.pos < n) {
    val c = cur(l)
    if (isSpace(c)) {
      l.pos = l.pos + 1
    } else {
      if (isDigit(c)) {
        val start = l.pos
        while (isDigit(cur(l))) {
          l.pos = l.pos + 1
        }
        print("INT ")
        println(src.substr(start, l.pos - start))
        count = count + 1
      } else {
        if (isIdStart(c)) {
          val start = l.pos
          while (isAlnum(cur(l))) {
            l.pos = l.pos + 1
          }
          val lex: String = src.substr(start, l.pos - start)
          if (isKeyword(lex)) {
            print("KW ")
            println(lex)
          } else {
            print("ID ")
            println(lex)
          }
          count = count + 1
        } else {
          val start = l.pos
          var oplen = 1
          if (isTwoChar(c, nxt(l))) {
            oplen = 2
          }
          print("OP ")
          println(src.substr(start, oplen))
          l.pos = l.pos + oplen
          count = count + 1
        }
      }
    }
  }
  return count
}

fun main(): Int {
  println("--- test 1: fun add(a, b) { return a + b } ---")
  val c1 = tokenize("fun add(a, b) { return a + b }")
  println("--- test 2: if (x <= 10) { x = x == 2 } ---")
  val c2 = tokenize("if (x <= 10) { x = x == 2 }")
  print("count1=")
  println(c1.toStr())
  print("count2=")
  println(c2.toStr())
  return c1
}
