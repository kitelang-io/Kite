// Regression: a NON-FIRST `when` arm led by `is` or `in` must not glue onto the previous arm's body.
// Since b08d7bd made `is`/`in` first-class infix expression operators, the arm-body expression parser
// could greedily absorb a following `is Type` / `in coll` (`prevBody is Type`), gluing two arms together
// and leaking the remaining arms out of the `when`. A regressed glue-parse fails to compile (unresolved
// name) or miscomputes, so this program's fixed result (141) catches it.

fun classifyIn(x: Int): Int {
  val lo = [1, 2, 3]
  val hi = [7, 8, 9]
  return when (x) {
    0 -> 0
    in lo -> 10 // non-first `in` arm — must not glue onto `0`
    in hi -> 20 // another non-first `in` arm
    else -> 99
  }
}

fun classifyIs(x: Int): Int {
  return when (x) {
    -1 -> 5
    is Int -> 7 // non-first `is` arm — must not glue onto `5`
    else -> 9
  }
}

fun main(): Int {
  var acc = 0
  acc = acc + classifyIn(2) // 10
  acc = acc + classifyIn(8) // 20
  acc = acc + classifyIn(5) // 99
  acc = acc + classifyIs(3) // 7
  acc = acc + classifyIs(-1) // 5
  println(acc.toStr()) // 141
  return acc // 10 + 20 + 99 + 7 + 5 = 141
}
