// stage1/letcalc.kite — the token-list front-end (see toklist.kite) grown with
// VARIABLES and a symbol-table ENVIRONMENT — the machinery the real Kite
// evaluator and type checker both need. A program is a run of `val NAME = expr`
// bindings followed by a final expression:
//     val a = 2 + 3   val b = a * 4   a + b     ==> 25
// Lexed into a List<Tok>, then interpreted against an Env of parallel
// name/value lists. Compiled by Fledge and run natively.

// kinds: 0 int  1 +  2 -  3 *  4 /  5 (  6 )  7 EOF  8 ident  9 '='  10 'val'
struct Tok(val kind: Int, val ival: Int, val text: String)

fun isDigit(c: Int): Bool { return c >= 48 && c <= 57 }

fun isSpace(c: Int): Bool { return c == 32 }

fun isAlpha(c: Int): Bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) }

fun isIdent(c: Int): Bool { return isAlpha(c) || isDigit(c) }

// ---- lexer: String -> List<Tok> -------------------------------------------
fun lex(src: String): List {
  val toks = list()
  val n = src.len()
  var i = 0
  while (i < n) {
    val c = src.charAt(i)
    if (isSpace(c)) {
      i = i + 1
    } else {
      if (isDigit(c)) {
        var v = 0
        while (i < n && isDigit(src.charAt(i))) {
          v = v * 10 + (src.charAt(i) - 48)
          i = i + 1
        }
        toks.push(Tok(0, v, ""))
      } else {
        if (isAlpha(c)) {
          val start = i
          while (i < n && isIdent(src.charAt(i))) { i = i + 1 }
          val word = src.substr(start, i - start)
          if (word == "val") { toks.push(Tok(10, 0, "")) }
          else { toks.push(Tok(8, 0, word)) }
        } else {
          var k = 7
          if (c == 43) { k = 1 } else {
            if (c == 45) { k = 2 } else {
              if (c == 42) { k = 3 } else {
                if (c == 47) { k = 4 } else {
                  if (c == 40) { k = 5 } else {
                    if (c == 41) { k = 6 } else {
                      if (c == 61) { k = 9 } else { k = 7 } } } } } } }
          toks.push(Tok(k, 0, ""))
          i = i + 1
        }
      }
    }
  }
  toks.push(Tok(7, 0, ""))
  return toks
}

// ---- environment: parallel name / value lists -----------------------------
struct Env(val names: List, val vals: List)

fun define(env: Env, name: String, value: Int): Int {
  env.names.push(name)
  env.vals.push(value)
  return 0
}

// last binding wins (scan and remember the newest match)
fun lookup(env: Env, name: String): Int {
  var i = 0
  var found = 0
  while (i < env.names.len()) {
    val nm: String = env.names.get(i)
    if (nm == name) { found = env.vals.get(i) }
    i = i + 1
  }
  return found
}

// ---- cursor over the token list -------------------------------------------
struct P(val toks: List, var pos: Int, val env: Env)

fun peekKind(p: P): Int {
  if (p.pos >= p.toks.len()) { return 7 }
  val t: Tok = p.toks.get(p.pos)
  return t.kind
}

fun peekVal(p: P): Int {
  val t: Tok = p.toks.get(p.pos)
  return t.ival
}

fun peekText(p: P): String {
  val t: Tok = p.toks.get(p.pos)
  return t.text
}

fun advance(p: P): Int { p.pos = p.pos + 1; return 0 }

// ---- expression evaluator (evaluate as we parse), reads Env for idents -----
fun parseFactor(p: P): Int {
  val k = peekKind(p)
  if (k == 5) { // '(' expr ')'
    advance(p)
    val v = parseExpr(p)
    advance(p) // consume ')'
    return v
  }
  if (k == 8) { // identifier
    val name = peekText(p)
    advance(p)
    return lookup(p.env, name)
  }
  val v = peekVal(p) // number
  advance(p)
  return v
}

fun parseTerm(p: P): Int {
  var acc = parseFactor(p)
  var k = peekKind(p)
  while (k == 3 || k == 4) {
    advance(p)
    val rhs = parseFactor(p)
    if (k == 3) { acc = acc * rhs } else { acc = acc / rhs }
    k = peekKind(p)
  }
  return acc
}

fun parseExpr(p: P): Int {
  var acc = parseTerm(p)
  var k = peekKind(p)
  while (k == 1 || k == 2) {
    advance(p)
    val rhs = parseTerm(p)
    if (k == 1) { acc = acc + rhs } else { acc = acc - rhs }
    k = peekKind(p)
  }
  return acc
}

// ---- program: `val NAME = expr`* then a final expression ------------------
fun run(src: String): Int {
  val env = Env(list(), list())
  val p = P(lex(src), 0, env)
  while (peekKind(p) == 10) { // 'val'
    advance(p) // consume 'val'
    val name = peekText(p) // binding name
    advance(p) // consume identifier
    advance(p) // consume '='
    val v = parseExpr(p) // value (stops at next 'val' or EOF)
    define(env, name, v)
  }
  return parseExpr(p) // trailing expression
}

fun main(): Int {
  println(run("val a = 2 + 3   val b = a * 4   a + b").toStr()) // 25
  println(run("val x = 10   val y = x * x   val z = y - x   z / 3").toStr()) // 30
  println(run("val a = 4   val b = a   val a = 9   a + b").toStr()) // 13 (last a wins)
  return run("val a = 2 + 3   val b = (a + 1) * 4   val c = b - a   a + b + c") // 5+24+19=48
}
