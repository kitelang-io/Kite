fun map1<A, B>(xs: IntBuf, f: (A) -> B): IntBuf {
  val out = intBuf()
  for (x in xs) { out.push(f(x)) }
  return out
}

fun main(): Int {
  // map1 takes the erased IntBuf (the `[..]` literal is now a first-class Vec<T>), so build one explicitly.
  val xs = intBuf()
  xs.push(1) xs.push(2) xs.push(3) xs.push(4)
  val ys = map1(xs, { n -> n * n })
  return ys.get(0) + ys.get(3)
}
