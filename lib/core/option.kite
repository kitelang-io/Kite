// kite::core::option — Option/Result (global enums) + helpers. No allocation, no OS.
enum Option { Some(v); None }

enum Result { Ok(v); Err(e) }

fun isSome(o: Option): Bool { return when (o) { Some(v) -> true; None -> false } }

fun isNone(o: Option): Bool { return when (o) { Some(v) -> false; None -> true } }

fun optGetOr(o: Option, dflt: Int): Int { return when (o) { Some(v) -> v; None -> dflt } }
