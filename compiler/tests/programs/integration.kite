struct Acc(var total: Int, var count: Int)

fun record(acc: Acc, v: Int): Int { acc.total = acc.total + v acc.count = acc.count + 1 return 0 }

fun mean(acc: Acc): Int { if (acc.count == 0) { return 0 } return acc.total / acc.count }

fun each(xs: IntBuf, f: (Int) -> Int): Int { for (v in xs) { f(v) } return 0 }

fun main(): Int {
  val a = Acc(0, 0)
  // `each` takes the erased IntBuf (the `[..]` literal is now a first-class Vec<T>), so build one explicitly.
  val xs = intBuf()
  xs.push(10) xs.push(20) xs.push(30) xs.push(40)
  each(xs, { v -> record(a, v) })
  return a.mean()
}
