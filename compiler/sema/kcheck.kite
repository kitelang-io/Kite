// compiler/sema/kcheck.kite — M2 semantic checks (name resolution + type check) in Kite, ported from
// lib/resolve.ml + lib/typecheck.ml. Operates on kfront's surface AST (F-prefixed nodes).
// Build: assembled into compiler/kitec.kite (a quoted-include LIBRARY, no main). The `kitec check` verb
// (klower's checkOnly) drives it; checkDiags is the reusable entry, returning the diagnostics list
// (empty = clean). Diagnostics render as "error: <msg>" per diag, then "<N> semantic error(s)".

// ---- top-level declaration wrapper (so we can iterate the program twice) ----
enum Decl { DFun(FFunc); DType(Int, FTDecl); DEnum(FEDecl); DTrait(FTraitDecl); DImpl(FImplDecl); DImport(String); DConst(String) }

// Parse the whole program, returning the decl list AND (index-aligned, via the `lines` out-param) the
// 1-based source line where each decl begins — captured from the first token of the decl (its leading
// annotation, if any). Diagnostics are later attributed to their enclosing decl's line.
fun parseProgramLn(toks: IntBuf, lines: IntBuf): IntBuf {
  // Seed the infix-name set with the prelude's declared infix funs (e.g. `to`) so `a to b` in user code
  // parses as an infix call even though `to` is declared in an auto-injected prelude module (not in `toks`).
  val p = mkPSeed(toks, preludeInfixNames())
  val decls = intBuf()
  var go = 1
  while (go == 1) {
    if (pk(p) == 0) { go = 0 }
    else {
      val dl = pline(p)
      val annos = parseAnnos(p)
      // A top-level decl may carry a `pub` visibility prefix (mirrors the full parsers: annos -> pub ->
      // decl). Consume it so a `pub`-prefixed decl still parses; without this the loop hit the `else` and
      // STOPPED at the first `pub import` of a concatenated namespace-module source — desyncing the whole
      // check pass so the ROOT module's decls (appended last) were never parsed or member-checked.
      if (pk(p) == 56) { eat(p) }
      val k = pk(p)
      val n0 = decls.len()
      if (k == 10 || k == 88) { decls.push(DFun(parseFunc(p, annos))) }
      else { if (k == 54) { decls.push(DType(0, parseTypeDecl(p, annos, 0))) }
        else { if (k == 65) { decls.push(DType(1, parseTypeDecl(p, annos, 1))) }
          else { if (k == 55) { decls.push(DEnum(parseEnum(p, annos))) }
            else { if (k == 66) { decls.push(DTrait(parseTrait(p, annos))) }
              else { if (k == 67) { decls.push(DImpl(parseImpl(p, annos))) }
                else { if (k == 58) { decls.push(DImport(parseImport(p))) }
                  // A top-level `const val NAME = ...` binds a resolvable global VALUE name — record it as
                  // DConst so references resolve (without it, parsing the whole program now reaches the
                  // referencing code and would false-flag `NAME` as unresolved). `use` carries no checker
                  // Decl variant; parse+discard it so the loop stays token-synced rather than bailing.
                  else { if (k == 80) { decls.push(DConst(parseConst(p).name)) }
                    // `use mod::name [as Alias]` introduces a bare name in the importing scope (the alias,
                    // or `name`). For a FREE-FN import the bare name usually already exists as a global, but
                    // for a TYPE rename (`use moda::Foo as AFoo`) the alias names NO existing global — record
                    // it as a resolvable value name (DConst) so `AFoo(..)` / `g()` resolve. Type-annotation
                    // strings (`val a: AFoo`) are not hard-validated by the checker, so the alias needs no
                    // type-table entry. Recording it keeps the loop token-synced either way.
                    else { if (k == 81) { decls.push(DConst(parseUse(p).alias)) }
                      else { go = 0 } } } } } } } } }
      if (decls.len() > n0) { lines.push(dl) }
    }
  }
  return decls
}

// line N: prefix for diagnostics (N is the 1-based source line of the offending construct's decl).
fun linePrefix(n: Int): String { return "line " + (n.toStr() + ": ") }

// ---- small helpers ----
fun memList(l: IntBuf, n: String): Bool {
  var i = 0
  while (i < l.len()) { val x: String = l.get(i); if (x == n) { return true }; i = i + 1 }
  return false
}

// A "builtin" for name resolution is EXACTLY an intrinsic — a name with no Kite body. isIntrinsic()
// (klower.kite) is the single source of truth, shared with the lowerer, so the two can never diverge.
// Prelude names (concat, list, strLen, Some/None via imports, ...) are no longer whitelisted here: 0a
// seeds them into the global scope from preludeSigs(), so they resolve because they are DEFINED. The
// implicit lambda parameter `it` is bound in rLambda, not whitelisted.
fun isBuiltin(n: String): Bool {
  return isIntrinsic(n)
}

// lambda param string "x: Int, y" -> ["x","y"]; "" -> []
fun splitLamParams(s: String): IntBuf {
  val out = intBuf()
  if (s == "") { return out }
  val n = s.len()
  var i = 0
  var start = 0
  while (i <= n) {
    if (i == n || (s.charAt(i) == 44)) { // ',' or end
      var e = start
      while (e < i && s.charAt(e) == 32) { e = e + 1 } // skip leading space
      var stop = e
      while (stop < i && s.charAt(stop) != 58) { stop = stop + 1 } // up to ':'
      out.push(s.substr(e, stop - e))
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// when-subject bind string "val y = " -> "y"  ("" -> "")
fun whenBindName(b: String): String {
  if (b == "") { return "" }
  return b.substr(4, b.len() - 4 - 3)
}

// ================= RESOLVE PASS =================
// mtab/shadow/shadowOn (Phase M2): the member table + a SEPARATE shadow-diagnostic sink, threaded through
// the resolver so rExpr can resolve the SELECTOR of a dot/`::` access (M1 built the parallel table and a
// prototype selector check in the type-check pass; M2 moves selector resolution into the RESOLVER — the
// pass that owns name-resolution diagnostics and where M3 will flip these to fatal). shadowOn==0 (the
// normal check/compile path) makes every rShadow* hook a NO-OP: the table is never consulted and the real
// resolve diagnostics are byte-identical to before. shadowOn==1 (the `kitec shadow` harness) consults the
// table at every selector site and logs would-be no-member diagnostics into `shadow`, NEVER into `diags`.
// nsMerged==1 when checking a MERGED namespace-module source (concatModuleSrcs): there, the base of a `::`
// may be a namespace-import MODULE alias (`a::helper`) that is not a recorded global — so a bare-identifier
// `::` base is NOT value-resolved (it would false-flag as unresolved). nsMerged==0 (the flat / no-import
// path) keeps the original behavior: a `::` base IS resolved, so an undefined type qualifier still errors.
struct RCtx(val globals: IntBuf, var scopes: IntBuf, val diags: IntBuf, var curLine: Int, val mtab: CMTab, val shadow: IntBuf, var shadowOn: Int, val nsMerged: Int)

fun rErr(ctx: RCtx, msg: String): Int { ctx.diags.push(linePrefix(ctx.curLine) + msg); return 0 }

// does ANY recorded member/free-fn/trait-method carry selector `sel`? The resolver, unlike the type-check
// pass, has no receiver TYPE at a dot access (it binds names, not their types), so `a.sel` is resolved at
// the NAME level: `sel` must exist SOMEWHERE as an instance field/getter/setter/instance-method, a UFCS
// free function, or a trait method (all recorded flat in mt.sel). This is the widest whitelist the
// resolver can vouch for without types; a selector that appears nowhere is a definite no-member.
fun cmSelExists(mt: CMTab, sel: String): Bool {
  var i = 0
  while (i < mt.sel.len()) { if (mt.sel.get(i) == sel) { return true }; i = i + 1 }
  return false
}

// SHADOW resolution of a DOT selector `a.sel` / `a?.sel` (Phase M2, resolver side). No receiver type here,
// so this is the name-level check (cmSelExists) — a getter/setter mangle exposes the bare property name in
// the table (M1 cmFreeFun), so property access resolves too. Purely additive: only under shadowOn, only
// writes env.shadow, never a real diagnostic.
fun rShadowField(ctx: RCtx, sel: String): Int {
  if (ctx.shadowOn == 0) { return 0 }
  if (cmSelExists(ctx.mtab, sel)) { return 0 }
  ctx.shadow.push(linePrefix(ctx.curLine) + ("no member `" + (sel + "`")))
  return 0
}

// SHADOW resolution of a `Base::sel` selector (Phase M2, resolver side). When Base is a bare identifier
// naming a KNOWN nominal type, this is TYPE-DIRECTED: `sel` must be an associated member of that type — an
// associated const/fn/static, an enum variant, a field, or (UFCS / by-name trait dispatch) a free fn or
// trait method of the same name. A Base that is NOT a known type (a namespace-import MODULE alias, a
// value, a type parameter) is skipped — the table records no module exports, so we never vouch against it.
fun rShadowStatic(ctx: RCtx, base: FExpr, sel: String): Int {
  if (ctx.shadowOn == 0) { return 0 }
  val b = when (base) { FEIdent(n) -> n; else -> "" }
  if (b == "") { return 0 }
  if (isTypeParam(b)) { return 0 }
  val tn = cmCanon(ctx.mtab, b)
  if (cmIsType(ctx.mtab, tn) == false) { return 0 }
  if (cmHasMember(ctx.mtab, tn, sel)) { return 0 }
  if (cmHasFree(ctx.mtab, sel)) { return 0 }
  if (cmHasTraitMethod(ctx.mtab, sel)) { return 0 }
  ctx.shadow.push(linePrefix(ctx.curLine) + ("no member `" + (sel + ("` on type " + tn))))
  return 0
}

fun rBound(ctx: RCtx, n: String): Bool {
  var i = 0
  while (i < ctx.scopes.len()) { val sc: IntBuf = ctx.scopes.get(i); if (memList(sc, n)) { return true }; i = i + 1 }
  if (memList(ctx.globals, n)) { return true }
  return isBuiltin(n)
}

fun rBind(ctx: RCtx, n: String): Int {
  val top: IntBuf = ctx.scopes.get(ctx.scopes.len() - 1)
  top.push(n)
  return 0
}

fun rPush(ctx: RCtx): IntBuf { // returns saved scopes for restore
  val saved = ctx.scopes
  val ns = intBuf()
  var i = 0
  while (i < saved.len()) { ns.push(saved.get(i)); i = i + 1 }
  ns.push(intBuf())
  ctx.scopes = ns
  return saved
}

fun rPop(ctx: RCtx, saved: IntBuf): Int { ctx.scopes = saved; return 0 }

// The base of a `::` is a QUALIFIER — a type / enum name, or (under a namespace import) a MODULE alias.
// On the MERGED namespace-module path a bare-identifier base may be a module alias (`a` in `a::helper()`)
// that is not a recorded global, so it is NOT value-resolved there (it would false-flag as unresolved).
// On the flat / no-import path there are no module aliases, so the base IS resolved — an undefined type
// qualifier (`Kind::Digit` with no `Kind`) still reports "unresolved name". Type/member validity is owned
// by the member-table typecheck pass (inferStatic / requireMember); a non-identifier base still resolves.
fun rStaticBase(ctx: RCtx, a: FExpr): Int {
  if (ctx.nsMerged == 0) { return rExpr(ctx, a) }
  return when (a) { FEIdent(n) -> 0; else -> rExpr(ctx, a) }
}

fun rExpr(ctx: RCtx, e: FExpr): Int {
  return when (e) {
    FEIdent(s) -> { if (rBound(ctx, s) == false) { rErr(ctx, "unresolved name: " + s) } 0 }
    FEUnary(op, a) -> rExpr(ctx, a)
    FENotNull(a) -> rExpr(ctx, a)
    FEField(a, f) -> { rExpr(ctx, a); rShadowField(ctx, f) }
    FESafeField(a, f) -> { rExpr(ctx, a); rShadowField(ctx, f) }
    FEStatic(a, f) -> { rStaticBase(ctx, a); rShadowStatic(ctx, a, f) }
    FETypeApp(a, t) -> rExpr(ctx, a)
    FECast(a, ty) -> rExpr(ctx, a)
    FEQuestion(a) -> rExpr(ctx, a)
    FEBin(op, a, b) -> { rExpr(ctx, a); rExpr(ctx, b) }
    FEElvis(a, b) -> { rExpr(ctx, a); rExpr(ctx, b) }
    FEIndex(a, b) -> { rExpr(ctx, a); rExpr(ctx, b) }
    FECall(f, args) -> { rExpr(ctx, f); rArgs(ctx, args) }
    FEList(es) -> rExprList(ctx, es)
    FEMap(ents) -> rMap(ctx, ents)
    FEInterp(parts, r) -> rInterp(ctx, parts)
    FERet(x) -> rExpr(ctx, x)
    FEIf(c, t, el) -> { rExpr(ctx, c); rExpr(ctx, t); rExpr(ctx, el) }
    FELambda(params, body) -> rLambda(ctx, params, body)
    FEBlock(stmts, res) -> rBlock(ctx, stmts, res)
    FEWhen(hasSubj, bind, subj, arms) -> rWhen(ctx, hasSubj, bind, subj, arms)
    else -> 0
  }
}

fun rArgs(ctx: RCtx, args: IntBuf): Int {
  var i = 0
  while (i < args.len()) { val a: FArg = args.get(i); rExpr(ctx, a.expr); i = i + 1 }
  return 0
}

fun rExprList(ctx: RCtx, es: IntBuf): Int {
  var i = 0
  while (i < es.len()) { val x: FExpr = es.get(i); rExpr(ctx, x); i = i + 1 }
  return 0
}

fun rMap(ctx: RCtx, ents: IntBuf): Int {
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); rExpr(ctx, en.k); rExpr(ctx, en.v); i = i + 1 }
  return 0
}

fun rInterp(ctx: RCtx, parts: IntBuf): Int {
  var i = 0
  while (i < parts.len()) {
    val pt: FIPart = parts.get(i)
    when (pt) { FIExpr(e) -> rExpr(ctx, e); else -> 0 }
    i = i + 1
  }
  return 0
}

fun rLambda(ctx: RCtx, params: String, body: FExpr): Int {
  val saved = rPush(ctx)
  val names = splitLamParams(params)
  // A lambda with no explicit parameters implicitly binds the single parameter `it` (kfront leaves
  // params="" for both `{ it }` and `{ -> ... }`; binding an unused `it` for the latter is harmless).
  if (params == "") { rBind(ctx, "it") }
  var i = 0
  while (i < names.len()) { val nm: String = names.get(i); rBind(ctx, nm); i = i + 1 }
  rExpr(ctx, body)
  rPop(ctx, saved)
  return 0
}

fun rBlock(ctx: RCtx, stmts: IntBuf, res: FExpr): Int {
  val saved = rPush(ctx)
  var i = 0
  while (i < stmts.len()) { val s: FStmt = stmts.get(i); rStmt(ctx, s); i = i + 1 }
  if (isNoResF(res) == false) { rExpr(ctx, res) }
  rPop(ctx, saved)
  return 0
}

fun rStmt(ctx: RCtx, s: FStmt): Int {
  return when (s) {
    FSLet(isVar, name, ty, init) -> { rExpr(ctx, init); rBind(ctx, name) }
    FSExprS(e) -> rExpr(ctx, e)
    FSAssign(l, r) -> { rExpr(ctx, l); rExpr(ctx, r) }
    FSReturnV(e) -> rExpr(ctx, e)
    FSReturnU -> 0
    FSWhile(c, b) -> { rExpr(ctx, c); rExpr(ctx, b) }
    FSFor(v, it, b) -> rFor(ctx, v, it, b)
    else -> 0
  }
}

fun rFor(ctx: RCtx, v: String, it: FExpr, b: FExpr): Int {
  rExpr(ctx, it)
  val saved = rPush(ctx)
  rBind(ctx, v)
  rExpr(ctx, b)
  rPop(ctx, saved)
  return 0
}

fun rPat(ctx: RCtx, pat: FPat): Int {
  return when (pat) {
    FPBind(s) -> rBind(ctx, s)
    FPInP(e, neg) -> rExpr(ctx, e)
    FPCtor(pth, subs) -> rPatList(ctx, subs)
    FPRecord(pth, flds, hasRest) -> rRecordPat(ctx, flds)
    else -> 0
  }
}

fun rPatList(ctx: RCtx, subs: IntBuf): Int {
  var i = 0
  while (i < subs.len()) { val sp: FPat = subs.get(i); rPat(ctx, sp); i = i + 1 }
  return 0
}

fun rRecordPat(ctx: RCtx, flds: IntBuf): Int {
  var i = 0
  while (i < flds.len()) {
    val f: FRFld = flds.get(i)
    if (f.hasPat == 1) { rPat(ctx, f.pat) } else { rBind(ctx, f.name) }
    i = i + 1
  }
  return 0
}

fun rWhen(ctx: RCtx, hasSubj: Int, bind: String, subj: FExpr, arms: IntBuf): Int {
  if (hasSubj == 1) { rExpr(ctx, subj) }
  val bn = whenBindName(bind)
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    val saved = rPush(ctx)
    if (hasSubj == 1 && bn != "") { rBind(ctx, bn) }
    if (a.kind == 0) { rExpr(ctx, a.lhs) }
    else { if (a.kind == 2) { var j = 0; while (j < a.pats.len()) { val pp: FPat = a.pats.get(j); rPat(ctx, pp); j = j + 1 } } }
    if (isNoResF(a.guard) == false) { rExpr(ctx, a.guard) }
    rExpr(ctx, a.body)
    rPop(ctx, saved)
    i = i + 1
  }
  return 0
}

fun rFun(ctx: RCtx, fd: FFunc): Int {
  if (isNoResF(fd.body)) { return 0 } // signature-only (trait) — nothing to resolve
  val saved = rPush(ctx)
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); rBind(ctx, pp.name); i = i + 1 }
  rExpr(ctx, fd.body)
  rPop(ctx, saved)
  return 0
}

fun rMethods(ctx: RCtx, methods: IntBuf): Int {
  var i = 0
  while (i < methods.len()) { val m: FFunc = methods.get(i); rFun(ctx, m); i = i + 1 }
  return 0
}

fun rDecl(ctx: RCtx, d: Decl): Int {
  return when (d) {
    DFun(fd) -> rFun(ctx, fd)
    DType(kind, td) -> { if (isNoResF(td.dtor) == false) { val sv = rPush(ctx); rExpr(ctx, td.dtor); rPop(ctx, sv) } rMethods(ctx, td.methods) }
    DEnum(ed) -> rMethods(ctx, ed.methods)
    DTrait(tr) -> rMethods(ctx, tr.methods)
    DImpl(im) -> rMethods(ctx, im.methods)
    else -> 0
  }
}

// collect globals + flag duplicate top-level definitions
// skipDup=1 suppresses duplicate-definition errors: used when checking a MERGED multi-module source
// (namespace imports), where two modules legitimately share a name (the module system mangles them).
fun collectGlobals(decls: IntBuf, lines: IntBuf, globals: IntBuf, diags: IntBuf, skipDup: Int): Int {
  val seen = intBuf()
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    val ln = lines.get(i)
    when (d) {
      DFun(fd) -> defineGKey(seen, globals, diags, cmFunSigKey(fd), fd.name, ln, skipDup)
      DType(kind, td) -> defineG(seen, globals, diags, td.name, ln, skipDup)
      DEnum(ed) -> { defineG(seen, globals, diags, ed.name, ln, skipDup); addVariants(globals, ed.variants) }
      DTrait(tr) -> defineG(seen, globals, diags, tr.name, ln, skipDup)
      DConst(nm) -> defineG(seen, globals, diags, nm, ln, skipDup)
      else -> 0
    }
    i = i + 1
  }
  return 0
}

fun defineG(seen: IntBuf, globals: IntBuf, diags: IntBuf, n: String, ln: Int, skipDup: Int): Int {
  if (skipDup == 0) { if (memList(seen, n)) { diags.push(linePrefix(ln) + ("duplicate top-level definition: " + n)) } }
  seen.push(n); globals.push(n)
  return 0
}

// duplicate detection keyed on a SIGNATURE key (M5 overloading): two free functions with the same name but
// DIFFERENT parameter signatures are allowed (an overload set); the SAME signature twice is the duplicate
// error. `gName` (the bare name) is what enters the resolvable global scope.
fun defineGKey(seen: IntBuf, globals: IntBuf, diags: IntBuf, dupKey: String, gName: String, ln: Int, skipDup: Int): Int {
  if (skipDup == 0) { if (memList(seen, dupKey)) { diags.push(linePrefix(ln) + ("duplicate top-level definition: " + gName)) } }
  seen.push(dupKey); globals.push(gName)
  return 0
}

// a free function's SIGNATURE key: `<name>#<arity>#<t1>#<t2>...`, coarse base-name tags. Same-name /
// different-signature functions produce distinct keys (overloading); an identical redeclaration collides.
fun cmFunSigKey(fd: FFunc): String {
  var s = fd.name + ("#" + fd.params.len().toStr())
  var i = 0
  while (i < fd.params.len()) { val p: FParam = fd.params.get(i); s = s + ("#" + cmBaseName(cmStripMode(p.ty))); i = i + 1 }
  return s
}

fun addVariants(globals: IntBuf, variants: IntBuf): Int {
  var i = 0
  while (i < variants.len()) { val v: FVariant = variants.get(i); globals.push(v.name); i = i + 1 }
  return 0
}

// Collect the top-level global names (functions, types, enums+variants, traits) a parsed program
// declares, WITHOUT dup-checking or diagnostics. Used to harvest the prelude's public names so the
// checker can treat them as DEFINED, not merely whitelisted.
fun collectDeclNames(decls: IntBuf, out: IntBuf): Int {
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    when (d) {
      DFun(fd) -> out.push(fd.name)
      DType(kind, td) -> out.push(td.name)
      DEnum(ed) -> { out.push(ed.name); addVariants(out, ed.variants) }
      DTrait(tr) -> out.push(tr.name)
      DConst(nm) -> out.push(nm)
      else -> 0
    }
    i = i + 1
  }
  return 0
}

// preludeSigs: parse the implicit-prelude modules ONCE and return their top-level names. The module list
// comes from preludeConfPaths() — the SAME source of truth the lowerer (injectHelpers) reads — so the
// checker and the lowerer can never disagree about what the prelude provides. Seeding the global scope
// with these makes prelude names (concat, list, strLen, ...) resolve because they are DEFINED, not
// whitelisted; this is what lets isBuiltin shrink to the intrinsic floor.
// The prelude's top-level declarations, parsed ONCE from the same module list preludeSigs/injectHelpers
// read. Returned so BOTH the resolver (names only) and the type-checker (full param/return signatures)
// can seed themselves from one source of truth.
fun preludeDeclList(): IntBuf {
  val out = intBuf()
  val paths = preludeConfPaths()
  var pi = 0
  while (pi < paths.len()) {
    val src = readFile(paths.get(pi))
    if (src.len() > 0) {
      val plines = intBuf()
      val decls = parseProgramLn(lex(src), plines)
      var di = 0
      while (di < decls.len()) { out.push(decls.get(di)); di = di + 1 }
    }
    pi = pi + 1
  }
  return out
}

fun preludeSigs(): IntBuf {
  val out = intBuf()
  collectDeclNames(preludeDeclList(), out)
  return out
}

fun resolveCheck(decls: IntBuf, lines: IntBuf, skipDup: Int): IntBuf {
  val diags = intBuf()
  val globals = intBuf()
  val pre = preludeSigs()
  var pj = 0
  while (pj < pre.len()) { globals.push(pre.get(pj)); pj = pj + 1 }
  collectGlobals(decls, lines, globals, diags, skipDup)
  val scopes = intBuf()
  // shadowOn=0: the member table is empty and every rShadow* hook is inert — the real resolve diagnostics
  // are byte-identical to before (M2 is SHADOW-only, no output regression on the check/compile path).
  val ctx = RCtx(globals, scopes, diags, 0, cmNew(), intBuf(), 0, skipDup)
  var i = 0
  while (i < decls.len()) { val d: Decl = decls.get(i); ctx.curLine = lines.get(i); rDecl(ctx, d); i = i + 1 }
  return diags
}

// SHADOW pass (Phase M2): run the RESOLVER traversal with the member table ON, collecting would-be
// no-member diagnostics (selectors that fail resolution against the table) into a SEPARATE shadow list.
// The real resolve diagnostics are computed by the same traversal but DISCARDED here — this entry exists
// only to harvest the shadow log, never to gate a build. Invoked only by the `kitec shadow` harness.
fun resolveShadow(decls: IntBuf, lines: IntBuf): IntBuf {
  val shadow = intBuf()
  val globals = intBuf()
  val pre = preludeSigs()
  var pj = 0
  while (pj < pre.len()) { globals.push(pre.get(pj)); pj = pj + 1 }
  collectGlobals(decls, lines, globals, intBuf(), 1)
  val scopes = intBuf()
  val mtab = buildCMTab(preludeDeclList(), decls)
  val ctx = RCtx(globals, scopes, intBuf(), 0, mtab, shadow, 1, 1)
  var i = 0
  while (i < decls.len()) { val d: Decl = decls.get(i); ctx.curLine = lines.get(i); rDecl(ctx, d); i = i + 1 }
  return shadow
}

// ================= TYPE CHECK PASS =================
enum Ty { TPrim(String); TNamed(String, IntBuf); TNull(Ty); TFun(IntBuf, Ty); TUnknown }

// ===== primitive-type REGISTRY (STDLIB-REDESIGN §2a numeric tower + scalars) =====
// The primitive tower is DECLARED IN lib/ (lib/core/num.kite), NOT hardcoded here. Each scalar carries
// a `@prim("<kind>", <bits>)` marker; `buildPReg` collects them during the prelude pass (exactly like
// @lang/@arc) into a `PReg` table, threaded through the checker as `reg`. `primKind`/`primBits`/… READ
// that table instead of a baked strEq switch, so the compiler SOURCES its numeric classification from
// the library. Kind codes:
//   0 none · 1 signed-int · 2 unsigned-int · 3 float · 4 bool · 5 char · 6 string
//   7 unit · 8 never (bottom) · 9 reserved (I128/U128, not yet implemented)
// A2: registers are always 64-bit words — width lives in the TYPE, not the runtime rep (Phase 1).
//
// ALIASING (Phase A): an explicit-width name (I8/I16/I32/I64, U8/U16/U32/U64, F32/F64, Never) carries a
// lib-declared `@alias("<Primary>")` marker; `aliasFrom`/`aliasTo` record that map so `canonPrim` folds
// an alias to its PRIMARY name. Compat then compares CANONICAL names (Long ≠ Int even at the same width;
// I64 == Long; I32 == Int) — sourced from lib/core/num.kite, not a hardcoded switch.
struct PReg(val names: IntBuf, val kinds: IntBuf, val bits: IntBuf, val aliasFrom: IntBuf, val aliasTo: IntBuf)

// map a @prim kind string to the checker's kind code (the table's canonical classification).
fun primKindCode(s: String): Int {
  if (s == "sint") { return 1 }
  if (s == "uint") { return 2 }
  if (s == "float") { return 3 }
  if (s == "bool") { return 4 }
  if (s == "char") { return 5 }
  if (s == "string") { return 6 }
  if (s == "unit") { return 7 }
  if (s == "never") { return 8 }
  if (s == "reserved") { return 9 }
  return 0
}

fun primAnnoStr(e: FExpr): String { return when (e) { FEStr(t, r) -> t; else -> "" } }

fun primAnnoInt(e: FExpr): Int { return when (e) { FEInt(t) -> parseIntK(t); else -> 0 } }

// record a decl's `@prim("<kind>", <bits>)` marker (name -> kind code + storage bits) into the registry.
fun recordPrim(annos: IntBuf, name: String, reg: PReg): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "prim" && a.args.len() >= 2) {
      reg.names.push(name)
      reg.kinds.push(primKindCode(primAnnoStr(a.args.get(0))))
      reg.bits.push(primAnnoInt(a.args.get(1)))
    }
    i = i + 1
  }
  return 0
}

// record a decl's `@alias("<Primary>")` marker (alias name -> primary name) into the registry.
fun recordAlias(annos: IntBuf, name: String, reg: PReg): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "alias" && a.args.len() >= 1) {
      reg.aliasFrom.push(name)
      reg.aliasTo.push(primAnnoStr(a.args.get(0)))
    }
    i = i + 1
  }
  return 0
}

// build the primitive registry from the prelude decl list: every @prim-marked declaration contributes
// one (name, kind, bits) row; every @alias-marked one contributes an (alias -> primary) row. lib/core/
// num.kite carries the whole tower + alias map, so this replaces the old hardcoded switch.
fun buildPReg(decls: IntBuf): PReg {
  val reg = PReg(intBuf(), intBuf(), intBuf(), intBuf(), intBuf())
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    when (d) {
      DFun(fd) -> { recordPrim(fd.annos, fd.name, reg); recordAlias(fd.annos, fd.name, reg) }
      DType(kind, td) -> { recordPrim(td.annos, td.name, reg); recordAlias(td.annos, td.name, reg) }
      else -> 0
    }
    i = i + 1
  }
  return reg
}

// ================= MEMBER TABLE (Phase M1: checker-side, SHADOW-only) =================
// The lowerer already builds a per-type MEMBER TABLE at its single collection point (klower.kite,
// struct MTab on Lo, Phase M0). The checker is a SEPARATE pass over its own F-prefixed decl list, so it
// carries its OWN parallel table here — same whitelist rules, rebuilt from the same prelude+user decls —
// so kcheck stays a standalone library (kfront + kcheck) with no dependency on klower's tables.
//
// One entry per member with an explicit owning-type back-link. In M1 NOTHING fatal consults it: the
// shadow-resolution pass (shadowMember) only READS it to decide whether a selector WOULD be a no-member
// diagnostic, and logs the misses to a SEPARATE shadow list — the real diagnostics are untouched.
//   types       : every nominal type name seen (struct/class/enum/trait/@prim), for prefix attribution.
//   aliasFrom/To: @alias views (I8 -> Byte, Never -> Nothing): one canonical primary + alias views.
//   owner       : owning type name of the member ("" = a true free/global function or top-level const).
//   sel         : the SELECTOR — the surface name used after `.`/`::` (field/method/variant/const name).
//   kind        : "field" | "method" | "assocfn" | "traitmethod" | "variant" | "freefn" | "const".
struct CMTab(val types: IntBuf, val aliasFrom: IntBuf, val aliasTo: IntBuf, val owner: IntBuf, val sel: IntBuf, val kind: IntBuf)

fun cmNew(): CMTab { return CMTab(intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf()) }

fun cmType(mt: CMTab, name: String): Int { if (memList(mt.types, name) == false) { mt.types.push(name) }; return 0 }

// Members are recorded under the owner's CANONICAL name so a method declared on a width alias (fun
// U8.inc) is found through the primary (a `UByte`-typed receiver), and vice versa — matching how the
// compiler's own UFCS dispatch canonicalizes the receiver-type name (see alias-method-dispatch). A
// struct/enum/trait owner is not in the alias table, so cmCanon is the identity for it. Called only in
// pass 2 (members), by which point pass 1 has recorded the full @alias table.
fun cmAdd(mt: CMTab, owner: String, sel: String, kind: String): Int {
  mt.owner.push(cmCanon(mt, owner)); mt.sel.push(sel); mt.kind.push(kind)
  return 0
}

fun cmIsType(mt: CMTab, n: String): Bool { return memList(mt.types, n) }

// fold an alias to its PRIMARY (I8 -> Byte, ...); a name with no @alias row is returned unchanged.
fun cmCanon(mt: CMTab, n: String): String {
  var i = 0
  while (i < mt.aliasFrom.len()) { if (mt.aliasFrom.get(i) == n) { return mt.aliasTo.get(i) }; i = i + 1 }
  return n
}

// does type `owner` (already canonicalized) carry a member named `sel`? Scans fields/methods/assocfns/
// variants/consts attributed to that owner.
fun cmHasMember(mt: CMTab, owner: String, sel: String): Bool {
  var i = 0
  while (i < mt.owner.len()) { if (mt.owner.get(i) == owner) { if (mt.sel.get(i) == sel) { return true } }; i = i + 1 }
  return false
}

// a plain free function (or top-level const) named `sel` — the UFCS `x.sel(..)` == `sel(x, ..)` fallback,
// which resolves a dotted selector against any free function of the right name.
fun cmHasFree(mt: CMTab, sel: String): Bool {
  var i = 0
  while (i < mt.owner.len()) { if (mt.owner.get(i) == "") { if (mt.sel.get(i) == sel) { return true } }; i = i + 1 }
  return false
}

// `sel` is a method of SOME trait — trait dispatch is by-name (dynamic, type-id at the use site), so a
// trait method resolves a dotted call on any type that impls it.
fun cmHasTraitMethod(mt: CMTab, sel: String): Bool {
  var i = 0
  while (i < mt.kind.len()) { if (mt.kind.get(i) == "traitmethod") { if (mt.sel.get(i) == sel) { return true } }; i = i + 1 }
  return false
}

// the KIND of member `sel` on `owner` (already canonicalized), "" if there is no such member. Used by the
// dot/`::` cross-use rule: a member declared as a `const` (or a `variant`) binds with `::`, so reaching it
// through `.` on the type is a cross-use error rather than a plain no-member.
fun cmMemberKind(mt: CMTab, owner: String, sel: String): String {
  var i = 0
  while (i < mt.owner.len()) { if (mt.owner.get(i) == owner) { if (mt.sel.get(i) == sel) { return mt.kind.get(i) } }; i = i + 1 }
  return ""
}

// is `name` a VARIANT of some enum? A bare variant used as a value (`Unit.debug()`, `Unit == Unit`) is an
// ordinary value expression, NOT a `Type.member` static access — even when the variant name COLLIDES with a
// primitive type name (`Unit` is both the primitive unit type AND a nullary variant). So a variant-name base
// stays on the instance path, never the type-dot path.
fun cmIsVariantName(mt: CMTab, name: String): Bool {
  var i = 0
  while (i < mt.kind.len()) { if (mt.kind.get(i) == "variant") { if (mt.sel.get(i) == name) { return true } }; i = i + 1 }
  return false
}

// --- member-table population (checker side; mirrors klower's collectDecl whitelist) ---
fun cmHasPrimAnno(annos: IntBuf): Bool {
  var i = 0
  while (i < annos.len()) { val a: Anno = annos.get(i); if (a.name == "prim") { return true }; i = i + 1 }
  return false
}

fun cmStripMode(ty: String): String {
  val n = ty.len()
  if (n >= 10) { if (ty.substr(0, 10) == "consuming ") { return ty.substr(10, n - 10) } }
  if (n >= 6) { if (ty.substr(0, 6) == "inout ") { return ty.substr(6, n - 6) } }
  return ty
}

// base name of a (possibly generic) type string: "Option" from "Option", "IntBuf" from "IntBuf<Int>".
fun cmBaseName(ty: String): String {
  val n = ty.len()
  var i = 0
  while (i < n && ty.charAt(i) != 60 && ty.charAt(i) != 32) { i = i + 1 }
  return ty.substr(0, i)
}

fun cmFirstUnderscore(s: String): Int {
  var i = 0
  while (i < s.len()) { if (s.charAt(i) == 95) { return i }; i = i + 1 }
  return 0 - 1
}

// An associated CONSTANT's selector, by convention, is SCREAMING_CASE — only uppercase letters, digits and
// underscore, with at least one letter (Int::MAX / Int::MIN / Int::BITS). A NULLARY `<Type>_<REST>` free fn
// whose REST matches is the assoc-const mangle and is classified "const" (so `Int.MAX` via dot is the locked
// cross-use error 'use `::`'); a lowercase-headed REST (a static factory like `List_of` / `Widget_make`) or
// any REST on a fn WITH params stays "assocfn" (a static METHOD, valid via dot). This is the only signal that
// separates a nullary assoc const from a nullary static method at the shared `<Type>_<REST>` surface mangle.
fun cmIsConstSel(s: String): Bool {
  val n = s.len()
  if (n == 0) { return false }
  var i = 0
  var hasAlpha = 0
  while (i < n) {
    val c = s.charAt(i)
    if (c >= 65 && c <= 90) { hasAlpha = 1 }
    else { if ((c >= 48 && c <= 57) || c == 95) { 0 } else { return false } }
    i = i + 1
  }
  return hasAlpha == 1
}

fun cmRecordAlias(mt: CMTab, annos: IntBuf, name: String): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "alias" && a.args.len() >= 1) { mt.aliasFrom.push(name); mt.aliasTo.push(primAnnoStr(a.args.get(0))) }
    i = i + 1
  }
  return 0
}

fun cmFields(mt: CMTab, td: FTDecl): Int {
  var i = 0
  while (i < td.fields.len()) { val f: FFld = td.fields.get(i); cmAdd(mt, td.name, f.name, "field"); i = i + 1 }
  return 0
}

// The `[..]`/`[k:v]` collection-literal PROTOCOL role markers a method declares (klower's recordProtocol is
// the lowerer analogue). Mirrored into the member table as a synthetic member `"#lang#<role>"` under the
// owner so the checker can recognize an opt-in target type (cmIsSeqProto/cmIsMapProto) and accept a literal
// bound to it, exactly as the lowerer routes it. Only the four protocol roles are mirrored.
fun cmIsProtoRole(r: String): Bool { return r == "seq.new" || r == "seq.push" || r == "map.new" || r == "map.set" }
// The two GLOBAL default-collection roles: `@lang("seq.default")`/`@lang("map.default")` name the type a
// bare `[..]`/`[k:v]` literal builds. Mirrored (like the lowerer's recordProtoRole default branch) under a
// synthetic `#default` owner keyed by the role, so inferList/inferMap/indexResTy read the declared name
// instead of a hardcoded "Vec"/"HashMap" — single-sourced from lib exactly as the lowerer's defaultSeqTy.
fun cmIsDefaultRole(r: String): Bool { return r == "seq.default" || r == "map.default" }
fun cmLangRoles(mt: CMTab, owner: String, annos: IntBuf): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "lang" && a.args.len() > 0) { val r = primAnnoStr(a.args.get(0)); if (cmIsProtoRole(r)) { cmAdd(mt, owner, "#lang#" + r, "role") } else { if (cmIsDefaultRole(r)) { cmAdd(mt, "#default", r, owner) } } }
    i = i + 1
  }
  return 0
}
// the type name a bare `[..]`/`[k:v]` literal builds, sourced from lib's @lang("seq.default")/
// @lang("map.default") (recorded by cmLangRoles under the `#default` owner). The hardcoded default is a
// never-hit fallback for a prelude with no such annotation, naming the built-in defaults (mirrors the
// lowerer's roleSymFallback for seq.default/map.default).
fun cmDefaultTy(mt: CMTab, role: String): String {
  var i = 0
  while (i < mt.owner.len()) { if (mt.owner.get(i) == "#default") { if (mt.sel.get(i) == role) { return mt.kind.get(i) } }; i = i + 1 }
  return ""
}
fun cmSeqDefault(mt: CMTab): String { val s = cmDefaultTy(mt, "seq.default"); if (s != "") { return s } return "Vec" }
fun cmMapDefault(mt: CMTab): String { val s = cmDefaultTy(mt, "map.default"); if (s != "") { return s } return "HashMap" }

// struct/class body or impl-block methods: recv non-empty => instance ("method"); recv empty => "assocfn".
fun cmMethods(mt: CMTab, owner: String, methods: IntBuf): Int {
  var i = 0
  while (i < methods.len()) {
    val m: FFunc = methods.get(i)
    if (isConstValFn(m.annos)) { cmAdd(mt, owner, m.name, "const") }
    else { if (m.recv == "") { cmAdd(mt, owner, m.name, "assocfn") } else { cmAdd(mt, owner, m.name, "method") } }
    cmLangRoles(mt, owner, m.annos)
    i = i + 1
  }
  return 0
}

// does type `base` carry the FULL `[..]` (resp `[k:v]`) protocol — both the empty-ctor and mutator role
// markers? The checker mirror of the lowerer's isSeqImplTag/isMapImplTag (minus the instantiation gate,
// which the lowerer owns): true means a collection literal may be bound to a `base<..>` annotation.
fun cmIsSeqProto(mt: CMTab, base: String): Bool {
  val o = cmCanon(mt, base)
  return cmHasMember(mt, o, "#lang#seq.new") && cmHasMember(mt, o, "#lang#seq.push")
}
fun cmIsMapProto(mt: CMTab, base: String): Bool {
  val o = cmCanon(mt, base)
  return cmHasMember(mt, o, "#lang#map.new") && cmHasMember(mt, o, "#lang#map.set")
}

fun cmTraitMethods(mt: CMTab, owner: String, methods: IntBuf): Int {
  var i = 0
  while (i < methods.len()) { val m: FFunc = methods.get(i); cmAdd(mt, owner, m.name, "traitmethod"); i = i + 1 }
  return 0
}

fun cmVariants(mt: CMTab, ed: FEDecl): Int {
  var i = 0
  while (i < ed.variants.len()) { val v: FVariant = ed.variants.get(i); cmAdd(mt, ed.name, v.name, "variant"); i = i + 1 }
  return 0
}

// The concrete method a `@derive(Tr)` SYNTHESIZES on its type — the checker mirror of klower's
// deriveMethodFor (Eq/PartialEq->eq, Ord->cmp, PartialOrd->partialCmp, Hash->hash, Clone->clone,
// Debug->debug, Default->default; Copy is a marker -> ""). Eq/Ord/PartialOrd/Hash also carry real trait
// decls (cmp.kite), so their methods already land in the table as `traitmethod`; but Clone/Debug/Default
// have NO trait decl in the prelude, so without this their derived `.clone()/.debug()/Type::default()`
// would be a false no-member. Registering the synthesized member per @derive'd type closes that miss.
fun cmDeriveMethod(tr: String): String {
  if (tr == "Eq" || tr == "PartialEq") { return "eq" }
  if (tr == "Ord") { return "cmp" }
  if (tr == "PartialOrd") { return "partialCmp" }
  if (tr == "Hash") { return "hash" }
  if (tr == "Clone") { return "clone" }
  if (tr == "Debug") { return "debug" }
  if (tr == "Default") { return "default" }
  return ""
}

// register the members SYNTHESIZED by a decl's `@derive(...)` annotations against its owning type. `default`
// is an associated fn (`Type::default()`); the rest are instance methods (`v.clone()`/`v.debug()`).
fun cmDerives(mt: CMTab, annos: IntBuf, tyName: String): Int {
  var i = 0
  while (i < annos.len()) {
    val a: Anno = annos.get(i)
    if (a.name == "derive") {
      var j = 0
      while (j < a.args.len()) {
        val ax: FExpr = a.args.get(j)
        val trn = when (ax) { FEIdent(n) -> n; else -> "" }
        val m = cmDeriveMethod(trn)
        if (m != "") { if (m == "default") { cmAdd(mt, tyName, m, "assocfn") } else { cmAdd(mt, tyName, m, "method") } }
        j = j + 1
      }
    }
    i = i + 1
  }
  return 0
}

// classify a free `fun` at collect time (mirrors klower's mtFreeFun whitelist):
//   - EXTENSION fn: first param named "this" — an instance method of its receiver type, selector recovered
//     by dropping the KNOWN "<Recv>_" prefix (never a guessed split, ambiguous with a real free fn Foo_bar).
//   - PLAIN free fn: recorded "freefn"; ADDITIONALLY when its name is "<KnownType>_<rest>" (the assoc-const
//     / static / UFCS mangle, e.g. Int_MAX, String_len) an ASSOCIATED VIEW is attributed to that nominal.
fun cmFreeFun(mt: CMTab, fd: FFunc): Int {
  if (fd.params.len() > 0) {
    val p0: FParam = fd.params.get(0)
    if (p0.name == "this") {
      val recv = cmBaseName(cmStripMode(p0.ty))
      val sel = if (fd.name.len() > recv.len() + 1) { fd.name.substr(recv.len() + 1, fd.name.len() - recv.len() - 1) } else { fd.name }
      // A GENERIC extension (`fun <A,B> A.to(..)`, receiver a type PARAMETER) is universally callable via
      // type erasure — a receiver of ANY type resolves it. Record the selector as a free UFCS-style fn so
      // requireMember(x, sel) passes for any receiver, rather than attributing it to the phantom type "A".
      if (isTypeParam(recv)) { cmAdd(mt, "", sel, "freefn") } else { cmAdd(mt, recv, sel, "method") }
      return 0
    }
  }
  cmAdd(mt, "", fd.name, "freefn")
  val us = cmFirstUnderscore(fd.name)
  if (us > 0) {
    val pre = fd.name.substr(0, us)
    if (memList(mt.types, pre)) {
      val rest = fd.name.substr(us + 1, fd.name.len() - us - 1)
      // A nullary `<Type>_<SCREAMING>` is an associated CONSTANT (Int::MAX) — classify "const" so dot-access
      // (`Int.MAX`) is the locked cross-use error. Everything else (has params, or a lowercase-headed rest
      // like a `_make`/`_of` factory) is a static "assocfn", reachable via dot.
      val amk = if (fd.params.len() == 0 && cmIsConstSel(rest)) { "const" } else { "assocfn" }
      cmAdd(mt, pre, rest, amk)
      // setter-property mangle `<Type>_<name>_set` also exposes the bare property name, so a setter-only
      // property (`b.wide = 7` -> Box_wide_set) resolves `b.wide` — mirroring the checker's hasAccessorM.
      val rn = rest.len()
      if (rn > 4 && rest.substr(rn - 4, 4) == "_set") { cmAdd(mt, pre, rest.substr(0, rn - 4), "assocfn") }
    }
  }
  return 0
}

// Pass 1: record every nominal TYPE name (+ its @alias view) so pass 2's "<KnownType>_<rest>" attribution
// sees the full type set regardless of decl order (a free Int_MAX may precede/follow `class Int`).
fun cmCollectTypes(mt: CMTab, decls: IntBuf): Int {
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    when (d) {
      DFun(fd) -> { if (cmHasPrimAnno(fd.annos)) { cmType(mt, fd.name); cmRecordAlias(mt, fd.annos, fd.name) } }
      DType(kind, td) -> { cmType(mt, td.name); cmRecordAlias(mt, td.annos, td.name) }
      DEnum(ed) -> cmType(mt, ed.name)
      DTrait(tr) -> cmType(mt, tr.name)
      else -> 0
    }
    i = i + 1
  }
  return 0
}

// Pass 2: record the MEMBERS of every decl against the type set from pass 1.
fun cmCollectMembers(mt: CMTab, decls: IntBuf): Int {
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    when (d) {
      DFun(fd) -> { if (cmHasPrimAnno(fd.annos) == false) { cmFreeFun(mt, fd) } }
      // A @prim type carries no heap FIELDS/derives, but its body's `const val` associated constants +
      // inherent methods ARE members (Phase M6: `Int::MAX` etc. now live in the `class Int` body). Collect
      // them so `Int::MAX` resolves and `Int.MAX` (dot on a const) is the locked cross-use error, not a
      // spurious "no member".
      DType(kind, td) -> { cmMethods(mt, td.name, td.methods); if (cmHasPrimAnno(td.annos) == false) { cmFields(mt, td); cmDerives(mt, td.annos, td.name) } }
      DEnum(ed) -> { cmVariants(mt, ed); cmMethods(mt, ed.name, ed.consts); cmMethods(mt, ed.name, ed.methods); cmDerives(mt, ed.annos, ed.name) }
      DTrait(tr) -> cmTraitMethods(mt, tr.name, tr.methods)
      DImpl(im) -> cmMethods(mt, im.forTy, im.methods)
      else -> 0
    }
    i = i + 1
  }
  return 0
}

// Build the checker's member table from the prelude decl list AND the user program's decls (both flow
// through the identical whitelist, so a builtin nominal and a user type land in it identically).
fun buildCMTab(pdecls: IntBuf, udecls: IntBuf): CMTab {
  val mt = cmNew()
  cmCollectTypes(mt, pdecls); cmCollectTypes(mt, udecls)
  cmCollectMembers(mt, pdecls); cmCollectMembers(mt, udecls)
  return mt
}

// canonicalize an alias to its PRIMARY name (I64 -> Long, I32 -> Int, U8 -> UByte, F64 -> Double,
// Never -> Nothing); a name with no @alias row is already canonical and returned unchanged. This is the
// SINGLE point where alias identity collapses — sourced from the lib @alias table, not a baked switch.
fun canonPrim(reg: PReg, n: String): String {
  var i = 0
  while (i < reg.aliasFrom.len()) { if (reg.aliasFrom.get(i) == n) { return reg.aliasTo.get(i) }; i = i + 1 }
  return n
}

fun primKind(reg: PReg, n: String): Int {
  var i = 0
  while (i < reg.names.len()) { if (reg.names.get(i) == n) { return reg.kinds.get(i) }; i = i + 1 }
  return 0
}

fun isPrimReg(reg: PReg, n: String): Bool { return primKind(reg, n) != 0 }

fun primIsInt(reg: PReg, n: String): Bool { val k = primKind(reg, n); return k == 1 || k == 2 }

fun primIsSigned(reg: PReg, n: String): Bool { return primKind(reg, n) == 1 }

fun primIsFloat(reg: PReg, n: String): Bool { return primKind(reg, n) == 3 }

fun primIsReserved(reg: PReg, n: String): Bool { return primKind(reg, n) == 9 }

// Storage width in bits for an integer primitive; the word types (Int/Long/I64/ISize/U64/USize) = 64.
// Only sub-word INTEGERS (kind 1/2 at 8/16/32) carry a narrow width; every other type reports 64,
// matching the legacy switch exactly (Char/Float/reserved etc. all fell through to 64 there too).
fun primBits(reg: PReg, n: String): Int {
  var i = 0
  while (i < reg.names.len()) {
    if (reg.names.get(i) == n) {
      val k = reg.kinds.get(i)
      val b = reg.bits.get(i)
      if ((k == 1 || k == 2) && (b == 8 || b == 16 || b == 32)) { return b }
      return 64
    }
    i = i + 1
  }
  return 64
}

fun isPrimitive(reg: PReg, n: String): Bool { return isPrimReg(reg, n) }

fun isNumericN(reg: PReg, n: String): Bool { return primIsInt(reg, n) || primIsFloat(reg, n) }

// 2^n for n in [0,63] (kite Int is the i64 word). Callers only pass n<=32, well inside the word.
// 2^n as a 64-bit machine word: n reaches 32 here (the sub-64-bit range-check bounds), so 2^n and the
// derived `pow2(bits)-1` exceed 32 bits — the result type MUST be a full word (Long), not a 32-bit Int,
// or a Phase-D compiler would wrap `pow2(32)-1` to -1 and mis-reject every valid U32/U64 literal.
fun pow2(n: Int): Long { var r: Long = 1; var i = 0; while (i < n) { r = r * 2; i = i + 1 }; return r }

// Compile-time range check: does the decimal literal `numStr` (optional leading '-') fit type `name`?
// Sub-word widths (8/16/32) are checked exactly; the 64-bit word can't be bounded inside an i64, so we
// only enforce the unsigned-can't-be-negative rule there.
fun intInRange(reg: PReg, numStr: String, name: String): Bool {
  val neg = numStr.len() >= 1 && numStr.charAt(0) == 45
  if (neg && primIsSigned(reg, name) == false) { return false } // unsigned rejects negatives
  val bits = primBits(reg, name)
  if (bits >= 64) { return true }
  val v = parseIntK(numStr)
  if (primIsSigned(reg, name)) { val hi = pow2(bits - 1) - 1; val lo = 0 - pow2(bits - 1); return v >= lo && v <= hi }
  return v >= 0 && v <= pow2(bits) - 1
}

// infer an integer literal, range-checking a SUFFIXED literal against its own fixed type (300u8 errors).
fun inferIntLit(env: TEnv, t: String): Ty {
  val nm = suffixTyName(litSuf(t))
  if (nm == "") { return TPrim("Int") }
  if (intInRange(env.prim, litNum(t), nm) == false) { tErr(env, "integer literal " + (t + (" out of range for " + nm))) }
  return TPrim(nm)
}

// Expected-type adoption: a BARE (unsuffixed) integer literal `val x: U16 = 300` adopts the annotated
// integer type and is range-checked at compile time. Returns true iff it fully handled the binding.
fun adoptDest(env: TEnv, numStr: String, dt: Ty): Bool {
  return when (dt) {
    TPrim(dn) -> { if (primIsInt(env.prim, dn)) { if (intInRange(env.prim, numStr, dn) == false) { tErr(env, "integer literal " + (numStr + (" out of range for " + dn))) }; true } else { false } }
    else -> false
  }
}

fun adoptBareIntLit(env: TEnv, init: FExpr, dt: Ty): Bool {
  return when (init) {
    FEInt(t) -> if (litSuf(t) == "") { adoptDest(env, litNum(t), dt) } else { false }
    FEUnary(op, x) -> if (op == "neg -") { adoptNegLit(env, x, dt) } else { false }
    else -> false
  }
}

fun adoptNegLit(env: TEnv, x: FExpr, dt: Ty): Bool {
  return when (x) {
    FEInt(t) -> if (litSuf(t) == "") { adoptDest(env, "-" + litNum(t), dt) } else { false }
    else -> false
  }
}

// Bare-integer-literal adoption in ARGUMENT position (mirrors checkLet's `val x: U16 = 300`): a bare
// (unsuffixed) integer literal passed to a parameter whose type is a non-`Int` integer primitive adopts
// that type, range-checked at compile time — so `RawBuf(0)`/`u32b(b, 0xFEEDFACF)` pass without a `usize`
// suffix or an `as` cast. `Int` (and its `I32` alias) is EXCLUDED so it keeps the historical permissive
// behavior (a bare literal infers `Int` and machine-word 32-bit-pattern constants are not range-rejected);
// only an explicitly wider/narrower annotation (USize/Long/U8/…) triggers the adoption + range check.
fun adoptArgLit(env: TEnv, e: FExpr, pt: Ty): Bool {
  return when (pt) {
    TPrim(pn) -> if (primIsInt(env.prim, pn) && canonPrim(env.prim, pn) != "Int") { adoptBareIntLit(env, e, pt) } else { false }
    else -> false
  }
}

fun cons1(t: Ty): IntBuf { val l = intBuf(); l.push(t); return l }

// --- type-string parser (reuses kfront's lexer + P) ---
// `reg` classifies a bare name as a primitive (-> TPrim) vs a nominal type (-> TNamed), sourced from
// the lib @prim table so the type parser reads the same registry as the rest of the checker.
fun tyBase(reg: PReg, p: P): Ty {
  if (pk(p) == 20) {
    eat(p)
    val args = intBuf()
    if (pk(p) != 21) { args.push(parseTyC(reg, p)); while (pk(p) == 24) { eat(p); args.push(parseTyC(reg, p)) } }
    eat(p); eat(p) // ')' '->'
    return TFun(args, parseTyC(reg, p))
  }
  var name = ptext(p); eat(p)
  while (pk(p) == 26) { eat(p); name = ptext(p); eat(p) }
  val args = intBuf()
  if (pk(p) == 37) { eat(p); args.push(parseTyC(reg, p)); while (pk(p) == 24) { eat(p); args.push(parseTyC(reg, p)) }; eat(p) }
  if (isPrimitive(reg, name) && args.len() == 0) { return TPrim(name) }
  return TNamed(name, args)
}

fun parseTyC(reg: PReg, p: P): Ty {
  var b = tyBase(reg, p)
  while (pk(p) == 45) { eat(p); b = TNull(b) }
  return b
}

// A param type string may carry a leading ownership modifier ("consuming Int" / "inout Int"); the
// modifier is not part of the type, so skip a leading `inout`(71)/`consuming`(72) token before parsing.
fun parseTyStr(reg: PReg, s: String): Ty {
  if (s == "") { return TUnknown }
  val p = P(lex(s), 0, intBuf())
  if (pk(p) == 71 || pk(p) == 72) { eat(p) }
  return parseTyC(reg, p)
}

// An empty return type means UNKNOWN, not Unit: Kite functions with an untyped param lose their
// declared return through a parser quirk (the untyped param swallows the `: Ret`), and assuming Unit
// there produces false "Unit and Int" arithmetic errors. Unknown is the honest, permissive choice.
fun retTy(reg: PReg, s: String): Ty { if (s == "") { return TUnknown } return parseTyStr(reg, s) }

// --- ty ops ---
fun isUnknownT(t: Ty): Bool { return when (t) { TUnknown -> true; else -> false } }

// Never (alias Nothing) is a REAL bottom type: uninhabited, subtype of every type — the type of a
// diverging expression (break/continue/return, and __abort). compat() lets it flow to any target.
fun isNothingT(reg: PReg, t: Ty): Bool { return when (t) { TPrim(x) -> primKind(reg, x) == 8; else -> false } }

fun isNum(reg: PReg, t: Ty): Bool { return when (t) { TPrim(x) -> isNumericN(reg, x); else -> false } }

// arithmetic on nullable numerics yields a plain numeric in Kite (null is 0): strip an outer `?`.
fun stripNull(t: Ty): Ty { return when (t) { TNull(x) -> x; else -> t } }

// permissive numeric-ness for arithmetic under erasure: a real numeric, a type parameter (T may be Int),
// or a nullable of one (`Int?` arithmetic). Keeps String/struct/Unit as genuine non-numeric errors.
fun isNumOk(reg: PReg, t: Ty): Bool {
  return when (t) {
    TPrim(x) -> isNumericN(reg, x)
    TNamed(n, args) -> isTypeParam(n)
    TNull(x) -> isNumOk(reg, x)
    else -> false
  }
}

fun tyEqPrim(t: Ty, name: String): Bool { return when (t) { TPrim(x) -> x == name; else -> false } }

fun compatList(reg: PReg, a: IntBuf, b: IntBuf): Bool {
  if (a.len() != b.len()) { return false }
  var i = 0
  while (i < a.len()) { val x: Ty = a.get(i); val y: Ty = b.get(i); if (compat(reg, x, y) == false) { return false }; i = i + 1 }
  return true
}

fun isTypeParamTy(t: Ty): Bool { return when (t) { TNamed(n, args) -> isTypeParam(n); else -> false } }

fun isUnitTy(t: Ty): Bool { return when (t) { TPrim(s) -> s == "Unit"; TNamed(n, args) -> n == "Unit"; else -> false } }

fun isNullUnknown(t: Ty): Bool { return when (t) { TNull(x) -> isUnknownT(x); else -> false } }

fun compat(reg: PReg, a: Ty, b: Ty): Bool {
  if (isUnknownT(a) || isUnknownT(b)) { return true }
  if (isNothingT(reg, a) || isNothingT(reg, b)) { return true }
  // erased generics: a type parameter (T/A/…) matches anything; Unit is the ignore-the-value type; a
  // nullable-of-unknown (`?unknown?`) is as permissive as unknown.
  if (isTypeParamTy(a) || isTypeParamTy(b)) { return true }
  if (isUnitTy(a) || isUnitTy(b)) { return true }
  if (isNullUnknown(a) || isNullUnknown(b)) { return true }
  return when (a) {
    TPrim(x) -> compatPrimR(reg, x, b)
    TNull(x) -> compatNullR(reg, x, b)
    TNamed(n1, a1) -> compatNamedR(reg, n1, a1, b)
    TFun(p1, r1) -> compatFunR(reg, p1, r1, b)
    else -> false
  }
}

// Distinct primitives are NOT interchangeable (STDLIB-REDESIGN §2a/§3: no implicit lossy coercion) — the
// old "any numeric ≈ any numeric" rule is gone. Two prims are compatible iff they CANONICALIZE to the
// same primary name (Phase A): I32/Int -> Int, I64/Long -> Long, U8/UByte -> UByte, F64/Double -> Double,
// Never/Nothing -> Nothing. So `Int != Long` (both sint64, but distinct primaries), `Int != ISize`,
// `Double != Float`, `Int != I8`, `Int != U16` — each needs an explicit conversion — while an alias and
// its primary are freely interchangeable. Canonicalization is lib-sourced (the @alias table), not baked.
fun primCompat(reg: PReg, x: String, y: String): Bool {
  if (x == y) { return true }
  if (primKind(reg, x) == 0 || primKind(reg, y) == 0) { return false }
  return canonPrim(reg, x) == canonPrim(reg, y)
}

fun compatPrimR(reg: PReg, x: String, b: Ty): Bool {
  return when (b) { TPrim(y) -> primCompat(reg, x, y); TNull(y) -> compat(reg, TPrim(x), y); else -> false }
}

fun compatNullR(reg: PReg, x: Ty, b: Ty): Bool { return when (b) { TNull(y) -> compat(reg, x, y); else -> false } }

// a single uppercase letter (T, A, K, V, ...) is a generic type PARAMETER — erased, compatible with any.
fun isTypeParam(n: String): Bool {
  if (n.len() != 1) { return false }
  val c = n.charAt(0)
  if (c < 65) { return false }
  if (c > 90) { return false }
  return true
}

fun compatNamedR(reg: PReg, n1: String, a1: IntBuf, b: Ty): Bool {
  if (isTypeParam(n1)) { return true }
  return when (b) {
    TNamed(n2, a2) -> {
      if (isTypeParam(n2)) { true }
      else { if (n1 != n2) { false }
        // same base type: with type erasure, `IntBuf<Int>` and `IntBuf` are compatible — only compare type
        // args when BOTH sides carry them.
        else { if (a1.len() == 0) { true } else { if (a2.len() == 0) { true } else { compatList(reg, a1, a2) } } } }
    }
    TNull(y) -> compat(reg, TNamed(n1, a1), y)
    else -> false
  }
}

fun compatFunR(reg: PReg, p1: IntBuf, r1: Ty, b: Ty): Bool {
  return when (b) { TFun(p2, r2) -> compatList(reg, p1, p2) && compat(reg, r1, r2); TNull(y) -> compat(reg, TFun(p1, r1), y); else -> false }
}

fun joinTy(reg: PReg, a: Ty, b: Ty): Ty { if (compat(reg, a, b)) { return b } if (compat(reg, b, a)) { return a } return TUnknown }

fun showTyList(l: IntBuf): String {
  var s = ""
  var i = 0
  while (i < l.len()) { val t: Ty = l.get(i); if (i == 0) { s = showTy(t) } else { s = s + (", " + showTy(t)) }; i = i + 1 }
  return s
}

fun showTy(t: Ty): String {
  return when (t) {
    TPrim(s) -> s
    TNamed(n, args) -> if (args.len() == 0) { n } else { n + ("<" + (showTyList(args) + ">")) }
    TNull(x) -> showTy(x) + "?"
    TFun(ps, r) -> "(" + (showTyList(ps) + (") -> " + showTy(r)))
    TUnknown -> "?unknown"
    else -> "?"
  }
}

// --- env + scope ---
struct Binding(val name: String, val ty: Ty)

struct Look(val found: Int, val ty: Ty)

struct LP(val name: String, val ty: String)

// mtab/shadow/shadowOn (Phase M1): the member table + the shadow-diagnostic sink. shadowOn==0 (the
// normal check/compile path) makes shadowMember a NO-OP — the member table is never consulted and the
// checker's real diagnostics are byte-identical to before. shadowOn==1 (the `kitec shadow` harness path)
// consults the table at every selector site and logs would-be no-member diagnostics into `shadow`,
// NEVER into `diags` — so no existing fatal diagnostic changes and the compiler's behavior is unchanged.
// memLevel (Phase M3): the FATAL undefined-member gate. 0 = off (member table inert, byte-identical to
// the pre-M3 checker). >0 turns a would-be no-member selector — on a KNOWN type whose receiver-family is
// enabled — into a REAL compile diagnostic (issued in the type-check pass, before lowering), which gates
// the build. Widened one receiver-family at a time: 1 = own structs/enums, 2 = +builtin nominals,
// 3 = +primitives. See memberFamilyEnabled / requireMember.
struct TEnv(val funN: IntBuf, val funP: IntBuf, val funR: IntBuf, val funG: IntBuf, val funVA: IntBuf, val structN: IntBuf, val structFN: IntBuf, val structFT: IntBuf, val enumN: IntBuf, var locals: IntBuf, var curRet: Ty, var hasRet: Int, val implN: IntBuf, val implT: IntBuf, val diags: IntBuf, var curLine: Int, val prim: PReg, val mtab: CMTab, val shadow: IntBuf, var shadowOn: Int, var memLevel: Int)

// trait subtyping: a concrete type is assignable to a trait it impls. implN/implT are parallel
// (type name -> trait name), collected from `impl Trait for Type`. subtypeOk is checked ALONGSIDE
// compat at return/arg/let sites (not inside compat, which is env-free).
fun implsTrait(env: TEnv, ty: String, tr: String): Bool {
  var i = 0
  while (i < env.implN.len()) {
    if (env.implN.get(i) == ty) { if (env.implT.get(i) == tr) { return true } }
    i = i + 1
  }
  return false
}

fun subtypeOk(env: TEnv, a: Ty, b: Ty): Bool {
  return when (a) {
    TNamed(na, aa) -> when (b) { TNamed(nb, bb) -> implsTrait(env, na, nb); else -> false }
    else -> false
  }
}

fun tErr(env: TEnv, msg: String): Int { env.diags.push(linePrefix(env.curLine) + msg); return 0 }

// Reserved primitives (I128/U128) are recognized names but carry no lowering yet — reject on use.
fun reservedTyErr(env: TEnv, t: Ty): Int {
  return when (t) {
    TPrim(x) -> { if (primIsReserved(env.prim, x)) { tErr(env, x + " is reserved and not yet implemented") }; 0 }
    TNull(y) -> reservedTyErr(env, y)
    else -> 0
  }
}

fun tPush(env: TEnv): IntBuf {
  val saved = env.locals
  val ns = intBuf()
  var i = 0
  while (i < saved.len()) { ns.push(saved.get(i)); i = i + 1 }
  ns.push(intBuf())
  env.locals = ns
  return saved
}

fun tPop(env: TEnv, saved: IntBuf): Int { env.locals = saved; return 0 }

fun tBind(env: TEnv, name: String, ty: Ty): Int {
  val top: IntBuf = env.locals.get(env.locals.len() - 1)
  top.push(Binding(name, ty))
  return 0
}

fun tLocal(env: TEnv, name: String): Look {
  var i = env.locals.len() - 1
  while (i >= 0) {
    val sc: IntBuf = env.locals.get(i)
    var j = sc.len() - 1
    while (j >= 0) { val b: Binding = sc.get(j); if (b.name == name) { return Look(1, b.ty) }; j = j - 1 }
    i = i - 1
  }
  return Look(0, TUnknown)
}

fun splitLamPairs(s: String): IntBuf {
  val out = intBuf()
  if (s == "") { return out }
  val n = s.len()
  var i = 0
  var start = 0
  while (i <= n) {
    if (i == n || s.charAt(i) == 44) {
      var e = start
      while (e < i && s.charAt(e) == 32) { e = e + 1 }
      var stop = e
      while (stop < i && s.charAt(stop) != 58) { stop = stop + 1 }
      val nm = s.substr(e, stop - e)
      var ty = ""
      if (stop < i) { var ts = stop + 1; while (ts < i && s.charAt(ts) == 32) { ts = ts + 1 }; ty = s.substr(ts, i - ts) }
      out.push(LP(nm, ty))
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// --- inference ---
fun isArith(op: String): Bool { return op == "+" || op == "-" || op == "*" || op == "/" || op == "%" }

fun isBitwise(op: String): Bool { return op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" }

fun isCmp(op: String): Bool { return op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" }

fun requireBool(env: TEnv, t: Ty, ctx: String): Int {
  if (compat(env.prim, t, TPrim("Bool")) == false) { tErr(env, ctx + (" condition must be Bool, found " + showTy(t))) }
  return 0
}

fun inferIdent(env: TEnv, s: String): Ty {
  val lk = tLocal(env, s)
  if (lk.found == 1) { return lk.ty }
  var i = 0
  while (i < env.funN.len()) { if (env.funN.get(i) == s) { return TFun(env.funP.get(i), env.funR.get(i)) }; i = i + 1 }
  var j = 0
  while (j < env.structN.len()) { if (env.structN.get(j) == s) { return TFun(env.structFT.get(j), TNamed(s, intBuf())) }; j = j + 1 }
  return TUnknown
}

// `::name` — an explicit free-function reference, immune to local val shadowing: resolve against the
// top-level function table ONLY (never a local), yielding its function type. TUnknown if `name` is not a
// visible free function (the lowerer raises the loud, actionable error for undefined/ambiguous refs).
fun inferFnRef(env: TEnv, s: String): Ty {
  var i = 0
  while (i < env.funN.len()) { if (env.funN.get(i) == s) { return TFun(env.funP.get(i), env.funR.get(i)) }; i = i + 1 }
  return TUnknown
}

fun inferUnary(env: TEnv, op: String, a: FExpr): Ty {
  if (op == "not !") { infer(env, a); return TPrim("Bool") }
  return infer(env, a)
}

// the operator trait for an arithmetic op (+ -> Add, - -> Sub, * -> Mul, / -> Div, % -> Rem).
fun opTraitName(op: String): String {
  if (op == "+") { return "Add" }
  if (op == "-") { return "Sub" }
  if (op == "*") { return "Mul" }
  if (op == "/") { return "Div" }
  return "Rem"
}

// operator overloading: if the LEFT operand's named type implements the op's trait, `a op b` is that
// trait method's call and yields the operand's type. Only named (struct/user) types are considered.
fun opOverloadTy(env: TEnv, op: String, ta: Ty): Ty {
  return when (ta) {
    TNamed(n, args) -> if (implsTrait(env, n, opTraitName(op))) { ta } else { TUnknown }
    else -> TUnknown
  }
}

// Silent Int/Float mixing is UNSOUND (the int operand would be dereferenced as a double-pointer): ban
// `i + f` when one side is a concrete integer prim and the other a concrete float prim — require an
// explicit toFloat(i)/toInt(f). Only fires for two concrete primitives, so erased generics stay permissive.
fun primFloatKind(reg: PReg, t: Ty): Int { return when (t) { TPrim(x) -> primKind(reg, x); else -> 0 } }

fun mixedIntFloat(reg: PReg, ta: Ty, tb: Ty): Bool {
  val ka = primFloatKind(reg, ta)
  val kb = primFloatKind(reg, tb)
  if (ka == 3 && (kb == 1 || kb == 2)) { return true }
  if (kb == 3 && (ka == 1 || ka == 2)) { return true }
  return false
}

fun inferBinary(env: TEnv, op: String, a: FExpr, b: FExpr): Ty {
  val ta = infer(env, a)
  val tb = infer(env, b)
  if (mixedIntFloat(env.prim, ta, tb)) {
    tErr(env, "mixed Int/Float arithmetic requires an explicit conversion (toFloat/toInt): " + (showTy(ta) + (" and " + showTy(tb))))
    return TUnknown
  }
  if (isArith(op)) {
    if (op == "+" && (tyEqPrim(ta, "String") || tyEqPrim(tb, "String"))) { return TPrim("String") }
    if (isNumOk(env.prim, ta) && isNumOk(env.prim, tb)) { return stripNull(joinTy(env.prim, ta, tb)) }
    val ov = opOverloadTy(env, op, ta)
    if (isUnknownT(ov) == false) { return ov }
    if (isUnknownT(ta) || isUnknownT(tb)) { return TUnknown }
    tErr(env, "arithmetic on non-numeric operands: " + (showTy(ta) + (" and " + showTy(tb))))
    return TUnknown
  }
  if (isCmp(op)) { return TPrim("Bool") }
  if (op == "&&" || op == "||") { requireBool(env, ta, "logical operator"); requireBool(env, tb, "logical operator"); return TPrim("Bool") }
  if (isBitwise(op)) {
    if (isNumOk(env.prim, ta) && isNumOk(env.prim, tb)) { return stripNull(joinTy(env.prim, ta, tb)) }
    if (isUnknownT(ta) || isUnknownT(tb)) { return TUnknown }
    tErr(env, "bitwise operator on non-numeric operands: " + (showTy(ta) + (" and " + showTy(tb))))
    return TUnknown
  }
  return TNamed("Range", cons1(joinTy(env.prim, ta, tb)))
}

fun inferNotNull(env: TEnv, a: FExpr): Ty { val t = infer(env, a); return when (t) { TNull(x) -> x; else -> t } }

// `e as T` (Phase 3): an explicit numeric conversion — width truncation/extension between integer types,
// int<->float via fcvt/scvtf, or a same-width sign reinterpret. The source and target must both be scalar
// numeric (integer/float/char); casting a String or a struct is a type error. The result type is T.
fun isCastScalar(reg: PReg, t: Ty): Bool {
  return when (t) {
    TPrim(x) -> { val k = primKind(reg, x); k == 1 || k == 2 || k == 3 || k == 5 }
    TNamed(n, args) -> isTypeParam(n)
    TNull(x) -> isCastScalar(reg, x)
    else -> false
  }
}

fun inferCast(env: TEnv, a: FExpr, ty: String): Ty {
  val src = infer(env, a)
  val dt = parseTyStr(env.prim, ty)
  reservedTyErr(env, dt)
  if (isUnknownT(src) == false) {
    if (isCastScalar(env.prim, src) == false || isCastScalar(env.prim, dt) == false) {
      tErr(env, "`as` cast requires numeric operands: " + (showTy(src) + (" as " + showTy(dt))))
    }
  }
  return dt
}

// A property accessor exists for `T.name` when a getter method `T_name(self)` or a setter method
// `T_name_set(self, v)` is defined. `obj.name` (getter) and `obj.name = v` (setter) then desugar to
// those calls in klower, so the checker must not report a "no such field" for such a name.
fun hasAccessorM(env: TEnv, n: String, f: String): Bool {
  val g = n + ("_" + f)
  if (memList(env.funN, g)) { return true }
  if (memList(env.funN, g + "_set")) { return true }
  return false
}

fun inferFieldNamed(env: TEnv, n: String, f: String, isSafe: Int): Ty {
  var i = 0
  while (i < env.structN.len()) {
    if (env.structN.get(i) == n) {
      val fns: IntBuf = env.structFN.get(i)
      val fts: IntBuf = env.structFT.get(i)
      var j = 0
      while (j < fns.len()) {
        if (fns.get(j) == f) { val ft: Ty = fts.get(j); if (isSafe == 1) { return TNull(ft) } return ft }
        j = j + 1
      }
      if (hasAccessorM(env, n, f)) { return TUnknown }
      tErr(env, "type " + (n + (" has no field " + f)))
      return TUnknown
    }
    i = i + 1
  }
  return TUnknown
}

// SHADOW member resolution (Phase M1): given a receiver type and a selector, decide whether the member
// table WOULD resolve it; if not, log a shadow diagnostic. Purely additive — only runs under shadowOn,
// only writes to env.shadow, never changes a return type or a real diagnostic. Conservative by design:
//   - an unknown / function / type-parameter receiver is skipped (no definite type to resolve against);
//   - a receiver whose head name is NOT a recorded nominal is skipped (we only vouch for known types);
//   - resolution succeeds on a member of the type, a UFCS free function of the same name, OR a trait
//     method of the same name (by-name dynamic dispatch). Anything else is a would-be no-member miss.
fun shadowMember(env: TEnv, recvTy: Ty, sel: String): Int {
  if (env.shadowOn == 0) { return 0 }
  val h = headNameOf(recvTy)
  if (h == "") { return 0 }
  if (isTypeParam(h)) { return 0 }
  val tn = cmCanon(env.mtab, h)
  if (cmIsType(env.mtab, tn) == false) { return 0 }
  if (cmHasMember(env.mtab, tn, sel)) { return 0 }
  if (cmHasFree(env.mtab, sel)) { return 0 }
  if (cmHasTraitMethod(env.mtab, sel)) { return 0 }
  env.shadow.push(linePrefix(env.curLine) + ("no member `" + (sel + ("` on type " + tn))))
  return 0
}

// receiver-FAMILY of a KNOWN nominal type name (Phase M3 widening gate):
//   1 = an OWN struct/enum (declared in THIS unit — env.structN / env.enumN)
//   3 = a PRIMITIVE (in the @prim registry, after alias-canonicalization: Int/Bool/U8/...)
//   2 = a BUILTIN NOMINAL — any other type the table knows (IntBuf, RawMap, String, Option, Result, ...)
// The families are widened one at a time so a stricter type-directed check can be turned on incrementally,
// gating the compiler+stdlib build after each. Own types are family 1 because their members are fully
// recorded here (fields + methods + variants), so a miss on them is the most reliable signal.
fun memberFamily(env: TEnv, tn: String): Int {
  if (memList(env.structN, tn)) { return 1 }
  if (memList(env.enumN, tn)) { return 1 }
  if (primKind(env.prim, canonPrim(env.prim, tn)) != 0) { return 3 }
  return 2
}

// is the FATAL member check enabled for a miss on type `tn`? Only when tn's family is at or below the
// current widening level (1 own-only, 2 +builtin, 3 +primitive).
fun memberFamilyEnabled(env: TEnv, tn: String): Bool {
  if (env.memLevel == 0) { return false }
  return memberFamily(env, tn) <= env.memLevel
}

// FATAL member resolution (Phase M3): the flip of shadowMember. Given a receiver type and a selector at a
// method-call or `Type::member` site, resolve it against the member table; a genuine no-member on a KNOWN
// type whose family is enabled is a REAL compile error ("type X has no member Y"), issued before lowering
// so the whole bare-undefined-symbol -> dyld-crash / garbage bug family cannot reach codegen. Conservative
// exactly like shadowMember: an unknown / type-parameter / not-a-known-type receiver is skipped (we only
// vouch for known types), and a member/UFCS-free-fn/trait-method of the same name resolves it. Field access
// is NOT routed here — inferFieldNamed already owns the "no field" diagnostic for own structs — so this
// never double-fires; it closes only the method-call and static-access gaps that were silently "ok".
fun requireMember(env: TEnv, recvTy: Ty, sel: String): Int {
  if (env.memLevel == 0) { return 0 }
  val h = headNameOf(recvTy)
  if (h == "") { return 0 }
  if (isTypeParam(h)) { return 0 }
  val tn = cmCanon(env.mtab, h)
  if (cmIsType(env.mtab, tn) == false) { return 0 }
  if (cmHasMember(env.mtab, tn, sel)) { return 0 }
  if (cmHasFree(env.mtab, sel)) { return 0 }
  if (cmHasTraitMethod(env.mtab, sel)) { return 0 }
  if (memberFamilyEnabled(env, tn)) { tErr(env, "type " + (tn + (" has no member " + sel))) }
  return 0
}

// is `base` a bare TYPE NAME here (not shadowed by a local of the same name)? A `Type.sel` / `Type.sel()`
// whose base is a known nominal is a STATIC access via dot, resolved against the member table exactly like
// the `::` path — NOT an instance field/method access. Guarding on "not a local" keeps a value named the
// same as a type (a local shadow) on the ordinary instance path.
fun isTypeBaseName(env: TEnv, base: String): Bool {
  if (base == "") { return false }
  if (tLocal(env, base).found == 1) { return false }
  if (cmIsVariantName(env.mtab, base)) { return false }
  return cmIsType(env.mtab, cmCanon(env.mtab, base))
}

// FATAL dot-access on a TYPE name (Phase M3 item 1 / Phase M4): `Type.sel` / `Type.sel()` where `Type` is
// a known nominal. Routed here so the bug family is killed on the DOT surface too, not just `::`:
//   - an undefined selector is a genuine no-member ("type X has no member Y"), issued BEFORE lowering so a
//     silent-0 / dangling `_sel` external (dyld crash) can never reach codegen;
//   - a member declared as a `const` OR an enum `variant` reached through `.` is the LOCKED cross-use error
//     ("use `::`") — the dot/`::` RULE binds const constants and enum variants with `::` (Enum::Variant),
//     methods+fields with `.`. Phase M4 flips variant-via-dot from the M3 permissive path to this error
//     (call sites in lib/examples/tests are migrated to `::` first, so the compiler+stdlib never trip it).
// Family-gated and permissive exactly like requireMember, so statics-via-dot (`List.of()`, a factory) that
// the compiler+stdlib rely on still resolve and build.
fun requireTypeMemberDot(env: TEnv, base: String, sel: String): Int {
  if (env.memLevel == 0) { return 0 }
  val tn = cmCanon(env.mtab, base)
  if (cmIsType(env.mtab, tn) == false) { return 0 }
  val mk = cmMemberKind(env.mtab, tn, sel)
  if (mk == "const" || mk == "variant") {
    if (memberFamilyEnabled(env, tn)) { tErr(env, "member " + (sel + (" of type " + (tn + " must be accessed with `::` not `.`")))) }
    return 0
  }
  if (cmHasMember(env.mtab, tn, sel)) { return 0 }
  if (cmHasFree(env.mtab, sel)) { return 0 }
  if (cmHasTraitMethod(env.mtab, sel)) { return 0 }
  if (memberFamilyEnabled(env, tn)) { tErr(env, "type " + (tn + (" has no member " + sel))) }
  return 0
}

fun inferField(env: TEnv, a: FExpr, f: String, isSafe: Int): Ty {
  // `Type.sel` (dot on a bare type name) is a STATIC access via dot — resolve the selector against the
  // member table (kill the silent-0 / dangling-symbol on a no-member), not an instance field access.
  val bn = when (a) { FEIdent(b) -> b; else -> "" }
  if (isTypeBaseName(env, bn)) { requireTypeMemberDot(env, bn, f); return TUnknown }
  val ta = infer(env, a)
  // NOTE: no requireMember here — inferFieldNamed already owns the "type X has no field Y" diagnostic for
  // own structs (fields + property accessors), so routing field access through requireMember would
  // double-fire. requireMember covers only the method-call (inferCall) and static (inferStatic) gaps.
  return when (ta) { TNamed(n, args) -> inferFieldNamed(env, n, f, isSafe); else -> TUnknown }
}

fun inferStatic(env: TEnv, a: FExpr, f: String): Ty {
  val base = when (a) { FEIdent(b) -> b; else -> "" }
  // Phase M4 cross-use: `::` binds const constants / enum variants / module paths / nested types — never a
  // VALUE. A `local::sel` whose base is a bound local is the locked "use `.` on a value" error. Guarded on
  // "is a local", so a type name (Color::Green), a module alias, or a type parameter stays on the normal
  // `::` path (they are not locals). Only fires under the fatal member gate, exactly like requireMember.
  if (env.memLevel != 0 && base != "" && tLocal(env, base).found == 1) {
    tErr(env, "member " + (f + (" of a value must be accessed with `.` not `::`")))
    return TUnknown
  }
  if (base != "") { requireMember(env, TNamed(base, intBuf()), f) }
  // `Enum::variant` VALUE has the enum type; an `Enum::CONST` associated constant (kind "const") does NOT —
  // it has its own declared type, so it falls through to the permissive TUnknown (like a struct assoc const).
  if (base != "" && memList(env.enumN, base)) { if (cmMemberKind(env.mtab, base, f) != "const") { return TNamed(base, intBuf()) } }
  infer(env, a)
  return TUnknown
}

// ---- generic instantiation (Target 1) ----
// A "concrete" type we can reason about for type-parameter binding consistency: a real primitive or a
// NON-type-parameter named type (a struct/enum/trait). Unknown / type-parameter / function types stay
// opaque, so binding against them never produces a definite mismatch.
fun isConcreteTy(t: Ty): Bool {
  return when (t) {
    TPrim(x) -> true
    TNamed(n, args) -> isTypeParam(n) == false
    TNull(x) -> isConcreteTy(x)
    else -> false
  }
}

// the head name of a type (Int, IntBuf, T, ...), "" for function/unknown types.
fun headNameOf(t: Ty): String { return when (t) { TPrim(x) -> x; TNamed(n, args) -> n; TNull(x) -> headNameOf(x); else -> "" } }

fun subFind(subN: IntBuf, n: String): Int {
  var i = 0
  while (i < subN.len()) { val x: String = subN.get(i); if (x == n) { return i }; i = i + 1 }
  return 0 - 1
}

// Bind type parameter `n` (from a callee's signature) to the argument type `at` for THIS call. Binding is
// per-call (a fresh subst per checkCallArgs), so unrelated calls never interfere. The consistency error
// fires ONLY when the same parameter is bound twice to two mutually-incompatible CONCRETE types — a
// definite type error under any instantiation (e.g. `fun f<T>(a: T, b: T)` called `f(1, "x")`). Any
// opaque binding (Unknown / another type-parameter) is permissive and upgrades toward the concrete one,
// so the checker never false-positives on genuinely-polymorphic code.
fun bindTypeVar(env: TEnv, subN: IntBuf, subT: IntBuf, n: String, at: Ty): Int {
  val j = subFind(subN, n)
  if (j < 0) { subN.push(n); subT.push(at); return 0 }
  val prev: Ty = subT.get(j)
  if (isUnknownT(prev) || isTypeParamTy(prev)) { subT.set(j, at); return 0 }
  if (isUnknownT(at) || isTypeParamTy(at)) { return 0 }
  if (isConcreteTy(prev) && isConcreteTy(at)) {
    if (compat(env.prim, at, prev) == false && compat(env.prim, prev, at) == false) {
      tErr(env, "type parameter " + (n + (" bound to incompatible types " + (showTy(prev) + (" and " + showTy(at))))))
    }
  }
  return 0
}

fun instTyList(l: IntBuf, subN: IntBuf, subT: IntBuf): IntBuf {
  val out = intBuf()
  var i = 0
  while (i < l.len()) { out.push(instTy(l.get(i), subN, subT)); i = i + 1 }
  return out
}

// Substitute bound type parameters into a type (used to instantiate a generic return type: `f(1)` where
// `fun f<T>(x: T): T` yields Int instead of the opaque T).
fun instTy(t: Ty, subN: IntBuf, subT: IntBuf): Ty {
  return when (t) {
    TNamed(n, args) -> {
      if (isTypeParam(n) && args.len() == 0) { val j = subFind(subN, n); if (j >= 0) { subT.get(j) } else { t } }
      else { TNamed(n, instTyList(args, subN, subT)) }
    }
    TNull(x) -> TNull(instTy(x, subN, subT))
    TFun(ps, r) -> TFun(instTyList(ps, subN, subT), instTy(r, subN, subT))
    else -> t
  }
}

// ---- trait-bounds enforcement (Target 2) ----
// GBounds is a callee's generic-parameter -> trait-bounds table (parallel lists), parsed from a FFunc's
// `gen` clause string (e.g. "<T: Show + Eq, U = Int>" -> names=[T,U], traits=[[Show,Eq],[]]).
struct GBounds(val names: IntBuf, val traits: IntBuf)

fun trimStr(s: String): String {
  val n = s.len()
  var a = 0
  while (a < n && s.charAt(a) == 32) { a = a + 1 }
  var b = n
  while (b > a && s.charAt(b - 1) == 32) { b = b - 1 }
  return s.substr(a, b - a)
}

// split `s` on separator char `sep`, but only at angle-bracket depth 0 (so `RawMap<K, V>` stays whole);
// each piece is trimmed.
fun topSplit(s: String, sep: Int): IntBuf {
  val out = intBuf()
  val n = s.len()
  var depth = 0
  var start = 0
  var i = 0
  while (i <= n) {
    if (i == n) { out.push(trimStr(s.substr(start, i - start))) }
    else {
      val c = s.charAt(i)
      if (c == 60) { depth = depth + 1 }
      else { if (c == 62) { depth = depth - 1 }
        else { if (c == sep && depth == 0) { out.push(trimStr(s.substr(start, i - start))); start = i + 1 } } }
    }
    i = i + 1
  }
  return out
}

// leading identifier of a (trimmed) type string: `Show<T>` -> `Show`, `Show` -> `Show`.
fun headIdent(s: String): String {
  val n = s.len()
  var i = 0
  while (i < n && s.charAt(i) != 60 && s.charAt(i) != 32) { i = i + 1 }
  return s.substr(0, i)
}

fun parseGenBounds(gen: String): GBounds {
  val names = intBuf()
  val traits = intBuf()
  if (gen == "") { return GBounds(names, traits) }
  val n = gen.len()
  var body = gen
  if (n >= 2 && gen.charAt(0) == 60) { body = gen.substr(1, n - 2) } // strip < >
  val segs = topSplit(body, 44) // ','
  var i = 0
  while (i < segs.len()) {
    val seg: String = segs.get(i)
    val sl = seg.len()
    var colon = 0 - 1
    var eq = 0 - 1
    var depth = 0
    var k = 0
    while (k < sl) {
      val c = seg.charAt(k)
      if (c == 60) { depth = depth + 1 } else { if (c == 62) { depth = depth - 1 } else {
          if (depth == 0 && c == 58 && colon < 0) { colon = k } // ':'
          if (depth == 0 && c == 61 && eq < 0) { eq = k } // '='
        } }
      k = k + 1
    }
    var nameEnd = sl
    if (colon >= 0) { nameEnd = colon } else { if (eq >= 0) { nameEnd = eq } }
    val nm = trimStr(seg.substr(0, nameEnd))
    val trs = intBuf()
    if (colon >= 0) {
      var bEnd = sl
      if (eq >= 0 && eq > colon) { bEnd = eq }
      val boundStr = seg.substr(colon + 1, bEnd - colon - 1)
      val parts = topSplit(boundStr, 43) // '+'
      var j = 0
      while (j < parts.len()) { val pnm = headIdent(trimStr(parts.get(j))); if (pnm != "") { trs.push(pnm) }; j = j + 1 }
    }
    names.push(nm)
    traits.push(trs)
    i = i + 1
  }
  return GBounds(names, traits)
}

fun boundsOf(gb: GBounds, n: String): IntBuf {
  var i = 0
  while (i < gb.names.len()) { if (gb.names.get(i) == n) { return gb.traits.get(i) }; i = i + 1 }
  return intBuf()
}

// When a type parameter `n: SomeTrait` is instantiated with a CONCRETE type `at`, require that type to
// impl the trait (via the collected impl registry). Only concrete types are checked, so passing another
// type parameter through (`fun g<T: Show>(x: T) = describe(x)`) never false-positives.
fun checkBound(env: TEnv, gb: GBounds, n: String, at: Ty): Int {
  if (isConcreteTy(at) == false) { return 0 }
  val ts = boundsOf(gb, n)
  val cn = headNameOf(at)
  var i = 0
  while (i < ts.len()) {
    val tr: String = ts.get(i)
    if (implsTrait(env, cn, tr) == false) {
      tErr(env, "type " + (showTy(at) + (" does not satisfy trait bound " + (tr + (" on type parameter " + n)))))
    }
    i = i + 1
  }
  return 0
}

// The callee's generic-bounds table: a named top-level function carries its `gen` clause in funG; any
// other callee (struct constructor, local, method) has no bounds.
fun calleeBounds(env: TEnv, f: FExpr): GBounds {
  val nm = when (f) { FEIdent(s) -> s; else -> "" }
  if (nm == "") { return GBounds(intBuf(), intBuf()) }
  var i = 0
  while (i < env.funN.len()) { if (env.funN.get(i) == nm) { return parseGenBounds(env.funG.get(i)) }; i = i + 1 }
  return GBounds(intBuf(), intBuf())
}

fun checkCallArgs(env: TEnv, params: IntBuf, args: IntBuf, ret: Ty, gb: GBounds): Ty {
  if (params.len() != args.len()) {
    tErr(env, "wrong number of arguments: expected " + (params.len().toStr() + (", got " + args.len().toStr())))
    return ret
  }
  val subN = intBuf()
  val subT = intBuf()
  var i = 0
  while (i < params.len()) {
    val pt: Ty = params.get(i)
    val ar: FArg = args.get(i)
    val at = infer(env, ar.expr)
    // A bare type parameter (single-uppercase head, no args) is instantiated by unification: bind it to
    // the arg type, check cross-occurrence consistency, and enforce its declared trait bounds. Everything
    // else keeps the exact prior structural compat + trait-subtype check, so non-generic calls are
    // byte-identical to before.
    if (isTypeParamTy(pt)) { bindTypeVar(env, subN, subT, headNameOf(pt), at); checkBound(env, gb, headNameOf(pt), at) }
    else { if (adoptArgLit(env, ar.expr, pt)) { 0 } else { if (compat(env.prim, at, pt) == false) { if (subtypeOk(env, at, pt) == false) { tErr(env, "argument type " + (showTy(at) + (" is not compatible with parameter " + showTy(pt)))) } } } }
    i = i + 1
  }
  return instTy(ret, subN, subT)
}

fun inferArgList(env: TEnv, args: IntBuf): Int {
  var i = 0
  while (i < args.len()) { val ar: FArg = args.get(i); infer(env, ar.expr); i = i + 1 }
  return 0
}

// The callee of a `recv.m(..)` call. When `recv` is a bare TYPE NAME (`Type.m(..)`, a static call via dot)
// resolve `m` against the member table as a static (requireTypeMemberDot) — an undefined `Type.m()` is a
// no-member error before lowering. Otherwise it is an ordinary instance method call: infer the receiver's
// type and route through requireMember (the value-receiver gap).
fun inferMethodOrStaticDot(env: TEnv, recv: FExpr, m: String): Int {
  val bn = when (recv) { FEIdent(b) -> b; else -> "" }
  if (isTypeBaseName(env, bn)) { requireTypeMemberDot(env, bn, m); return 0 }
  val tr = infer(env, recv)
  requireMember(env, tr, m)
  return 0
}

// A call whose callee is a field-expr is a METHOD CALL (`recv.m(args)`), not a field access. Check the
// receiver and args, but do NOT run field-access checking on the callee (which would falsely report
// "type X has no field m"). Method dispatch/return types aren't modeled → TUnknown.
// a SECONDARY CONSTRUCTOR `<Owner>(args)` — an `Owner___ctor_<arity>` assoc factory is registered for the
// argument count. Its member selector is `__ctor_<arity>` (from parseSecondaryCtor). "" base or no such
// member => not a secondary-ctor call.
fun hasSecondaryCtor(env: TEnv, nm: String, arity: Int): Bool {
  if (nm == "") { return false }
  return cmMemberKind(env.mtab, nm, "__ctor_" + arity.toStr()) != ""
}

// number of top-level function definitions named `nm` (an overload set when > 1).
fun funOverloadCount(env: TEnv, nm: String): Int {
  var c = 0
  var i = 0
  while (i < env.funN.len()) { if (env.funN.get(i) == nm) { c = c + 1 }; i = i + 1 }
  return c
}

// do all argument types `ats` fit the parameter types `ps` (structural compat OR trait-subtype)?
fun overloadParamsFit(env: TEnv, ps: IntBuf, ats: IntBuf): Bool {
  if (ps.len() != ats.len()) { return false }
  var i = 0
  while (i < ps.len()) {
    val pt: Ty = ps.get(i); val at: Ty = ats.get(i)
    if (isTypeParamTy(pt) == false) { if (compat(env.prim, at, pt) == false) { if (subtypeOk(env, at, pt) == false) { return false } } }
    i = i + 1
  }
  return true
}

// resolve an OVERLOADED free call `nm(args)` to the matching overload's RETURN type. Arg types are inferred
// once; among the same-name overloads, arity-first then type-fit selects the unique match. A unique fit wins;
// zero or multiple fits is accepted leniently (TUnknown) — the klower resolver is the final arbiter and emits
// the 'ambiguous overload' hard error, so the checker never false-rejects a genuinely-overloaded call.
fun resolveOverloadRet(env: TEnv, nm: String, args: IntBuf): Ty {
  val ats = intBuf()
  var a = 0
  while (a < args.len()) { val ar: FArg = args.get(a); ats.push(infer(env, ar.expr)); a = a + 1 }
  var best = TUnknown
  var nmatch = 0
  var i = 0
  while (i < env.funN.len()) {
    if (env.funN.get(i) == nm) { val ps: IntBuf = env.funP.get(i); if (overloadParamsFit(env, ps, ats)) { nmatch = nmatch + 1; best = env.funR.get(i) } }
    i = i + 1
  }
  if (nmatch == 1) { return best }
  return TUnknown
}

// the vararg FIXED-param count registered for free function `nm` (parallel to funN), or -1 if `nm` is not
// a variadic free function. Used to relax the strict arity check on a call to a single vararg definition.
fun funVarargFixed(env: TEnv, nm: String): Int {
  var i = 0
  while (i < env.funN.len()) { if (env.funN.get(i) == nm) { if (env.funVA.get(i) >= 0) { return env.funVA.get(i) } }; i = i + 1 }
  return 0 - 1
}

// the ELEMENT type E of vararg free function `nm` — the type-arg of its trailing `Array<E>` param.
fun funVarargElemTy(env: TEnv, nm: String): Ty {
  var i = 0
  while (i < env.funN.len()) {
    if (env.funN.get(i) == nm) { if (env.funVA.get(i) >= 0) {
      val ps: IntBuf = env.funP.get(i)
      if (ps.len() >= 1) { val last: Ty = ps.get(ps.len() - 1); return when (last) { TNamed(hn, ta) -> if (ta.len() >= 1) { ta.get(0) } else { TUnknown }; else -> TUnknown } }
    } }
    i = i + 1
  }
  return TUnknown
}

// type-check a call to a vararg free function `nm`: the FIXED args (positions < `fixed`) against the fixed
// parameters, and every TRAILING arg against the element type E (lenient compat||subtype, as elsewhere).
// Returns the function's declared return type. No strict arity error — a vararg accepts >= `fixed` args.
fun checkVarargCall(env: TEnv, nm: String, args: IntBuf, fixed: Int): Ty {
  var fps = TUnknown
  var fret = TUnknown
  var i = 0
  while (i < env.funN.len()) { if (env.funN.get(i) == nm) { if (env.funVA.get(i) >= 0) { fps = TFun(env.funP.get(i), env.funR.get(i)); fret = env.funR.get(i) } }; i = i + 1 }
  val fparams = when (fps) { TFun(ps, r) -> ps; else -> intBuf() }
  val elem = funVarargElemTy(env, nm)
  var a = 0
  while (a < args.len()) {
    val ar: FArg = args.get(a)
    val at = infer(env, ar.expr)
    if (a < fixed) {
      if (a < fparams.len()) { val pt: Ty = fparams.get(a)
        if (isTypeParamTy(pt) == false) { if (adoptArgLit(env, ar.expr, pt)) { 0 } else { if (compat(env.prim, at, pt) == false) { if (subtypeOk(env, at, pt) == false) { tErr(env, "argument type " + (showTy(at) + (" is not compatible with parameter " + showTy(pt)))) } } } } }
    }
    else {
      // A generic vararg element type E (a bare type param, e.g. `vararg xs: T` reached via a turbofish
      // `vecOf::<Int>(..)`) is satisfied by any arg — the concrete E is bound at the call, checked by the
      // lowerer's monomorphization; only a CONCRETE element type gets the compat/subtype check.
      if (isTypeParamTy(elem)) { 0 } else { if (adoptArgLit(env, ar.expr, elem)) { 0 } else { if (compat(env.prim, at, elem) == false) { if (subtypeOk(env, at, elem) == false) { tErr(env, "vararg argument type " + (showTy(at) + (" is not compatible with element type " + showTy(elem)))) } } } }
    }
    a = a + 1
  }
  return fret
}

fun inferCall(env: TEnv, f: FExpr, args: IntBuf): Ty {
  return when (f) {
    FEField(recv, m) -> { inferMethodOrStaticDot(env, recv, m); inferArgList(env, args); TUnknown }
    FESafeField(recv, m) -> { inferMethodOrStaticDot(env, recv, m); inferArgList(env, args); TUnknown }
    else -> {
      val nm = when (f) { FEIdent(s) -> s; else -> "" }
      // A turbofish call `f::<..>(args)` has an FETypeApp callee — unwrap it to the inner free-fn name so an
      // `@mono` overload set (incl. a `vararg`) routes through the same overload/vararg logic as a bare call.
      // Kept separate from `nm` so the secondary-ctor path below (keyed on `nm`) is byte-unchanged.
      val tnm = when (f) { FEIdent(s) -> s; FETypeApp(inner, t) -> when (inner) { FEIdent(s2) -> s2; else -> "" }; else -> "" }
      // A secondary-constructor call `Owner(args)` whose arity matches a `__ctor_<arity>` factory (not the
      // primary field list) is accepted with the owner type — bypassing the primary-ctor arity check.
      if (cmIsType(env.mtab, nm) && hasSecondaryCtor(env, nm, args.len())) { inferArgList(env, args); TNamed(nm, intBuf()) }
      else { if (tnm != "" && funOverloadCount(env, tnm) > 1) {
        // OVERLOADED free function: arity-first + arg-type selection against the overload set (lenient tie).
        resolveOverloadRet(env, tnm, args)
      }
      else {
        // VARARG free function (single definition): accept >= fixed args, check fixed vs params and
        // trailing vs element type E — no strict arity error (the lowerer collects the tail into Array<E>).
        val vf = if (tnm != "") { funVarargFixed(env, tnm) } else { 0 - 1 }
        if (vf >= 0) { checkVarargCall(env, tnm, args, vf) }
        else {
        val tf = infer(env, f)
        inferArgList(env, args)
        when (tf) { TFun(params, ret) -> checkCallArgs(env, params, args, ret, calleeBounds(env, f)); else -> TUnknown } }
      } }
    }
  }
}

// Phase-8 literal FLIP: a `[..]` literal is a first-class `Vec<T>` (was the erased IntBuf). T is the join of
// the element types (Unknown for an empty `[]`, which unifies with any `Vec<T>` annotation). Vec + its
// methods (push/get/pop/…) are prelude-injected, so `xs.pop()` on a `[..]` literal resolves.
fun inferList(env: TEnv, es: IntBuf): Ty {
  var acc = TUnknown
  var i = 0
  while (i < es.len()) { val x: FExpr = es.get(i); acc = joinTy(env.prim, acc, infer(env, x)); i = i + 1 }
  return TNamed(cmSeqDefault(env.mtab), cons1(acc))
}

// Phase-8 literal FLIP: a `[k:v]` map literal is a first-class `HashMap<K,V>` (was the erased RawMap). K is
// the join of the key types, V the join of the value types (Unknown for a non-homogeneous column, which
// unifies with any `HashMap<K,V>` annotation). HashMap + its methods (get/set/getOr/has/size/…) are
// prelude-injected, so `m.getOr(k, d)` on a `[k:v]` literal resolves. `m[k]` types as `Option<V>` — see
// indexResTy — so a miss is a None the code must handle, not a silent 0 (Kotlin's `V?`).
fun inferMap(env: TEnv, ents: IntBuf): Ty {
  var kacc = TUnknown
  var vacc = TUnknown
  var i = 0
  while (i < ents.len()) { val en: FMapEnt = ents.get(i); kacc = joinTy(env.prim, kacc, infer(env, en.k)); vacc = joinTy(env.prim, vacc, infer(env, en.v)); i = i + 1 }
  val l = intBuf(); l.push(kacc); l.push(vacc)
  return TNamed(cmMapDefault(env.mtab), l)
}

// the static type of `a[ix]`: `Option<V>` when `a` is a `HashMap<K,V>` (Kotlin `map[k]: V?`), so an
// unhandled miss surfaces at the type level; every other receiver (RawMap/IntBuf/Vec/String/…) stays the
// lenient `TUnknown` — the pre-flip index behavior, so RawMap's raw-value indexing is unchanged.
fun indexResTy(mt: CMTab, at: Ty): Ty {
  return when (at) {
    TNamed(n, args) -> if (n == cmMapDefault(mt) && args.len() >= 2) { TNamed("Option", cons1(args.get(1))) } else { TUnknown }
    else -> TUnknown
  }
}

fun inferLambda(env: TEnv, params: String, body: FExpr): Ty {
  val saved = tPush(env)
  val ptys = intBuf()
  val pairs = splitLamPairs(params)
  var i = 0
  while (i < pairs.len()) {
    val lp: LP = pairs.get(i)
    val ty = if (lp.ty == "") { TUnknown } else { parseTyStr(env.prim, lp.ty) }
    ptys.push(ty); tBind(env, lp.name, ty); i = i + 1
  }
  val bt = infer(env, body)
  tPop(env, saved)
  return TFun(ptys, bt)
}

fun inferIf(env: TEnv, c: FExpr, t: FExpr, el: FExpr): Ty {
  requireBool(env, infer(env, c), "if")
  val tt = infer(env, t)
  if (isNoResF(el)) { return tt }
  return joinTy(env.prim, tt, infer(env, el))
}

fun inferInterp(env: TEnv, parts: IntBuf): Int {
  var i = 0
  while (i < parts.len()) { val pt: FIPart = parts.get(i); when (pt) { FIExpr(e) -> infer(env, e); else -> TUnknown }; i = i + 1 }
  return 0
}

fun bindPattern(env: TEnv, pat: FPat): Int {
  return when (pat) {
    FPBind(s) -> tBind(env, s, TUnknown)
    FPInP(e, neg) -> { infer(env, e); 0 }
    FPCtor(pth, subs) -> { var i = 0; while (i < subs.len()) { bindPattern(env, subs.get(i)); i = i + 1 }; 0 }
    FPRecord(pth, flds, hasRest) -> bindRecordPat(env, flds)
    else -> 0
  }
}

fun bindRecordPat(env: TEnv, flds: IntBuf): Int {
  var i = 0
  while (i < flds.len()) { val f: FRFld = flds.get(i); if (f.hasPat == 1) { bindPattern(env, f.pat) } else { tBind(env, f.name, TUnknown) }; i = i + 1 }
  return 0
}

fun inferWhen(env: TEnv, hasSubj: Int, bind: String, subj: FExpr, arms: IntBuf): Ty {
  if (hasSubj == 1) { infer(env, subj) }
  val bn = whenBindName(bind)
  var acc = TUnknown
  var i = 0
  while (i < arms.len()) {
    val a: FArm = arms.get(i)
    val saved = tPush(env)
    if (a.kind == 0) { requireBool(env, infer(env, a.lhs), "when") }
    else { if (a.kind == 2) { var j = 0; while (j < a.pats.len()) { bindPattern(env, a.pats.get(j)); j = j + 1 } } }
    if (hasSubj == 1 && bn != "") { tBind(env, bn, TUnknown) }
    if (isNoResF(a.guard) == false) { requireBool(env, infer(env, a.guard), "guard") }
    acc = joinTy(env.prim, acc, infer(env, a.body))
    tPop(env, saved)
    i = i + 1
  }
  return acc
}

fun inferBlock(env: TEnv, stmts: IntBuf, res: FExpr): Ty {
  val saved = tPush(env)
  var i = 0
  while (i < stmts.len()) { checkStmt(env, stmts.get(i)); i = i + 1 }
  var rt = TPrim("Unit")
  if (isNoResF(res) == false) { rt = infer(env, res) }
  tPop(env, saved)
  return rt
}

fun infer(env: TEnv, e: FExpr): Ty {
  return when (e) {
    FEInt(t) -> inferIntLit(env, t)
    FEFloat(t) -> TPrim("Double")
    FEStr(t, r) -> TPrim("String")
    FEInterp(parts, r) -> { inferInterp(env, parts); TPrim("String") }
    FEChar(t) -> TPrim("Char")
    FEBool(b) -> TPrim("Bool")
    FENull -> TNull(TUnknown)
    FEThis -> TUnknown
    FEBrk -> TPrim("Nothing")
    FECont -> TPrim("Nothing")
    FERet(x) -> TPrim("Nothing")
    FEIdent(s) -> inferIdent(env, s)
    FEFnRef(nm) -> inferFnRef(env, nm)
    FEUnary(op, a) -> inferUnary(env, op, a)
    FEBin(op, a, b) -> inferBinary(env, op, a, b)
    FEElvis(a, b) -> { infer(env, a); infer(env, b) }
    FENotNull(a) -> inferNotNull(env, a)
    FEField(a, f) -> inferField(env, a, f, 0)
    FESafeField(a, f) -> inferField(env, a, f, 1)
    FEStatic(a, f) -> inferStatic(env, a, f)
    FETypeApp(a, t) -> infer(env, a)
    FECast(a, ty) -> inferCast(env, a, ty)
    FEQuestion(a) -> { infer(env, a); TUnknown }
    FECall(f, args) -> inferCall(env, f, args)
    FEIndex(a, ix) -> { val at = infer(env, a); infer(env, ix); indexResTy(env.mtab, at) }
    FEList(es) -> inferList(env, es)
    FEMap(ents) -> inferMap(env, ents)
    FELambda(params, body) -> inferLambda(env, params, body)
    FEIf(c, t, el) -> inferIf(env, c, t, el)
    FEWhen(hasSubj, bind, subj, arms) -> inferWhen(env, hasSubj, bind, subj, arms)
    FEBlock(stmts, res) -> inferBlock(env, stmts, res)
    else -> TUnknown
  }
}

// the type ARGUMENTS of a named type (`Vec<Int>` -> [Int], `HashMap<K,V>` -> [K,V]); empty for a bare type.
fun tyArgsOf(t: Ty): IntBuf { return when (t) { TNamed(n, a) -> a; else -> intBuf() } }
// erased-generic arg compatibility (mirrors compatNamedR's rule): compatible when either side omits its
// type args, else element-wise compatible.
fun protoArgsOk(reg: PReg, litArgs: IntBuf, annoArgs: IntBuf): Bool {
  if (litArgs.len() == 0) { return true }
  if (annoArgs.len() == 0) { return true }
  return compatList(reg, litArgs, annoArgs)
}
// EXPECTED-TYPE opt-in: a `[..]`/`[k:v]` literal (inferred `it` = Vec<E> / HashMap<K,V>) is assignable to a
// protocol-implementor annotation `dt` even though its base name differs — this is what lets `val xs:
// MyList<Int> = [1,2,3]` type-check. The element types are still checked (protoArgsOk), so a wrong-element
// literal (`MyList<Int> = ["a"]`) is still rejected. Vec/HashMap annotations already pass via plain compat;
// this only ADDS the user opt-in, so no existing program's diagnostics change.
fun collectionLitCompat(env: TEnv, init: FExpr, it: Ty, dt: Ty): Bool {
  return when (dt) {
    TNamed(n, a) -> when (init) {
      FEList(es) -> cmIsSeqProto(env.mtab, n) && protoArgsOk(env.prim, tyArgsOf(it), a)
      FEMap(ents) -> cmIsMapProto(env.mtab, n) && protoArgsOk(env.prim, tyArgsOf(it), a)
      else -> false
    }
    else -> false
  }
}

fun checkLet(env: TEnv, name: String, ty: String, init: FExpr): Int {
  if (ty == "") { val it0 = infer(env, init); tBind(env, name, it0); return 0 }
  val dt = parseTyStr(env.prim, ty)
  reservedTyErr(env, dt)
  // A bare integer literal adopts an integer annotation (val x: U16 = 300) with a compile-time range
  // check, instead of the generic compat test (which would reject Int vs U16 under the tightened rule).
  if (adoptBareIntLit(env, init, dt)) { tBind(env, name, dt); return 0 }
  val it = infer(env, init)
  // A collection literal bound to an opt-in protocol implementor (`val xs: MyList<Int> = [1,2,3]`) is
  // accepted before the base-name compat test (which would reject Vec<Int> vs MyList<Int>).
  if (collectionLitCompat(env, init, it, dt)) { tBind(env, name, dt); return 0 }
  if (compat(env.prim, it, dt) == false) { tErr(env, "cannot assign " + (showTy(it) + (" to " + (showTy(dt) + (" " + name))))) }
  tBind(env, name, dt)
  return 0
}

fun checkReturnV(env: TEnv, e: FExpr): Int {
  val t = infer(env, e)
  // `return [..]`/`[k:v]` from a function whose return type is a protocol implementor (Vec/HashMap or a user
  // opt-in type) is accepted the same way the `val` binding is.
  if (env.hasRet == 1 && compat(env.prim, t, env.curRet) == false) { if (collectionLitCompat(env, e, t, env.curRet) == false) { if (subtypeOk(env, t, env.curRet) == false) { tErr(env, "return type " + (showTy(t) + (" is not compatible with " + showTy(env.curRet)))) } } }
  return 0
}

fun checkReturnU(env: TEnv): Int {
  if (env.hasRet == 1 && compat(env.prim, TPrim("Unit"), env.curRet) == false) { tErr(env, "return type Unit is not compatible with " + showTy(env.curRet)) }
  return 0
}

fun checkFor(env: TEnv, v: String, it: FExpr, b: FExpr): Int {
  infer(env, it)
  val saved = tPush(env)
  tBind(env, v, TUnknown)
  infer(env, b)
  tPop(env, saved)
  return 0
}

fun checkStmt(env: TEnv, s: FStmt): Int {
  return when (s) {
    FSLet(isVar, name, ty, init) -> checkLet(env, name, ty, init)
    FSExprS(e) -> { infer(env, e); 0 }
    FSAssign(l, r) -> { infer(env, l); infer(env, r); 0 }
    FSReturnV(e) -> checkReturnV(env, e)
    FSReturnU -> checkReturnU(env)
    FSWhile(c, b) -> { requireBool(env, infer(env, c), "while"); infer(env, b); 0 }
    FSFor(v, it, b) -> checkFor(env, v, it, b)
    else -> 0
  }
}

fun shouldCheckBody(body: FExpr): Bool {
  return when (body) { FEBlock(stmts, res) -> isNoResF(res) == false; else -> true }
}

fun checkFun(env: TEnv, fd: FFunc): Int {
  if (isNoResF(fd.body)) { return 0 }
  val saved = tPush(env)
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); val pt = parseTyStr(env.prim, pp.ty); reservedTyErr(env, pt); tBind(env, pp.name, pt); i = i + 1 }
  val prevRet = env.curRet
  val prevHas = env.hasRet
  env.curRet = retTy(env.prim, fd.ret)
  reservedTyErr(env, env.curRet)
  env.hasRet = 1
  val bt = infer(env, fd.body)
  // A collection-literal EXPR-BODY (`fun f(): MySeq<Int> = [1,2,3]`) against a protocol-implementor return
  // type is accepted the same way `checkReturnV` accepts a block-body `return [..]` — element-type compat is
  // still enforced by collectionLitCompat (a wrong-element literal, or a roleless annotation, still fails),
  // so this only ADDS the opt-in expr-body form; it never opens a compiles-then-crashes path.
  if (shouldCheckBody(fd.body) && fd.ret != "" && compat(env.prim, bt, env.curRet) == false && tyEqPrim(bt, "Nothing") == false && collectionLitCompat(env, fd.body, bt, env.curRet) == false) {
    tErr(env, "function " + (fd.name + (" body has type " + (showTy(bt) + (", expected " + showTy(env.curRet))))))
  }
  env.curRet = prevRet
  env.hasRet = prevHas
  tPop(env, saved)
  return 0
}

fun checkMethods(env: TEnv, methods: IntBuf): Int {
  var i = 0
  while (i < methods.len()) { checkFun(env, methods.get(i)); i = i + 1 }
  return 0
}

fun checkDecl(env: TEnv, d: Decl): Int {
  return when (d) {
    DFun(fd) -> checkFun(env, fd)
    DType(kind, td) -> { if (isNoResF(td.dtor) == false) { val sv = tPush(env); infer(env, td.dtor); tPop(env, sv) } checkMethods(env, td.methods) }
    DEnum(ed) -> checkMethods(env, ed.methods)
    DTrait(tr) -> checkMethods(env, tr.methods)
    DImpl(im) -> checkMethods(env, im.methods)
    else -> 0
  }
}

// the vararg FIXED-parameter count of a function's signature: (#params - 1) when the LAST param is a
// vararg, else -1 (not variadic). Recorded parallel to funN so an overloaded-away arity check is skipped.
fun funVarargFixedOf(fd: FFunc): Int {
  val n = fd.params.len()
  if (n == 0) { return 0 - 1 }
  val last: FParam = fd.params.get(n - 1)
  if (last.isVararg == 1) { return n - 1 }
  return 0 - 1
}

fun addFunSig(env: TEnv, fd: FFunc): Int {
  val ptys = intBuf()
  var i = 0
  while (i < fd.params.len()) { val pp: FParam = fd.params.get(i); ptys.push(parseTyStr(env.prim, pp.ty)); i = i + 1 }
  env.funN.push(fd.name); env.funP.push(ptys); env.funR.push(retTy(env.prim, fd.ret)); env.funG.push(fd.gen); env.funVA.push(funVarargFixedOf(fd))
  return 0
}

fun addStructSig(env: TEnv, td: FTDecl): Int {
  val fns = intBuf(); val fts = intBuf()
  var i = 0
  while (i < td.fields.len()) { val f: FFld = td.fields.get(i); fns.push(f.name); fts.push(parseTyStr(env.prim, f.ty)); i = i + 1 }
  env.structN.push(td.name); env.structFN.push(fns); env.structFT.push(fts)
  return 0
}

// Seed ONLY function signatures from a decl list (used for the prelude): structs/enums/impls are
// deliberately skipped so prelude nominal types stay opaque to field-access checking.
fun collectFunSigsOnly(env: TEnv, decls: IntBuf): Int {
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    when (d) { DFun(fd) -> addFunSig(env, fd); else -> 0 }
    i = i + 1
  }
  return 0
}

fun collectSigs(env: TEnv, decls: IntBuf): Int {
  var i = 0
  while (i < decls.len()) {
    val d: Decl = decls.get(i)
    when (d) {
      DFun(fd) -> addFunSig(env, fd)
      DType(kind, td) -> addStructSig(env, td)
      DEnum(ed) -> env.enumN.push(ed.name)
      DImpl(im) -> { if (im.traitName != "") { env.implN.push(im.forTy); env.implT.push(im.traitName) }; 0 }
      else -> 0
    }
    i = i + 1
  }
  return 0
}

fun typecheckCheck(decls: IntBuf, lines: IntBuf): IntBuf {
  val diags = intBuf()
  // The prelude decl list is parsed ONCE: it seeds the primitive registry (@prim markers in
  // lib/core/num.kite -> PReg, the checker's whole numeric classification) AND the function signatures.
  val pdecls = preludeDeclList()
  // Phase M3: build the REAL member table (prelude + user decls) and turn the FATAL member gate on at
  // level 3 — ALL receiver families (own structs/enums, then builtin nominals, then primitives), widened
  // one at a time and full-gated at each step (2a own, 2b +builtin, 2c +primitive). shadowOn stays 0 (the
  // TEnv shadow log is the resolver's job); the member check emits real diagnostics via requireMember,
  // gated by receiver-family (memberFamilyEnabled). A level-3 shadow probe over the whole compiler+stdlib+
  // test corpus surfaced 0 false positives, so a genuinely-undefined selector on ANY known type now errors.
  val env = TEnv(intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), intBuf(), TUnknown, 0, intBuf(), intBuf(), diags, 0, buildPReg(pdecls), buildCMTab(pdecls, decls), intBuf(), 0, 3)
  collectSigs(env, decls)
  // Seed prelude/lib FUNCTION signatures so their calls are arg-type-checked exactly like user calls (an
  // unsound gap otherwise: a wrong-typed argument to a stdlib function slipped through). Only functions
  // are seeded — NOT prelude structs/enums — so field-access checking is unaffected (prelude nominal
  // types like IntBuf keep their erased/opaque treatment, and property-getter accessors on them are not
  // mis-flagged as missing fields). User decls are collected FIRST, so on a name collision inferIdent's
  // first-match keeps the user's definition.
  collectFunSigsOnly(env, pdecls)
  var i = 0
  while (i < decls.len()) { env.curLine = lines.get(i); checkDecl(env, decls.get(i)); i = i + 1 }
  return diags
}

// Parse a token stream and return ONLY the shadow-log lines (empty = every selector resolved). Mirrors
// checkDiagsT's parse, but runs the RESOLVER shadow traversal (Phase M2) instead of the check gate.
fun shadowDiags(toks: IntBuf): IntBuf {
  val lines = intBuf()
  val decls = parseProgramLn(toks, lines)
  return resolveShadow(decls, lines)
}

// checkDiags is the reusable entry: parse a token stream, run name-resolution + type-check, return the
// combined diagnostics list (empty = clean). No `main` here — kcheck is a LIBRARY now, so it can be
// quoted-included into kitec.kite alongside klower (which owns `main`). The `kitec check` verb (klower's
// checkOnly) is the entry point that drives it.
fun checkDiags(toks: IntBuf, skipDup: Int): IntBuf {
  val lines = intBuf()
  val decls = parseProgramLn(toks, lines)
  val diags = resolveCheck(decls, lines, skipDup)
  val td = typecheckCheck(decls, lines)
  var k = 0
  while (k < td.len()) { diags.push(td.get(k)); k = k + 1 }
  return diags
}
