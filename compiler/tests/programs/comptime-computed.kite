fun buildLen(n: Int): Int {
  val xs = listNew()
  var i = 0
  while (i < n) { listPush(xs, i * i)
    i = i + 1 }
  return listLen(xs)
}

fun sumBuilt(n: Int): Int {
  val xs = listNew()
  var i = 0
  while (i < n) { listPush(xs, i)
    i = i + 1 }
  var s = 0
  var j = 0
  while (j < listLen(xs)) { s = s + listGet(xs, j)
    j = j + 1 }
  return s
}

fun repLen(s: String, n: Int): Int {
  var out = ""
  var i = 0
  while (i < n) { out = concat(out, s)
    i = i + 1 }
  return strLen(out)
}

fun main(): Int {
  val a = comptime(buildLen(5))
  val b = comptime(sumBuilt(5))
  val c = comptime(strLen(concat("ab", "cd")))
  val d = comptime(repLen("xy", 3))
  return a + b + c + d
}
