// kite::core::num — the numeric primitives' LIBRARY HOME (STDLIB-REDESIGN §2a/§3d).
//
// Every scalar the compiler recognizes is DECLARED here, in lib, not hardcoded in the checker. Each
// `@prim("<kind>", <bits>)` marker names one primitive and carries its machine classification:
//
//   kind: "sint" signed-int · "uint" unsigned-int · "float" · "bool" · "char" · "string"
//         "unit" · "never" (bottom) · "reserved" (I128/U128 — recognized, not yet implemented)
//   bits: storage width (8/16/32/64); word types are 64. Consulted only for the integer tower.
//
// The checker's `buildPReg` collects these during the prelude pass (exactly like @lang/@arc), and
// `primKind`/`primBits`/`primIsInt`/`primIsSigned`/… READ that table instead of a baked strEq switch.
// The markers are signature-only: the type-checker skips them (no body) and codegen emits nothing of
// substance — they exist purely to carry the classification a primitive's name maps to. A2: registers
// are always 64-bit words; the width lives in the TYPE, so a U16 computes in an X-register like an Int.
//
// NAMING (Phase A — Kotlin-primary + explicit-width aliases). The PRIMARY (canonical) name of each
// primitive carries its @prim classification; the explicit-width alias carries `@alias("<Primary>")` so
// the checker CANONICALIZES the alias to its primary (same type-id, freely interchangeable). Canon:
//   Byte(sint8, alias I8) · Short(sint16, alias I16) · Int(sint32, alias I32) · Long(sint64, alias I64)
//   UByte(uint8, U8) · UShort(uint16, U16) · UInt(uint32, U32) · ULong(uint64, U64)
//   ISize/USize (ptr word, no alias) · Float(f32, F32) · Double(f64, F64) · Nothing(bottom, alias Never)
// The dropped Int8../UInt8../old-sint64-over-aliases are GONE; Byte is now SIGNED 8-bit (was uint8) —
// unsigned bytes are UByte/U8. WIDTH is unchanged this phase: `Int` keeps its 64-bit @prim (Phase BC
// narrows it to sint32); each fixed-width alias keeps its true width so sizeOf<I8>/<I16>/<I32> and casts
// stay 8/16/32. An alias defers TYPE-IDENTITY to its primary via @alias but keeps its own @prim so
// recognition/sizeOf/range-checks read a width directly; only the checker's compat canonicalizes.

// ---- signed integer tower (primaries + explicit-width aliases) ----
// Each scalar is a `@prim class`: a NON-BOXING value class. The @prim marker diverts it away from the
// heap-layout (structN) and auto-ARC (classN) tables in klower's collectDecl, so it is an unboxed
// primitive — byte-for-byte the old `@prim fun Int()`, only the declaration syntax now reads as a type.
@prim("sint", 8) class Byte
@prim("sint", 16) class Short
// Int is a 32-bit signed integer (Phase BC narrowed it from the 64-bit word). The pointer-width machine
// word is now Long/ISize/USize, NOT Int — addresses/sizes/buffer pointers carry those types.
@prim("sint", 32) class Int {
  const val BITS: Int = 32
  const val MAX: Int = 2147483647
  const val MIN: Int = 0 - 2147483648
}
// signed 64-bit standalone (Long == I64); the pointer-width signed word is ISize (same width). The 64-bit
// bounds are written with the `L`/`isize` suffix so the literal carries the wide type (a bare literal
// infers Int, which no longer holds a 64-bit value).
@prim("sint", 64) class Long {
  const val BITS: Int = 64
  const val MAX: Long = 9223372036854775807L
  const val MIN: Long = 0L - 9223372036854775807L - 1L
}
@prim("sint", 64) class ISize {
  const val BITS: Int = 64
  const val MAX: ISize = 9223372036854775807isize
  const val MIN: ISize = 0isize - 9223372036854775807isize - 1isize
}
@prim("sint", 8) @alias("Byte") class I8 {
  const val BITS: Int = 8
  const val MAX: Int = 127
  const val MIN: Int = 0 - 128
}
@prim("sint", 16) @alias("Short") class I16 {
  const val BITS: Int = 16
  const val MAX: Int = 32767
  const val MIN: Int = 0 - 32768
}
@prim("sint", 32) @alias("Int") class I32 {
  const val BITS: Int = 32
  const val MAX: Int = 2147483647
  const val MIN: Int = 0 - 2147483648
}
@prim("sint", 64) @alias("Long") class I64 {
  const val BITS: Int = 64
  const val MAX: Int = 9223372036854775807
  const val MIN: Int = 0 - 9223372036854775807 - 1
}

// ---- unsigned integer tower (primaries + explicit-width aliases) ----
@prim("uint", 8) class UByte
@prim("uint", 16) class UShort
@prim("uint", 32) class UInt
@prim("uint", 64) class ULong
// USize is the unsigned pointer-width word (addresses/sizes); MIN is 0, MAX (2^64-1) exceeds the signed
// word so it is deferred with I128/U128 exactly like U64::MAX.
@prim("uint", 64) class USize {
  const val BITS: Int = 64
  const val MIN: USize = 0usize
}
@prim("uint", 8) @alias("UByte") class U8 {
  const val BITS: Int = 8
  const val MAX: Int = 255
  const val MIN: Int = 0
}
@prim("uint", 16) @alias("UShort") class U16 {
  const val BITS: Int = 16
  const val MAX: Int = 65535
  const val MIN: Int = 0
}
@prim("uint", 32) @alias("UInt") class U32 {
  const val BITS: Int = 32
  const val MAX: Int = 4294967295
  const val MIN: Int = 0
}
// U64_MAX exceeds the i64 word, so it is deferred with I128/U128
@prim("uint", 64) @alias("ULong") class U64 {
  const val BITS: Int = 64
  const val MIN: Int = 0
}

// ---- floating point ----
@prim("float", 32) class Float
@prim("float", 64) class Double
@prim("float", 32) @alias("Float") class F32
@prim("float", 64) @alias("Double") class F64

// ---- non-integer scalars ----
@prim("bool", 8) class Bool
@prim("char", 32) class Char
@prim("string", 64) fun String()
@prim("unit", 0) fun Unit()

// ---- bottom + reserved ----
@prim("never", 0) fun Nothing()
@prim("never", 0) @alias("Nothing") fun Never()
@prim("reserved", 128) fun I128()
@prim("reserved", 128) fun U128()

// ======================================================================================
// Associated constants — each numeric type's SURFACE, library-defined (STDLIB-REDESIGN §2a).
//
// These are Kite's stand-in for Rust's `i64::MAX` / `u8::MAX` / `i32::BITS`: the bounds and width of each
// scalar, written in the library rather than baked into the compiler. They are `const val` members of each
// numeric type's body (Phase M6 — the ONE associated-constant syntax), read as `Int::MAX` / `U8::MAX` /
// `I32::BITS` via the `::` static-member path. Bare integer arithmetic (registers are 64-bit words), so
// word-width MIN is computed as `0 - MAX - 1` rather than written as an out-of-range literal. The `<Type>_<CONST>`
// mangle these lower to is no longer a valid surface identifier.
