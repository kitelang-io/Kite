// S2 nominal-types: List/String/Map as nominal types with methods (type-scoped wrappers over builtins).
// Exercises list() constructor sugar, xs.push/xs.len/xs.get/xs.set, xs[i] indexing,
// s.charAt/s.len/s.substr on String, {..} map literal + m[k] indexing + m.size().
fun main(): Int {
  val xs = list()
  xs.push(3)
  xs.push(5)
  var acc = xs.len() // 2
  acc = acc + xs.get(0) // + 3  = 5
  acc = acc + xs[1] // + 5  = 10
  xs.set(0, 7)
  acc = acc + xs[0] // + 7  = 17
  val str = "hello"
  acc = acc + str.len() // + 5  = 22
  if (str.charAt(1) == 101) { acc = acc + 1 } // 'e' = 101 -> 23
  val sub = str.substr(1, 3) // "ell", len 3
  acc = acc + sub.len() // + 3  = 26
  val m = ["a": 4, "b": 6]
  acc = acc + m["a"] // + 4  = 30
  acc = acc + m.size() // + 2  = 32
  return acc
}
