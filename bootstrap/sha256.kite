// stage1/sha256.kite — SHA-256 in Kite (Phase C: needed for the ad-hoc Mach-O
// code signature Apple Silicon requires). Pure integer/bitwise; 32-bit values are
// kept in the low bits of Kite's 63-bit Int and masked to 0xffffffff after each
// op (so arithmetic `>>` acts as logical on these non-negative values). Verified
// against the NIST test vectors for "" and "abc".

fun splitWords(s: String): List {
  val out = listNew()
  val n = strLen(s)
  var i = 0
  var start = 0
  while (i <= n) {
    if (i == n) { if (i > start) { listPush(out, substr(s, start, i - start)) } }
    else { if (charAt(s, i) == 32) { if (i > start) { listPush(out, substr(s, start, i - start)) } start = i + 1 } }
    i = i + 1
  }
  return out
}
fun hexVal(c: Int): Int {
  if (c >= 48 && c <= 57) { return c - 48 }
  if (c >= 97 && c <= 102) { return c - 87 }
  if (c >= 65 && c <= 70) { return c - 55 }
  return 0
}
fun parseHex(s: String): Int {
  var v = 0
  var i = 0
  while (i < strLen(s)) { v = (v << 4) | hexVal(charAt(s, i)) ; i = i + 1 }
  return v
}
fun hexList(s: String): List {
  val parts = splitWords(s)
  val out = listNew()
  var i = 0
  while (i < listLen(parts)) { listPush(out, parseHex(listGet(parts, i))) ; i = i + 1 }
  return out
}
fun hexDigit(d: Int): String { return substr("0123456789abcdef", d, 1) }
fun toHex8(n: Int): String {
  var s = ""
  var i = 7
  while (i >= 0) { s = concat(s, hexDigit((n >> (i * 4)) & 15)) ; i = i - 1 }
  return s
}

fun m32(x: Int): Int { return x & 0xffffffff }
fun add32(a: Int, b: Int): Int { return (a + b) & 0xffffffff }
fun rotr(x: Int, n: Int): Int { return ((x >> n) | (x << (32 - n))) & 0xffffffff }
fun shr(x: Int, n: Int): Int { return x >> n }
fun ch(x: Int, y: Int, z: Int): Int { return (x & y) ^ ((x ^ 0xffffffff) & z) }
fun maj(x: Int, y: Int, z: Int): Int { return (x & y) ^ (x & z) ^ (y & z) }
fun bsig0(x: Int): Int { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22) }
fun bsig1(x: Int): Int { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25) }
fun ssig0(x: Int): Int { return rotr(x, 7) ^ rotr(x, 18) ^ shr(x, 3) }
fun ssig1(x: Int): Int { return rotr(x, 17) ^ rotr(x, 19) ^ shr(x, 10) }

// message bytes -> padded byte list (multiple of 64)
fun padded(bytes: List): List {
  val out = listNew()
  var i = 0
  val len = listLen(bytes)
  while (i < len) { listPush(out, listGet(bytes, i)) ; i = i + 1 }
  listPush(out, 0x80)
  while ((listLen(out) % 64) != 56) { listPush(out, 0) }
  val bitLen = len * 8
  var j = 7
  while (j >= 0) { listPush(out, (bitLen >> (8 * j)) & 0xff) ; j = j - 1 }
  return out
}

fun strBytes(s: String): List {
  val out = listNew()
  var i = 0
  while (i < strLen(s)) { listPush(out, charAt(s, i)) ; i = i + 1 }
  return out
}

fun sha256(msg: List): String {
  val K = hexList("428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2")
  val H = hexList("6a09e667 bb67ae85 3c6ef372 a54ff53a 510e527f 9b05688c 1f83d9ab 5be0cd19")
  val data = padded(msg)
  val nblocks = listLen(data) / 64
  var blk = 0
  while (blk < nblocks) {
    val base = blk * 64
    // message schedule W[0..63]
    val W = listNew()
    var t = 0
    while (t < 16) {
      val o = base + t * 4
      val w = ((listGet(data, o) << 24) | (listGet(data, o + 1) << 16) | (listGet(data, o + 2) << 8) | listGet(data, o + 3)) & 0xffffffff
      listPush(W, w)
      t = t + 1
    }
    t = 16
    while (t < 64) {
      val v = (ssig1(listGet(W, t - 2)) + listGet(W, t - 7) + ssig0(listGet(W, t - 15)) + listGet(W, t - 16)) & 0xffffffff
      listPush(W, v)
      t = t + 1
    }
    var a = listGet(H, 0)
    var b = listGet(H, 1)
    var c = listGet(H, 2)
    var d = listGet(H, 3)
    var e = listGet(H, 4)
    var ff = listGet(H, 5)
    var g = listGet(H, 6)
    var h = listGet(H, 7)
    t = 0
    while (t < 64) {
      val t1 = (h + bsig1(e) + ch(e, ff, g) + listGet(K, t) + listGet(W, t)) & 0xffffffff
      val t2 = (bsig0(a) + maj(a, b, c)) & 0xffffffff
      h = g ; g = ff ; ff = e ; e = add32(d, t1)
      d = c ; c = b ; b = a ; a = add32(t1, t2)
      t = t + 1
    }
    listSet(H, 0, add32(listGet(H, 0), a))
    listSet(H, 1, add32(listGet(H, 1), b))
    listSet(H, 2, add32(listGet(H, 2), c))
    listSet(H, 3, add32(listGet(H, 3), d))
    listSet(H, 4, add32(listGet(H, 4), e))
    listSet(H, 5, add32(listGet(H, 5), ff))
    listSet(H, 6, add32(listGet(H, 6), g))
    listSet(H, 7, add32(listGet(H, 7), h))
    blk = blk + 1
  }
  var out = ""
  var i = 0
  while (i < 8) { out = concat(out, toHex8(listGet(H, i))) ; i = i + 1 }
  return out
}

fun main(): Int {
  val empty = listNew()
  val h0 = sha256(empty)
  val hAbc = sha256(strBytes("abc"))
  println(h0)
  println(hAbc)
  var fails = 0
  if (strEq(h0, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") == false) { println("FAIL empty") ; fails = fails + 1 }
  if (strEq(hAbc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == false) { println("FAIL abc") ; fails = fails + 1 }
  if (fails == 0) { println("SHA-256 vectors PASS") }
  return fails
}
