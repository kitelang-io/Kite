// String-T1 (Phase 9) leak-end proof. Under the T0 primitive String, every string allocation (concat,
// substr, intToStr, a literal binding) leaked forever — @arc(manual), never freed. Under T1, String is a
// real ref-counted class whose `deinit { __rawFree(data) }` runs on the last release, so a String local is
// freed at scope exit. This asserts that freeing actually happens, with an exit code (no leak detector needed).
//
// probeAlloc allocates a boxed String local, captures its data pointer, and returns just the number. The
// String is released when probeAlloc returns -> refcount 0 -> deinit -> __rawFree(data). Because macOS's
// small-block allocator hands back the most-recently-freed same-size block (LIFO free list), a subsequent
// same-size allocation reuses that exact address: the captured pointer STAYS STABLE across iterations iff the
// buffer was really freed each time. Had it leaked, the allocator would climb to fresh addresses every call.
fun probeAlloc(): Int {
  val s = "abcdefgh"
  val d = s.data
  return d
}

fun main(): Int {
  var prev = 0
  var reuse = 0
  var total = 0
  var i = 0
  while (i < 4000) {
    val p = probeAlloc()
    if (i > 2) { total = total + 1; if (p == prev) { reuse = reuse + 1 } }
    prev = p
    i = i + 1
  }
  // FREED: the LIFO free list hands the just-freed same-size block straight back, so the captured pointer
  //   is IDENTICAL to the previous iteration nearly every time -> reuse ~= total.
  // LEAKING: nothing is freed, so each same-size alloc climbs to a fresh higher address and the pointer is
  //   NEVER equal to the previous one -> reuse ~= 0.
  // Require only a strong MAJORITY of reuses rather than a perfect run: the OS allocator occasionally hands
  // back a different block (a fresh page / another arena) even when freeing correctly (~1/7 of runs saw one
  // such blip), which made an exact-stability check flaky WITHOUT changing the invariant proven. A real leak
  // still fails hard (reuse stays ~0), so this de-flakes without weakening the leak-end assertion.
  return if (reuse * 2 > total) { 0 } else { 1 }
}
