// Phase D regression: RAW arithmetic on a sub-64-bit integer type wraps at its declared runtime width
// (unsigned: mask to N bits; signed: mask + sign-extend). No wrappingAdd() call — the `+`/`*`/`<<`/`-`
// operators themselves must wrap. 64-bit types (Long) must NOT wrap. Exit code is a checksum.
fun main(): Int {
  var acc = 0

  // ---- unsigned masks to N bits ----
  val u8a: U8 = 250
  val u8b: U8 = 10
  if ((u8a + u8b) == 4) { acc = acc + 1 } // 1  260 & 0xFF = 4
  val u8c: U8 = 20
  if ((u8c * u8c) == 144) { acc = acc + 1 } // 2  400 & 0xFF = 144
  val u8d: U8 = 255
  if ((u8d << 4) == 240) { acc = acc + 1 } // 3  4080 & 0xFF = 240
  val u8e: U8 = 5
  val u8f: U8 = 10
  if ((u8e - u8f) == 251) { acc = acc + 1 } // 4  -5 & 0xFF = 251

  val u16a: U16 = 65535
  val u16b: U16 = 2
  if ((u16a + u16b) == 1) { acc = acc + 1 } // 5  65537 & 0xFFFF = 1

  val u32a: U32 = 4294967295
  val u32b: U32 = 3
  if ((u32a + u32b) == 2) { acc = acc + 1 } // 6  (2^32+2) & 0xFFFFFFFF = 2

  // ---- signed sign-extends after the mask ----
  val i8a: I8 = 100
  val i8b: I8 = 50
  if ((i8a + i8b) == (0 - 106)) { acc = acc + 1 } // 7  150 -> -106 (150-256)
  val i8c: I8 = 100
  val i8d: I8 = 20
  if ((i8a + i8d) == 120) { acc = acc + 1 } // 8  in-range, no flip

  // ---- Int is 32-bit (Phase BC): its arithmetic wraps too ----
  val big: Int = 2147483647
  if ((big + 1) < 0) { acc = acc + 1 } // 9  0x7FFFFFFF+1 -> negative
  if ((100 + 100) == 200) { acc = acc + 1 } // 10 small Int, no spurious wrap

  // ---- 64-bit is UNAFFECTED ----
  val big64: Long = 2147483647L
  if ((big64 + big64) == 4294967294L) { acc = acc + 1 } // 11 no mask to 32 (would be -2)

  return acc // 11
}
