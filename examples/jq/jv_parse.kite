// jv_parse.kite — a recursive-descent JSON parser. Mirrors jq's src/jv_parse.c.
// A Parser holds the source text and a mutable cursor; parseValue dispatches on the first non-space byte.
import kite::core::option
import "examples/jq/jv.kite"

struct Parser(val src: String, var pos: Int)

fun peek(p: Parser): Int { if (p.pos >= strLen(p.src)) { return 0 - 1 } return charAt(p.src, p.pos) }

fun bump(p: Parser) { p.pos += 1 }

fun isDigit(c: Int): Bool { return c >= 48 && c <= 57 }

fun isSpace(c: Int): Bool { return c == 32 || c == 9 || c == 10 || c == 13 }

fun skipWs(p: Parser) { while (isSpace(peek(p))) { bump(p) } }

// chr(byte) -> one-character String is shared from jv.kite.

fun parseStr(p: Parser): String {
  bump(p) // opening quote
  var s = ""
  var go = true
  while (go) {
    val c = peek(p)
    if (c == 0 - 1 || c == 34) { bump(p) go = false } // EOF or closing quote
    else { if (c == 92) { // backslash escape
        bump(p)
        val e = peek(p) bump(p)
        s += if (e == 110) { chr(10) } else { if (e == 116) { chr(9) } else { chr(e) } }
      } else { s += chr(c) bump(p) } }
  }
  return s
}

fun parseNum(p: Parser): Int {
  var neg = false
  if (peek(p) == 45) { neg = true bump(p) } // '-'
  var n = 0
  while (isDigit(peek(p))) { n = n * 10 + (peek(p) - 48) bump(p) }
  if (peek(p) == 46) { bump(p) while (isDigit(peek(p))) { bump(p) } } // drop a fractional part
  return if (neg) { 0 - n } else { n }
}

// parseValue dispatches; the array/object parsers recurse back into it.
fun parseValue(p: Parser): Json {
  skipWs(p)
  val c = peek(p)
  if (c == 123) { return parseObject(p) } // '{'
  if (c == 91) { return parseArray(p) } // '['
  if (c == 34) { return JStr(parseStr(p)) } // '"'
  if (c == 116) { p.pos += 4 return JBool(true) } // true
  if (c == 102) { p.pos += 5 return JBool(false) } // false
  if (c == 110) { p.pos += 4 return JNull } // null
  return JNum(parseNum(p))
}

fun parseArray(p: Parser): Json {
  bump(p) // '['
  val xs = listNew()
  skipWs(p)
  if (peek(p) == 93) { bump(p) return JArr(xs) } // empty ']'
  var go = true
  while (go) {
    xs.push(parseValue(p))
    skipWs(p)
    val c = peek(p)
    if (c == 44) { bump(p) skipWs(p) } else { bump(p) go = false } // ',' else ']'/EOF
  }
  return JArr(xs)
}

fun parseObject(p: Parser): Json {
  bump(p) // '{'
  val es = listNew()
  skipWs(p)
  if (peek(p) == 125) { bump(p) return JObj(es) } // empty '}'
  var go = true
  while (go) {
    skipWs(p)
    val key = parseStr(p)
    skipWs(p)
    if (peek(p) == 58) { bump(p) } // ':'
    es.push(Entry(key, parseValue(p)))
    skipWs(p)
    val c = peek(p)
    if (c == 44) { bump(p) } else { bump(p) go = false } // ',' else '}'/EOF
  }
  return JObj(es)
}

// jv_parse — the public entry: text -> Json.
fun parseJson(src: String): Json { return parseValue(Parser(src, 0)) }
