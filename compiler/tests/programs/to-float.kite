// Phase 3 regression: toFloat(int) — the int->float intrinsic that makes mixed int/float sound. A plain
// `i + 1.0` would deref the int as a double-pointer (unsound); `toFloat(i) + 1.0` is the correct idiom.
fun main(): Int {
  var acc = 0

  // toFloat then float arithmetic.
  val a = toFloat(7)
  val b = a + 1.0                 // 8.0
  if (toInt(b) == 8) { acc = acc + 1 }          // 1

  // toFloat of a computed int, float divide.
  val n = 10
  val half = toFloat(n) / 2.0    // 5.0
  if (toInt(half) == 5) { acc = acc + 1 }       // 2

  // round trip: int -> float -> int.
  if (toInt(toFloat(42)) == 42) { acc = acc + 1 } // 3

  // toFloat of two ints added as floats (both operands non-literal float).
  val x = toFloat(3)
  val y = toFloat(4)
  if (toInt(x + y) == 7) { acc = acc + 1 }        // 4

  // float comparison after conversion.
  if (toFloat(5) < 6.0) { acc = acc + 1 }         // 5

  return acc                                       // 5
}
