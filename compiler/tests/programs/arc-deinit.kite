class Resource(val id: Int, val log: IntBuf) {
  deinit { self.log.set(0, self.log.get(0) + 1) }
}

fun makeAndDrop(log: IntBuf): Int {
  val r = Resource(7, log)
  return r.id
}

fun main(): Int {
  val log = intBuf()
  log.push(0)
  val x = makeAndDrop(log)
  val y = makeAndDrop(log)
  return x + y * 10 + log.get(0)
}
