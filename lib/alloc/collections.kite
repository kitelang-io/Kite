// kite::alloc::collections — generic List operations (one machine word per element).
import kite::core::option    // findList returns Option
fun rangeList(n: Int): List { val out = listNew()  var i = 0  while (i < n) { listPush(out, i)  i = i + 1 }  return out }
fun mapList(xs: List, f): List { val out = listNew()  var i = 0  while (i < listLen(xs)) { listPush(out, f(listGet(xs, i)))  i = i + 1 }  return out }
fun filterList(xs: List, pred): List { val out = listNew()  var i = 0  while (i < listLen(xs)) { val x = listGet(xs, i)  if (pred(x)) { listPush(out, x) }  i = i + 1 }  return out }
fun foldList(xs: List, acc: Int, f): Int { var a = acc  var i = 0  while (i < listLen(xs)) { a = f(a, listGet(xs, i))  i = i + 1 }  return a }
fun findList(xs: List, pred): Option { var i = 0  while (i < listLen(xs)) { val x = listGet(xs, i)  if (pred(x)) { return Some(x) }  i = i + 1 }  return None }
fun anyList(xs: List, pred): Bool { var i = 0  while (i < listLen(xs)) { if (pred(listGet(xs, i))) { return true }  i = i + 1 }  return false }
fun allList(xs: List, pred): Bool { var i = 0  while (i < listLen(xs)) { if (pred(listGet(xs, i)) == false) { return false }  i = i + 1 }  return true }
fun reverseList(xs: List): List { val out = listNew()  var i = listLen(xs) - 1  while (i >= 0) { listPush(out, listGet(xs, i))  i = i - 1 }  return out }
fun sumList(xs: List): Int { return foldList(xs, 0, { a, x -> a + x }) }

pub import kite::alloc::collections::vec
pub import kite::alloc::collections::map
