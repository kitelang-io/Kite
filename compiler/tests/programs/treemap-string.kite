import "lib/alloc/collections/treemap.kite"
fun eqs(a: String, b: String): Bool { return a.eq(b) }
fun main(): Int {
  var acc = 0
  val t = TreeMap::<String, Int>(0 - 1, 0, 0, 0, RawBuf(0), RawBuf(0), RawBuf(0), RawBuf(0))
  t.set("mango", 1) t.set("apple", 2) t.set("cherry", 3) t.set("banana", 4)
  if (t.size() == 4) { acc = acc + 1 }
  when (t.get("cherry")) { Some(v) -> { if (v == 3) { acc = acc + 1 } }; None -> 0 }
  when (t.min()) { Some(k) -> { if (eqs(k, "apple")) { acc = acc + 1 } }; None -> 0 }
  when (t.max()) { Some(k) -> { if (eqs(k, "mango")) { acc = acc + 1 } }; None -> 0 }
  when (t.higher("banana")) { Some(k) -> { if (eqs(k, "cherry")) { acc = acc + 1 } }; None -> 0 }
  when (t.floor("coconut")) { Some(k) -> { if (eqs(k, "cherry")) { acc = acc + 1 } }; None -> 0 }
  return acc
}
