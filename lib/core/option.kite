// kite::core::option — Option/Result (global enums) + helpers. No allocation, no OS.
enum Option { Some(v); None }

enum Result { Ok(v); Err(e) }

fun Option.isSome(): Bool { return when (self) { Some(v) -> true; None -> false } }

fun Option.isNone(): Bool { return when (self) { Some(v) -> false; None -> true } }

fun Option.getOr(dflt: Int): Int { return when (self) { Some(v) -> v; None -> dflt } }
