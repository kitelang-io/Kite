// stage1/toklist.kite — a mini arithmetic compiler in Kite whose lexer and parser
// are DECOUPLED by a real token list (the interface the full Kite front-end uses):
//   source String  ->  lex  ->  IntBuf<Tok>  ->  parse  ->  enum Ast  ->  evalAst.
// Compiled by Fledge (stage-0) and run natively.

// Token kinds.
//   0 = number   1 = '+'   2 = '-'   3 = '*'   4 = '/'   5 = '('   6 = ')'   7 = EOF
struct Tok(val kind: Int, val ival: Int)

// Expression tree. One-level `when` patterns + recursion (bootstrap subset).
enum Ast { Num(Int); Add(Ast, Ast); Sub(Ast, Ast); Mul(Ast, Ast); Div(Ast, Ast) }

fun isDigit(c: Int): Bool { return c >= 48 && c <= 57 }

fun isSpace(c: Int): Bool { return c == 32 }

// ---- lexer: String -> IntBuf<Tok> -------------------------------------------
fun lex(src: String): IntBuf {
  val toks = intBuf()
  val n = src.len()
  var i = 0
  while (i < n) {
    val c = src.charAt(i)
    if (isSpace(c)) {
      i = i + 1
    } else {
      if (isDigit(c)) {
        var v = 0
        while (i < n && isDigit(src.charAt(i))) {
          v = v * 10 + (src.charAt(i) - 48)
          i = i + 1
        }
        toks.push(Tok(0, v))
      } else {
        var k = 7
        if (c == 43) { k = 1 } else {
          if (c == 45) { k = 2 } else {
            if (c == 42) { k = 3 } else {
              if (c == 47) { k = 4 } else {
                if (c == 40) { k = 5 } else {
                  if (c == 41) { k = 6 } else { k = 7 } } } } } }
        toks.push(Tok(k, 0))
        i = i + 1
      }
    }
  }
  toks.push(Tok(7, 0))
  return toks
}

// ---- parser: IntBuf<Tok> -> Ast, via a mutable cursor -----------------------
struct PS(val toks: IntBuf, var pos: Int)

fun peekKind(ps: PS): Int {
  if (ps.pos >= ps.toks.len()) { return 7 }
  val t: Tok = ps.toks.get(ps.pos)
  return t.kind
}

fun peekVal(ps: PS): Int {
  val t: Tok = ps.toks.get(ps.pos)
  return t.ival
}

fun advance(ps: PS): Int { ps.pos = ps.pos + 1; return 0 }

fun parseFactor(ps: PS): Ast {
  val k = peekKind(ps)
  if (k == 5) { // '(' expr ')'
    advance(ps)
    val inner = parseExpr(ps)
    advance(ps) // consume ')'
    return inner
  }
  val v = peekVal(ps) // a number
  advance(ps)
  return Num(v)
}

fun parseTerm(ps: PS): Ast {
  var left = parseFactor(ps)
  var k = peekKind(ps)
  while (k == 3 || k == 4) {
    advance(ps)
    val right = parseFactor(ps)
    if (k == 3) { left = Mul(left, right) } else { left = Div(left, right) }
    k = peekKind(ps)
  }
  return left
}

fun parseExpr(ps: PS): Ast {
  var left = parseTerm(ps)
  var k = peekKind(ps)
  while (k == 1 || k == 2) {
    advance(ps)
    val right = parseTerm(ps)
    if (k == 1) { left = Add(left, right) } else { left = Sub(left, right) }
    k = peekKind(ps)
  }
  return left
}

// ---- evaluator: walk the AST ----------------------------------------------
fun evalAst(a: Ast): Int {
  return when (a) {
    Num(n) -> n
    Add(x, y) -> evalAst(x) + evalAst(y)
    Sub(x, y) -> evalAst(x) - evalAst(y)
    Mul(x, y) -> evalAst(x) * evalAst(y)
    Div(x, y) -> evalAst(x) / evalAst(y)
    else -> 0
  }
}

fun compile(src: String): Int {
  val toks = lex(src)
  val ps = PS(toks, 0)
  val ast = parseExpr(ps)
  return evalAst(ast)
}

fun main(): Int {
  println(compile("(2 + 3) * 4").toStr()) // 20
  println(compile("2 + 3 * 4").toStr()) // 14
  println(compile("100 - 7 * (3 + 4)").toStr()) // 51
  return compile("2 * 3 + 4 * 5") // 26  (exit code)
}
