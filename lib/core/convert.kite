// kite::core::convert — From / Into / TryFrom conversions for the fixed-width integer types. Opt in with
// `import kite::core::convert`.
//
// Under erasure the "trait" impls are concrete monomorphic functions (STDLIB-REDESIGN §2a: "From/Into for
// lossless widening — each impl is a concrete monomorphic function, expressible under erasure"). Rust's
// `T::from(x)` / `x.into()` need expected-type-directed dispatch that Kite (name-convention, no return-type
// dispatch) does not have, so each conversion is a named function:
//
//   *From*  (From/Into): LOSSLESS widening to a wider type — the value always fits, cannot fail.
//   *TryFrom*          : FALLIBLE narrowing to a narrower type -> Option (None when the value doesn't fit).
//
// Widening is `x as WiderType`, which preserves the value (zero-extend for unsigned); narrowing checks the
// destination range first and returns Some(x)/None.

// ---- From / Into: lossless unsigned widening ----
fun u16FromU8(x: U8): U16 { return x as U16 }

fun u32FromU8(x: U8): U32 { return x as U32 }

fun u32FromU16(x: U16): U32 { return x as U32 }

fun u64FromU8(x: U8): U64 { return x as U64 }

fun u64FromU16(x: U16): U64 { return x as U64 }

fun u64FromU32(x: U32): U64 { return x as U64 }

// ---- From / Into: lossless signed widening (sign-preserving) ----
fun i16FromI8(x: I8): I16 { return x as I16 }

fun i32FromI8(x: I8): I32 { return x as I32 }

fun i32FromI16(x: I16): I32 { return x as I32 }

fun i64FromI8(x: I8): Int { return x as I64 }

fun i64FromI16(x: I16): Int { return x as I64 }

fun i64FromI32(x: I32): Int { return x as I64 }

// ---- TryFrom: fallible unsigned narrowing (-> Option, None when out of range) ----
fun u8TryFromU16(x: U16): Option { if (x > 255) { return None } return Some(x as U8) }

fun u8TryFromU32(x: U32): Option { if (x > 255) { return None } return Some(x as U8) }

fun u8TryFromU64(x: U64): Option { if (x > 255) { return None } return Some(x as U8) }

fun u16TryFromU32(x: U32): Option { if (x > 65535) { return None } return Some(x as U16) }

fun u16TryFromU64(x: U64): Option { if (x > 65535) { return None } return Some(x as U16) }

fun u32TryFromU64(x: U64): Option { if (x > 4294967295) { return None } return Some(x as U32) }
