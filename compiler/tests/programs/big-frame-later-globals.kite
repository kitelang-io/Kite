// globals defined AFTER the over-large function:
fun after1(): Int { return 7 }
fun after2(x: Int): Int { return x * 2 }
fun main(): Int {
  val s = big()          // 180300
  val a = after1()       // 7
  val b = after2(a)      // 14
  if (s == 180300) { if (b == 14) { return 42 } }
  return 1
}
