// lib/core/string.kite — the ONE canonical home for String: the built-in String type (its convention
// methods, its `+` / `==` operator overloads), the allocating String utility joinList, and the growable
// `Str` byte-buffer builder — all co-located (kite::core::string). The former kite::alloc::string /
// kite::alloc::string::strbuf modules were folded in here.
//
// The built-in String is a primitive (a C-string). Following Kotlin, its convention methods live WITH the
// type: the byte-loop bodies are the METHODS/OPERATORS here — `s.charAt(i)` -> String_charAt, `s.len()`/
// `s.length` -> String_len/String_length, `s.substr(a,b)` -> String_substr, `s.repeat(n)` -> String_repeat,
// `a + b` -> `impl Add for String` (String_add), `a == b`/`a != b` -> `impl Eq for String` (String_eq),
// and `n.toStr()` -> Int_toStr. Method dispatch on the String builtin-nominal mangles `s.m(..)` to
// `String_m(s, ..)`; the desugar roles str.get/str.concat/str.show land on these too. Auto-included via
// compiler/prelude.conf (after kite::core::ops, which declares Add/Eq); names are global (unmangled).

// Pure-Kite string ops on the null-terminated byte representation (were libc-backed codegen builtins).
// String_charAt is just a byte load; String_len scans to the terminating 0. @lang("str.get") makes
// String_charAt the landing point for `s[i]` indexing on a String.
@lang("str.get")
fun String_charAt(s: String, i: Int): Int { return __rawLoadByte(s, i) }

fun String_len(s: String): Int { var i = 0 var go = 1 while (go == 1) { if (__rawLoadByte(s, i) == 0) { go = 0 } else { i = i + 1 } } return i }

// `length` is the getter alias of `len`: a nullary method, so `s.length` (no parens) resolves here
// via klower's getter routing.
fun String_length(s: String): Int { return String_len(s) }

// String_substr(s, start, length): copy length bytes from s+start into a fresh NUL-terminated buffer.
fun String_substr(s: String, st: Int, len: Int): String {
  val r = __rawAlloc(len + 1)
  var i = 0
  while (i < len) { __rawStoreByte(r, i, __rawLoadByte(s, st + i)) i = i + 1 }
  __rawStoreByte(r, len, 0)
  return r
}

// `s.repeat(n)` — n copies of s, concatenated (n<=0 yields ""). Allocating, but only via `+`.
fun String_repeat(s: String, n: Int): String { var out = "" var i = 0 while (i < n) { out = out + s i = i + 1 } return out }

// Int_toStr / n.toStr(): base-10, handles 0 and negatives, into a fresh NUL-terminated buffer. `%` avoided
// via d = mm - (mm/10)*10. (ASCII '0'=48, '-'=45.) Was libc snprintf("%ld"). @lang("str.show") makes it the
// landing point for `$expr` string interpolation on a non-String value.
@lang("str.show")
fun Int_toStr(n: Int): String {
  if (n == 0) { val z = __rawAlloc(2) __rawStoreByte(z, 0, 48) __rawStoreByte(z, 1, 0) return z }
  var neg = 0
  var m = n
  if (n < 0) { neg = 1 m = 0 - n }
  var digits = 0
  var t = m
  while (t > 0) { digits = digits + 1 t = t / 10 }
  val total = digits + neg
  val r = __rawAlloc(total + 1)
  __rawStoreByte(r, total, 0)
  var pos = total - 1
  var mm = m
  while (mm > 0) { val d = mm - (mm / 10) * 10 __rawStoreByte(r, pos, 48 + d) pos = pos - 1 mm = mm / 10 }
  if (neg == 1) { __rawStoreByte(r, 0, 45) }
  return r
}

// `n.toStr()` — the UFCS entry for the Int-typed method (Int is not a nominal type, so `n.toStr()`
// resolves as the free call `toStr(n)`). Delegates to the canonical Int_toStr body above.
fun toStr(n: Int): String { return Int_toStr(n) }

// String overloads `+` as concatenation via the Add operator trait (see kite::core::ops): klower's
// lowerBin desugars `a + b` where a (or b) is a String to String_add(a, b). @lang("str.concat") also makes
// it the interpolation-join landing point. Allocates la+lb+1 bytes, copies both, NUL-terminated (leaks like
// the old libc version). @arc(manual): String is a primitive C-string word — never ref-counted, exempt from
// automatic ARC. It has no class/struct decl, so the exemption tag rides this canonical `impl Add for
// String` (the collector records the impl's for-type). This is what registers "String" as a builtin
// nominal (String_charAt, ...).
@arc(manual)
impl Add for String {
  @lang("str.concat")
  fun add(self, rhs: String): String {
    val la = String_len(self)
    val lb = String_len(rhs)
    val r = __rawAlloc(la + lb + 1)
    var i = 0
    while (i < la) { __rawStoreByte(r, i, __rawLoadByte(self, i)) i = i + 1 }
    var j = 0
    while (j < lb) { __rawStoreByte(r, la + j, __rawLoadByte(rhs, j)) j = j + 1 }
    __rawStoreByte(r, la + lb, 0)
    return r
  }
}

// String value-equality via the Eq operator trait (see kite::core::ops): klower's lowerBin desugars
// `a == b`/`a != b` where a (or b) is a String to String_eq(a, b) / not(String_eq(a, b)). Byte-by-byte
// compare to the terminating 0 (returns Bool). Int/Char/other `==` has no Eq impl and stays a machine compare.
impl Eq for String {
  fun eq(self, rhs: String): Bool {
    var i = 0
    var go = 1
    while (go == 1) {
      val ca = __rawLoadByte(self, i)
      val cb = __rawLoadByte(rhs, i)
      if (ca == cb) { if (ca == 0) { return true } } else { return false }
      i = i + 1
    }
    return false
  }
}

// joinList — concatenate the string elements of `xs`, separated by `sep`.
fun joinList(xs: List, sep: String): String { var out = "" var i = 0 while (i < xs.len()) { if (i > 0) { out = out + sep } out = out + xs.get(i) i = i + 1 } return out }

// --- the growable String (byte-buffer) builder (folded in from kite::alloc::string::strbuf) -----------
// A mutable byte buffer built on the raw-memory intrinsics; the canonical way to assemble a String
// incrementally without repeated whole-string concat allocations.
class Str(var n: Int, var cap: Int, var data: Int) {
  fun pushByte(self, b: Int): Int {
    if (self.n == self.cap) { self.cap = self.cap * 2 self.data = __rawRealloc(self.data, self.cap) }
    __rawStoreByte(self.data, self.n, b)
    self.n = self.n + 1
    return 0
  }
  fun byteAt(self, i: Int): Int { return __rawLoadByte(self.data, i) }
  fun size(self): Int { return self.n }
  deinit { __rawFree(self.data) }
}

fun strNew(): Str { return Str(0, 8, __rawAlloc(8)) }

fun strFrom(lit: String): Str {
  val s = strNew()
  var i = 0
  while (i < lit.len()) { s.pushByte(lit.charAt(i)) i = i + 1 }
  return s
}
