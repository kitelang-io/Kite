// kite::alloc::collections::vec — a growable vector in pure Kite on the raw memory primitives.
// Method style (v.push(x) / v.get(i) / v.len()), consistent with the nominal List methods.
class Vec(var n: Int, var cap: Int, var data: Int) {
  fun push(self, x: Int): Int {
    if (self.n == self.cap) { self.cap = self.cap * 2  self.data = __rawRealloc(self.data, self.cap * 8) }
    __rawStore(self.data, self.n * 8, x)
    self.n = self.n + 1
    return 0
  }
  fun get(self, i: Int): Int { return __rawLoad(self.data, i * 8) }
  fun set(self, i: Int, x: Int): Int { __rawStore(self.data, i * 8, x)  return 0 }
  fun len(self): Int { return self.n }
  fun pop(self): Int { self.n = self.n - 1  return __rawLoad(self.data, self.n * 8) }
  deinit { __rawFree(self.data) }
}
fun vecNew(): Vec { return Vec(0, 4, __rawAlloc(4 * 8)) }
