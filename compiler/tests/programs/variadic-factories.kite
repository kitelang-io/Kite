// variadic-factories — the variadic IntBuf factory `intBuf(vararg xs: Int)`, an element-initialized
// construction sugar equivalent to the `[..]` literal, OVERLOADING the prelude's 0-arg `intBuf()`.
//
// The factory now lives IN THE PRELUDE (kite::alloc::collections::internal::intbuf), co-located with the
// 0-arg `intBuf()` it overloads, so `intBuf(1, 2, 3)` needs NO explicit import. This became possible after
// the committed bootstrap seed was reseeded to the current fixpoint, which carries the overload-aware
// return-tag inference (klower `freeCallRetSym`): an overloaded `intBuf()` result still tags as IntBuf, so
// the seed can rebuild the compiler even though the compiler's own ~388 zero-arg `intBuf()` calls now go
// through the overload sig-mangle (an EXACT fixed-arity overload wins over the vararg — Kotlin semantics).
// Emitting this function into the compiler binary legitimately grew the self-host fixpoint; the invariant
// is self-reproduction (kcc2==kcc3), not a fixed byte size.
//
// The companion `@mono fun hashMap<K,V>(vararg entries: Pair<K,V>)` now SHIPS (lib/alloc/collections/hashmap.kite):
// the @mono mangle is no longer arity-blind — a 0-arg and a vararg @mono overload get per-overload-distinct
// symbols (`hashMap$K_V$a0` vs `hashMap$K_V$v0`) and the vararg overload keeps its `vararg` param through
// specialization, so the call site both specializes AND collects the tail. See compiler/tests/programs/mono-vararg.kite.
//
// main returns the number of passed checks (14 on full success); the harness asserts exit 14.

fun main(): Int {
  var acc = 0

  // (A) intBuf(vararg): a 3-element list built element-by-element.
  val a = intBuf(1, 2, 3)
  if (a.size() == 3) { acc = acc + 1 } // 1
  if (a.get(0) == 1) { acc = acc + 1 } // 2
  if (a.get(1) == 2) { acc = acc + 1 } // 3
  if (a.get(2) == 3) { acc = acc + 1 } // 4
  if (a.sum() == 6) { acc = acc + 1 } // 5

  // (B) the 0-arg overload still binds the empty constructor (exact fixed-arity wins over vararg).
  val e = intBuf()
  if (e.size() == 0) { acc = acc + 1 } // 6
  e.push(7)
  e.push(8)
  if (e.size() == 2) { acc = acc + 1 } // 7
  if (e.sum() == 15) { acc = acc + 1 } // 8

  // (C) the `[..]` literal still works alongside the overload (its @lang("intbuf.new") role follows the
  //     overload sig-mangle via klower remangleRoles, so the literal's constructor call is not dangling).
  val lit = [10, 20, 30]
  if (lit.size() == 3) { acc = acc + 1 } // 9
  if (lit.get(1) == 20) { acc = acc + 1 } // 10

  // (D) single-arg and larger vararg calls; a set() write on a vararg-built buffer.
  val one = intBuf(42)
  if (one.size() == 1) { acc = acc + 1 } // 11
  if (one.get(0) == 42) { acc = acc + 1 } // 12
  val big = intBuf(1, 2, 3, 4, 5)
  if (big.sum() == 15) { acc = acc + 1 } // 13
  big.set(0, 100)
  if (big.sum() == 114) { acc = acc + 1 } // 14

  return acc
}
