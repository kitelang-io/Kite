// {..} builds a REAL Map class (not a List-as-[k,v] alias): exercises m.get/set/has/size + key
// iteration, m[k] / m[k]=v index sugar, map() returning a real Map, and List's .length()/.len() methods.
fun main(): Int {
  val m = ["a": 10, "b": 20] // real Map via {..}
  var acc = 0
  acc = acc + m.get("a") // 10  -> 10
  acc = acc + m.get("b") // 20  -> 30
  acc = acc + m.size() // 2   -> 32
  if (m.has("a")) { acc = acc + 1 } //     -> 33
  if (m.has("z") == false) { acc = acc + 1 } //     -> 34
  m.set("a", 100) // update existing key
  acc = acc + m.get("a") // 100 -> 134
  m.set("c", 5) // append new key
  acc = acc + m.size() // 3   -> 137
  acc = acc + m["c"] // 5   -> 142  (index read)
  m["c"] = 9 // index write (update in place)
  acc = acc + m["c"] // 9   -> 151

  val e = map() // map() returns a real Map
  e.set("k", 7)
  acc = acc + e.size() // 1   -> 152
  acc = acc + e.get("k") // 7   -> 159

  var ksum = 0 // iterate the keys
  val ks = m.keys() // ["a","b","c"]
  var i = 0
  while (i < ks.len()) { if (strEq(ks.get(i), "b")) { ksum = ksum + 1 } i = i + 1 }
  acc = acc + ksum // 1   -> 160

  val xs = [3, 5, 8]
  acc = acc + xs.length() // 3   -> 163  (canonical length method)
  acc = acc + xs.len() // 3   -> 166
  return acc
}
