// builtin.kite — jq's named builtins (length, keys, add). Mirrors the numeric/collection parts of
// jq's src/builtin.c. `add` folds with the standard library's `List.fold` method (prelude).
import kite::core::option
import kite::alloc::collections
import "examples/jq/jv.kite"

fun numOf(j: Json): Int { return when (j) { JNum(n) -> n; else -> 0 } }

// length: elements of an array, keys of an object, characters of a string, |value| of a number, 0 for null.
fun lengthOf(j: Json): Int {
  return when (j) {
    JArr(xs) -> xs.len()
    JObj(es) -> es.len()
    JStr(s) -> s.len()
    JNum(n) -> if (n < 0) { 0 - n } else { n }
    else -> 0
  }
}

// lexicographic String <, used to sort object keys the way jq's `keys` does.
fun strLess(a: String, b: String): Bool {
  val la = a.len()
  val lb = b.len()
  val n = if (la < lb) { la } else { lb }
  var i = 0
  while (i < n) {
    val ca = a.charAt(i)
    val cb = b.charAt(i)
    if (ca < cb) { return true }
    if (ca > cb) { return false }
    i += 1
  }
  return la < lb
}

// keys: a SORTED array of an object's keys (jq's `keys` sorts; `keys_unsorted` preserves order).
fun keysOf(j: Json): Json {
  val ks = list()
  when (j) {
    JObj(es) -> { for (e in es) { ks.push(entryKey(e)) } }
    else -> 0
  }
  var i = 1 // insertion sort (key sets are small)
  while (i < ks.len()) {
    val key = ks.get(i)
    var d = i - 1
    while (d >= 0 && strLess(key, ks.get(d))) { ks.set(d + 1, ks.get(d)) d -= 1 }
    ks.set(d + 1, key)
    i += 1
  }
  val out = list()
  for (k in ks) { out.push(JStr(k)) }
  return JArr(out)
}

// add: sum an array's numbers (jq's numeric `add`); an empty array is null.
fun addOf(j: Json): Json {
  return when (j) {
    JArr(xs) -> if (xs.len() == 0) { JNull } else { JNum(xs.fold(0, { a, x -> a + numOf(x) })) }
    else -> JNull
  }
}
