// Phase 3 regression: From/Into (lossless widening) + TryFrom (fallible narrowing -> Option), as
// extension methods on the source type (x.toWiderN() / x.toNarrowerN()).
import "lib/core/convert.kite"
import kite::core::option

fun main(): Int {
  var acc = 0

  // lossless unsigned widening preserves the value.
  if ((200 as U8).toU16() == 200) { acc = acc + 1 }               // 1
  if ((4294967295 as U32).toU64() == 4294967295) { acc = acc + 1 } // 2

  // lossless signed widening preserves sign (0xFF as I8 = -1 stays -1).
  if ((0xFF as I8).toI16() == (0 - 1)) { acc = acc + 1 }          // 3
  if ((0x8000 as I16).toI32() == (0 - 32768)) { acc = acc + 1 }   // 4

  // TryFrom: in-range narrows to Some, out-of-range to None.
  if ((200 as U16).toU8().isSome()) { acc = acc + 1 }              // 5
  if ((300 as U16).toU8().isNone()) { acc = acc + 1 }              // 6
  if ((200 as U16).toU8().getOr(0) == 200) { acc = acc + 1 }  // 7
  if ((70000 as U32).toU16().isNone()) { acc = acc + 1 }           // 8
  if ((4294967295 as U64).toU32().isSome()) { acc = acc + 1 }      // 9
  if (((1u64 << 40) as U64).toU32().isNone()) { acc = acc + 1 }    // 10

  return acc                                                        // 10
}
