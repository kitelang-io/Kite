// lib/alloc/collections/internal/rawbuf.kite — the CoW backing buffer for the value-semantics collections (Vec/Array/Deque).
// A distinct ARC object whose REFCOUNT IS THE UNIQUENESS SIGNAL (STDLIB-REDESIGN §124): the collection
// handle is a `@value` struct that shares this buffer; a mutator clones it (ensureUnique) when the
// refcount shows another owner, so mutating a copy copy-on-writes instead of corrupting the original.
//
// @arc(manual): the compiler never auto-retains/releases it. The collection's `copy` method (+1 via
// __retain) and ensureUnique/rawBufDrop (the -1) manage the count explicitly through the refcount
// intrinsics — __refcount reads it, __decRefcount drops without freeing, __freeObj/__rawFree free the
// object shell and the byte buffer at the last owner.
//
// `data` is the raw byte buffer (0 when the collection has never allocated); a fresh RawBuf(_) starts at
// refcount 1 (the header the allocator installs), i.e. uniquely owned by the constructing handle.
@arc(manual)
class RawBuf(var data: Int) {
}

// drop one co-ownership of a buffer: at the LAST owner free the byte buffer and the object; otherwise
// just decrement the shared count. Called by ensureUnique after it has cloned away from a shared buffer.
fun rawBufDrop(b: RawBuf): Int {
  if (__refcount(b) <= 1) {
    if (b.data != 0) { __rawFree(b.data) }
    __freeObj(b)
    return 0
  }
  __decRefcount(b)
  return 0
}
