// Regression coverage for MULTIPLE distinct capturing closures alive + called at once.
//
// A report claimed `f(1) + g(1)` (with f={x->x+100}, g={x->x+200}) "corrupted" its captures and
// returned 46 instead of 302. The captures are in fact correct: 46 == 302 & 0xFF — a Unix process
// exit status is only 8 bits, so `return f(1)+g(1)` silently truncates 302 -> 46. There was never a
// closure-capture bug; the earlier closures-* tests all returned <256 so they never tripped the trap.
//
// This test therefore verifies each closure result AGAINST ITS EXPECTED VALUE IN-PROGRAM (full 64-bit
// comparisons, never via the exit code) and returns the COUNT of passed assertions, which stays <256.
// Any real capture corruption makes an assertion fail, dropping the count below the expected total.
// Wired into run-compiler-tests.sh as `closures-multi-capture.kite:15`.

fun mk(n: Int): (Int) -> Int { return { x -> x + n } }

fun main(): Int {
  var ok = 0

  // -- two DISTINCT inline capturing closures, both called (the exact reported case) --
  val a = 100
  val b = 200
  val f = { x -> x + a }
  val g = { x -> x + b }
  if (f(1) == 101) { ok = ok + 1 } // 1: f keeps its own capture a=100
  if (g(1) == 201) { ok = ok + 1 } // 2: g keeps its own capture b=200
  if (f(1) + g(1) == 302) { ok = ok + 1 } // 3: both in ONE expression (was misread as 46)
  if (g(1) + f(1) == 302) { ok = ok + 1 } // 4: call-order independence

  // -- single-closure control: repeated calls after a second closure exists --
  if (f(5) + f(5) == 210) { ok = ok + 1 } // 5: 105 + 105

  // -- factory producing 3 distinct closures, all called --
  val p = mk(10)
  val q = mk(20)
  val r = mk(30)
  if (p(1) + q(1) + r(1) == 63) { ok = ok + 1 } // 6: 11 + 21 + 31
  if (p(0) == 10) { ok = ok + 1 } // 7: first factory closure not overwritten
  if (r(0) == 30) { ok = ok + 1 } // 8: last factory closure holds its own capture

  // -- one closure capturing MULTIPLE variables --
  val c = 7
  val d = 11
  val e = 13
  val m = { x -> x + c + d + e }
  if (m(1) == 32) { ok = ok + 1 } // 9: 1 + 7 + 11 + 13

  // -- two multi-var closures alive together, both called --
  val p2 = 1
  val q2 = 2
  val r2 = 3
  val s2 = 4
  val u = { x -> x + p2 + q2 }
  val v = { x -> x + r2 + s2 }
  if (u(10) + v(10) == 30) { ok = ok + 1 } // 10: 13 + 17
  if (u(0) == 3) { ok = ok + 1 } // 11: u undisturbed by v (p2+q2)

  // -- non-capturing control (the shape the old tests already covered) --
  val n = { x, y -> x + y }
  if (n(3, 4) == 7) { ok = ok + 1 } // 12

  return ok // 12 iff every assertion held
}
