// index STORE sugar `a[i] = v` (was a no-op before; had to use .set): IntBuf via listSet, RawMap via
// __mapSet (update-in-place, then append). xs -> [9,1,5]; m[7]:42->100. Returns 9+1+5 + 100 = 115.
fun main(): Int {
  val xs = [3, 1, 2]
  xs[0] = 9
  xs[2] = 5
  val m = rawMap()
  m[7] = 42
  m[7] = 100
  return xs[0] + xs[1] + xs[2] + m[7]
}
