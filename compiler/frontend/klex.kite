// stage1/klex.kite — the real Kite lexer, written in Kite (Phase B.1 of self-host).
//
// Tokenizes real Kite source into the SAME token stream as the OCaml stage-0
// lexer (lib/lexer.ml), printing each token in Token.to_string form — FUN,
// IDENT(add), INT(42), FLOAT(3.14), STRING("hi"), CHAR(120), INTERP[...], and the
// ATI-inserted NEWLINE / trailing EOF — one per line, so it diffs token-for-token
// against `kitec lex`.
//
// 100% lexical-construct coverage: identifiers + all 31 keywords, int + float
// literals, single/double + triple-quoted strings, `$x` / `${expr}` interpolation
// (INTERP), // and nested /* */ comments, every operator/punctuation, and Go-style
// automatic NEWLINE insertion (ATI). Written in the plain bootstrap subset Fledge
// compiles; the pretty rewrite comes after self-hosting.
//
// Payload caveats (int-only bootstrap can't reproduce two OCaml runtime artifacts):
//   * floats print their raw lexeme, not %g-normalized (3.140 stays "3.140");
//   * string payloads echo the raw source, matching %S for the standard escapes
//     (\n \t \r \\ \") but not \$, \0, or multi-line triple-string newlines.

struct Lx(val src: String, val n: Int, var pos: Int)

fun cur(lx: Lx): Int { if (lx.pos < lx.n) { return charAt(lx.src, lx.pos) } return 0 }
fun nxt(lx: Lx): Int { if (lx.pos + 1 < lx.n) { return charAt(lx.src, lx.pos + 1) } return 0 }
fun at2(lx: Lx): Int { if (lx.pos + 2 < lx.n) { return charAt(lx.src, lx.pos + 2) } return 0 }
fun advance(lx: Lx): Int { lx.pos = lx.pos + 1 ; return 0 }

fun isDigit(c: Int): Bool { return c >= 48 && c <= 57 }
fun isAlpha(c: Int): Bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 }
fun isAlnum(c: Int): Bool { return isAlpha(c) || isDigit(c) }

fun startsWith(s: String, p: String): Bool {
  if (strLen(s) < strLen(p)) { return false }
  return strEq(substr(s, 0, strLen(p)), p)
}

// Which token kinds may terminate a statement when they end a line (lexer.ml can_end).
fun canEnd(s: String): Bool {
  if (startsWith(s, "INT(")) { return true }
  if (startsWith(s, "FLOAT(")) { return true }
  if (startsWith(s, "STRING(")) { return true }
  if (startsWith(s, "CHAR(")) { return true }
  if (startsWith(s, "INTERP[")) { return true }
  if (startsWith(s, "IDENT(")) { return true }
  if (strEq(s, "TRUE") || strEq(s, "FALSE") || strEq(s, "NULL") || strEq(s, "THIS")) { return true }
  if (strEq(s, "RETURN") || strEq(s, "BREAK") || strEq(s, "CONTINUE")) { return true }
  if (strEq(s, "RPAREN") || strEq(s, "RBRACKET") || strEq(s, "RBRACE")) { return true }
  if (strEq(s, "BANGBANG") || strEq(s, "QUESTION")) { return true }
  return false
}

// --- comments + whitespace (mirrors lexer.ml skip_trivia / skip_comment); the
//     return value is 1 iff a line break was crossed (for ATI). -----------------
fun skipLine(lx: Lx): Int {
  while (cur(lx) != 10 && cur(lx) != 0) { advance(lx) }       // stop AT the newline
  return 0
}
fun skipBlock(lx: Lx): Int {
  var depth = 1
  var sawNl = 0
  while (depth > 0) {
    val c = cur(lx)
    val d = nxt(lx)
    if (c == 0) { depth = 0 }                                  // EOF: bail
    else { if (c == 47 && d == 42) { advance(lx) ; advance(lx) ; depth = depth + 1 }
    else { if (c == 42 && d == 47) { advance(lx) ; advance(lx) ; depth = depth - 1 }
    else { if (c == 10) { sawNl = 1 ; advance(lx) } else { advance(lx) } } } }
  }
  return sawNl
}
fun skipTrivia(lx: Lx): Int {
  var sawNl = 0
  var go = 1
  while (go == 1) {
    val c = cur(lx)
    if (c == 10) { sawNl = 1 ; advance(lx) }
    else { if (c == 32 || c == 9 || c == 13) { advance(lx) }
    else {
      if (c == 47) {                                           // '/'
        val d = nxt(lx)
        if (d == 47) { advance(lx) ; advance(lx) ; skipLine(lx) }
        else { if (d == 42) { advance(lx) ; advance(lx) ; if (skipBlock(lx) == 1) { sawNl = 1 } }
        else { go = 0 } }                                      // a real SLASH operator
      } else { go = 0 } }
    }
  }
  return sawNl
}

// --- keywords: lexeme -> token name, or "" if it is an ordinary identifier ----
fun kwName(w: String): String {
  if (strEq(w, "fun")) { return "FUN" }
  if (strEq(w, "val")) { return "VAL" }
  if (strEq(w, "var")) { return "VAR" }
  if (strEq(w, "if")) { return "IF" }
  if (strEq(w, "else")) { return "ELSE" }
  if (strEq(w, "while")) { return "WHILE" }
  if (strEq(w, "for")) { return "FOR" }
  if (strEq(w, "return")) { return "RETURN" }
  if (strEq(w, "when")) { return "WHEN" }
  if (strEq(w, "is")) { return "IS" }
  if (strEq(w, "in")) { return "IN" }
  if (strEq(w, "as")) { return "AS" }
  if (strEq(w, "struct")) { return "STRUCT" }
  if (strEq(w, "class")) { return "CLASS" }
  if (strEq(w, "enum")) { return "ENUM" }
  if (strEq(w, "deinit")) { return "DEINIT" }
  if (strEq(w, "pub")) { return "PUB" }
  if (strEq(w, "import")) { return "IMPORT" }
  if (strEq(w, "true")) { return "TRUE" }
  if (strEq(w, "false")) { return "FALSE" }
  if (strEq(w, "null")) { return "NULL" }
  if (strEq(w, "this")) { return "THIS" }
  if (strEq(w, "self")) { return "SELF" }
  if (strEq(w, "mut")) { return "MUT" }
  if (strEq(w, "consuming")) { return "CONSUMING" }
  if (strEq(w, "inout")) { return "INOUT" }
  if (strEq(w, "trait")) { return "TRAIT" }
  if (strEq(w, "impl")) { return "IMPL" }
  if (strEq(w, "where")) { return "WHERE" }
  if (strEq(w, "break")) { return "BREAK" }
  if (strEq(w, "continue")) { return "CONTINUE" }
  return ""
}

// --- token readers (each returns the Token.to_string form, advancing lx) -------
fun readIdent(lx: Lx): String {
  val start = lx.pos
  while (isAlnum(cur(lx))) { advance(lx) }
  val w = substr(lx.src, start, lx.pos - start)
  val kw = kwName(w)
  if (strEq(kw, "")) { return concat("IDENT(", concat(w, ")")) }
  return kw
}

fun readNumber(lx: Lx): String {
  val start = lx.pos
  while (isDigit(cur(lx))) { advance(lx) }
  if (cur(lx) == 46 && isDigit(nxt(lx))) {                     // '.' then digit -> float
    advance(lx)
    while (isDigit(cur(lx))) { advance(lx) }
    val f = substr(lx.src, start, lx.pos - start)
    return concat("FLOAT(", concat(f, ")"))
  }
  val w = substr(lx.src, start, lx.pos - start)
  return concat("INT(", concat(w, ")"))
}

fun readChar(lx: Lx): String {
  advance(lx)                                                  // opening '
  var code = 0
  if (cur(lx) == 92) {                                         // escape
    advance(lx)
    val e = cur(lx)
    if (e == 110) { code = 10 } else {
    if (e == 116) { code = 9 } else {
    if (e == 114) { code = 13 } else {
    if (e == 92) { code = 92 } else {
    if (e == 39) { code = 39 } else {
    if (e == 48) { code = 0 } else { code = e } } } } } }
    advance(lx)
  } else { code = cur(lx) ; advance(lx) }
  advance(lx)                                                  // closing '
  return concat("CHAR(", concat(intToStr(code), ")"))
}

fun appendPart(out: String, n: Int, part: String): String {
  if (n == 0) { return part }
  return concat(out, concat("; ", part))
}

// Re-escape a raw (triple-string) chunk to match OCaml's %S rendering: literal
// backslash/quote/newline/tab/CR become \\ \" \n \t \r. (Non-triple chunks already
// carry their escapes in the source, so they are emitted verbatim.)
fun escapeS(s: String): String {
  var out = ""
  var i = 0
  val n = strLen(s)
  while (i < n) {
    val c = charAt(s, i)
    if (c == 92) { out = concat(out, "\\\\") }
    else { if (c == 34) { out = concat(out, "\\\"") }
    else { if (c == 10) { out = concat(out, "\\n") }
    else { if (c == 9) { out = concat(out, "\\t") }
    else { if (c == 13) { out = concat(out, "\\r") }
    else { out = concat(out, substr(s, i, 1)) } } } } }
    i = i + 1
  }
  return out
}

// Render a literal string chunk as a `str "..."` INTERP part (escaping only when
// the surrounding literal is a raw triple-quoted string).
fun strPart(raw: String, triple: Int): String {
  if (triple == 1) { return concat("str \"", concat(escapeS(raw), "\"")) }
  return concat("str \"", concat(raw, "\""))
}

// forward-referenced by ${...}: tokenize a substring, space-joined to_string.
fun tokenizeSub(sub: String): String {
  val lx = Lx(sub, strLen(sub), 0)
  var out = ""
  var first = 1
  var go = 1
  while (go == 1) {
    skipTrivia(lx)
    if (lx.pos >= lx.n) { go = 0 }
    else {
      val t = tokStr(lx)
      if (first == 1) { out = t ; first = 0 } else { out = concat(out, concat(" ", t)) }
    }
  }
  return out
}

fun atClose(lx: Lx, triple: Int): Bool {
  if (triple == 1) { return cur(lx) == 34 && nxt(lx) == 34 && at2(lx) == 34 }
  return cur(lx) == 34
}

// "..." / """...""" with $x and ${expr} interpolation (mirrors lexer.ml read_interp).
fun readString(lx: Lx): String {
  var triple = 0
  if (cur(lx) == 34 && nxt(lx) == 34 && at2(lx) == 34) { triple = 1 }
  advance(lx)                                                  // opening quote
  if (triple == 1) { advance(lx) ; advance(lx) }
  var out = ""
  var nparts = 0
  var hasInterp = 0
  var chunkStart = lx.pos
  var wholeStart = lx.pos
  var payload = ""
  var scanning = 1
  while (scanning == 1) {
    if (atClose(lx, triple)) {
      if (hasInterp == 1) {
        if (lx.pos > chunkStart) {
          val chunk = substr(lx.src, chunkStart, lx.pos - chunkStart)
          out = appendPart(out, nparts, strPart(chunk, triple))
          nparts = nparts + 1
        }
      } else {
        val rawp = substr(lx.src, wholeStart, lx.pos - wholeStart)
        if (triple == 1) { payload = escapeS(rawp) } else { payload = rawp }
      }
      advance(lx)                                              // closing quote
      if (triple == 1) { advance(lx) ; advance(lx) }
      scanning = 0
    } else {
      val c = cur(lx)
      if (c == 0) { scanning = 0 }                             // unterminated: bail
      else {
        if (triple == 0 && c == 92) { advance(lx) ; advance(lx) }   // escape: stays in chunk
        else {
          if (c == 36 && nxt(lx) == 123) {                     // ${ expr }
            if (lx.pos > chunkStart) {
              val chunk = substr(lx.src, chunkStart, lx.pos - chunkStart)
              out = appendPart(out, nparts, strPart(chunk, triple))
              nparts = nparts + 1
            }
            hasInterp = 1
            advance(lx) ; advance(lx)                          // $ {
            val subStart = lx.pos
            var depth = 1
            var sc = 1
            while (sc == 1) {
              val cc = cur(lx)
              if (cc == 0) { sc = 0 }
              else { if (cc == 123) { depth = depth + 1 ; advance(lx) }
              else { if (cc == 125) { depth = depth - 1 ; if (depth == 0) { sc = 0 } else { advance(lx) } }
              else { advance(lx) } } }
            }
            val sub = substr(lx.src, subStart, lx.pos - subStart)
            advance(lx)                                        // closing }
            out = appendPart(out, nparts, concat("expr(", concat(tokenizeSub(sub), ")")))
            nparts = nparts + 1
            chunkStart = lx.pos
          } else {
            if (c == 36 && isAlpha(nxt(lx))) {                 // $ident
              if (lx.pos > chunkStart) {
                val chunk = substr(lx.src, chunkStart, lx.pos - chunkStart)
                out = appendPart(out, nparts, strPart(chunk, triple))
                nparts = nparts + 1
              }
              hasInterp = 1
              advance(lx)                                      // $
              val s0 = lx.pos
              while (isAlnum(cur(lx))) { advance(lx) }
              val name = substr(lx.src, s0, lx.pos - s0)
              out = appendPart(out, nparts, concat("expr(IDENT(", concat(name, "))")))
              nparts = nparts + 1
              chunkStart = lx.pos
            } else { advance(lx) }                             // literal char
          }
        }
      }
    }
  }
  if (hasInterp == 0) { return concat("STRING(\"", concat(payload, "\")")) }
  return concat("INTERP[", concat(out, "]"))
}

fun readOp(lx: Lx): String {
  val c = cur(lx)
  advance(lx)                                                  // consume c; cur is now the lookahead
  val d = cur(lx)
  if (c == 40) { return "LPAREN" }
  if (c == 41) { return "RPAREN" }
  if (c == 123) { return "LBRACE" }
  if (c == 125) { return "RBRACE" }
  if (c == 91) { return "LBRACKET" }
  if (c == 93) { return "RBRACKET" }
  if (c == 44) { return "COMMA" }
  if (c == 59) { return "SEMI" }
  if (c == 64) { return "AT" }
  if (c == 46) { if (d == 46) { advance(lx) ; return "DOTDOT" } return "DOT" }
  if (c == 58) { if (d == 58) { advance(lx) ; return "COLONCOLON" } return "COLON" }
  if (c == 43) { return "PLUS" }
  if (c == 42) { return "STAR" }
  if (c == 47) { return "SLASH" }
  if (c == 37) { return "PERCENT" }
  if (c == 45) { if (d == 62) { advance(lx) ; return "ARROW" } return "MINUS" }
  if (c == 61) {
    if (d == 61) { advance(lx) ; return "EQ" }
    if (d == 62) { advance(lx) ; return "FATARROW" }
    return "ASSIGN"
  }
  if (c == 33) {
    if (d == 61) { advance(lx) ; return "NEQ" }
    if (d == 33) { advance(lx) ; return "BANGBANG" }
    return "NOT"
  }
  if (c == 60) { if (d == 61) { advance(lx) ; return "LE" } return "LT" }
  if (c == 62) { if (d == 61) { advance(lx) ; return "GE" } return "GT" }
  if (c == 38) { if (d == 38) { advance(lx) ; return "ANDAND" } return "ERR" }
  if (c == 124) { if (d == 124) { advance(lx) ; return "OROR" } return "PIPE" }
  if (c == 63) {
    if (d == 46) { advance(lx) ; return "QDOT" }
    if (d == 58) { advance(lx) ; return "ELVIS" }
    return "QUESTION"
  }
  return "ERR"
}

fun tokStr(lx: Lx): String {
  val c = cur(lx)
  if (isDigit(c)) { return readNumber(lx) }
  if (isAlpha(c)) { return readIdent(lx) }
  if (c == 34) { return readString(lx) }                       // "
  if (c == 39) { return readChar(lx) }                         // '
  return readOp(lx)
}

// Main scan loop: mirrors lexer.ml tokenize, including ATI NEWLINE + trailing EOF.
fun lexAll(src: String): Int {
  val lx = Lx(src, strLen(src), 0)
  var last = "NEWLINE"                                         // start as if just after a newline
  var count = 0
  var go = 1
  while (go == 1) {
    val sawNl = skipTrivia(lx)
    if (lx.pos >= lx.n) { println("EOF") ; count = count + 1 ; go = 0 }
    else {
      var nextCont = 0
      if (cur(lx) == 46) { nextCont = 1 }
      if (cur(lx) == 63 && nxt(lx) == 46) { nextCont = 1 }
      if (sawNl == 1 && canEnd(last) && nextCont == 0) {
        println("NEWLINE") ; last = "NEWLINE" ; count = count + 1
      } else {
        val t = tokStr(lx)
        println(t) ; last = t ; count = count + 1
      }
    }
  }
  return count
}

fun main(): Int {
  val src = readFile("/tmp/klex_input.kite")
  return lexAll(src)                                           // exit code = token count (mod 256)
}
