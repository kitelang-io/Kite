// lib/alloc/collections/vec.kite — the monomorphized, CoW value-semantics growable array (kite::alloc::collections::vec), the
// Phase-7 target-tier Vec<T>. `@mono` marks it a TEMPLATE: the compiler emits nothing for the generic
// form; each concrete construction `Vec::<U16>(..)` instantiates a specialized `Vec$U16` whose storage is
// PACKED by sizeOf<T>() stride and whose element ops are the width/sign-correct sized load/store chosen at
// instantiation — zero-cost, exactly the code a programmer would hand-write per type. `Vec<Point>` (a
// reference element) stores one pointer word per element (sizeOf<T>() = 8).
//
// `@value` gives it VALUE SEMANTICS via CoW-over-ARC (STDLIB-REDESIGN §124): the handle {n, cap, buf} is
// copied on bind (its `copy` method deep-retains the shared RawBuf), and a mutator calls `ensureUnique`
// first — cloning the buffer when __refcount(buf) > 1 — so mutating a copy copy-on-writes and never
// corrupts the original. `val b = a; b.set(0, 9)` leaves `a` untouched. The RawBuf is a distinct ARC
// object whose refcount is the uniqueness signal.
//
// Access is bounds-checked: `get(i)`/`set(i,_)` panic on an out-of-range index (the raw ops read arbitrary
// heap); where empty is a valid state the accessor returns `Option` (`pop`/`first`/`last`/`indexOf`).
// `getOr(i, d)` is the non-panicking read. Construct empty with `Vec::<T>(0, 0, RawBuf(0))`.
//
// Storage: {n: element count, cap: capacity in elements, buf: RawBuf holding the packed byte-buffer}.
//
// Deps via NAMESPACE import: the module pipeline runs the @mono instantiation pass (klower's collectModuleDecls
// records the @mono/@value templates and finishLower's runMono instantiates them), so `import kite::alloc::collections::vec`
// + `Vec::<Int>(..)` monomorphizes exactly as a quoted/flat include does — no quoted-path workaround needed.
import kite::core::panic
import kite::alloc::collections::internal::rawbuf

@mono
@value
class Vec<T>(var n: Int, var cap: Int, var buf: RawBuf) {
  // CoW: clone the buffer away from other owners before an in-place write. A no-op when uniquely owned
  // (the common path), so mutation stays zero-overhead beyond a single refcount read.
  fun ensureUnique(self): Int {
    if (__refcount(self.buf) > 1) {
      val stride = sizeOf::<T>()
      val nd = if (self.cap == 0) { 0 } else { __rawAlloc(self.cap * stride) }
      val used = self.n * stride
      var i = 0
      while (i < used) { __rawStoreByte(nd, i, __rawLoadByte(self.buf.data, i)) i = i + 1 }
      // element-ARC: the clone's byte-copy duplicated each class element POINTER without a retain, so the two
      // buffers now co-own the same elements. Retain each so both handles' drops balance (else a double-free).
      // No-op (byte-free) for non-class T, so a non-class Vec's ensureUnique is byte-identical.
      __packedRetainAll::<T>(nd, self.n)
      val old = self.buf
      self.buf = RawBuf(nd)
      old.drop()
    }
    return 0
  }
  // TRUE element-ARC drop: for a CLASS-element instantiation (Vec$Box), the compiler SYNTHESIZES a
  // `deinit` (klower monoInstantiate -> synthContainerDeinit) that, at the last owner of the shared buffer,
  // releases the buffer's +1 on every live element (slots 0..n, all push-initialized) then drops the buffer;
  // the generated ___rel_Vec$Box runs it on last release. It is NOT written here as a template `deinit {}`
  // block on purpose: that would give the erased TEMPLATE `Vec` a `Vec_deinit` and make the bootstrap seed
  // emit a ___rel_Vec calling the (dropped) template deinit — a dangling symbol. Synthesizing per class
  // instantiation keeps the template deinit-free (seed-safe) and Vec$Int deinit-free (byte-identical).
  // value COPY on bind: share the buffer (+1) so a later write on either side copy-on-writes.
  fun copy(self): Vec<T> {
    __retain(self.buf)
    return Vec::<T>(self.n, self.cap, self.buf)
  }
  // `[..]` COLLECTION-LITERAL PROTOCOL (opt-in, see klower recordProtocol / buildSeqLit). A type joins the
  // `[a, b, c]` desugar by declaring an ASSOCIATED empty-constructor tagged `@lang("seq.new")` (the desugar
  // calls it to build a fresh empty instance) plus a mutator tagged `@lang("seq.push")` (the desugar appends
  // each element through it, element type = the first generic param). `@lang("seq.default")` additionally
  // designates Vec as the type a bare `[a, b, c]` (no expected user type) builds — the compiler-wide default,
  // sourced from HERE, not a hardcoded type-name in the lowerer.
  @lang("seq.new")
  @lang("seq.default")
  fun empty(): Vec<T> = Vec::<T>(0, 0, RawBuf(0))
  @lang("seq.push")
  fun push(self, x: consuming T): Int {
    self.ensureUnique()
    if (self.n == self.cap) {
      if (self.cap == 0) { self.cap = 4 } else { self.cap = self.cap * 2 }
      self.buf.data = __rawRealloc(self.buf.data, self.cap * sizeOf::<T>())
    }
    __packedSet::<T>(self.buf.data, self.n, x)
    self.n = self.n + 1
    return 0
  }
  fun get(self, i: Int): T {
    if (i < 0 || i >= self.n) { panicOOB("Vec.get", i, self.n) }
    return __packedGet::<T>(self.buf.data, i)
  }
  fun getOr(self, i: Int, dflt: T): T {
    if (i < 0 || i >= self.n) { return dflt }
    return __packedGet::<T>(self.buf.data, i)
  }
  fun set(self, i: Int, x: consuming T): Int {
    if (i < 0 || i >= self.n) { panicOOB("Vec.set", i, self.n) }
    self.ensureUnique()
    // OVERWRITE of an occupied slot: release the old class element (the buffer's +1) before storing the new
    // one. Safe because a Vec slot i<n was always filled by push. For non-class T this is a plain store.
    __packedSetOw::<T>(self.buf.data, i, x)
    return 0
  }
  fun len(self): Int { return self.n }
  fun isEmpty(self): Bool { return self.n == 0 }
  fun capacity(self): Int { return self.cap }
  fun clear(self): Int { self.n = 0 return 0 }
  fun reserve(self, want: Int): Int {
    if (want > self.cap) {
      self.ensureUnique()
      var c = self.cap
      if (c == 0) { c = 4 }
      while (c < want) { c = c * 2 }
      self.buf.data = __rawRealloc(self.buf.data, c * sizeOf::<T>())
      self.cap = c
    }
    return 0
  }
  fun pop(self): Option<T> {
    if (self.n == 0) { return None }
    self.n = self.n - 1
    return Some(__packedGet::<T>(self.buf.data, self.n))
  }
  fun first(self): Option<T> {
    if (self.n == 0) { return None }
    return Some(__packedGet::<T>(self.buf.data, 0))
  }
  fun last(self): Option<T> {
    if (self.n == 0) { return None }
    return Some(__packedGet::<T>(self.buf.data, self.n - 1))
  }
  fun indexOf(self, x: T): Option<Int> {
    var i = 0
    while (i < self.n) {
      if (__packedGet::<T>(self.buf.data, i) == x) { return Some(i) }
      i = i + 1
    }
    return None
  }
  fun contains(self, x: T): Bool { return self.indexOf(x).isSome() }

  // ---- sequence combinators (Kotlin-style) ----
  // The Vec<T> analogues of IntBuf's Int-only fold/find/map/filter, now on the public generic Vec (what
  // `[..]` yields). Each is a read-only walk that INVOKES the caller's closure; the method body itself does
  // no arithmetic on T (only `find`/`filter` build Options/Vecs), so every one monomorphizes cleanly for ANY
  // element type — important because a Vec<T> instantiation specializes ALL its template methods, used or not.
  // `fold`'s accumulator is `Int` (matching IntBuf.fold, the common reduce-to-a-number case); `find` returns
  // `Option<T>`; `map`/`filter` return a fresh `Vec<T>`. `sum` (the one method that arithmetically combines
  // elements) stays on IntBuf only — a Vec<T>.sum would monomorphize `a + x` for every instantiated T
  // (String/Box/...), silently misrouting for a non-numeric element; use `.fold(0){ a, x -> a + x }`.
  // A closure whose body calls a METHOD on the element (`{ s -> s.len() }`) needs an explicit param type
  // (`{ s: String -> s.len() }`) since the erased element type does not flow into an unannotated lambda param.
  fun forEach(self, f: (T) -> Int): Int { var i = 0 while (i < self.n) { f(self.get(i)) i = i + 1 } return 0 }
  fun fold(self, acc: Int, f: (Int, T) -> Int): Int { var a = acc var i = 0 while (i < self.n) { a = f(a, self.get(i)) i = i + 1 } return a }
  fun any(self, pred: (T) -> Bool): Bool { var i = 0 while (i < self.n) { if (pred(self.get(i))) { return true } i = i + 1 } return false }
  fun all(self, pred: (T) -> Bool): Bool { var i = 0 while (i < self.n) { if (pred(self.get(i)) == false) { return false } i = i + 1 } return true }
  fun find(self, pred: (T) -> Bool): Option<T> { var i = 0 while (i < self.n) { val x = self.get(i) if (pred(x)) { return Some(x) } i = i + 1 } return None }
  fun map(self, f: (T) -> T): Vec<T> { val out = Vec::<T>(0, 0, RawBuf(0)) var i = 0 while (i < self.n) { out.push(f(self.get(i))) i = i + 1 } return out }
  fun filter(self, pred: (T) -> Bool): Vec<T> { val out = Vec::<T>(0, 0, RawBuf(0)) var i = 0 while (i < self.n) { val x = self.get(i) if (pred(x)) { out.push(x) } i = i + 1 } return out }

  // Kotlin `joinToString`: render EACH element to its string form and concatenate with `sep`, onto ONE
  // StrBuilder (amortized, no O(n^2) concat chain). The element is rendered through interpolation
  // (`"${self.get(i)}"`) — which lowers via the `str.show` role — so in each MONOMORPHIZED specialization
  // `self.get(i)` has the concrete element type T and its renderer resolves at instantiation time: a
  // `Vec$Int` renders via Int_toStr, a `Vec$String` passes the String through unchanged. There is no
  // "assume the erased word is already a String" footgun — a `Vec<Int>.join(",")` prints "1,2,3", never
  // crashes. An empty Vec joins to "", a single element to just that element (no separator).
  fun join(self, sep: String): String {
    val sb = strNew()
    var i = 0
    while (i < self.len()) {
      if (i > 0) { sb.pushStr(sep) }
      sb.pushStr("${self.get(i)}")
      i = i + 1
    }
    return sb.finish()
  }
}
