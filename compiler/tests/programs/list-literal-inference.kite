// TYPE-DIRECTED `[..]` element inference: a list literal becomes a first-class monomorphized Vec<T> whenever
// the element type T is statically KNOWN from the checker-equivalent type oracle — not only for literal/ctor
// elements. This exercises the cases the old SYNTACTIC inference fell back to IntBuf for:
//   1. `[a, b, c]` over Int VARIABLES  -> Vec<Int> (proven via Vec-only methods contains/getOr/pop), and the
//      same over a `Vec<Int>` annotation.
//   2. `[s1, s2]` over String VARIABLES -> Vec<String> (element .len() dispatches through the loop var + get).
//   3. `[p, q]` over class VARIABLES    -> Vec<Box> (index + get + field read; clean ARC scope-exit).
//   4. empty `[]` RETURNED from a `Vec<Int>` function -> a real empty Vec that accepts .push/index.
//   5. empty `[]` passed as a `Vec<Int>` ARGUMENT      -> a real empty Vec, grown inside the callee.
//   6. a genuinely-heterogeneous list -> graceful IntBuf fallback (no flip, no crash).
// Exit code = 17 (count of passed assertions).
class Box(val v: Int) { }

fun makeEmpty(): Vec<Int>{ return [] }

fun sumVec(xs: Vec<Int>): Int {
  xs.push(10)
  xs.push(20)
  var s = 0
  for (x in xs) { s = s + x }
  return s
}

fun main(): Int {
  var acc = 0

  // 1. [a, b, c] over Int VARIABLES is a Vec<Int> (not the erased IntBuf) — prove it via Vec-only methods.
  val a = 1
  val b = 2
  val c = 3
  val xs = [a, b, c]
  if (xs.len() == 3) { acc = acc + 1 } // 1
  if (xs.contains(2)) { acc = acc + 1 } // 2  (Vec-only)
  if (xs.getOr(9, 7) == 7) { acc = acc + 1 } // 3  (Vec-only, out-of-range default)
  when (xs.pop()) { Some(v) -> { if (v == 3) { acc = acc + 1 } }; None -> 0 } // 4 (Vec-only)
  if (xs.len() == 2) { acc = acc + 1 } // 5  (pop shrank it)

  // variable-element literal assigned to a Vec<Int> annotation.
  val ys: Vec<Int> = [a, b, c]
  if (ys.contains(1)) { acc = acc + 1 } // 6

  // 2. [s1, s2] over String VARIABLES -> Vec<String>; the loop var + get dispatch String_len.
  val s1 = "ab"
  val s2 = "cde"
  val ws = [s1, s2]
  var tot = 0
  for (w in ws) { tot = tot + w.len() } // 2 + 3 = 5
  if (tot == 5) { acc = acc + 1 } // 7
  if (ws.get(0).len() == 2) { acc = acc + 1 } // 8  (Vec<String> element method)
  if (ws.len() == 2) { acc = acc + 1 } // 9

  // 3. [p, q] over class VARIABLES -> Vec<Box>: index + get + field read.
  val p = Box(100)
  val q = Box(200)
  val bs = [p, q]
  if (bs.get(0).v == 100) { acc = acc + 1 } // 10
  if (bs[1].v == 200) { acc = acc + 1 } // 11
  if (bs.len() == 2) { acc = acc + 1 } // 12

  // 4. empty `[]` returned from a Vec<Int> function -> real empty Vec, accepts .push + index.
  val e1 = makeEmpty()
  if (e1.isEmpty()) { acc = acc + 1 } // 13
  e1.push(5)
  e1.push(6)
  if (e1.len() == 2) { acc = acc + 1 } // 14
  if (e1[1] == 6) { acc = acc + 1 } // 15

  // 5. empty `[]` passed as a Vec<Int> argument -> real empty Vec, grown inside the callee.
  if (sumVec([]) == 30) { acc = acc + 1 } // 16

  // 6. heterogeneous elements -> graceful IntBuf fallback (no Vec flip, no crash); len() still works.
  val mix = [1, "two"]
  if (mix.len() == 2) { acc = acc + 1 } // 17

  return acc
}
