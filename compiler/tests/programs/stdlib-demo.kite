// stdlib-demo — exercises the standard library's higher-order IntBuf methods (map/filter/fold/find) and
// the Option helpers, all from the prelude (kite::alloc::collections::internal::intbuf + kite::core::option). No
// local reimplementations: these ARE the shipped methods.
fun main(): Int {
  val xs = list()
  xs.push(1); xs.push(2); xs.push(3); xs.push(4); xs.push(5)
  val doubled = xs.map({ n -> n * 2 })
  val evens = doubled.filter({ n -> n % 4 == 0 })
  val sum = evens.fold(0, { a, x -> a + x })
  val found = xs.find({ n -> n > 3 })
  val fv = optGetOr(found, 0)
  val none = xs.find({ n -> n > 100 })
  val nv = optGetOr(none, 99)
  return sum * 10 + fv + nv
}
