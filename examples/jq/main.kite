// main.kite — the jq CLI entry point. Mirrors jq's src/main.c: read a filter + a JSON file, evaluate,
// print each result on its own line (compact, like `jq -c`).
//
//   build: kitec examples/jq/main.kite -o jq
//   run:   ./jq '.tags[]' file.json
import "examples/jq/jv.kite"
import "examples/jq/jv_parse.kite"
import "examples/jq/jv_print.kite"
import "examples/jq/jq.kite"

fun main(argc: Int, argv: Int): Int {
  if (argc < 3) { println("usage: jq '<filter>' <file.json>") return 1 }
  val program = __argv(argv, 1)
  val file = __argv(argv, 2)
  val root = parseJson(readFile(file))
  val results = runQuery(parseQuery(program), root)
  for (r in results) { println(jsonToStr(r)) }
  return 0
}
