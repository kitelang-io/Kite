// kite::core::ops — operator overloading traits (Rust-style), routed through the existing trait system.
//
// An arithmetic operator desugars (in klower's lowerBin) to the matching trait method when the LEFT
// operand's concrete type defines it:
//   +  ->  Add::add      -  ->  Sub::sub      *  ->  Mul::mul      /  ->  Div::div      %  ->  Rem::rem
// A type overloads an operator by implementing the trait, e.g.
//   impl Add for V2 { fun add(self, rhs: V2): V2 { return V2(self.x + rhs.x, self.y + rhs.y) } }
// Primitive Int/Float arithmetic has no such impl, so it falls through to the built-in machine ops —
// this is zero-cost for the numeric core (the compiler's own sources only ever `+` integers).
// `Self` denotes the implementing type. Auto-included via compiler/prelude.conf BEFORE the string module
// (which impls Add for String to overload `+` as concatenation).
// The @lang("op.X") attribute names the desugar role: klower's lowerBin maps a source operator to the
// trait method's bare name (emitted mangled with the LEFT operand's type at the use site, e.g. V2_add).
trait Add { @lang("op.+") fun add(self, rhs: Self): Self }

trait Sub { @lang("op.-") fun sub(self, rhs: Self): Self }

trait Mul { @lang("op.*") fun mul(self, rhs: Self): Self }

trait Div { @lang("op./") fun div(self, rhs: Self): Self }

trait Rem { @lang("op.%") fun rem(self, rhs: Self): Self }

// Eq overloads `==` (and `!=` as its negation) as VALUE comparison, routed like the arithmetic operators.
// klower's lowerBin desugars `a == b` to the `eq` method (emitted mangled with the operand's type, e.g.
// String_eq) ONLY when an operand is concretely String; `a != b` lowers to `not(a == b)`. Int/Char/Float
// and every other type have no Eq impl, so their `==`/`!=` fall through to the built-in machine compare —
// zero-cost, and the pervasive integer `==` in the compiler's own sources is never misrouted. Returns Bool.
trait Eq { @lang("op.==") fun eq(self, rhs: Self): Bool }
