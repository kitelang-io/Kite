// lib/alloc/collections/internal/intbuf.kite — the language-primitive IntBuf (kite::alloc::collections::internal::intbuf).
// The growable word-list {len@0, cap@8, data@16} that backs the [..] literal, built on the compiler
// raw-memory intrinsics. In alloc because it OWNS a heap allocation; a sibling of vec/map (RawMap lives in
// the sibling map module). Following Kotlin, a type's convention methods (the desugar landing points)
// live WITH the type, not in a separate sugar library; the [..] constructor is top-level like Kotlin
// listOf(). Names are global (unmangled): the prelude injects them.
//
// IntBuf is a real CLASS: {n: count, cap: capacity, data: heap word-buffer}. The intBuf() factory builds
// it with the class constructor and the ops read/write its fields. NOTE: IntBuf is EXEMPT from automatic ARC (see
// isBuiltinNominal in klower.kite) — its elements are type-erased Int words that listPush can't retain,
// and the compiler nests lists-in-lists (structF/funP/variantTys), so a naive release would free an
// inner list while the outer still holds its raw pointer (UAF). So IntBuf stays leak-managed as before;
// the class only gives it a visible layout + methods.
// Methods live IN the class body (self-style, like Vec) — these ARE the real implementation AND the
// desugar landing points, mangled to IntBuf_push / IntBuf_get / IntBuf_set / IntBuf_size by the
// method system. The [..] literal lowering and a[i]/for-in desugar (klower's roleSym) resolve directly
// to these mangled methods — there are NO free-function delegates anymore (pure method-ification).
// `push`/`get`/`set`/`size` (Kotlin names a sequence's element count `size`; `xs.size` no-parens also
// resolves here as a getter).
// @arc(manual): IntBuf is exempt from automatic ARC — its elements are type-erased words push can't
// retain, and the compiler nests lists-in-lists, so a naive deep-release would UAF. Leak-managed.
@arc(manual)
class IntBuf(var n: Int, var cap: Int, var data: USize) {
  // @lang("intbuf.push"): the [..] literal desugar appends elements via this method (emitted List_push).
  // @lang("rawmap.putList"): the {..} map desugar also appends into a parallel word-list via this method.
  @lang("intbuf.push")
  @lang("rawmap.putList")
  fun push(self, x: consuming Int): Int {
    // grow-if-full. Guard cap==0 explicitly: 0*2 is still 0, so a lazily-allocated (cap 0) IntBuf would
    // realloc 0 bytes and write OOB at offset 0, then never grow (n==cap forever). Today intBuf() starts
    // cap at 4 so this can't happen, but the guard keeps push correct if a cap-0 constructor is added.
    if (self.n == self.cap) {
      if (self.cap == 0) { self.cap = 4 } else { self.cap = self.cap * 2 }
      self.data = __rawRealloc(self.data, self.cap * 8)
    }
    __rawStore(self.data, self.n * 8, x)
    self.n = self.n + 1
    return 0
  }
  // @lang("intbuf.get"): a[i] load / for-in element resolves to this method (emitted List_get).
  @lang("intbuf.get")
  fun get(self, i: Int): Int { return __rawLoad(self.data, i * 8) }
  // @lang("intbuf.set"): a[i] = v store resolves to this method (emitted List_set).
  @lang("intbuf.set")
  fun set(self, i: Int, x: consuming Int): Int { __rawStore(self.data, i * 8, x) return 0 }
  // @lang("intbuf.len"): for-in bound / a[i] length resolves to this method (emitted IntBuf_size). The role
  // KEY stays "intbuf.len" (a stable internal identifier); the METHOD is Kotlin's sequence `size`.
  @lang("intbuf.len")
  fun size(self): Int { return self.n }
  fun isEmpty(self): Bool { return self.n == 0 }

  // Generic higher-order operations — one machine word per element, closures supported. These were the
  // free rangeList/mapList/filterList/foldList/findList/sumList of kite::alloc::collections; folded in as
  // real methods (xs.map(f) / xs.fold(acc,f) / xs.find(pred) / ...) alongside the type they operate on.
  // The element type is the erased machine word (Int); the closure params carry function types so the
  // parser records the real RETURN type (an untyped last param would absorb it), which makes chaining
  // like `xs.map(f).sum()` resolve the receiver correctly.
  fun map(self, f: (Int) -> Int): IntBuf { val out = intBuf() var i = 0 while (i < self.n) { out.push(f(self.get(i))) i = i + 1 } return out }
  fun filter(self, pred: (Int) -> Bool): IntBuf { val out = intBuf() var i = 0 while (i < self.n) { val x = self.get(i) if (pred(x)) { out.push(x) } i = i + 1 } return out }
  fun fold(self, acc: Int, f: (Int, Int) -> Int): Int { var a = acc var i = 0 while (i < self.n) { a = f(a, self.get(i)) i = i + 1 } return a }
  // find returns a std Option<elem> (kite::core::option, in the prelude) — Some(x) for the first match, else None.
  fun find(self, pred: (Int) -> Bool): Option { var i = 0 while (i < self.n) { val x = self.get(i) if (pred(x)) { return Some(x) } i = i + 1 } return None }
  fun sum(self): Int { return self.fold(0, { a, x -> a + x }) }
}

@lang("intbuf.new")
fun intBuf(): IntBuf { return IntBuf(0, 4, __rawAlloc(4 * 8)) }

// intBuf(xs..) — element-initialized construction sugar: `intBuf(1, 2, 3)` builds a populated IntBuf, a
// convenient equivalent of the `[..]` literal. This OVERLOADS the 0-arg `@lang("intbuf.new") fun intBuf()`
// above: an EXACT fixed-arity overload wins over a vararg one (Kotlin semantics), so a bare `intBuf()`
// still binds the 0-arg constructor and the `@lang` role stays on it (the compiler's own ~388 zero-arg
// `intBuf()` calls all resolve to the 0-arg version). The vararg tail is collected into a fresh
// `Array<Int>` — its `Array<T>` template is a sibling prelude module (kite::alloc::collections::array), so
// it is in scope here with no explicit import. Now a PRELUDE overload: `intBuf(1, 2, 3)` needs no import.
// This is safe because the committed seed now carries the overload-aware return-tag inference (klower
// `freeCallRetSym`) that tags an overloaded `intBuf()` result as IntBuf. Moving it here (from the former
// non-prelude kite::alloc::collections::factory module) legitimately grows the self-host fixpoint by
// emitting this function into the compiler binary; the invariant is self-reproduction (kcc2==kcc3), not a
// fixed byte size.
fun intBuf(vararg xs: Int): IntBuf {
  val out: IntBuf = intBuf()
  var i = 0
  while (i < xs.size()) { out.push(xs.get(i)) i = i + 1 }
  return out
}

// rangeList(n) — the list [0, 1, .., n-1]. A top-level IntBuf factory (no receiver), sibling to intBuf().
fun rangeList(n: Int): IntBuf { val out = intBuf() var i = 0 while (i < n) { out.push(i) i = i + 1 } return out }

// RawMap moved to its own prelude module (kite::alloc::collections::internal::rawmap) as a method-ified class.
