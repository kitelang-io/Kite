// lib/alloc/collections/list.kite — the language-primitive List (kite::alloc::collections::list).
// The growable word-list {len@0, cap@8, data@16} that backs the [..] literal, built on the compiler
// raw-memory intrinsics. In alloc because it OWNS a heap allocation; a sibling of vec/map (Map lives in
// the sibling map module). Following Kotlin, a type's convention methods (the desugar landing points)
// live WITH the type, not in a separate sugar library; the [..] constructor is top-level like Kotlin
// listOf(). Names are global (unmangled): the prelude injects them.
//
// List is a real CLASS: {n: count, cap: capacity, data: heap word-buffer}. listNew builds it with the
// class constructor and the ops read/write its fields. NOTE: List is EXEMPT from automatic ARC (see
// isBuiltinNominal in klower.kite) — its elements are type-erased Int words that listPush can't retain,
// and the compiler nests lists-in-lists (structF/funP/variantTys), so a naive release would free an
// inner list while the outer still holds its raw pointer (UAF). So List stays leak-managed as before;
// the class only gives it a visible layout + methods.
// Methods live IN the class body (self-style, like Vec) — these ARE the real implementation AND the
// desugar landing points, mangled to List_push / List_get / List_set / List_len / List_length by the
// method system. The [..] literal lowering and a[i]/for-in desugar (klower's roleSym) resolve directly
// to these mangled methods — there are NO free-function delegates anymore (pure method-ification).
// `push`/`get`/`set`/`len`, plus a `length` getter alias (so `xs.length` no-parens resolves here).
// @arc(manual): List is exempt from automatic ARC — its elements are type-erased words push can't
// retain, and the compiler nests lists-in-lists, so a naive deep-release would UAF. Leak-managed.
@arc(manual)
class List(var n: Int, var cap: Int, var data: Int) {
  // @lang("list.push"): the [..] literal desugar appends elements via this method (emitted List_push).
  // @lang("map.putList"): the {..} map desugar also appends into a parallel word-list via this method.
  @lang("list.push")
  @lang("map.putList")
  fun push(self, x: consuming Int): Int {
    // grow-if-full. Guard cap==0 explicitly: 0*2 is still 0, so a lazily-allocated (cap 0) List would
    // realloc 0 bytes and write OOB at offset 0, then never grow (n==cap forever). Today list() starts
    // cap at 4 so this can't happen, but the guard keeps push correct if a cap-0 constructor is added.
    if (self.n == self.cap) {
      if (self.cap == 0) { self.cap = 4 } else { self.cap = self.cap * 2 }
      self.data = __rawRealloc(self.data, self.cap * 8)
    }
    __rawStore(self.data, self.n * 8, x)
    self.n = self.n + 1
    return 0
  }
  // @lang("list.get"): a[i] load / for-in element resolves to this method (emitted List_get).
  @lang("list.get")
  fun get(self, i: Int): Int { return __rawLoad(self.data, i * 8) }
  // @lang("list.set"): a[i] = v store resolves to this method (emitted List_set).
  @lang("list.set")
  fun set(self, i: Int, x: consuming Int): Int { __rawStore(self.data, i * 8, x) return 0 }
  // @lang("list.len"): for-in bound / a[i] length resolves to this method (emitted List_len).
  @lang("list.len")
  fun len(self): Int { return self.n }
  fun length(self): Int { return self.n }

  // Generic higher-order operations — one machine word per element, closures supported. These were the
  // free rangeList/mapList/filterList/foldList/findList/sumList of kite::alloc::collections; folded in as
  // real methods (xs.map(f) / xs.fold(acc,f) / xs.find(pred) / ...) alongside the type they operate on.
  // The element type is the erased machine word (Int); the closure params carry function types so the
  // parser records the real RETURN type (an untyped last param would absorb it), which makes chaining
  // like `xs.map(f).sum()` resolve the receiver correctly.
  fun map(self, f: (Int) -> Int): List { val out = list() var i = 0 while (i < self.n) { out.push(f(self.get(i))) i = i + 1 } return out }
  fun filter(self, pred: (Int) -> Bool): List { val out = list() var i = 0 while (i < self.n) { val x = self.get(i) if (pred(x)) { out.push(x) } i = i + 1 } return out }
  fun fold(self, acc: Int, f: (Int, Int) -> Int): Int { var a = acc var i = 0 while (i < self.n) { a = f(a, self.get(i)) i = i + 1 } return a }
  // find returns a std Option<elem> (kite::core::option, in the prelude) — Some(x) for the first match, else None.
  fun find(self, pred: (Int) -> Bool): Option { var i = 0 while (i < self.n) { val x = self.get(i) if (pred(x)) { return Some(x) } i = i + 1 } return None }
  fun sum(self): Int { return self.fold(0, { a, x -> a + x }) }
}

@lang("list.new")
fun list(): List { return List(0, 4, __rawAlloc(4 * 8)) }

// rangeList(n) — the list [0, 1, .., n-1]. A top-level List factory (no receiver), sibling to list().
fun rangeList(n: Int): List { val out = list() var i = 0 while (i < n) { out.push(i) i = i + 1 } return out }

// Map moved to its own prelude module (kite::alloc::collections::map) as a method-ified class.
