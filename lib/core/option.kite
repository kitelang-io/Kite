// kite::core::option — Option/Result (global enums) + helpers. No allocation, no OS.
enum Option {
  Some(v); None
  fun isSome(self): Bool { return when (self) { Some(v) -> true; None -> false } }
  fun isNone(self): Bool { return when (self) { Some(v) -> false; None -> true } }
  fun getOr(self, dflt: Int): Int { return when (self) { Some(v) -> v; None -> dflt } }
}

enum Result { Ok(v); Err(e) }
