// lib/core/string.kite — the built-in String type: its primitives, its convention methods, and its
// operator overload — all co-located (kite::core::string). This is String's canonical home, mirroring
// how `lib/alloc/collections/list.kite` is `class List` + its methods; the extra ALLOCATING String
// utilities (joinList, strRepeat) live in `lib/alloc/string.kite`, and the growable `Str` builder in
// `lib/alloc/string/strbuf.kite` — the same type/utilities/builder split List uses.
//
// The built-in String is a primitive (a C-string). Below are (1) the raw byte primitives
// (charAt/strLen/strEq/concat/substr/intToStr), then (2) the desugar landing points for its nominal
// methods — `s.charAt(i)` -> String_charAt, `s.len()`/`s.length` -> String_len/String_length,
// `s.substr(a,b)` -> String_substr, `s.repeat(n)` -> String_repeat — and (3) `impl Add for String`,
// which overloads `+` as concatenation (klower's lowerBin desugars String `+` to String_add). Following
// Kotlin, a type's convention methods live WITH the type, not in a separate sugar library. Auto-included
// via compiler/prelude.conf (after kite::core::ops, which declares Add); names are global (unmangled).

// Pure-Kite string ops on the null-terminated byte representation (were libc-backed codegen builtins).
// charAt is just a byte load; strLen scans to the terminating 0. (`&&`/`!=` avoided — `&&` is bitwise.)
fun charAt(s: String, i: Int): Int { return __rawLoadByte(s, i) }
fun strLen(s: String): Int { var i = 0 var go = 1 while (go == 1) { if (__rawLoadByte(s, i) == 0) { go = 0 } else { i = i + 1 } } return i }
// byte-by-byte compare to the terminating 0 (returns Bool to match the intrinsic's registered type).
fun strEq(a: String, b: String): Bool {
  var i = 0
  var go = 1
  while (go == 1) {
    val ca = __rawLoadByte(a, i)
    val cb = __rawLoadByte(b, i)
    if (ca == cb) { if (ca == 0) { return true } } else { return false }
    i = i + 1
  }
  return false
}
// concat allocates la+lb+1 bytes and copies both, NUL-terminated (leaks like the old libc version).
fun concat(a: String, b: String): String {
  val la = strLen(a)
  val lb = strLen(b)
  val r = __rawAlloc(la + lb + 1)
  var i = 0
  while (i < la) { __rawStoreByte(r, i, __rawLoadByte(a, i)) i = i + 1 }
  var j = 0
  while (j < lb) { __rawStoreByte(r, la + j, __rawLoadByte(b, j)) j = j + 1 }
  __rawStoreByte(r, la + lb, 0)
  return r
}
// substr(s, start, length): copy length bytes from s+start into a fresh NUL-terminated buffer.
fun substr(s: String, st: Int, len: Int): String {
  val r = __rawAlloc(len + 1)
  var i = 0
  while (i < len) { __rawStoreByte(r, i, __rawLoadByte(s, st + i)) i = i + 1 }
  __rawStoreByte(r, len, 0)
  return r
}
// intToStr: base-10, handles 0 and negatives, into a fresh NUL-terminated buffer. `%` avoided via
// d = mm - (mm/10)*10. (ASCII '0'=48, '-'=45.) Was libc snprintf("%ld").
fun intToStr(n: Int): String {
  if (n == 0) { val z = __rawAlloc(2) __rawStoreByte(z, 0, 48) __rawStoreByte(z, 1, 0) return z }
  var neg = 0
  var m = n
  if (n < 0) { neg = 1 m = 0 - n }
  var digits = 0
  var t = m
  while (t > 0) { digits = digits + 1 t = t / 10 }
  val total = digits + neg
  val r = __rawAlloc(total + 1)
  __rawStoreByte(r, total, 0)
  var pos = total - 1
  var mm = m
  while (mm > 0) { val d = mm - (mm / 10) * 10 __rawStoreByte(r, pos, 48 + d) pos = pos - 1 mm = mm / 10 }
  if (neg == 1) { __rawStoreByte(r, 0, 45) }
  return r
}
fun String_charAt(s: String, i: Int): Int { return charAt(s, i) }
fun String_len(s: String): Int { return strLen(s) }
// `length` is the getter alias of `len`: a nullary method, so `s.length` (no parens) resolves here
// via klower's getter routing. NB: the receiver param is named `s`, not `self` — `self` is a reserved
// receiver keyword valid only inside a struct/impl method; free-function accessors need a plain name.
fun String_length(s: String): Int { return strLen(s) }
fun String_substr(s: String, a: Int, b: Int): String { return substr(s, a, b) }
// `s.repeat(n)` — n copies of s, concatenated (n<=0 yields ""). Allocating, but only via the concat primitive.
fun String_repeat(s: String, n: Int): String { var out = "" var i = 0 while (i < n) { out = concat(out, s) i = i + 1 } return out }
// String overloads `+` as concatenation via the Add operator trait (see kite::core::ops): klower's
// lowerBin desugars `a + b` where a: String to String_add(a, b). Registered as the mangled method String_add.
impl Add for String { fun add(self, rhs: String): String { return concat(self, rhs) } }
