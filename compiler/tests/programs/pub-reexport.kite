// pub-import re-export chain: `import kite::core` gives `Int.gcd` (core pub-imports core::math),
// Option::getOr/Some (core pub-imports core::option). `Int.gcd` is an extension method whose desugared free
// function is module-mangled under the namespace import; Phase M6's module-aware method resolver (resolveFun)
// binds `n.gcd(m)` across the module boundary to that mangled symbol — the surface `Int_gcd` name is no
// longer valid. `rangeList` and the `.sum()` IntBuf method come from the prelude
// (kite::alloc::collections::internal::intbuf); `import kite::alloc` still pulls in the collections aggregator.
import kite::core
import kite::alloc

fun main(): Int {
  return 100.gcd(60) + rangeList(5).sum() + Some(7).getOr(0)
}
