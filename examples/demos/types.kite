import kite::io

// value type: paren primary constructor, mixed pub/val/var
struct Rect(pub val width: Int, pub val height: Int, var scale: Int)

// reference type (ARC) with a deinit for RAII cleanup
class File(val fd: I32) {
  deinit {
    sysClose(fd)
  }
}

// payloaded enum: no payload, positional-type payload, named-field payload
enum Expr {
  Lit(Int)
  Bin(Op, Expr, Expr)
  Var(name: String)
}

enum IoError {
  NotFound
  Subprocess(code: I32)
  Other(msg: String)
}

fun area(r: Rect): Int {
  return r.width * r.height * r.scale
}
