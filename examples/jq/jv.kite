// jv.kite — the JSON value model + core accessors. Mirrors jq's src/jv.h + src/jv.c + src/jv_aux.c.
//
// Real jq stores numbers as IEEE-754 doubles (src/jv_dtoa.c); this port keeps them as Int and truncates
// fractions on parse. Lookups return a standard-library Option<Json> (kite::core::option) rather than a
// null sentinel, and the higher-order list ops are List methods (xs.find, from the prelude).
import kite::core::option
import kite::alloc::collections

struct Entry(val key: String, val value: Json)

enum Json { JNull; JBool(Bool); JNum(Int); JStr(String); JArr(List); JObj(List) } // JArr: List<Json>, JObj: List<Entry>

fun entryKey(e: Entry): String { return e.key }

fun entryValue(e: Entry): Json { return e.value }

// a one-character String from a byte, via a NUL-terminated 2-byte scratch buffer (shared string util).
fun chr(c: Int): String { val b = __rawAlloc(2) __rawStoreByte(b, 0, c) __rawStoreByte(b, 1, 0) return b }

// jv_object_get — Some(value) for a present key, else None (also None if the value isn't an object).
fun objGet(j: Json, name: String): Option {
  return when (j) {
    JObj(es) -> when (es.find({ e -> entryKey(e) == name })) {
      Some(e) -> Some(entryValue(e))
      None -> None
    }
    else -> None
  }
}

// jv_array_get — Some(elem) for an in-range index, else None. Like jq, a negative index counts from the end.
fun arrGet(j: Json, i: Int): Option {
  return when (j) {
    JArr(xs) -> {
      val idx = if (i < 0) { xs.len() + i } else { i }
      if (idx < 0) { None } else { if (idx >= xs.len()) { None } else { Some(xs.get(idx)) } }
    }
    else -> None
  }
}

// the stream `.[]` yields: an array's elements or an object's values, in insertion order (jq semantics).
fun jsonValues(j: Json): List {
  val out = list()
  when (j) {
    JArr(xs) -> { for (x in xs) { out.push(x) } }
    JObj(es) -> { for (e in es) { out.push(entryValue(e)) } }
    else -> 0
  }
  return out
}
